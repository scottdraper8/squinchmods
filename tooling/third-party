#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
tool_dir="${repo_root}/games/minecraft/tooling/third-party"
source "${repo_root}/games/minecraft/tooling/env.sh"

if ! command -v uv &>/dev/null; then
    echo "Install uv: https://docs.astral.sh/uv/getting-started/installation/" >&2
    exit 127
fi

exec uv run --project "${tool_dir}" python -m squinch_minecraft_third_party "$@"
