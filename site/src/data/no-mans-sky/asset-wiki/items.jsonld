ed combat unit.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.WALK_S.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.walk_s.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_WALK_S_NAME","descriptionKey":"BLD_WALK_S_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/STATUE_WALK_S","@type":"GameAsset"},{"id":"FOOD_B_PLAIN","name":"SIMPLE BISCUIT","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A refined food product, created in the Nutrient Processor. This thin sheet of nutrient paste has been slightly sweetened before being baked and sliced into a perfect portable snack.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.BISCUIT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.biscuit.webp","colour":"#534c45","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_B_PLAIN_NAME","descriptionKey":"UI_BISCUIT_DESC_BASIC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":28000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_B_PLAIN","@type":"GameAsset"},{"id":"UT_TRANSLATE1","name":"SIMPLE TRANSLATOR","kind":"Technology","category":"Suit","categoryKey":"Suit","rarity":"Common","subtitle":"Automatic Language Parser","description":"An automatic translation device. It records and parses nearby conversations before running the data through a contextual learning system to determine intended meaning. Low memory capacity on this entry-level model limits translation capacity.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/AUTOTRANSLATOR.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/autotranslator.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_TRANSLATE1_NAME","descriptionKey":"UT_TRANSLATE1_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/UT_TRANSLATE1","@type":"GameAsset"},{"id":"F_ALL_LEG_S1","name":"SINGING SEA-SNAIL","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Legendary Fish","description":"\"A voice like honey from a mouth of mucus.\"","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.SNAIL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.snail.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_ALL_LEG_S1_NAME","descriptionKey":"UI_FISH_ALL_LEG_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":50000,"level":4,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_ALL_LEG_S1","@type":"GameAsset"},{"id":"EXPD_BANNER10","name":"SINGULARITY BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Equip this exclusive Personal Flair in commemoration of the Singularity expedition, and the forging of the mysterious Construct. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.BANNER10.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.banner10.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_EXPD_10_NAME","descriptionKey":"UI_BANNER_EXPD_10_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_BANNER10","@type":"GameAsset"},{"id":"BIOSHIP_GROWTH4","name":"SINGULARITY CORE","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Living Starship Organ","description":"A sensitive arrangement of neurons in a stable orbit around a miniature black hole. The mind at the heart of this bionic miracle is free from the constraints of linear time, its experience an impossible web of myriad collected lifeforms. It awaits its host.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/BIOTECH.EYECLUSTER.MOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/biotech.eyecluster.mod.webp","colour":"#1e2328","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BIOSHIP_GROWTH4_NAME","descriptionKey":"UI_BIOSHIP_GROWTH4_DESC","secondary":"Exotic","tags":[],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BIOSHIP_GROWTH4","@type":"GameAsset"},{"id":"WARP_ALIEN","name":"SINGULARITY CORTEX","kind":"Technology","category":"Alien Ship","categoryKey":"AlienShip","rarity":"Always","subtitle":"Fused Organic Technology","description":"A complex bio-metallic stem plugged directly into an antimatter heart. Registers high activity during interstellar jumps. It appears to delight in the complex calculations required for FTL travel. Access long-distance navigation systems through Galactic Map. Keep the ship happy by regularly jumping between systems.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/BIOTECH.EYECLUSTER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/biotech.eyecluster.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"ION1_ALIEN_NAME","descriptionKey":"ION1_ALIEN_DESC","secondary":"Core","tags":["Core technology","Chargeable","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/WARP_ALIEN","@type":"GameAsset"},{"id":"UA_HYP1","name":"Singularity Cortex","kind":"Upgrade module","category":"Protection","categoryKey":"Protection","rarity":"Normal","subtitle":"C-Class %NAME% Node","description":"A moderate upgrade for the Singularity Cortex. Use to trigger node growth and begin the grafting process. Each node is genetically unique, and exact upgrade statistics are unknown until installation is complete. Potential improvements include: warp-drive efficiency and jump distance.","icon":"","preview":"","colour":"#1a2733","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"AP_HYPERDRIVE","descriptionKey":"BIO_PROD_HYPER1_DESC","secondary":"A_HDRIVE","tags":["1 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UA_HYP1","@type":"GameAsset"},{"id":"UA_HYP2","name":"Singularity Cortex","kind":"Upgrade module","category":"Protection","categoryKey":"Protection","rarity":"Rare","subtitle":"B-Class %NAME% Node","description":"A significant upgrade for the Singularity Cortex. Use to trigger node growth and begin the grafting process. Each node is genetically unique, and exact upgrade statistics are unknown until installation is complete. Potential improvements include: warp-drive efficiency and jump distance.","icon":"","preview":"","colour":"#1a2733","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"AP_HYPERDRIVE","descriptionKey":"BIO_PROD_HYPER2_DESC","secondary":"A_HDRIVE","tags":["1 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UA_HYP2","@type":"GameAsset"},{"id":"UA_HYP3","name":"Singularity Cortex","kind":"Upgrade module","category":"Protection","categoryKey":"Protection","rarity":"Epic","subtitle":"A-Class %NAME% Node","description":"An extremely powerful upgrade for the Singularity Cortex. Use to trigger node growth and begin the grafting process. Each node is genetically unique, and exac