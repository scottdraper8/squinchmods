,"description":"UI_FISH_DUST_COM_S_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.SMALL.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.small.1.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_DUST_COM_S1_NAME","descriptionKey":"UI_FISH_DUST_COM_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":1000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_DUST_COM_S1","@type":"GameAsset"},{"id":"FOOD_V_MOLE","name":"FORAGED MUSHROOMS","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"An animal byproduct, this nutritious morsel can be easily farmed without harm to the animal that produces it. Process in a Nutrient Processor to generate edible products.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.CATFRUIT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.catfruit.webp","colour":"#e57002","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_MOLE_VEG_NAME","descriptionKey":"FOOD_VEG_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":3200,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_V_MOLE","@type":"GameAsset"},{"id":"REP_TOKEN","name":"FORGED PASSPORT","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Overwritten Digital Record","description":"A counterfeit starship registration document. This digital signature is guaranteed free of previous crimes or misdemeanors. Can be used to reset any negative faction standing records at a Space Station Core.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/REPTOKEN.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/reptoken.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_REP_TOKEN_NAME","descriptionKey":"UI_REP_TOKEN_DESC","secondary":"Exotic","tags":[],"baseValue":256000,"level":0,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/REP_TOKEN","@type":"GameAsset"},{"id":"BASE_PEACOCK03","name":"FORKED PLUMAGE PALM","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A tall desert-native tree. The fronds resemble the plumage of a bird, and crown in a vertical formation. This specimen has branched into two separate crowns. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BIOMEPROP.PEACOCK03.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.biomeprop.peacock03.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_PEACOCK_3_NAME","descriptionKey":"BLD_PEACOCK_3_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_PEACOCK03","@type":"GameAsset"},{"id":"F_RAD_COM_M1","name":"FORKTAILED SPLICER","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_RAD_COM_M_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.DEFAULT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.default.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_RAD_COM_M1_NAME","descriptionKey":"UI_FISH_RAD_COM_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":2000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_RAD_COM_M1","@type":"GameAsset"},{"id":"PROC_FOSS","name":"Fossil (procedural)","kind":"Procedural item","category":"Fossil","categoryKey":"Fossil","rarity":"Rare","subtitle":"Fossil Sample","description":"Fossil Sample","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TREASUREPROD.FOSSIL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/treasureprod.fossil.webp","colour":"#1fb80a","source":"PROCEDURALPRODUCTTABLE.MBIN","nameKey":"ITEMGEN_FORMAT_FOSSIL","descriptionKey":"FOSSIL_SUB","secondary":"Procedural","tags":["Generated name and value"],"baseValue":1000,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/procedural-item/PROC_FOSS","@type":"GameAsset"},{"id":"EXPD_EGG_18","name":"FOSSILISED EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Bone Cradle","description":"A living, fertile egg, ready to hatch! A foetal creature of bone grows inside, its delicate body suspended in vitellus. Its fleshless limbs are comprised of soft cartilage, which will harden and densify as it grows. Scans indicate the being within has the genetic potential to be skeletal and elephantine.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S18.EGG.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s18.egg.webp","colour":"#4d2987","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_EGG_18_NAME","descriptionKey":"UI_EXPD_EGG_18_DESC","secondary":"Exotic","tags":[],"baseValue":3200,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_EGG_18","@type":"GameAsset"},{"id":"UT_SHIPLAS","name":"FOURIER DE-LIMITER","kind":"Technology","category":"All Ships Except Alien","categoryKey":"AllShipsExceptAlien","rarity":"Normal","subtitle":"Phase Beam Upgrade","description":"Rewires the Phase Beam with nanite-based circuitry, bypassing conventional reality limits on laser power. Significantly improves heat performance.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.PHASEBEAMMOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.phasebeammod.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_SHIPLAS_NAME","descriptionKey":"UT_SHIPLAS_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/UT_SHIPLAS","@type":"GameAsset"},{"id":"BIOSHIP_STEM2","name":"FRAGILE HEART","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Fragment of Life","description":"Though nothing more than a cluster of cells, it is already possible to detect the soft beating of this proto-heart. It requires careful attendance while it matures.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/PRODUCT.STEM2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/product.stem2.webp","colour":"#1e2328","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BIOSHIP_STEM2_NAME","descriptionKey":"UI_BIOSHIP_STEM2_DESC","secondary":"Exotic","tags":[],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BIOSHIP_STEM2","@type":"GameAsset"},{"id":"F_DUST_LEG_S1","name":"FRAGILE ICTHYOSCALE","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Legendary Fish","description":"\"A delicate creature, a fragment of the past that lives on in the water.\"","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.SMALL.3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.small.3.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_DUST_LEG_S1_NAME","descriptionKey":"UI_FISH_DUST_LEG_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":50000,"level":4,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_DUST_LEG_S1","@type":"GameAsset"},{"id":"BIOSHIP_STEM1","name":"FRAGILE NEURAL STEM","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Fragment of Life","description":"A delicate web of living tissue, this is the spark that will ignite a new lifeform into existence. It requires careful attendance while it matures.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/PRODUCT.STEM1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/product.stem1.webp","colour":"#1e2328","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BIOSHIP_STEM1_NAME","descriptionKey":"UI_BIOSHIP_STEM1_DESC","secondary":"Exotic","tags":[],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BIOSHIP_STEM1","@type":"GameAsset"},{"id":"BIOSHIP_STEM3","name":"FRAGILE SHELL","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Fragment of Life","description":"Translucent and impossibly thin, this shell is no more than the merest breath of glass. And yet the potential is clear, a relentless multiplicative hardening adding constantly to its strength. It requires careful attendance while it matures.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/PRODUCT.STEM3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/product.stem3.webp","colour":"#1e2328","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BIOSHIP_STEM3_NAME","descriptionKey":"UI_BIOSHIP_STEM3_DESC","secondary":"Exotic","tags":[],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BIOSHIP_STEM3","@type":"GameAsset"},{"id":"UT_SHIPSHOT","name":"FRAGMENT SUPERCHARGER","kind":"Technology","category":"All Ships Except Alien","categoryKey":"AllShipsExceptAlien","rarity":"Normal","subtitle":"Starship Positron Ejector Upgrade","description":"Overhauls the firing mechanism of the Positron Ejector, resulting in faster, more accurate particles. Improves range and accuracy.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.PHOTONBLASTMOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.photonblastmod.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_SHIPSHOT_NAME","descriptionKey":"UT_SHIPSHOT_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/UT_SHIPSHOT","@type":"GameAsset"},{"id":"SOULFRAG","name":"FRAGMENTED QUALIA","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Common","subtitle":"Soul Fragment","description":"A pattern, no more than a mere waveform, etched into the surface of a tiny metallic shard. This fragment of data represents a recording of the electrical impulses running across a neural network. Many fragments would be required to recreate any sensible experience. Generated by the interaction of the Animus Beam with a living target.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/SUB.SOULFRAG.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/sub.soulfrag.webp","colour":"#8a7f72","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_SOULFRAG_NAME","descriptionKey":"UI_SOULFRAG_DESC","secondary":"Substance","tags":[],"baseValue":16,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/SOULFRAG","@type":"GameAsset"},{"id":"EXPD_POSTER23B","name":"FRAMED \"ATLAS RISES\" ART","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive framed print, featuring the artwork from Atlas Rises.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S23.POSTERB.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s23.posterb.webp","colour":"#2c7c