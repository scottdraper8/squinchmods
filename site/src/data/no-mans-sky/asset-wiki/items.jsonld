,"description":"Specialist harmonic resonators allow the Pulse Spitter to split inserted ammunition, effective manufacturing more shots from fewer materials. Increases weapon clip size.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.PULSESPITTERMOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.pulsespittermod.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_SMG_NAME","descriptionKey":"UT_SMG_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/UT_SMG","@type":"GameAsset"},{"id":"F_HACCESS1","name":"AMPLIFIED WARP SHIELDING","kind":"Technology","category":"Freighter","categoryKey":"Freighter","rarity":"Impossible","subtitle":"Hyperdrive Upgrade: Red Systems","description":"Upgrades the hyperdrive's core bounding magnets, preventing rapid disassembly when attempting to reach rare-class red stellar bodies. User is advised to access Hyperdrive systems via the Galactic Map.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/TECHNOLOGY.FREIGHTERSIGMA.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/technology.freightersigma.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"RGB_WARP_1_NAME","descriptionKey":"RGB_WARP_1_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":2,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/F_HACCESS1","@type":"GameAsset"},{"id":"SCANBINOC1","name":"ANALYSIS VISOR","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Always","subtitle":"Binocular Tagging Device","description":"Specialist Discovery and Survey unit. Augments standard Scanner capabilities by projecting detailed environmental data directly over the user's visor. Allows the identification of distant points of interest. The Visor will generate valuable data when used to study flora, fauna and minerals. Hold to operate. Press to zoom.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.BINOCULARS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.binoculars.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"SCANBINOC1_NAME","descriptionKey":"SCANBINOC1_DESCRIPTION","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SCANBINOC1","@type":"GameAsset"},{"id":"UP_SCAN0","name":"Analysis Visor","kind":"Upgrade module","category":"Scanning","categoryKey":"Scanning","rarity":"SeaTrash","subtitle":"Rusted %NAME% Upgrade","description":"UP_SEATRASH_DESC","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_SCANNER","descriptionKey":"UP_SEATRASH_DESC","secondary":"T_SCAN","tags":["4 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_SCAN0","@type":"GameAsset"},{"id":"UP_SCAN1","name":"Analysis Visor","kind":"Upgrade module","category":"Scanning","categoryKey":"Scanning","rarity":"Normal","subtitle":"C-Class %NAME% Upgrade","description":"A moderate upgrade for the Multi-Tool Scanning Systems. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potential upgrades include: scan radius and/or significantly increasing the value of discovery data.","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_SCANNER","descriptionKey":"UP_SCANNER1_DESC","secondary":"T_SCAN","tags":["4 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_SCAN1","@type":"GameAsset"},{"id":"UP_SCAN2","name":"Analysis Visor","kind":"Upgrade module","category":"Scanning","categoryKey":"Scanning","rarity":"Rare","subtitle":"B-Class %NAME% Upgrade","description":"A significant upgrade for the Multi-Tool Scanning Systems. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potential upgrades include: scan radius and/or significantly increasing the value of discovery data.","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_SCANNER","descriptionKey":"UP_SCANNER2_DESC","secondary":"T_SCAN","tags":["4 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_SCAN2","@type":"GameAsset"},{"id":"UP_SCAN3","name":"Analysis Visor","kind":"Upgrade module","category":"Scanning","categoryKey":"Scanning","rarity":"Epic","subtitle":"A-Class %NAME% Upgrade","description":"An extremely powerful upgrade for the Multi-Tool Scanning Systems. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potential upgrades include: scan radius and/or significantly increasing the value of discovery data.","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_SCANNER","descriptionKey":"UP_SCANNER3_DESC","secondary":"T_SCAN","tags":["4 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_SCAN3","@type":"GameAsset"},{"id":"UP_SCAN4","name":"Analysis Visor","kind":"Upgrade module","category":"Scanning","categoryKey":"Scanning","rarity":"Legendary","subtitle":"S-Class %NAME% Upgrade","description":"A supremely powerful upgrade for the Multi-Tool Scanning Systems. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potential upgrades include: scan radius and/or significantly increasing the value of discovery data.","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_SCANNER","descriptionKey":"UP_SCANNER4_DESC","secondary":"T_SCAN","tags":["4 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_SCAN4","@type":"GameAsset"},{"id":"UP_SCANX","name":"Analysis Visor","kind":"Upgrade module","category":"Scanning","categoryKey":"Scanning","rarity":"Illegal","subtitle":"Illegal %NAME% Upgrade","description":"UP_SCANNERX_DESC","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_SCANNER","descriptionKey":"UP_SCANNERX_DESC","secondary":"T_SCAN","tags":["4 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_SCANX","@type":"GameAsset"},{"id":"TIMEMILK","name":"ANCESTRAL MEMORIES","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Recessive Creature Genes","description":"The echo of a genetic possibility, forgotten by evolution. It twitches with a wild energy. Extracted from a creature caught within a repeating circuit of time. Of great value to Specialist Polo as they research the loop.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.TIMEMILK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.timemilk.webp","colour":"#dedcd1","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_ROGUE_TIME_MILK_NAME","descriptionKey":"UI_ROGUE_TIME_MILK_DESC","secondary":"Substance","tags":[],"baseValue":1616,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/TIMEMILK","@type":"GameAsset"},{"id":"BASE_COLDPLANT3","name":"ANCIENT CONIFER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"This tree lives on an almost geological time scale. Low heat and light levels in their native habitat restrict growth to mere millimeters each season. A sample this size is a botanical marvel. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.COLDPLANT03.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.coldplant03.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_COLDPLANT_3_NAME","descriptionKey":"BLD_COLDPLANT_3_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_COLDPLANT3","@type":"GameAsset"},{"id":"F_HOT_LEG_XL","name":"ANCIENT IRONTAIL","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Legendary Fish","description":"\"Heart of stone and fins of iron, this creature lives on where all else falters.\"","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.XL.3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.xl.3.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_HOT_LEG_XL_NAME","descriptionKey":"UI_FISH_HOT_LEG_XL_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":200000,"level":4,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_HOT_LEG_XL","@type":"GameAsset"},{"id":"ARTIFACT_KEY","name":"ANCIENT KEY","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Timeless Artifact","description":"A key of some weight, this aged piece of wrought iron must belong in a nearby lock...","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/PRODUCT.ANCIENTKEY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/product.ancientkey.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_ARTIFACT_KEY_NAME","descriptionKey":"UI_ARTIFACT_KEY_DESC","secondary":"Special","tags":["Consumable"],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ARTIFACT_KEY","@type":"GameAsset"},{"id":"MAINT_ARTIFACT","name":"ANCIENT LOCK","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Heavy Locking Mechanism","description":"A mysterious lock with several keyholes, this relic protects what must surely be a valuable treasure.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.VORTEXCUBE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.vortexcube.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_ARTIFACT_LOCK_NAME","descriptionKey":"UI_ARTIFACT_LOCK_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_ARTIFACT","@type":"GameAsset"},{"id":"F_ODD_RARE_S1","name":"ANEMONE ANOMALY","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Uncommon Fish","description":"UI_FISH_ODD_RARE_S_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT2.FISH.STARFISH.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product2.fish.starfish.webp","colour":"#2177c8","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_ODD_RARE_S1_NAME","descriptionKey":"UI_FISH_ODD_RARE_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":3000,"level":2,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_ODD_RARE_S1","@type":"GameAsset"},{"id":"FOOD_MC_APPLE","name":"ANGELIC FRUITCAKE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Extra-Fluffy Batter.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.CAKE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.cake.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_MC_APPLE_NAME","descriptionKey":"UI_CAKE_DESC_MC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":31300,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_MC_APPLE","@type":"GameAsset"},{"id":"SOUL_LASER","name":"ANIMUS BEAM","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Impossible","subtitle":"Soul Extractor","description":"A unique overload to the Multi-Tool's standard mining laser. Beam frequency is modulated precisely in a feedback loop with the delta-waves generated by the impact target. Recordings of the target's experiences are thus etched into tiny fragments of metal and rendered as Fragmented Qualia. Readability of collected fragments is not guaranteed.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.SOULLASER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.soullaser.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SOUL_LASER_NAME","descriptionKey":"UI_SOUL_LASER_DESC","secondary":"Installable","tags":["Chargeable","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SOUL_LASER","@type":"GameAsset"},{"id":"FOOD_DNUT_AJAM","name":"ANOMALOUS DOUGHNUT","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.DOUGHNUT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.doughnut.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_DNUT_AJAM_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":70000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_DNUT_AJAM","@type":"GameAsset"},{"id":"S_POSTER14","name":"ANOMALOUS HOME POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This brightly-coloured poster depicts a wireframe illustration of the Space Anomaly.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.S_POSTER14.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.s_poster14.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_S_POSTER14_NAME","descriptionKey":"BLD_S_POSTER14_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S_POSTER14","@type":"GameAsset"},{"id":"FOOD_JAM_GLITCH","name":"ANOMALOUS JAM","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A refined food product, created in the Nutrient Processor. Food such as this can be highly valuable. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.SAUCE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.sauce.webp","colour":"#095c77","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_JAM_GLITCH_NAME","descriptionKey":"FOOD_REFINED_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":5400,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_JAM_GLITCH","@type":"GameAsset"},{"id":"PURPM_MIRROR","name":"ANOMALOUS SCAFFOLD","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Crystalline Breach","description":"To bridge between realities requires a scaffold and a seed. This crystalline propagation matrix will allow the breach to become the bridge, the seed by which a new reality can bloom.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.2024.PURPLEMIRROR.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.2024.purplemirror.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_PURPM_MIRROR_NAME","descriptionKey":"UI_PURPM_MIRROR_DESC","secondary":"Special","tags":["Craftable","Consumable"],"baseValue":1919,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/PURPM_MIRROR","@type":"GameAsset"},{"id":"FOOD_PIE_WEIRD","name":"ANOMALOUS TART","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.TART.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.tart.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_PIE_WEIRD_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":44000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_PIE_WEIRD","@type":"GameAsset"},{"id":"EXPD_POSTER11B","name":"ANOMALOUS WONDER POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster depicts one of the universe's great mysteries, the anomaly of existence itself.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.POSTER11B.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.poster11b.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER11B_NAME","descriptionKey":"BLD_EXPD_POSTER11B_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER11B","@type":"GameAsset"},{"id":"SPEC_DECAL01","name":"ANOMALY DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal depicts a Traveller Anomaly.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.DECAL01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.decal01.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_ANOMALY_NAME","descriptionKey":"BLD_DECAL_ANOMALY_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_DECAL01","@type":"GameAsset"},{"id":"POI_LOCATOR","name":"ANOMALY DETECTOR","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Anomalous Homing Device","description":"A single-use geometric beacon that probes the surrounding area for near-space anomalies. Such objects are highly unpredictable. Select the Detector and use Begin Scan () to begin the location process.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.LOCATOR.POI.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.locator.poi.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_POI_LOCATOR_NAME","descriptionKey":"UI_POI_LOCATOR_DESC","secondary":"Special","tags":["Consumable"],"baseValue":3200,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/POI_LOCATOR","@type":"GameAsset"},{"id":"S16_HEATER","name":"ANOMALY SEAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Boundary Integrity Totem","description":"As the boundaries of reality begin to weaken, the risk of catastrophic breach anomalies increases. This ancient artifact radiates with a spectral energy, increasing the boundary strength within the local area and guarding against reality continuity errors. Must be constructed within the boundaries of a habitable base.","icon":"TEXTURES/UI/FRONTEND/ICONS/BUILDABLE/BUILDABLE.S16.HEATER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/buildable/buildable.s16.heater.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_S16_HEATER_NAME","descriptionKey":"BLD_S16_HEATER_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S16_HEATER","@type":"GameAsset"},{"id":"SPOOK_PACK","name":"ANOMALY SUPPRESSOR","kind":"Technology","category":"Suit","categoryKey":"Suit","rarity":"Always","subtitle":"Automated Breach Integrity Device","description":"As the boundaries of reality begin to weaken, the risk of catastrophic breach anomalies increases. This device monitors and maintains the local boundary strength, guarding against reality continuity errors. Supply the device with glass to maintain functionality.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.HAZARD.SPOOK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.hazard.spook.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SPOOK_PACK_NAME","descriptionKey":"UI_SPOOK_PACK_DESC","secondary":"Core","tags":["Core technology","Chargeable","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SPOOK_PACK","@type":"GameAsset"},{"id":"LAUNCHER_ROBO","name":"ANTI-GRAVITY WELL","kind":"Technology","category":"Robot Ship","categoryKey":"RobotShip","rarity":"Always","subtitle":"Aeron Sub-Orbital Engine","description":"Gently detaches the starship from gravitational fields, lifting it toward the stars. The well hungers for pugneum or radiant shards, and must be sufficiently fueled before launch. Hold to take off from planet. Hold to initiate in-flight speed boost.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/ROBOTSHIP.LAUNCHER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/robotship.launcher.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_LAUNCHER_ROBO_NAME","descriptionKey":"UI_LAUNCHER_ROBO_DESC","secondary":"Core","tags":["Core technology","Chargeable","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/LAUNCHER_ROBO","@type":"GameAsset"},{"id":"ANTIMATTER","name":"ANTIMATTER","kind":"Product","category":"Component","categoryKey":"Component","rarity":"Rare","subtitle":"Crafted Technology Component","description":"Contained negative matter and baryogenesis antiparticles. The vast energy potential of antimatter makes it highly valuable. 95% of existing antimatter consumption is in the powering of starship hyperdrives. WARNING: uncontained usage is not recommended.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.ANTIMATTER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.antimatter.webp","colour":"#c01746","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"COMMODITY6_NAME","descriptionKey":"COMMODITY6_DESCRIPTION","secondary":"Special","tags":["Craftable"],"baseValue":5233,"level":0,"stackMultiplier":2,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ANTIMATTER","@type":"GameAsset"},{"id":"FREI_TRAIL_PUR","name":"ANTIMATTER FREIGHTER TRAIL","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Freighter Engine Flare Override","description":"An exclusive Freighter Engine Flare Modifier. A grid of compact particle accelerators activate with heat from the freighter engines, streaking the exhaust with a dark trail of antimatter. Transform the appearance of your freighter at the Upgrade Control Terminal on the bridge.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.FREIGHTJETS.PURPLE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.freightjets.purple.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FREI_TRAIL_PUR_NAME","descriptionKey":"UI_FREI_TRAIL_PUR_DESC","secondary":"Exotic","tags":[],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FREI_TRAIL_PUR","@type":"GameAsset"},{"id":"AM_HOUSING","name":"ANTIMATTER HOUSING","kind":"Product","category":"Component","categoryKey":"Component","rarity":"Uncommon","subtitle":"Crafted Technology Component","description":"Secure antimatter containment device, required before Antimatter can be safely secured as Warp Cells. Rebound Oxygen forms a protective gas pocket, preventing the antimatter from reacting with the surrounding casing.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.AMHOUSING.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.amhousing.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"AM_HOUSING_NAME","descriptionKey":"AM_HOUSING_DESC","secondary":"Special","tags":["Craftable"],"baseValue":6500,"level":0,"stackMultiplier":2,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/AM_HOUSING","@type":"GameAsset"},{"id":"JETS_DARK","name":"ANTIMATTER JETPACK TRAIL","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Jetpack Exhaust Override","description":"An exclusive Exosuit Appearance Override. Baryon suppressors alter the Jetpack's output, giving a distinct black tint to its signature trail. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.JETS.DARK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.jets.dark.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_JETTRAIL_DARK_NAME","descriptionKey":"UI_JETTRAIL_DARK_DESC","secondary":"Exotic","tags":[],"baseValue":2100,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/JETS_DARK","@type":"GameAsset"},{"id":"BASE_NEXUS1","name":"ANTIMATTER OBSERVATION ORB","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Space Anomaly Replica Part","description":"This spiked chamber contains a globule of antimatter, creating an unusual display piece for discerning base builders.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.NEXUSPROP01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.nexusprop01.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_NEXUSPROP_1_NAME","descriptionKey":"BLD_NEXUSPROP_1_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_NEXUS1","@type":"GameAsset"},{"id":"BASE_GRASS7","name":"ANTLER GRASS","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A tough ornamental grass, suitable for growing in all biomes, soil types, and weather conditions. The branching blades of this variety are formed of woody, twig-like armour insulating thick veins of moisture-storing resin.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.GRASS07.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.grass07.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_GRASS_7_NAME","descriptionKey":"BLD_GRASS_7_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_GRASS7","@type":"GameAsset"},{"id":"ANY_FISH_COOKED","name":"ANY COOKED SEAFOOD","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Ingredient Category","description":"A piece of seafood, created in the Nutrient Processor. Food such as this can be highly valuable. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.DEFAULT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.default.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_ANY_COOKED_NAME","descriptionKey":"UI_FISH_FOOD_MED_DESC","secondary":"Special","tags":["Craftable","Cooking ingredient"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ANY_FISH_COOKED","@type":"GameAsset"},{"id":"ANY_BONE","name":"ANY EDIBLE BONE","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Ingredient Category","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.BONES.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.bones.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BONE_ANY_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Special","tags":["Craftable","Cooking ingredient"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ANY_BONE","@type":"GameAsset"},{"id":"ANY_FISH_RAW","name":"ANY RAW SEAFOOD","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Ingredient Category","description":"A piece of seafood, created in the Nutrient Processor. Food such as this can be highly valuable. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.DEFAULT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.default.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_ANY_RAW_NAME","descriptionKey":"UI_FISH_FOOD_MED_DESC","secondary":"Special","tags":["Craftable","Cooking ingredient"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ANY_FISH_RAW","@type":"GameAsset"},{"id":"ANY_FISH","name":"ANY SEAFOOD","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Ingredient Category","description":"A piece of seafood, created in the Nutrient Processor. Food such as this can be highly valuable. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.DEFAULT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.default.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_ANY_NAME","descriptionKey":"UI_FISH_FOOD_MED_DESC","secondary":"Special","tags":["Craftable","Cooking ingredient"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ANY_FISH","@type":"GameAsset"},{"id":"SPEC_DECAL06","name":"APOLLO DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal depicts the Traveller Apollo.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.DECAL06.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.decal06.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_APOLLO_NAME","descriptionKey":"BLD_DECAL_APOLLO_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_DECAL06","@type":"GameAsset"},{"id":"BOBBLE_APOLLO","name":"APOLLO FIGURINE","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Starship Interior Adornment","description":"A synthetic polymer companion for your starship's cockpit, fashioned in the likeness of the Traveller Apollo. Install to an Inventory Slot to decorate your ship's interior.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BOBBLEAPOLLO.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.bobbleapollo.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BOBBLE_APOLLO_NAME","descriptionKey":"UI_BOBBLE_APOLLO_DESC","secondary":"Exotic","tags":[],"baseValue":3200,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BOBBLE_APOLLO","@type":"GameAsset"},{"id":"T_BOBBLE_APOLLO","name":"APOLLO FIGURINE","kind":"Technology","category":"All Ships","categoryKey":"AllShips","rarity":"Impossible","subtitle":"Starship Interior Adornment","description":"A synthetic polymer companion for your starship's cockpit, fashioned in the likeness of the Traveller Apollo. Install to an Inventory Slot to decorate your ship's interior.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BOBBLEAPOLLO.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.bobbleapollo.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_BOBBLE_APOLLO_NAME","descriptionKey":"UI_BOBBLE_APOLLO_DESC","secondary":"Installable","tags":[],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/T_BOBBLE_APOLLO","@type":"GameAsset"},{"id":"BANNER_SPOOKY","name":"APPALLING BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Demonstrate your interest in the macabre and the horrific with this exclusive Personal Flair. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BANNER.SPOOKY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.banner.spooky.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_SPOOKY_NAME","descriptionKey":"UI_BANNER_SPOOKY_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BANNER_SPOOKY","@type":"GameAsset"},{"id":"EXPD_EGG_13","name":"APPALLING EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Spawning Sac","description":"A living, fertile egg, ready to hatch! A shadow writhes beneath the egg's protective membrane. Scans indicate the being within has the genetic potential to be nightmarish and soul-consuming.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.MINIFIEND.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.minifiend.webp","colour":"#4d2987","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_EGG_13_NAME","descriptionKey":"UI_EXPD_EGG_13_DESC","secondary":"Exotic","tags":[],"baseValue":3200,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_EGG_13","@type":"GameAsset"},{"id":"FOOD_CM_JAM","name":"APPALLING JAM SPONGE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Wailing Batter.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.CCAKEEVIL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.ccakeevil.webp","colour":"#6ad01e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_CM_JAM_NAME","descriptionKey":"UI_CAKE_DESC_CM","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":180700,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_CM_JAM","@type":"GameAsset"},{"id":"WATER_LANDER","name":"AQUA-JETS","kind":"Technology","category":"All Ships Except Alien","categoryKey":"AllShipsExceptAlien","rarity":"VeryRare","subtitle":"Aquatic Landing System","description":"An advanced upgrade for the starship's landing system, enabling the ship to land and take off from aquatic surfaces. A mixture of bespoke jets and re-directed exhaust fans allow the ship to hover just above the water's surface.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.LANDINGGEARMOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.landinggearmod.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_WATER_LANDER_NAME","descriptionKey":"UI_WATER_LANDER_DESC","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":4,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/WATER_LANDER","@type":"GameAsset"},{"id":"EXPD_BANNER15","name":"AQUARIUS BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Equip this exclusive Personal Flair in commemoration of the Aquarius expedition. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.BANNER15.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.banner15.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_EXPD_15_NAME","descriptionKey":"UI_BANNER_EXPD_15_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_BANNER15","@type":"GameAsset"},{"id":"EXPD_DECAL15","name":"AQUARIUS DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal commemorates the catches, the stories, and the ones that got away while on the Aquarius expedition.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.DECAL15.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.decal15.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_EXPD_15_NAME","descriptionKey":"BLD_DECAL_EXPD_15_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_DECAL15","@type":"GameAsset"},{"id":"EXPD_FISH_PACK","name":"AQUARIUS FLIGHT PACK","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Jetpack","description":"An exclusive Exosuit Appearance Override. Hardened against the extreme conditions found beneath the waves, this jetpack replacement allows for smooth and stylish passage through the murky abyss. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.S15.DIVINGBACKPACK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.s15.divingbackpack.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_FISH_PACK_NAME","descriptionKey":"UI_EXPED_FISH_PACK_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_FISH_PACK","@type":"GameAsset"},{"id":"BASE_WPLANT6","name":"AQUATIC COLONY","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A rock formation pulled from the floor of a densely-populated ocean. The attached marine life is lacquered in a nutrient-rich mucus, to keep it fed and moist in terrestrial conditions.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.WATERPLANT06.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.waterplant06.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_WATERPLANT_6_NAME","descriptionKey":"BLD_WATERPLANT_6_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_WPLANT6","@type":"GameAsset"},{"id":"BASE_WPLANT2","name":"AQUATIC CRYSTAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"An eye-catching cluster of crystallised oceanic minerals. These crystals grow in a shard-like structure, and feature an unusual marbled colouration.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.WATERPLANT02.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.waterplant02.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_WATERPLANT_2_NAME","descriptionKey":"BLD_WATERPLANT_2_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_WPLANT2","@type":"GameAsset"},{"id":"TWITCH_GUN03","name":"ARC CAPACITOR W/17L-15P","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Multifunction Survival Device","description":"An exclusive Multi-Tool. This specialised tool comes with an Advanced Mining Laser and powerful Optical Drill upgrade pre-installed. Take this Multi-Tool to add it to your collection, or Exchange it with your current Multi-Tool. Swap between active Multi-Tools from the Utilities section of the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.TWITCH.GUN03.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.twitch.gun03.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_GUN_03_NAME","descriptionKey":"UI_TWIT_GUN_03_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_GUN03","@type":"GameAsset"},{"id":"BASE_LAVA3","name":"ARCHAIC HABITATION HEATER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"Although primitive in design, this habitation heater is nonetheless a popular home furnishing. Its hypnotic flames and gentle crackling lend a comforting ambience to any room. Provides interior decoration opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.LAVAPLANT03.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.lavaplant03.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_LAVAPLANT_3_NAME","descriptionKey":"BLD_LAVAPLANT_3_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_LAVA3","@type":"GameAsset"},{"id":"WORMREADER","name":"ARCHIVE BYPASS IMPLANT","kind":"Technology","category":"Suit","categoryKey":"Suit","rarity":"Common","subtitle":"Subcutaneous Access Circuit","description":"A biotechnical firewall, developed as a safeguard against textual cognitohazards. It is coated in something slippery, and has started to bubble along the surface. Embedded beneath the skin, this grants administrative access to ancient forbidden texts bound at a Planetary Archive. Warning: Do not unbind the forbidden texts. Exposure to forbidden texts carries extreme risk.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/TECH.WORMREADER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/tech.wormreader.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_WORMREADER_NAME","descriptionKey":"UI_WORMREADER_DESC","secondary":"Installable","tags":["Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/WORMREADER","@type":"GameAsset"},{"id":"BIOSHIP_COMP5","name":"ARCHIVED SOUL","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Bionic Ark","description":"A biomechanical construct, created to the design of an anonymous host. A fusion of complex circuitry and the ineffable glitch of the Traveller. Such a calculus might bind realities together, or tear them into mere simulated fragments.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/PRODUCT.BIOCOMP5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/product.biocomp5.webp","colour":"#311a49","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BIOSHIP_COMP5_NAME","descriptionKey":"UI_BIOSHIP_COMP5_DESC","secondary":"Exotic","tags":["Craftable"],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BIOSHIP_COMP5","@type":"GameAsset"},{"id":"MECH_BOOST","name":"ARIADNE'S FLAME","kind":"Technology","category":"Mech","categoryKey":"Mech","rarity":"Impossible","subtitle":"Minotaur Thruster System","description":"A series of agile, high-powered jet thrusters mounted to the rear of the rear of the Minotaur. Precise use allows the Minotaur to quickly and powerfully traverse all manner of terrain. Press and hold to activate. Limited in-flight control is possible.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/VEHICLE/RENDER.BOOST.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/vehicle/render.boost.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MECH_BOOST_NAME","descriptionKey":"UI_MECH_BOOST_DESC","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MECH_BOOST","@type":"GameAsset"},{"id":"BASE_WPLANT4","name":"ARMOURED ANEMONE","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A carnivorous marine organism. An armoured shell encloses the core polyp, exposing only the stinging tentacles. Involuntary nerve spasms cause the creature to writhe perpetually: always seeking, always hungering.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.WATERPLANT04.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.waterplant04.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_WATERPLANT_4_NAME","descriptionKey":"BLD_WATERPLANT_4_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_WPLANT4","@type":"GameAsset"},{"id":"SPEC_VYK_BOOTS","name":"ARMOURED BOOTS","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Boots","description":"Reinforced foot protection system with integrated tread-balancing gyroscopes. Hundreds of years of high-tech research, as applied to footwear.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.VYKBOOTS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.vykboots.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"SPEC_VYKEEN_BOOTS_NAME","descriptionKey":"SPEC_VYKEEN_BOOTS_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_VYK_BOOTS","@type":"GameAsset"},{"id":"SPEC_VYK_TORSO","name":"ARMOURED CHESTPIECE","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Torso Customisation","description":"Reinforced yet stylish, this Exosuit chest armour provides excellent abdominal protection without compromising on looks.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.VYKTORSO.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.vyktorso.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"SPEC_VYKEEN_TORSO_NAME","descriptionKey":"SPEC_VYKEEN_TORSO_DESC","secondary":"Exotic","tags":[],"baseValue":750,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_VYK_TORSO","@type":"GameAsset"},{"id":"SPEC_VYK_GLOVES","name":"ARMOURED EXOGLOVES","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Gloves","description":"Armoured gloves, perfect for wielding weapons, impressing martial cultures, and picking really spiky plants.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.VYKGLOVES.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.vykgloves.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"SPEC_VYKEEN_GLOVES_NAME","descriptionKey":"SPEC_VYKEEN_GLOVES_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_VYK_GLOVES","@type":"GameAsset"},{"id":"BUI_HEAD_11","name":"ARMOURED FACIAL UNIT","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Rare","subtitle":"Autophage Appearance Modification","description":"An exclusive Exosuit Appearance Override, granted by the Autophage to those who seek to build their own shell. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/ROBOTPARTS/ROBOTPARTS.HEAD.11.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/robotparts/robotparts.head.11.webp","colour":"#8c4b9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TIP_HEAD_BUI_11_U","descriptionKey":"UI_BUILDER_CUSTOM_DESC","secondary":"Exotic","tags":[],"baseValue":999,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BUI_HEAD_11","@type":"GameAsset"},{"id":"SPEC_VYK_LEGS","name":"ARMOURED LEGGINGS","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Leg Customisation","description":"Carefully woven nano-fibres make these leggings both flexible and resistant to small-arms fire. Washing requires specialist equipment.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.VYKLEGS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.vyklegs.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"SPEC_VYKEEN_LEGS_NAME","descriptionKey":"SPEC_VYKEEN_LEGS_DESC","secondary":"Exotic","tags":[],"baseValue":750,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_VYK_LEGS","@type":"GameAsset"},{"id":"SPEC_VYK_ARMOUR","name":"ARMOURED SHOULDERPADS","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Armour","description":"Powerful shoulder armour, this Exosuit augmentation comes with high-voltage connections into the user's skeletal system. This current jolts the user's body as required, manipulating the muscles into their optimal defensive posture.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.VYKARMOUR.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.vykarmour.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"SPEC_VYKEEN_ARMOUR_NAME","descriptionKey":"SPEC_VYKEEN_ARMOUR_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_VYK_ARMOUR","@type":"GameAsset"},{"id":"ALLOY1","name":"ARONIUM","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Rare","subtitle":"Alloy Metal","description":"A lightweight and highly malleable alloy. Crafted from Paraffinium and Ionised Cobalt. In high demand on the Galactic Trade Network due to its utility in the construction of planetside outposts and facilities.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.METALLIC.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.metallic.1.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_ALLOY_SIMPLE_1_NAME","descriptionKey":"UI_ALLOY_SIMPLE_1_DESC","secondary":"Stellar","tags":["Craftable"],"baseValue":25000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ALLOY1","@type":"GameAsset"},{"id":"TWITCH_GUN28","name":"ART OF ESENYOV-XVI","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Multifunction Survival Device","description":"An exclusive Multi-Tool. This A-class weapon comes equipped with a range of pre-installed technologies and upgrades. Take this Multi-Tool to add it to your collection, or Exchange it with your current Multi-Tool. Swap between active Multi-Tools from the Utilities section of the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/TWITCH.GUN28.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/twitch.gun28.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_GUN_28_NAME","descriptionKey":"UI_TWIT_GUN_GENERIC_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_GUN28","@type":"GameAsset"},{"id":"TWITCH_GUN23","name":"ART OF STORMS","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Multifunction Survival Device","description":"An exclusive Multi-Tool. This A-class weapon comes equipped with a range of pre-installed technologies and upgrades. Take this Multi-Tool to add it to your collection, or Exchange it with your current Multi-Tool. Swap between active Multi-Tools from the Utilities section of the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/TWITCH.GUN23.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/twitch.gun23.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_GUN_23_NAME","descriptionKey":"UI_TWIT_GUN_23_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_GUN23","@type":"GameAsset"},{"id":"SPEC_DECAL07","name":"ARTEMIS DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal depicts the Traveller Artemis.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.DECAL07.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.decal07.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_ARTEMIS_NAME","descriptionKey":"BLD_DECAL_ARTEMIS_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_DECAL07","@type":"GameAsset"},{"id":"BOBBLE_ART","name":"ARTEMIS FIGURINE","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Starship Interior Adornment","description":"A synthetic polymer companion for your starship's cockpit, fashioned in the likeness of the Traveller Artemis. Install to an Inventory Slot to decorate your ship's interior.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BOBBLEARTEMIS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.bobbleartemis.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BOBBLE_ARTEMIS_NAME","descriptionKey":"UI_BOBBLE_ARTEMIS_DESC","secondary":"Exotic","tags":[],"baseValue":3200,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BOBBLE_ART","@type":"GameAsset"},{"id":"T_BOBBLE_ART","name":"ARTEMIS FIGURINE","kind":"Technology","category":"All Ships","categoryKey":"AllShips","rarity":"Impossible","subtitle":"Starship Interior Adornment","description":"A synthetic polymer companion for your starship's cockpit, fashioned in the likeness of the Traveller Artemis. Install to an Inventory Slot to decorate your ship's interior.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BOBBLEARTEMIS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.bobbleartemis.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_BOBBLE_ARTEMIS_NAME","descriptionKey":"UI_BOBBLE_ARTEMIS_DESC","secondary":"Installable","tags":[],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/T_BOBBLE_ART","@type":"GameAsset"},{"id":"STORY_TRANSLATE","name":"ARTEMIS' TRANSLATOR","kind":"Technology","category":"Suit","categoryKey":"Suit","rarity":"Common","subtitle":"Automatic Language Parser","description":"An automatic translation device. Device must be calibrated by pre-loading with existing translation data. Device must have network connection to Artemis to function. Without access to host translation service, on-board circuit allows limited real-time translation of a small number of words.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/ARTEMISTRANSLATOR.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/artemistranslator.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_TRANSLATESTORY_NAME","descriptionKey":"UT_TRANSLATESTORY_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/STORY_TRANSLATE","@type":"GameAsset"},{"id":"CHART_TREASURE","name":"ARTIFACT CHART","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Dig Site Cartographic Data","description":"A map of a nearby planet. An ancient ruined site has been marked. Excavating this site is likely to yield valuable treasures. Select the map and use Plot Route () to pin the location in your Exosuit display. New maps can be gained by exchanging Navigation Data with a Space Station Cartographer.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.STARCHART.TREASURE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.starchart.treasure.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_STARCHART_TREASURE_NAME","descriptionKey":"UI_STARCHART_TREASURE_DESC","secondary":"Special","tags":["Consumable"],"baseValue":3200,"level":0,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/CHART_TREASURE","@type":"GameAsset"},{"id":"F_HOT_COM_S3","name":"ASH SNAIL","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_HOT_COM_S_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT5.FISH.SNAIL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product5.fish.snail.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_HOT_COM_S3_NAME","descriptionKey":"UI_FISH_HOT_COM_S_DESC","sec