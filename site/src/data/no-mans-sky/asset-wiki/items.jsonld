iplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_BUG_HAT3","@type":"GameAsset"},{"id":"FISHBAIT_3","name":"BIONIC LURE","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Fishing Bait","description":"A specialist lure, designed to vastly improve the size and rarity of your catch. Of particular interest to anglers seeking legendary fish. Locate your Fishing Rig and begin bait application with .","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.FISHBAIT.3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.fishbait.3.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_BAIT_3_NAME","descriptionKey":"UI_FISH_BAIT_3_DESC","secondary":"Special","tags":["Craftable","Consumable"],"baseValue":450,"level":0,"stackMultiplier":50,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FISHBAIT_3","@type":"GameAsset"},{"id":"F_TOX_RARE_XL","name":"BITTERSCALE RAY","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Uncommon Fish","description":"UI_FISH_TOX_RARE_XL_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT4.FISH.RAY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product4.fish.ray.webp","colour":"#2177c8","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_TOX_RARE_XL_NAME","descriptionKey":"UI_FISH_TOX_RARE_XL_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":20000,"level":2,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_TOX_RARE_XL","@type":"GameAsset"},{"id":"FOOD_R_CHOC","name":"BITTERSWEET COCOA","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A refined food product, created in the Nutrient Processor. Food such as this can be highly valuable. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.CHOCOLATE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.chocolate.webp","colour":"#79502e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_R_CHOC_NAME","descriptionKey":"FOOD_REFINED_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":1800,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_R_CHOC","@type":"GameAsset"},{"id":"FREIGHT_BLACK","name":"BLACK","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Rare","subtitle":"Freighter Customisation Option","description":"Unlocks this colour for freighter customisation. A self-replicating cloud of highly pigmatised nano-robots swarm the capital ship, changing its external appearance.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.FREIGHTPAINT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.freightpaint.webp","colour":"#260000","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_PAINT_BLACK_DARK_U","descriptionKey":"UI_PAINT_PROD_DESC","secondary":"Exotic","tags":[],"baseValue":12300,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FREIGHT_BLACK","@type":"GameAsset"},{"id":"S_POSTER12","name":"BLACK & GOLD TRAVELLER POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This sumptuous black and gold poster depicts a Traveller in the likeness of Apollo.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.S_POSTER12.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.s_poster12.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_S_POSTER12_NAME","descriptionKey":"BLD_S_POSTER12_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S_POSTER12","@type":"GameAsset"},{"id":"F_COLD_EPIC_XL","name":"BLACK-EYED SHARK","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Rare Fish","description":"UI_FISH_COLD_EPIC_XL_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT2.FISH.SHARK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product2.fish.shark.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_COLD_EPIC_XL_NAME","descriptionKey":"UI_FISH_COLD_EPIC_XL_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":50000,"level":3,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_COLD_EPIC_XL","@type":"GameAsset"},{"id":"F_DUST_RARE_S1","name":"BLADDERSAC","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Uncommon Fish","description":"UI_FISH_DUST_RARE_S_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.MEDIUM.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.medium.1.webp","colour":"#2177c8","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_DUST_RARE_S1_NAME","descriptionKey":"UI_FISH_DUST_RARE_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":3000,"level":2,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_DUST_RARE_S1","@type":"GameAsset"},{"id":"RAILGUN","name":"BLAZE JAVELIN","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Common","subtitle":"Energy Beam Weapon","description":"Aggressive weapon attachment for the Multi-Tool. Access fire mode by pressing and fire weapon with . The Blaze Javelin delivers instantaneous damage on targets. Plasma charge process creates an ionised gas arc to propel projectiles at great speed. User will perceive destructive results simultaneous to the pull of the trigger.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.BLAZEJAVELIN.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.blazejavelin.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"RAILGUN1_NAME","descriptionKey":"RAILGUN1_DESCRIPTION","secondary":"Installable","tags":["Chargeable","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/RAILGUN","@type":"GameAsset"},{"id":"UP_RAIL1","name":"Blaze Javelin","kind":"Upgrade module","category":"Combat","categoryKey":"Combat","rarity":"Normal","subtitle":"C-Class %NAME% Upgrade","description":"A moderate upgrade for the Blaze Javelin. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potential upgrades include: laser damage and recharge time.","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_RAIL","descriptionKey":"UP_RAIL1_DESC","secondary":"T_RAIL","tags":["2 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_RAIL1","@type":"GameAsset"},{"id":"UP_RAIL2","name":"Blaze Javelin","kind":"Upgrade module","category":"Combat","categoryKey":"Combat","rarity":"Rare","subtitle":"B-Class %NAME% Upgrade","description":"A significant upgrade for the Blaze Javelin. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potential upgrades include: la