"GameAsset"},{"id":"TRIDENT_KEY","name":"TRIDENT KEY","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Aquatic Relic","description":"A strange forked key, glowing with an ultraviolet light. Despite its primitive appearance, Exosuit scanning systems reveal traces of nanite foam upon its teeth.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.TRIDENTKEY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.tridentkey.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_WATERKEY_NAME","descriptionKey":"UI_WATERKEY_DESC","secondary":"Special","tags":["Consumable"],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TRIDENT_KEY","@type":"GameAsset"},{"id":"MAINT_SEALOCK2","name":"TRIDENT KEY","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Offering to the Sea","description":"The chest requires a Trident Key, given to those who study the mysterious sites in the deep ocean.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.TRIDENTKEY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.tridentkey.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_WATERCHEST_2_NAME","descriptionKey":"UI_WATERCHEST_2_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_SEALOCK2","@type":"GameAsset"},{"id":"SPEC_FIREWORK04","name":"TRIPLE BURST FIREWORK","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Consumable Pyrotechnics Device","description":"A luxury firework, featuring a triple-burst symphony of colour. Ignite to create glittering displays in the sky. Place launch tube via the Build Menu (). Warning: Aim away from living creatures. Not recommended for indoor use.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.FIREWORK04.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.firework04.webp","colour":"#262626","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FIREWORK_PROD_TRIPLE_NAME","descriptionKey":"UI_FIREWORK_PROD_TRIPLE_DESC","secondary":"Exotic","tags":[],"baseValue":60,"level":0,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_FIREWORK04","@type":"GameAsset"},{"id":"ROCKETSUB","name":"TRITIUM","kind":"Resource","category":"Exotic","categoryKey":"Exotic","rarity":"Common","subtitle":"Neutron-Rich Fuel Element","description":"Radioactive isotope commonly used to fuel the fusion reactor at the heart of starship Pulse Engines. Abundant in interstellar asteroid fields, Tritium can be mined from asteroids using starship weaponry. Scan () to search for tritium-rich asteroids.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.ROCKETSUB.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.rocketsub.webp","colour":"#dedcd1","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_ROCKETFUEL_NAME","descriptionKey":"UI_ROCKETFUEL_DESC","secondary":"Substance","tags":[],"baseValue":6,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/ROCKETSUB","@type":"GameAsset"},{"id":"GEODE_SPACE","name":"TRITIUM HYPERCLUSTER","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Energetic Fragment","description":"A shard of pure crystalised Tritium. Select in the Inventory () and crack open with .","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.GEODE.SPACE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.geode.space.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_GEODE_SPACE_NAME","descriptionKey":"UI_GEODE_SPACE_DESC","secondary":"Special","tags":["Consumable"],"baseValue":3200,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/GEODE_SPACE","@type":"GameAsset"},{"id":"BASE_CAVE3","name":"TROGLOTULIP","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"This attractive glowing flower is remarkable for its scent, reminiscent of freshly tilled soil. Due to the plant's mineral-rich diet, the stamens often contain traces of cobalt.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.CAVEPLANT03.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.caveplant03.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_CAVEPLANT_3_NAME","descriptionKey":"BLD_CAVEPLANT_3_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_CAVE3","@type":"GameAsset"},{"id":"FREIGHT_CYAN","name":"TURQUOISE","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Rare","subtitle":"Freighter Customisation Option","description":"Unlocks this colour for freighter customisation. A self-replicating cloud of highly pigmatised nano-robots swarm the capital ship, changing its external appearance.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.FREIGHTPAINT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.freightpaint.webp","colour":"#9bd2d5","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_PAINT_CYAN_U","descriptionKey":"UI_PAINT_PROD_DESC","secondary":"Exotic","tags":[],"baseValue":12300,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FREIGHT_CYAN","@type":"GameAsset"},{"id":"TWITCH_SHIP29","name":"TV2 AEBASHI","kind":"Product","category":"Curiosity","category