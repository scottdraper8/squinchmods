kMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/DECAL_RUINMECH","@type":"GameAsset"},{"id":"STONE_GLOVES","name":"LIVING STONE GLOVES","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Gloves","description":"An exclusive Exosuit Appearance Override. A powerful magnetic field runs through this ancient stone, turning lumpen rock into something almost alive. The carver of this effigy is unknown. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S18.STONEGLOVES.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s18.stonegloves.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_STONE_GLOVES_NAME","descriptionKey":"UI_EXPED_STONE_ARMOUR_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/STONE_GLOVES","@type":"GameAsset"},{"id":"EXPD_STONE_PACK","name":"LIVING STONE HARDPACK","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Jetpack","description":"An exclusive Exosuit Appearance Override. An unusual alternative to the traditional jetpack, this flight device is sculpted from the remains of sentient rock. Magmatic gases provide the hardpack's thrust, while an anti-gravity field supports the weight of the stone, ensuring ergonomic safety for the user. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S18.PACK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s18.pack.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_STONE_PACK_NAME","descriptionKey":"UI_EXPED_STONE_PACK_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_STONE_PACK","@type":"GameAsset"},{"id":"STONE_HAT","name":"LIVING STONE HELMET","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Helmet","description":"An exclusive Exosuit Appearance Override. A powerful magnetic field runs through this ancient stone, turning lumpen rock into something almost alive. The carver of this effigy is unknown. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S18.STONEHAT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s18.stonehat.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_STONE_HAT_NAME","descriptionKey":"UI_EXPED_STONE_ARMOUR_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/STONE_HAT","@type":"GameAsset"},{"id":"STONE_LEGS","name":"LIVING STONE LEGPLATES","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Leg Customisation","description":"An exclusive Exosuit Appearance Override. A powerful magnetic field runs through this ancient stone, turning lumpen rock into something almost alive. The carver of this effigy is unknown. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S18.STONELEGS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s18.stonelegs.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_STONE_LEGS_NAME","descriptionKey":"UI_EXPED_STONE_ARMOUR_DESC","secondary":"Exotic","tags":[],"baseValue":750,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/STONE_LEGS","@type":"GameAsset"},{"id":"EXOTIC_BIOPROD","name":"LIVING WATER","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Glassy Indeterminance","description":"Unusual surface interactions cause this liquid to quickly split into small, perfect, spheres. Light refracted through one such sphere splits into colours beyond description. Of unknown origin.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/PRODUCT.BIOEXOTIC.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/product.bioexotic.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BIO_EXOTIC_SUB_NAME","descriptionKey":"UI_BIO_EXOTIC_SUB_DESC","secondary":"Exotic","tags":[],"baseValue":1616,"level":0,"stackMultiplier":30,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXOTIC_BIOPROD","@type":"GameAsset"},{"id":"MAINT_TECH20","name":"LOAD BALANCER","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Damaged Component","description":"A small unit designed to regulate the flow of power across the device. A malfunction is causing it to short, damaging other components.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.ENERGY5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.energy5.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINTAIN_TECH20_NAME","descriptionKey":"UI_MAINTAIN_TECH20_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_TECH20","@type":"GameAsset"},{"id":"MAINT_TECH1","name":"LOCKING MECHANISM","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Damaged Component","description":"A simple locking device, designed to keep out unauthorised pilferers. Damage has locked it permanently.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/MAINTTECH.TECH1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/mainttech.tech1.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINTAIN_TECH1_NAME","descriptionKey":"UI_MAINTAIN_TECH1_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_TECH1","@type":"GameAsset"},{"id":"LOG_KEY","name":"LOG ENCRYPTION KEY","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Incomplete Data Sequence","description":"A fragment of the encryption override sequence for a freighter's emergency log. Several parts of the sequence may be required to gain full access to recorded data.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.LOGKEY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.logkey.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_LOG_FRAG_NAME","descriptionKey":"UI_LOG_FRAG_DESC","secondary":"Special","tags":["Consumable"],"baseValue":1500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/LOG_KEY","@type":"GameAsset"},{"id":"S20_LOG1","name":"LOG OF THE FIRESHIP ARCADIA","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":":: Datestamp 22516.01 ::","description":"LOG CORRUPT RECOVERING DAMAGED SECTORS \"captain found a ::: on the last walk out says it'll bring us luck we'll need it, cruise has been a ::: waste so far all the asteroids just dust and ice ::: nonsense but better than nothing\"","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.LOGKEY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.logkey.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S20_BIGGS_LOG_NAME","descriptionKey":"UI_S20_BIGGS_LOG_DESC1","secondary":"Special","tags":["Craftable"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S20_LOG1","@type":"GameAsset"},{"id":"S20_LOG2","name":"LOG OF THE FIRESHIP ARCADIA","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":":: Datestamp 22518.24 ::","description":"LOG CORRUPT RECOVERING DAMAGED SECTORS \"going from bad to worse can't wait to get home navigation ::: distorted ::: nothing but static warping but ::: just empty systems ::: lost in some abandoned sector?\"","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.LOGKEY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.logkey.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S20_BIGGS_LOG_NAME","descriptionKey":"UI_S20_BIGGS_LOG_DESC2","secondary":"Special","tags":["Craftable"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S20_LOG2","@type":"GameAsset"},{"id":"S20_LOG3","name":"LOG OF THE FIRESHIP ARCADIA","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":":: Datestamp 22522.31 ::","description":"LOG CORRUPT RECOVERING DAMAGED SECTORS \"the captain ::: gone tried to wake them for their watch no sign of them ::: nothing on the cameras door logs are normal, no kit missing where are they? where are we\"","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.LOGKEY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.logkey.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S20_BIGGS_LOG_NAME","descriptionKey":"UI_S20_BIGGS_LOG_DESC3","secondary":"Special","tags":["Craftable"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S20_LOG3","@type":"GameAsset"},{"id":"S20_LOG4","name":"LOG OF THE FIRESHIP ARCADIA","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":":: Datestamp 22594.16 ::","description":"LOG CORRUPT RECOVERING DAMAGED SECTORS \"we saw them they ::: out the airlock just ::: floating there could hear them ::: singing ... get us home ::: please\"","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.LOGKEY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.logkey.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S20_BIGGS_LOG_NAME","descriptionKey":"UI_S20_BIGGS_LOG_DESC4","secondary":"Special","tags":["Craftable"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S20_LOG4","@type":"GameAsset"},{"id":"S20_LOG5","name":"LOG OF THE FIRESHIP ARCADIA","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":":: Datestamp 22512.64 ::","description":"LOG CORRUPT RECOVERING DAMAGED SECTORS \"they all followed ::: the music one by one ::: the lights called them alone now i hear the song now too, even when i ::: sleep i'm so lonely ::: when will ::: when help\"","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.LOGKEY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.logkey.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S20_BIGGS_LOG_NAME","descriptionKey":"UI_S20_BIGGS_LOG_DESC5","secondary":"Special","tags":["Craftable"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S20_LOG5","@type":"GameAsset"},{"id":"F_ALL_RARE_M2","name":"LONGJAW SNAPPER","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Uncommon Fish","description":"UI_FISH_ALL_RARE_M_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FIS