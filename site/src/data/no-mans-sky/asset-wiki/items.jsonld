uinchmods.com/asset-wiki/id/item/technology/PROTECT","@type":"GameAsset"},{"id":"UP_HAZ0","name":"Hazard Protection","kind":"Upgrade module","category":"Protection","categoryKey":"Protection","rarity":"SeaTrash","subtitle":"Rusted %NAME% Upgrade","description":"UP_SEATRASH_DESC","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_HAZPROT","descriptionKey":"UP_SEATRASH_DESC","secondary":"T_HAZ","tags":["4 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_HAZ0","@type":"GameAsset"},{"id":"UP_HAZX","name":"Hazard Protection","kind":"Upgrade module","category":"Protection","categoryKey":"Protection","rarity":"Illegal","subtitle":"Illegal %NAME% Upgrade","description":"UP_ENERGYX_DESC","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_HAZPROT","descriptionKey":"UP_ENERGYX_DESC","secondary":"T_HAZ","tags":["4 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_HAZX","@type":"GameAsset"},{"id":"FOOD_B_VEG","name":"HEALTHY WHEATBLOCK","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A well-baked biscuit, created in the Nutrient Processor. What was once a thin sheet of vaguely-sweetend nutrient paste has been elevated with the addition of carefully-chosen ingredients.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.BISCUIT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.biscuit.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_B_VEG_NAME","descriptionKey":"UI_BISCUIT_DESC_REF","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":35000,"level":0,"stackMultiplier"