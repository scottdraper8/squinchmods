webp","colour":"#7b0000","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SHIPSLOT_DMG3_NAME","descriptionKey":"UI_SHIPSLOT_DMG_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SHIPSLOT_DMG3","@type":"GameAsset"},{"id":"MAINT_S22_PART2","name":"SHATTERED CORTEX","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Damaged Neural Component","description":"A critically damaged component housed within what appears to be the processing centre of a fallen swarmer. Partial functionality could be restored by repairing the component.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/FARMPROD.3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/farmprod.3.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINT_S22_PART_2_NAME","descriptionKey":"UI_MAINT_S22_PART_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_S22_PART2","@type":"GameAsset"},{"id":"WEAPSLOT_DMG10","name":"SHATTERED LENS","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Impossible","subtitle":"Damaged Multi-Tool Component","description":"Multi-Tool subsystem critically damaged. Slot cannot be used until damage is repaired. Use to begin repair process. Repairing will free slot up for general use.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/MAINTTECH.TECH5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/mainttech.tech5.webp","colour":"#7b0000","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_WEAPSLOT_DMG10_NAME","descriptionKey":"UI_WEAPSLOT_DMG_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/WEAPSLOT_DMG10","@type":"GameAsset"},{"id":"EXOPOD_TECH3","name":"SHATTERED POWER CORE","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Damaged Component","description":"This Exosuit Upgrade Module is critically damaged. Repair systems to restore upgrade functionality. If repaired, User will not be charged for any Exosuit Upgrades.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.ALLOY4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.alloy4.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_EXO_MAINT3_NAME","descriptionKey":"UI_EXO_MAINT_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/EXOPOD_TECH3","@type":"GameAsset"},{"id":"SQUIDFRAG","name":"SHATTERED QUALIA","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Common","subtitle":"Soul Fragment","description":"A pattern, no more than a mere waveform, etched into an ethereal shard of glass. This fragment of data represents a trace of the electrical impulses running across a neural network. Many fragments would be required to recreate any sensible experience. Released upon the destruction of a boundary horror.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/SUB.SOULFRAG.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/sub.soulfrag.webp","colour":"#4d2957","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_SQUIDFRAG_NAME","descriptionKey":"UI_SQUIDFRAG_DESC","secondary":"Substance","tags":[],"baseValue":16,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/SQUIDFRAG","@type":"GameAsset"},{"id":"UT_SHOT","name":"SHELL GREASER","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Common","subtitle":"Scatter Blaster Upgrade","desc