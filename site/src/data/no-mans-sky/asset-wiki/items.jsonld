y"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/GROUND_SHIELD","@type":"GameAsset"},{"id":"SUIT_REFINER","name":"PERSONAL REFINER","kind":"Technology","category":"Suit","categoryKey":"Suit","rarity":"Common","subtitle":"Self-Mounted Refiner Unit","description":"A compact extension to the Exosuit, installing a small Portable Refiner, accessible directly from the user's Exosuit interface. Unit requires fuel and is limited to refining one substance at a time.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.PERSONALREFINER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.personalrefiner.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SUIT_REFINER_NAME","descriptionKey":"UI_SUIT_REFINER_DESC","secondary":"Installable","tags":["Chargeable","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SUIT_REFINER","@type":"GameAsset"},{"id":"SUIT_REFINER2","name":"PERSONAL REFINER MK 2","kind":"Technology","category":"Suit","categoryKey":"Suit","rarity":"Common","subtitle":"Self-Mounted Advanced Refiner","description":"A compact extension to the Exosuit, installing an advanced yet portable Medium Refiner, accessible directly from the user's Exosuit interface. Unit requires fuel and is able to refine more complex recipes than the standard personal refiner unit.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.PERSONALREFINER2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.personalrefiner2.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SUIT_REFINER2_NAME","descriptionKey":"UI_SUIT_REFINER2_DESC","secondary":"Installable","tags":["Chargeable","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wi