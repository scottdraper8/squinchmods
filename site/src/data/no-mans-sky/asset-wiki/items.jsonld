GameAsset"},{"id":"EXPED_BUG_ARMOR","name":"CHITIN EXOSKELETON","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Armour","description":"An exclusive Exosuit Appearance Override. A fusion of advanced technology and resinous organic secretions, this hardened carapace represents the apex of bio-organic engineering. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.BUGARMOUR.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.bugarmour.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_BUG_ARMOUR_NAME","descriptionKey":"UI_EXPED_BUG_ARMOUR_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPED_BUG_ARMOR","@type":"GameAsset"},{"id":"EXPED_BUG_PACK","name":"CHITIN FLIGHT PACK","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Jetpack","description":"An exclusive Exosuit Appearance Override. A fusion of advanced technology and resinous organic secretions, this jetpack replacement represents the apex of bio-organic engineering. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.BUGPACK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.bugpack.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_BUG_PACK_NAME","descriptionKey":"UI_EXPED_BUG_PACK_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPED_BUG_PACK","@type":"GameAsset"},{"id":"EXPED_BUG_GLOVE","name":"CHITIN GAUNTLETS","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Gloves","description":"An exclusive Exosuit Appearance Override. A fusion of advanced technology and resinous organic secretions, these protective claws represent the apex of bio-organic engineering. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.BUGGLOVES.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.buggloves.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_BUG_GLOVES_NAME","descriptionKey":"UI_EXPED_BUG_GLOVES_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPED_BUG_GLOVE","@type":"GameAsset"},{"id":"EXPED_BUG_HAT","name":"CHITIN MANDIBLES","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Helmet","description":"An exclusive Exosuit Appearance Override. A fusion of advanced technology and resinous organic secretions, this insectoid helmet represents the apex of bio-organic engineering. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.BUGHAT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.bughat.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_BUG_HAT_NAME","descriptionKey":"UI_EXPED_BUG_HAT_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPED_BUG_HAT","@type":"GameAsset"},{"id":"EXPED_BUG_BOOTS","name":"CHITIN SPURS","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Boots","description":"An exclusive Exosuit Appearance Override. A fusion of advanced technology and resinous organic secretions, these feet-replacements represent the apex of bio-organic engineering. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.BUGBOOTS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.bugboots.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_BUG_BOOTS_NAME","descriptionKey":"UI_EXPED_BUG_BOOTS_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPED_BUG_BOOTS","@type":"GameAsset"},{"id":"BASE_HOUDINI1","name":"CHITINOUS CAGE","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A proteinous formation of unknown origin, replicated aboard the Space Anomaly. Its skeletal structure often retains pockets of air, leading to slightly warmer or cooler temperatures in the centre of the cage. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.HOUDINIPLANT01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.houdiniplant01.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_HOUDINIPLANT_1_NAME","descriptionKey":"BLD_HOUDINIPLANT_1_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_HOUDINI1","@type":"GameAsset"},{"id":"WATERPROD3","name":"CHLORIDE LATTICE","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Concentrated Chlorine Deposit","description":"A tightly-bonded form of Chlorine. Rigidly-packed molecules offer unrivalled conductivity. Not known to form spontaneously: creation requires highly-focused energy inputs. Synthesised from Chlorine.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.WATERPROD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.waterprod.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_CATAPROD3_NAME","descriptionKey":"UI_CATAPROD3_DESC","secondary":"Exotic","tags":[],"baseValue":6150,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/WATERPROD3","@type":"GameAsset"},{"id":"WATER2","name":"CHLORINE","kind":"Resource","category":"Earth","categoryKey":"Earth","rarity":"Rare","subtitle":"Processed Aquatic Mineral","description":"A reactive element most easily harvested by processing the salt-infused minerals found in oceans. Used in the manufacture of advanced technologies.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.WATER.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.water.2.webp","colour":"#1e8a42","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_NEWWATER2_NAME","descriptionKey":"UI_WATER2_DESC","secondary":"Substance","tags":["Easy to refine"],"baseValue":205,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/WATER2","@type":"GameAsset"},{"id":"CHARGER_ALIEN","name":"CHLOROPLAST MEMBRANE","kind":"Technology","category":"Alien Ship","categoryKey":"AlienShip","rarity":"Impossible","subtitle":"Sentient Vessel Node","description":"An infusion of cyanobacteria fills the membrane, which rests just beneath the ship's translucent dermal layer. The membrane will recharge the Neural Assembly automatically when exposed to sunlight.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/PRODUCT.STEM2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/product.stem2.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_CHARGER_ALIEN_NAME","descriptionKey":"UI_CHARGER_ALIEN_DESC","secondary"