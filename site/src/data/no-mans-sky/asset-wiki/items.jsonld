ry Slot to decorate your ship's interior.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BOBBLEPOLO.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.bobblepolo.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_BOBBLE_POLO_NAME","descriptionKey":"UI_BOBBLE_POLO_DESC","secondary":"Installable","tags":[],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/T_BOBBLE_POLO","@type":"GameAsset"},{"id":"FARMPROD5","name":"POLY FIBRE","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Rare","subtitle":"Advanced Agricultural Product","description":"A connective fibre for electronics, made from an advanced synthetic polymer and capable of serving as a conduit for power and data. Crafted from Cactus Flesh and Star Bulbs.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/FARMPROD.5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/farmprod.5.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FARMPROD_5_NAME","descriptionKey":"UI_FARMPROD_5_DESC","secondary":"Special","tags":["Craftable"],"baseValue":130000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FARMPROD5","@type":"GameAsset"},{"id":"TRA_MINERALS4","name":"POLYCHROMATIC ZIRCONIUM","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Trade Goods (Minerals)","description":"A sack full of polychromatic zirconium crystals. These crystals produce lenses of dazzling colour and near-indestructible hardness. Highly valuable in manufacturing economies.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.MINERALS4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.minerals4.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TRADE_ITEM_MINERALS_4_NAME","descriptionKey