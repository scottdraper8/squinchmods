_21_NAME","descriptionKey":"BLD_DECAL_EXPD_21_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_DECAL21","@type":"GameAsset"},{"id":"PIRATE_BEACON","name":"RENDEZVOUS BEACON","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Navigational Data Recorder","description":"An unmarked navigation beacon, acquired from the wreck of a downed starship. Use Activate Beacon () to deploy the beacon and retrace the final steps of the crashed ship.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.PIRATEBEACON.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.piratebeacon.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_PIRATE_BEACON_NAME","descriptionKey":"UI_PIRATE_BEACON_DESC","secondary":"Special","tags":["Craftable"],"baseValue":888,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/PIRATE_BEACON","@type":"GameAsset"},{"id":"REPAIRKIT","name":"REPAIR KIT","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Rare","subtitle":"Automatic Patching Unit","description":"A highly useful piece of survival technology, the Repair Kit allows damaged equipment to be quickly and efficiently restored to working order. While repairing a piece of techology, the Repair Kit can be applied to any damaged subcomponent in place of the usual requirements.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.REPAIRKIT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.repairkit.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_REPAIR_KIT_NAME","descriptionKey":"UI_REPAIR_KIT_DESC","secondary":"Special","tags":["Craftable","Consumable"],"baseValue":450,"level":0,"stackMultiplier":2,"@id":"https://no-mans-sky.squinchmods.com/asset-w