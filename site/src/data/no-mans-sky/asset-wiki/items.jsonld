","rarity":"Rare","subtitle":"Lost Artifact","description":"Lost Artifact","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.COMPONENT4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.component4.webp","colour":"#1fb80a","source":"PROCEDURALPRODUCTTABLE.MBIN","nameKey":"ITEMGEN_FORMAT_TOOL","descriptionKey":"TOOL_SUB","secondary":"Procedural","tags":["Generated name and value"],"baseValue":1000,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/procedural-item/PROC_TOOL","@type":"GameAsset"},{"id":"TWITCH_SHIP49","name":"TOONTU SJ3","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship. This A-class explorer benefits from hyperdrive and launcher bonuses, and is pre-installed with a selection of technologies and upgrades. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/TWITCH.SHIP49.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/twitch.ship49.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_49_NAME","descriptionKey":"UI_TWIT_SHIP_SCIENTIFIC_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP49","@type":"GameAsset"},{"id":"SPEC_EMOTE16","name":"TOOT TOOT!","kind":"Product","category":"Emote","categoryKey":"Emote","rarity":"Common","subtitle":"Unlockable Gesture","description":"An exclusive gesture. This can be selected from the Quick Menu. All aboard!","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EMOTE16.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.emote16.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","name