evel":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_STEW_DIG","@type":"GameAsset"},{"id":"PLANT_HOT","name":"SOLANIUM","kind":"Resource","category":"Flora","categoryKey":"Flora","rarity":"Rare","subtitle":"Harvested Agricultural Substance","description":"A powerful chemical that has resisted attempts at synthesis. It can be harvested from the bark of the Solar Vine. The vine requires a hot climate to thrive in the wild, but can be farmed in all environments with the aid of a Hydroponics Tray.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.PLANT.HOT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.plant.hot.webp","colour":"#b94318","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_PLANTSUB_SCORCHED_NAME","descriptionKey":"UI_PLANTSUB_SCORCHED_DESC","secondary":"Substance","tags":["Cooking ingredient"],"baseValue":70,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/PLANT_HOT","@type":"GameAsset"},{"id":"MIRROR","name":"SOLAR MIRROR","kind":"Product","category":"Component","categoryKey":"Component","rarity":"Rare","subtitle":"Crafted Technology Component","description":"A specialist optical component. Employing an impossibly polished surface, this mirror is able to selectively filter different wavelengths of light, changing its reflective pattern based on nearby magnetic fields. Used in the creation of a wide range of advanced technologies.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.MIRROR.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.mirror.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_MIRROR_NAME","descriptionKey":"UI_MIRROR_DESC","secondary":"Catalyst","tags":["Craftable"],"baseValue":6150,"level":0,"stackMultiplier":2,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/MIRROR","@type":"GameAsset"},{"id":"SUN_LASER","name":"SOLAR RAY","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Impossible","subtitle":"Alchemical Laser","description":"A highly specialised addition to the Multi-Tool's mining capabilities, transforming terrain deposits into liquid sun. A powerful laser array amplifies local solar radiation, allowing for the rapid reconfiguration of nearby mineral ores.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.SUNLASER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.sunlaser.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SUN_LASER_NAME","descriptionKey":"UI_SUN_LASER_DESC","secondary":"Installable","tags":["Chargeable","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SUN_LASER","@type":"GameAsset"},{"id":"F_HOT_RARE_M2","name":"SOLAR ROACH","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Uncommon Fish","description":"UI_FISH_HOT_RARE_M_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.MEDIUM.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.medium.2.webp","colour":"#2177c8","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_HOT_RARE_M2_NAME","descriptionKey":"UI_FISH_HOT_RARE_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":5000,"level":2,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_HOT_RARE_M2","@type":"GameAsset"},{"id":"FOOD_P_HOTFARM","name":"SOLARTILLO","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"An edible plant, harvested from planetary flora. Process in a Nutrient Processor to generate edible products.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.PLANT.HOTFARM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.plant.hotfarm.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_PLANT_HOT_FARM_NAME","descriptionKey":"FOOD_PLANT_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":300,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_P_HOTFARM","@type":"GameAsset"},{"id":"MAINT_FRIG5","name":"SOLENOID","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Damaged Component","description":"A relay switch, intended to aid the powering up of the device. The connectors have become corroded, and the solenoid is no longer functioning.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.COMMIDITY3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.commidity3.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINTAIN_TECH16_NAME","descriptionKey":"UI_MAINTAIN_TECH16_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_FRIG5","@type":"GameAsset"},{"id":"MAINT_TECH16","name":"SOLENOID","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Damaged Component","description":"A relay switch, intended to aid the powering up of the device. The connectors have become corroded, and the solenoid is no longer functioning.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.COMMIDITY3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.commidity3.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINTAIN_TECH16_NAME","descriptionKey":"UI_MAINTAIN_TECH16_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_TECH16","@type":"GameAsset"},{"id":"FOOD_PIE_GREASE","name":"SOLIDIFIED GREASE PIE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.VEGPIE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.vegpie.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_PIE_GREASE_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":54000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_PIE_GREASE","@type":"GameAsset"},{"id":"EXPD_POSTER05A","name":"SOLSTICE POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This golden poster evokes the of nostalgia of long summer days.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.POSTER05A.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.poster05a.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER5A_NAME","descriptionKey":"BLD_EXPD_POSTER5A_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER05A","@type":"GameAsset"},{"id":"TIMEDUST","name":"SOMNAL DUST","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Decayed Spacetime Remnant","description":"Grey, dead, sparkling with life and colour, singing as it shimmers. This impossibly fine dust is the accumulated decay of time and memories. Collected from the fine layers it forms around hotspots in the loop. Of great value to Specialist Polo as they research the loop.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.TIMEDUST.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.timedust.webp","colour":"#512741","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_ROGUE_TIME_DUST_NAME","descriptionKey":"UI_ROGUE_TIME_DUST_DESC","secondary":"Substance","tags":[],"baseValue":1616,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/TIMEDUST","@type":"GameAsset"},{"id":"BIOSHIP_COMP5_0","name":"SOUL CHAMBER (0%)","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Bionic Ark","description":"A biomechanical construct, created to the design of an anonymous host. A fusion of complex circuitry and the ineffable glitch of the Traveller. Such a calculus might bind realities together, or tear them into mere simulated fragments.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/PRODUCT.BIOCOMP5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/product.biocomp5.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BIOSHIP_COMP5_NAME0","descriptionKey":"UI_BIOSHIP_COMP5_DESC","secondary":"Exotic","tags":["Craftable"],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BIOSHIP_COMP5_0","@type":"GameAsset"},{"id":"BIOSHIP_COMP5_1","name":"SOUL CHAMBER (33%)","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Bionic Ark","description":"A biomechanical construct, created to the design of an anonymous host. A fusion of complex circuitry and the ineffable glitch of the Traveller. Such a calculus might bind realities together, or tear them into mere simulated fragments.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/PRODUCT.BIOCOMP5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/product.biocomp5.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BIOSHIP_COMP5_NAME1","descriptionKey":"UI_BIOSHIP_COMP5_DESC","secondary":"Exotic","tags":["Craftable"],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BIOSHIP_COMP5_1","@type":"GameAsset"},{"id":"BIOSHIP_COMP5_2","name":"SOUL CHAMBER (66%)","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Bionic Ark","description":"A biomechanical construct, created to the design of an anonymous host. A fusion of complex circuitry and the ineffable glitch of the Traveller. Such a calculus might bind realities together, or tear them into mere simulated fragments.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/PRODUCT.BIOCOMP5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/product.biocomp5.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BIOSHIP_COMP5_NAME2","descriptionKey":"UI_BIOSHIP_COMP5_DESC","secondary":"Exotic","tags":["Craftable"],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BIOSHIP_COMP5_2","@type":"GameAsset"},{"id":"SOUL_ENGINE","name":"SOUL ENGINE","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Advanced Crafted Product","description":"A powerful organic computing unit. A glitching beat drives this miracle circuit, performing cycle after cycle in an endless, furious loop of calculation.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/SOULENGINE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/soulengine.webp","colour":"#0063b7","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SOULENGINE_NAME","descriptionKey":"UI_SOULENGINE_DESC","secondary":"Special","tags":["Craftable"],"baseValue":1000,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SOUL_ENGINE","@type":"GameAsset"},{"id":"DECAL_NEXUSM","name":"SPACE ANOMALY DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal depicts a starship pulsing past Nada and Polo's anomalous home.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.DECAL19.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.decal19.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_P_NEXUSMISSION_NAME","descriptionKey":"BLD_DECAL_P_NEXUSMISSION_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/DECAL_NEXUSM","@type":"GameAsset"},{"id":"PROC_STAR","name":"Space Bones (procedural)","kind":"Procedural item","category":"Space Bones","categoryKey":"Space Bones","rarity":"Rare","subtitle":"Ancient Skeleton","description":"Approximately %AGE%00 years old, and made from pure gold. These bones are unlike those of any terrestial creature. The remains of a true deep-space leviathan.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.BONES.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.bones.webp","colour":"#ffffff","source":"PROCEDURALPRODUCTTABLE.MBIN","nameKey":"ITEMGEN_FORMAT_STARBONE","descriptionKey":"ITEMGEN_SPACEBONE_DESC","secondary":"Procedural","tags":["Generated name and value"],"baseValue":1000,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/procedural-item/PROC_STAR","@type":"GameAsset"},{"id":"PROC_DARK","name":"Space Horror (procedural)","kind":"Procedural item","category":"Space Horror","categoryKey":"Space Horror","rarity":"Rare","subtitle":"Terrifying Sample","description":"An appalling relic, the haunted remains of some abyssal horror. It has lived at least %AGE%0 lifetimes, and will live many more again. Will stalk the bearer across the galaxy and the next, unless it is sold before the curse can take effect.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.HORRIFICARTIFACT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.horrificartifact.webp","colour":"#ffffff","source":"PROCEDURALPRODUCTTABLE.MBIN","nameKey":"ITEMGEN_FORMAT_SPACEFEAR","descriptionKey":"ITEMGEN_SPACEFEAR_DESC","secondary":"Procedural","tags":["Generated name and value"],"baseValue":1000,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/procedural-item/PROC_DARK","@type":"GameAsset"},{"id":"TRA_ENERGY1","name":"SPARK CANISTER","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Trade Goods (Energy Source)","description":"A crate packed with spark canisters. Many industrial and mining processes have considerable power demands. A counterpart to the slow release of a battery, spark canisters are able to meet these demands instantaneously.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.ENERGY1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.energy1.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TRADE_ITEM_ENERGY_1_NAME","descriptionKey":"UI_TRADE_ITEM_ENERGY_1_DESC","secondary":"Exotic","tags":["Trade good"],"baseValue":1000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TRA_ENERGY1","@type":"GameAsset"},{"id":"MAINT_ROBO6","name":"SPARK RELAY","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Damaged Autophage Component","description":"This autophage is far from working order, but its subcomponents shows the signs of a previous repair attempt. With a few additional tweaks, the work might be completed... Repair this component with , or use to locate the needed materials.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/MAINTTECH.FARM5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/mainttech.farm5.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINT_ROBO6_NAME","descriptionKey":"UI_MAINT_ROBO_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_ROBO6","@type":"GameAsset"},{"id":"SPEC_HELMET01","name":"SPARSE HORIZON HELMET","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Helmet","description":"An exclusive Exosuit Appearance Override. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.HELMET01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.helmet01.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SPEC_HELMET_01_NAME","descriptionKey":"UI_SPEC_HELMET_01_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_HELMET01","@type":"GameAsset"},{"id":"F_BOSS_JELLY","name":"SPAWN OF ARCADIA","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Fragile Medusoid","description":"A glassy jellyfish, lights pulsing beneath its skin. Its thin tentacles pluck at the air, their vibrations manipulating the space around its body. As it writhes, a faint music drifts from its tendrils, worming its way into your ears. The melody seems to never end, worming its way into your ears, never ending, worming its way into your ears, never ending, never...","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT4.FISH.JELLY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product4.fish.jelly.webp","colour":"#2177c8","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_BOSS_JELLY_NAME","descriptionKey":"UI_FISH_BOSS_JELLY_DESC","secondary":"Special","tags":["Consumable","Trade good"],"baseValue":500,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_BOSS_JELLY","@type":"GameAsset"},{"id":"HOOD_GEK","name":"SPAWNING COWL","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Hood","description":"This grand hood is worn by the upper ranks of Gek at events and conventions, distinguishing the esteemed Trade Lord from the lowly Hireling. Transform the appearance of your Exosuit with this exclusive Appearance Override at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.GEKHOOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.gekhood.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SPEC_HOOD_GEK_NAME","descriptionKey":"UI_SPEC_HOOD_GEK_DESC","secondary":"Exotic","tags":[],"baseValue":3200,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/HOOD_GEK","@type":"GameAsset"},{"id":"ALIEN_INV_TOKEN","name":"SPAWNING SAC","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Sentient Vessel Storage Sac","description":"An additional storage nodule for Sentient starships. Upon hatching, the parasite inside this sac is grafted upon the vessel, exchanging the use of its cavernous innards for vital nutrients from the host. Use to trigger growth and begin the hatching process.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/PRODUCT.BIOCOMP4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/product.biocomp4.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_ALIEN_INV_TOKEN_NAME","descriptionKey":"UI_ALIEN_INV_TOKEN_DESC","secondary":"Exotic","tags":["Craftable","Consumable"],"baseValue":125000,"level":0,"stackMultiplier":3,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ALIEN_INV_TOKEN","@type":"GameAsset"},{"id":"BANNER_POLO","name":"SPECIALIST POLO BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Specialist Polo hopes you enjoy this exclusive Personal Flair. May it bring you joy on your travels! Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BANNER.POLO.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.banner.polo.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_POLO_NAME","descriptionKey":"UI_BANNER_POLO_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BANNER_POLO","@type":"GameAsset"},{"id":"TWITCH_SHIP55","name":"SPEEDY NOICHIR V","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship. This A-class fighter benefits from damage and manoeuvrability bonuses, and is pre-installed with a selection of technologies and upgrades. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/TWITCH.SHIP55.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/twitch.ship55.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_55_NAME","descriptionKey":"UI_TWIT_SHIP_FIGHTER_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP55","@type":"GameAsset"},{"id":"AP_SHIPGUN1","name":"SPEWING VENT NODE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Rare","subtitle":"Living Weapon Upgrade","description":"A moderate upgrade for the Spewing Vents. Use to trigger node growth and begin the grafting process. Each node is genetically unique, and exact upgrade statistics are unknown until installation is complete. Potential improvements include: damage, fire rate and overheat times.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PROCTECH/PROCTECHALIEN.C.SHIPGUN.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/proctech/proctechalien.c.shipgun.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BIO_PROD_GUN_NAME","descriptionKey":"BIO_PROD_GUN1_DESC","secondary":"Special","tags":["Consumable"],"baseValue":60,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/AP_SHIPGUN1","@type":"GameAsset"},{"id":"AP_SHIPGUN2","name":"SPEWING VENT NODE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Rare","subtitle":"Significant Living Weapon Upgrade","description":"A significant upgrade for the Spewing Vents. Use to trigger node growth and begin the grafting process. Each node is genetically unique, and exact upgrade statistics are unknown until installation is complete. Potential improvements include: damage, fire rate and overheat times.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PROCTECH/PROCTECHALIEN.B.SHIPGUN.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/procte