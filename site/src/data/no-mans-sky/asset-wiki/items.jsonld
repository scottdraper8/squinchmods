in the upper hand in any negotiation.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.FRIGBOOST.TRADE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.frigboost.trade.webp","colour":"#0063b7","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FRIG_BOOST_TRA_NAME","descriptionKey":"UI_FRIG_BOOST_TRA_DESC","secondary":"Special","tags":["Craftable","Consumable"],"baseValue":75000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FRIG_BOOST_TRA","@type":"GameAsset"},{"id":"BASE_ROCK02","name":"MINERAL ARCH","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A remarkable piece of geological geometry. A stable load-bearing arch, infused with curiously angular solid geodes. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.ROCK02.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.rock02.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_ROCK_2_NAME","descriptionKey":"BLD_ROCK_2_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_ROCK02","@type":"GameAsset"},{"id":"FRIG_BOOST_MIN","name":"MINERAL COMPRESSOR","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Rare","subtitle":"Consumable Frigate Upgrade","description":"A temporary frigate upgrade that lasts for one expedition. The mineral compressor allows fleet mining crews to liquidise the substances they extract, for both faster processing and easier transportation.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.FRIGBOOST.MINING.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.frigboost.mining.webp","colour":"#0063b7","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FRIG_BOOST_MIN_NAME","descriptionKey":"UI_FRIG_BOOST_MIN_DESC","secondary":"Special","tags":["Craftable","Consumable"],"baseValue":75000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FRIG_BOOST_MIN","@type":"GameAsset"},{"id":"EXO_REFINER","name":"MINERAL PROCESSING RIG","kind":"Technology","category":"Colossus","categoryKey":"Colossus","rarity":"Impossible","subtitle":"Vehicle-Borne Refiner","description":"A large and powerful refiner unit, designed to be housed within the belly of a Colossus Exocraft. The unit is able to process the most complex recipes, but requires its own independent fuel source.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/VEHICLE/RENDER.REFINER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/vehicle/render.refiner.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_EXO_REFINER_NAME","descriptionKey":"UI_EXO_REFINER_DESC","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/EXO_REFINER","@type":"GameAsset"},{"id":"F_GAS_RARE_M2","name":"MINERALISED JELLYFISH","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Uncommon Fish","description":"UI_FISH_GAS_RARE_M_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT5.FISH.JELLY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product5.fish.jelly.webp","colour":"#2177c8","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_GAS_RARE_M2_NAME","descriptionKey":"UI_FISH_GAS_RARE_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":5000,"level":2,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_GAS_RARE_M2","@type":"GameAsset"},{"id":"LASER","name":"MINING BEAM","kind":"