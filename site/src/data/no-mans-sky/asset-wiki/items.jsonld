pedition.s19.shiptrail.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SHIPTRAIL_PLASMA_NAME","descriptionKey":"UI_SHIPTRAIL_PLASMA_DESC","secondary":"Exotic","tags":[],"baseValue":2100,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SHIP_PLASMA","@type":"GameAsset"},{"id":"T_SHIP_PLASMA","name":"PLASMA STARSHIP TRAIL","kind":"Technology","category":"All Ships","categoryKey":"AllShips","rarity":"Impossible","subtitle":"Starship Exhaust Override","description":"An exclusive Starship Exhaust Modifier. A visual enhancement for the starship, replacing traditional exhaust jets with a plasma thruster and generating a dramatic plume of ionised matter. Install this technology in your starship inventory to change the appearance of the engine exhaust trails.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S19.SHIPTRAIL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s19.shiptrail.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SHIPTRAIL_PLASMA_NAME","descriptionKey":"UI_SHIPTRAIL_PLASMA_DESC","secondary":"Installable","tags":[],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/T_SHIP_PLASMA","@type":"GameAsset"},{"id":"F_GAS_COM_L1","name":"PLASMATIC SQUID","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_GAS_COM_L_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.SQUID.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.squid.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_GAS_COM_L1_NAME","descriptionKey":"UI_FISH_GAS_COM_L_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":3000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_GAS_COM_L1","@type":"GameAsset"},{"id":"F_HDRIVEBOOST2","name":"PLASMATIC WARP INJECTOR","kind":"Technology","category":"Freighter","categoryKey":"Freighter","rarity":"VeryRare","subtitle":"Hyperdrive Companion Unit","description":"An augmentation for the colossal hyperdrive engine of an interstellar freighter. Hyperdrive benefits from advanced fusion that brings starship to higher warp speed and intensity. User's craft will become able to leap deeper into space, and into more distant planetary systems.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/TECHNOLOGY.FREIGHTERTAU.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/technology.freightertau.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_FREIGHTER_DRIVE2_NAME","descriptionKey":"UI_FREIGHTER_DRIVE2_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":3,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/F_HDRIVEBOOST2","@type":"GameAsset"},{"id":"BASE_INFEST2","name":"PLATE STEM","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"The broad, plate-like leaf topping this tree is highly efficient for photosynthesis, and wild specimens can grow to extraordinary heights. This domestic variety is cultivated to be suitable to furnish habitations. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.INFESTEDPLANT02.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.infestedplant02.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_INFESTEDPLANT_2_NAME","descriptionKey":"BLD_INFESTEDPLANT_2_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_INFEST2","@type":"GameAsset"},{"id":"ASTEROID3","name":"PLATINUM","kind":"Resource","category":"Exotic","categoryKey":"Exotic","rarity":"Rare","subtitle":"Valuable Asteroid Mineral","description":"Extremely valuable interstellar trading mineral, typically mined from asteroids. Occasionally found in underground planetary deposits. Universally prized for its hardiness and versatility.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.ASTEROID.3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.asteroid.3.webp","colour":"#507575","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_ASTEROID3_NAME","descriptionKey":"UI_ASTEROID3_DESC","secondary":"Substance","tags":["Trade good"],"baseValue":505,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/ASTEROID3","@type":"GameAsset"},{"id":"BASE_PEACOCK01","name":"PLUMAGE PALM","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A tall desert-native tree. The fronds resemble the plumage of a bird, and crown in a vertical formation. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BIOMEPROP.PEACOCK01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.biomeprop.peacock01.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_PEACOCK_1_NAME","descriptionKey":"BLD_PEACOCK_1_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_PEACOCK01","@type":"GameAsset"},{"id":"FOOD_F_WORM","name":"POACHED WORMS","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A small morsel of seafood, created in the Nutrient Processor. Food such as this can be highly valuable. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.FISH.OCTOPUS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.fish.octopus.webp","colour":"#095c77","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_FOOD_WORM_NAME","descriptionKey":"UI_FISH_FOOD_SMALL_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":33100,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_F_WORM","@type":"GameAsset"},{"id":"BASE_TOYCORE","name":"POCKET REALITY GENERATOR","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Unlockable Decoration","description":"An exclusive decorative curiosity for bases. A model of reality itself, as viewed from the perspective of an impossible observer. Infinite levels of detail wait to be discovered by the viewer with a powerful enough lens.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.TOYCORE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.toycore.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_TOYCORE_NAME","descriptionKey":"BLD_TOYCORE_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_TOYCORE","@type":"GameAsset"},{"id":"EXPD_BANNER08","name":"POLESTAR EXPEDITION BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Equip this exclusive Personal Flair in commemoration of the 'Polestar' Expedition, and the completion of a long cruise aboard a capital ship. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.BANNER08.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.banner08.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_EXPD_08_NAME","descriptionKey":"UI_BANNER_EXPD_08_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_BANNER08","@type":"GameAsset"},{"id":"EXPD_DECAL08","name":"POLESTAR EXPEDITION DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal commemorates completion of the Polestar expedition, and the completion of a long cruise aboard a capital ship.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.DECAL08.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.decal08.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_EXPD_08_NAME","descriptionKey":"BLD_DECAL_EXPD_08_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_DECAL08","@type":"GameAsset"},{"id":"EXPD_POSTER08B","name":"POLESTAR POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster is dedicated to explorers and navigators who boldly seek out new horizons.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.POSTER08B.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.poster08b.webp","colour":"#2c8c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER8B_