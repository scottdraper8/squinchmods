eKey":"UI_FISH_FOOD_SMALL_3_NAME","descriptionKey":"UI_FISH_FOOD_SMALL_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":28000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_F_SMALL3","@type":"GameAsset"},{"id":"FOOD_R_PIECASE","name":"PIE CASE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A refined food product, created in the Nutrient Processor. Food such as this can be highly valuable. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.EMPTYPIE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.emptypie.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_R_PIECASE_NAME","descriptionKey":"FOOD_REFINED_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":30000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_R_PIECASE","@type":"GameAsset"},{"id":"EXPD_POSTER08A","name":"PILGRIM POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster is dedicated to brave spacefarers who forge new paths across the galaxy.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.POSTER08A.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.poster08a.webp","colour":"#2c8c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER8A_NAME","descriptionKey":"BLD_EXPD_POSTER8A_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER08A","@type":"GameAsset"},{"id":"FOOD_J_LUSH","name":"PILGRIM'S TONIC","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A consumable liquid, created in the Nutrient Processor. Prized across the galaxy for its pleasing mouth-feel and authentically natural flavours. Can be ingested as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.SAUCE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.sauce.webp","colour":"#007953","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_J_LUSH_NAME","descriptionKey":"FOOD_DRINK_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":800,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_J_LUSH","@type":"GameAsset"},{"id":"FOOD_P_LUSHFARM","name":"PILGRIMBERRY","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"An edible plant, harvested from planetary flora. Process in a Nutrient Processor to generate edible products.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.PLANT.LUSHFARM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.plant.lushfarm.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_PLANT_LUSH_FARM_NAME","descriptionKey":"FOOD_PLANT_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":300,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_P_LUSHFARM","@type":"GameAsset"},{"id":"TWITCH_GUN19","name":"PILLAR OF THE DANCE","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Multifunction Survival Device","description":"An exclusive Multi-Tool. This pistol comes with a powerful, upgraded Pulse Spitter pre-installed. Take this Multi-Tool to add it to your collection, or Exchange it with your current Multi-Tool. Swap between active Multi-Tools from the Utilities section of the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.GUN19.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.gun19.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_GUN_19_NAME","descriptionKey":"UI_TWIT_GUN_19_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_GUN19","@type":"GameAsset"},{"id":"EXPD_STAFF_17","name":"PILLAR OF TITAN","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Unique Korvax Technology?","description":"An exclusive Multi-Tool. This sturdy staff is hewn from polished stone, and yet floats in the hand as if it were no weight at all. It is a perfect companion to those who seek to make long trips across the wilderness. Take this Multi-Tool to add it to your collection, or Exchange it with your current Multi-Tool. Swap between active Multi-Tools from the Utilities section of the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.S17.RUINSTAFF.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.s17.ruinstaff.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_STAFF_17_NAME","descriptionKey":"UI_EXPED_STAFF_17_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_STAFF_17","@type":"GameAsset"},{"id":"S22_ECHO","name":"PILOT ECHO","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Unfragmented Traveller Essence","description":"The final sputtering flame of a Traveller soul. This is the echo of an unfragmented Traveller, with equal fragments of Royal, Sage, and Weaver. It is an essential component of their signature.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.2026.S22_ECHO.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.2026.s22_echo.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S22_ECHO_NAME","descriptionKey":"UI_S22_ECHO_DESC","secondary":"Special","tags":["Craftable"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S22_ECHO","@type":"GameAsset"},{"id":"LIFESUP_ROBO","name":"PILOT INTERFACE","kind":"Technology","category":"Robot Ship","categoryKey":"RobotShip","rarity":"Always","subtitle":"Glass / Boundary Terminal","description":"This device allows a pilot's brain to interface with the mind of the Sentinel Interceptor, granting the pilot access to ship control systems and external sensors. The enmeshing of the pilot's mind with that of the vessel is necessary to prevent rejection/consumption of the pilot by the ship's vestigial cockpit.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/ROBOTSHIP.INTERFACE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/robotship.interface.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_LIFESUP_ROBO_NAME","descriptionKey":"UI_LIFESUP_ROBO_DESC","secondary":"Core","tags":["Core technology","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/LIFESUP_ROBO","@type":"GameAsset"},{"id":"S22_SIGNATURE","name":"PILOT SIGNATURE","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Unfragmented Traveller Identification","description":"The final sputtering flame of a Traveller soul, bound in the remains of living creatures. This identifying signature belonged to an intact, unfragmented Traveller, with equal fragments of Royal, Sage, and Weaver. It will unlock the Launch Thrusters of the starship %SHIPNAME%.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.2026.S22_SIGNATURE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.2026.s22_signature.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S22_SIGNATURE_NAME","descriptionKey":"UI_S22_SIGNATURE_DESC","secondary":"Special","tags":["Craftable"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S22_SIGNATURE","@type":"GameAsset"},{"id":"FREIGHT_PINK","name":"PINK","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Rare","subtitle":"Freighter Customisation Option","description":"Unlocks this colour for freighter customisation. A self-replicating cloud of highly pigmatised nano-robots swarm the capital ship, changing its external appearance.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.FREIGHTPAINT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.freightpaint.webp","colour":"#b65992","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_PAINT_PINK_U","descriptionKey":"UI_PAINT_PROD_DESC","secondary":"Exotic","tags":[],"baseValue":12300,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FREIGHT_PINK","@type":"GameAsset"},{"id":"EXPD_BANNER01","name":"PIONEERS EXPEDITION BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Equip this exclusive Personal Flair in commemoration of the inaugural Expedition, 'Pioneers'. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.EXPEDITION.BANNER01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.expedition.banner01.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_EXPD_01_NAME","descriptionKey":"UI_BANNER_EXPD_01_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_BANNER01","@type":"GameAsset"},{"id":"EXPD_DECAL01","name":"PIONEERS EXPEDITION DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal features the golden edition of the iconic Alpha Vector Starship, and commemorates completion of the inaugural Expedition, 'Pioneers'.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.EXPEDITION.DECAL01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.expedition.decal01.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_EXPD_01_NAME","descriptionKey":"BLD_DECAL_EXPD_01_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_DECAL01","@type":"GameAsset"},{"id":"BLD_EXPD_BASE01","name":"PIONEERS EXPEDITION FLAG","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Unlockable Decoration","description":"An exclusive buildable base ornament. This elaborate, gold-fringed flag features a rendition of the iconic Alpha Vector Starship. Plant in a habitable base to commemorate completion of the inaugural Expedition, 'Pioneers'.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.EXPEDITION.BASEPART01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.expedition.basepart01.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_01_NAME","descriptionKey":"BLD_EXPD_01_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BLD_EXPD_BASE01","@type":"GameAsset"},{"id":"BASE_DUST02","name":"PIPE CACTUS","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A squat, dense succulent, covered with millions of needle-like thorns. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BIOMEPROP.DUST02.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.biomeprop.dust02.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DUST02_NAME","descriptionKey":"BLD_DUST02_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_DUST02","@type":"GameAsset"},{"id":"EXPD_FLAG_06A","name":"PIRACY FLAG","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Exclusive Flag","description":"The bright red skull emblazoned on this velvety flag serves as a warning to hostile parties. An exclusive buildable base ornament.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.FLAG06A.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.flag06a.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_FLAG_06A_NAME","descriptionKey":"UI_EXPD_FLAG_06A_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_FLAG_06A","@type":"GameAsset"},{"id":"PIRATE_MAPWHOLE","name":"PIRATE MAP","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Illicit Geographic Data","description":"Reassembled treasure coordinate data, retrieved from the victims of pirate faction The Blight.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PIRATEMAPWHOLE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/piratemapwhole.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_PIRATE_MAPWHOLE_NAME","descriptionKey":"UI_PIRATE_MAPWHOLE_DESC","secondary":"Special","tags":["Craftable"],"baseValue":888,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/PIRATE_MAPWHOLE","@type":"GameAsset"},{"id":"PIRATE_MAPPROD0","name":"PIRATE MAP FRAGMENT 1 OF 3","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Scrambled Geographic Data","description":"Partial coordinate data, acquired from a troubled freighter captain. The chart is signed with a snippet of pirate manifesto: \"We Blight this new galaxy, as we did the last, as we will the next!\" The data is of value to pirate faction The Blight, who attempted to retrieve it by violent means.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PIRATEMAP0.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/piratemap0.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_PIRATE_MAP0_NAME","descriptionKey":"UI_PIRATE_MAP0_DESC","secondary":"Special","tags":["Craftable"],"baseValue":88,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/PIRATE_MAPPROD0","@type":"GameAsset"},{"id":"PIRATE_MAPPROD1","name":"PIRATE MAP FRAGMENT 2 OF 3","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Scrambled Geographic Data","description":"Partial coordinate data, acquired from a freighter shot down by pirate faction The Blight. The chart is signed with a snippet of pirate manifesto: \"The galactic tunnels belong to the Blight!\" The navigational information is corrupted, but appears to be linked to the data acquired from the freighter captain.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PIRATEMAP1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/piratemap1.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_PIRATE_MAP1_NAME","descriptionKey":"UI_PIRATE_MAP1_DESC","secondary":"Special","tags":["Craftable"],"baseValue":88,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/PIRATE_MAPPROD1","@type":"GameAsset"},{"id":"PIRATE_MAPPROD2","name":"PIRATE MAP FRAGMENT 3 OF 3","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Scrambled Geographic Data","description":"Partial coordinate data, acquired from a starship crashed on an ocean bed. The chart is signed with a snippet of pirate manifesto: \"Annihilate every Traveller! All galaxies will fall to Blight!\" The navigational information is unreadable in its current state, but appears to be linked to the data acquired from the freighter captain.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PIRATEMAP2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/piratemap2.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_PIRATE_MAP2_NAME","descriptionKey":"UI_PIRATE_MAP2_DESC","secondary":"Special","tags":["Craftable"],"baseValue":88,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/PIRATE_MAPPROD2","@type":"GameAsset"},{"id":"PIRATE_PROD","name":"PIRATE TRANSPONDER","kind":"Product","category":"Component","categoryKey":"Component","rarity":"Rare","subtitle":"Salvaged Identification Device","description":"A unique ID transponder, ripped from the internal signal array of an outlaw starship. Possesion of such a device implies the destruction of the vessel in question. Turn it over to an envoy of the Mercenaries Guild to collect any associated bounties.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.PIRATELOOT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.pirateloot.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_PIRATE_PROD_NAME","descriptionKey":"UI_PIRATE_PROD_DESC","secondary":"Special","tags":["Consumable"],"baseValue":85000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/PIRATE_PROD","@type":"GameAsset"},{"id":"EXPD_POSTER09C","name":"PLANETARY BASE POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster captures a towering skyline within the Utopia Foundation communal habitation project.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.POSTER09C.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.poster09c.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER9C_NAME","descriptionKey":"BLD_EXPD_POSTER9C_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER09C","@type":"GameAsset"},{"id":"A1S6_STARMAP","name":"PLANETARY CHART","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Cartographic Data","description":"A map of a nearby planet. A a relic of an ancient civilisation has been marked. Select the map and use Plot Route () to pin the location in your Exosuit display. New maps can be gained by exchanging Navigation Data with a Space Station Cartographer.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.STARCHART.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.starchart.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_STARCHART_NAME","descriptionKey":"UI_STARCHART_DESC_ALIEN","secondary":"Special","tags":["Consumable"],"baseValue":3200,"level":0,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/A1S6_STARMAP","@type":"GameAsset"},{"id":"STARCHART_A","name":"PLANETARY CHART","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Secret Cartographic Data","description":"A map of a nearby planet. A secure site of interest has been marked. Such sites often hold blueprints for new products. Select the map and use Plot Route () to pin the location in your Exosuit display. New maps can be gained by exchanging Navigation Data with a Space Station Cartographer.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.STARCHART.FACTORY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.starchart.factory.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_STARCHART_NAME","descriptionKey":"UI_STARCHART_DESC_SECURE","secondary":"Special","tags":["Consumable"],"baseValue":3200,"level":0,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/STARCHART_A","@type":"GameAsset"},{"id":"STARCHART_B","name":"PLANETARY CHART","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Emergency Cartographic Data","description":"A map of a nearby planet. The coordinates of a distress signal have been marked. Select the map and use Plot Route () to pin the location in your Exosuit display. New maps can be gained by exchanging Navigation Data with a Space Station Cartographer.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.STARCHART.DISTRESSSIGNAL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.starchart.distresssignal.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_STARCHART_NAME","descriptionKey":"UI_STARCHART_DESC_DISTRESS","secondary":"Special","tags":["Consumable"],"baseValue":3200,"level":0,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/STARCHART_B","@type":"GameAsset"},{"id":"STARCHART_C","name":"PLANETARY CHART","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Commercial Cartographic Data","description":"A map of a nearby planet. An inhabited outpost of some kind has been marked. Select the map and use Plot Route () to pin the location in your Exosuit display. New maps can be gained by exchanging Navigation Data with a Space Station Cartographer.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.STARCHART.BUILDING.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.starchart.building.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_STARCHART_NAME","descriptionKey":"UI_STARCHART_DESC_HABITABLE","secondary":"Special","tags":["Consumable"],"baseValue":3200,"level":0,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/STARCHART_C","@type":"GameAsset"},{"id":"STARCHART_D","name":"PLANETARY CHART","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Alien Cartographic Data","description":"A map of a nearby planet. A a relic of an ancient civilisation has been marked. Select the map and use Plot Route () to pin the location in your Exosuit display. New maps can be gained by exchanging Navigation Data with a Space Station Cartographer.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.STARCHART.RUNE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.starchart.rune.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_STAR