RES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.POWERCELL2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.powercell2.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SHIPCHARGE_NAME","descriptionKey":"UI_SHIPCHARGE_DESC","secondary":"Catalyst","tags":["Craftable","Consumable"],"baseValue":500,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SHIPCHARGE","@type":"GameAsset"},{"id":"SALVAGE_TECH10","name":"STARSHIP AI VALVES","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Rare","subtitle":"Starship Subcomponent","description":"A valuable piece of broken down starship, created by a Starship Outfitting Terminal at a Space Station. Component is useful only as scrap to be sold at a Trade Terminal.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.EXOTICS5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.exotics5.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SALVAGE_TECH_10_NAME","descriptionKey":"UI_SALVAGE_TECH_DESC","secondary":"Special","tags":[],"baseValue":12000000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SALVAGE_TECH10","@type":"GameAsset"},{"id":"LAUNCHFUEL","name":"STARSHIP LAUNCH FUEL","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Uncommon","subtitle":"Stabilised Di-hydrogen Fuel","description":"Highly reactive solid-state fuel, required to fuel Starship Launch Thrusters. Created from crystallised Di-hydrogen, found in blue deposits on all worlds.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.LAUNCHFUEL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.launchfuel.webp","colour":"#c01746","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"LAUNCHFUEL_NAME","descriptionKey":"LAUNCHFUEL_DESC","secondary":"Fuel","tags":["Craftabl