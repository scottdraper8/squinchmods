S4","@type":"GameAsset"},{"id":"VEHICLE_SCAN","name":"EXOCRAFT RADAR","kind":"Technology","category":"Exocraft","categoryKey":"Exocraft","rarity":"Impossible","subtitle":"Exocraft Scan Equipment","description":"A large and complex field-based subspace radar. Due to its large power consumption and inherent subatomic instability, this technology must be mounted to an Exocraft. Press to activate the Signal Booster.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/VEHICLE/RENDER.SCAN.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/vehicle/render.scan.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"VEHICLESCAN_NAME","descriptionKey":"VEHICLESCAN_DESC","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/VEHICLE_SCAN","@type":"GameAsset"},{"id":"SUMMON_SUIT","name":"EXOCRAFT SUMMONING UNIT","kind":"Technology","category":"Suit","categoryKey":"Suit","rarity":"Common","subtitle":"Vehicle Translocation Device","description":"A high-powered matter teleportation device, this personal translocator allows any connected Exocraft to be instantly transported to your location, from anywhere in the galaxy. Interfaces with the Exosuit Quick Menu for ease of use.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/TECHNOLOGY.SUITSUMMONER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/technology.suitsummoner.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SUMMON_SUIT_NAME","descriptionKey":"UI_SUMMON_SUIT_DESC","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SUMMON_SUIT","@type":"GameAsset"},{"id":"UP_RBSUIT","name":"Exosuit","kind":"Upgrade module","category":"Protection","categoryKey":"Protection","rarity":"Robot","subtitle":"Salvaged Upgrade Components","description":"A salvaged upgrade for the Exosuit. Use to begin upgrade installation process. Constructed by the Autophage, this technology package is the result of a high degree of engineering improvisation. As a one-of-a-kind piece of repurposed technology, its exact effect upon suit performance is hard to determine prior to installation within the Exosuit's systems.","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_RBSUIT","descriptionKey":"UP_ROBOSUIT_DESC","secondary":"T_ROBOSUIT","tags":["6 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_RBSUIT","@type":"GameAsset"},{"id":"UP_SNSUIT","name":"Exosuit","kind":"Upgrade module","category":"Protection","categoryKey":"Protection","rarity":"Sentinel","subtitle":"Forbidden Exosuit Module","description":"An anomalous upgrade for Exosuit. Use to begin upgrade installation process. This strange fragment of debris has been extracted from Sentinel technology. Its exact effect upon suit performance is impossible to predict before the nantite foam has fully spread within the Exosuit's systems.","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_SENTSUIT","descriptionKey":"UP_SENTSUIT_DESC","secondary":"T_SENTSUIT","tags":["6 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_SNSUIT","@type":"GameAsset"},{"id":"NEW_BACKPACK","name":"EXOSUIT BACKPACK","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Exosuit Visual Enhancement","description":"An exclusive Exosuit Appearance Override. A tough, modular backpack unit. Its styling calls to mind a previous era of exploration. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BACKPACKRETRO.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.backpackretro.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BACKPACK2_NAME","descriptionKey":"UI_BACKPACK2_DESC","secondary":"Exotic","tags":[],"baseValue":3500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/NEW_BACKPACK","@type":"GameAsset"},{"id":"SUIT_INV_TOKEN","name":"EXOSUIT EXPANSION UNIT","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Upgrade Unit","description":"An advanced survival technology module that allows expansion of a user's Exosuit Storage. Pre-packed nano-expanders create stablised sub-warp voids within the Exosuit, increasing its inventory capacity. Apply this augmentation at the Exosuit upgrade terminal on board a Space Station.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.EXOSUITTOKEN.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.exosuittoken.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SUIT_INV_TOKEN_NAME","descriptionKey":"UI_SUIT_INV_TOKEN_DESC","secondary":"Exotic","tags":["Craftable","Consumable"],"baseValue":155000,"level":0,"stackMultiplier":3,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SUIT_INV_TOKEN","@type":"GameAsset"},{"id":"NAV_DATA_DROP","name":"EXOSUIT UPGRADE CHART","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Encrypted Navigation Data","description":"Encoded navigation data which, when properly decrypted, will reveal the location of a Drop Pod containing an Exosuit Inventory Upgrade. Select the coordinates in the inventory and use Plot Route () to pin the location in your Exosuit display.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.STARCHART.DROPPOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.starchart.droppod.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_NAV_DROPPOD_NAME","descriptionKey":"UI_NAV_DROPPOD_DESC","secondary":"Special","tags":["Consumable"],"baseValue":85000,"level":0,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/NAV_DATA_DROP","@type":"GameAsset"},{"id":"EXPD_PETCUST05","name":"EXOTIC ARMOUR","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Companion Accessory","description":"An exclusive Companion Appearance Enhancement. Ideal for fierce-tempered companions, this stylish plate armour protects vital organs against laser and projectile fire. Ultra-soft breathable padding reduces the likelihood of companions wriggling out of the accessory. Earn the trust of wild animals to adopt companions. Interact with companions to customise their appearance.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.PETCUSTOM05.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.petcustom05.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_PET_CUSTOM_05_NAME","descriptionKey":"UI_EXPD_PET_CUSTOM_05_DESC","secondary":"Exotic","tags":[],"baseValue":1600,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_PETCUST05","@type":"GameAsset"},{"id":"SPEC_FISH_BOB2","name":"EXOTIC PLUMAGE FLOAT","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Customised Fishing Equipment","description":"An exclusive Fishing Rig Customisation, altering the appearance of the float. Transform the appearance of your fishing equipment from the fishing rig's bait management page.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.S17.FISHINGF