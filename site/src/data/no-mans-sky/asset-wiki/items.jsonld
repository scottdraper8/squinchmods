":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_DUST09","@type":"GameAsset"},{"id":"BASE_DUST08","name":"SANDSTONE ROCK","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A natural chunk of sedimentary rock, its surface unmarred by tool marks. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BIOMEPROP.DUST08.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.biomeprop.dust08.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DUST08_NAME","descriptionKey":"BLD_DUST08_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_DUST08","@type":"GameAsset"},{"id":"EXPD_EGG_04","name":"SANDWORM EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Titanic Spawn","description":"A living, fertile egg, ready to hatch! Curled within the shell is a hungry wormlet, its coils rippling restlessly. Scans indicate the being within has the genetic potential to be cursed and insatiable.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.WORMPET.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.wormpet.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_EGG_04_NAME","descriptionKey":"UI_EXPD_EGG_04_DESC","secondary":"Exotic","tags":[],"baseValue":3200,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_EGG_04","@type":"GameAsset"},{"id":"BASE_CAVE1","name":"SAUCER FUNGUS","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"This fungal growth, identifiable by its wide, smooth cap and luminescent pores, is native to a variety of cave biomes. Saucer Fungi enjoy a symbiotic relationship with many species of burrowing creatures.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.CAVEPLANT01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.caveplant01.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_CAVEPLANT_1_NAME","descriptionKey":"BLD_CAVEPLANT_1_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_CAVE1","@type":"GameAsset"},{"id":"FOOD_M_REX","name":"SCALY MEAT","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"A nutritious meat product, harvested from the corpse of the creature that once contained it. Process in a Nutrient Processor to generate edible products.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.MEAT.RAW.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.meat.raw.webp","colour":"#bb3830","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_REX_MEAT_NAME","descriptionKey":"FOOD_MEAT_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":1400,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_M_REX","@type":"GameAsset"},{"id":"UT_BUI_SCAN","name":"SCAN HARMONISER","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Impossible","subtitle":"Multi-Tool Upgrade","description":"An attachment for the Multi-Tool Scanner that allows the device to detect and decode the cloaking signal of nearby Autophage units. Use to activate the Scanner. As its detector waveform passes over the local area, it will automatically reveal any nearby Autophage entities.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.BUILDERSSCANMOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.buildersscanmod.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_BUI_SCAN_NAME","descriptionKey":"UI_BUI_SCAN_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/UT_BUI_SCAN","@type":"GameAsset"},{"id":"SCAN1","name":"SCANNER","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Always","subtitle":"Topographic Survey","description":"A Personal Surface Radar augmentation for the Multi-Tool. The Scanner releases a high-energy pulse that reveals any critical survival resources in the immediate area. Data is transmitted via the Exosuit directly into the user's visual nervous system. Press to activate a local scan.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.SCAN.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.scan.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"SCAN1_NAME","descriptionKey":"SCAN1_DESCRIPTION","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SCAN1","@type":"GameAsset"},{"id":"U_SCANNER1","name":"SCANNER MODULE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Rare","subtitle":"Scanning System Upgrade","description":"A moderate upgrade for the Multi-Tool Scanning Systems. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potential upgrades include: scan radius and/or significantly increasing the value of discovery data.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PROCTECH/PROCTECH.C.BINOCS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/proctech/proctech.c.binocs.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UP_SCANNER1_NAME","descriptionKey":"UP_SCANNER1_DESC","secondary":"Special","tags":["Consumable"],"baseValue":60,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/U_SCANNER1","@type":"GameAsset"},{"id":"U_SCANNER2","name":"SCANNER MODULE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Rare","subtitle":"Significant Scanning System Upgrade","description":"A significant upgrade for the Multi-Tool Scanning Systems. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potential upgrades include: scan radius and/or significantly increasing the value of discovery data.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PROCTECH/PROCTECH.B.BINOCS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/proctech/proctech.b.binocs.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UP_SCANNER2_NAME","descriptionKey":"UP_SCANNER2_DESC","secondary":"Special","tags":["Consumable"],"baseValue":140,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/U_SCANNER2","@type":"GameAsset"},{"id":"U_SCANNER3","name":"SCANNER MODULE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Rare","subtitle":"Powerful Scanning System Upgrade","description":"An extremely powerful upgrade for the Multi-Tool Scanning Systems. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potential upgrades include: scan radius and/or significantly increasing the value of discovery data.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PROCTECH/PROCTECH.A.BINOCS.DDS","preview":"/asset-wiki/assets/textures/ui/fr