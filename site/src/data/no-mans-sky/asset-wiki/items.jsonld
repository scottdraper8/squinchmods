:"An exclusive placeable decal, to add flair and decoration to bases. This decal represents the Alliance of Galactic Travellers, and the value of nomadic exploration.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.DECAL11.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.decal11.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_AGT_NAME","descriptionKey":"BLD_DECAL_AGT_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/DECAL_AGT","@type":"GameAsset"},{"id":"SALVAGE_TECHMT5","name":"ALLOY SCRAPS","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Uncommon","subtitle":"Multi-Tool Subcomponent","description":"A valuable piece of recycled Multi-Tool technology, created by a Multi-Tool Decommissioning Terminal aboard the Space Anomaly. Component is useful only as scrap to be sold at a Trade Terminal.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.TECH2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.tech2.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SALVAGE_TECH_MT_5_NAME","descriptionKey":"UI_SALVAGE_TECH_MT_DESC","secondary":"Special","tags":[],"baseValue":3100000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SALVAGE_TECHMT5","@type":"GameAsset"},{"id":"FOOD_P_DUSTWILD","name":"ALOE FLESH","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"An edible plant, harvested from planetary flora. Process in a Nutrient Processor to generate edible products.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.PLANT.DUSTWILD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.plant.dustwild.webp","colour":"#007951",