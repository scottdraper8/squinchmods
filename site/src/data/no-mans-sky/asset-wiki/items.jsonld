tem/technology/EXOPOD_TECH2","@type":"GameAsset"},{"id":"SHIPSLOT_DMG6","name":"DAMAGED GEARS","kind":"Technology","category":"Ship","categoryKey":"Ship","rarity":"Impossible","subtitle":"Damaged Starship Component","description":"Starship subsystem severely damaged. Slot cannot be used for storage or technology until damage is repaired. Use to begin repair process. Core starship functionality is not affected. Repairing this damage will free slot up for general inventory use.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.COMPONENT4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.component4.webp","colour":"#7b0000","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SHIPSLOT_DMG6_NAME","descriptionKey":"UI_SHIPSLOT_DMG_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SHIPSLOT_DMG6","@type":"GameAsset"},{"id":"BLD_SHIPBREAK4","name":"DAMAGED STARSHIP","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive buildable base ornament. The shattered remains of a crashed starship, this shell of a ship has rotted beyond the point of any useful salvage.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.SHIPBREAK4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.shipbreak4.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_SHIPBREAK4_NAME","descriptionKey":"BLD_EXPD_SHIPBREAK_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BLD_SHIPBREAK4","@type":"GameAsset"},{"id":"WEAPSLOT_DMG3","name":"DAMAGED WIRING","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Impossible","subtitle":"Damaged Multi-Tool Component","description":"Multi-Tool subsystem critically damaged. Slot cannot be used until damage is repaired. Use to begin repair process. Repairing will free slot up for general use.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.TECH1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.tech1.webp","colour":"#7b0000","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_WEAPSLOT_DMG3_NAME","descriptionKey":"UI_WEAPSLOT_DMG_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/WEAPSLOT_DMG3","@type":"GameAsset"},{"id":"BASE_DUST11","name":"DANCER TREE","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A domesticated variety of desert tree, prized for the twirling, sculpted quality of its trunk. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BIOMEPROP.DUST11.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.biomeprop.dust11.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DUST11_NAME","descriptionKey":"BLD_DUST11_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_DUST11","@type":"GameAsset"},{"id":"FISHBAIT_DAY","name":"DANGLING ORB","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Fishing Bait","description":"A specialist lure, designed to attract diurnal fish. Locate your Fishing Rig and begin bait application with .","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.FISHBAIT.DAY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.fishbait.day.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_BAIT_DAY_NAME","descriptionKey":"UI_FISH_BAIT_DAY_DESC","secondary":"Special","tags":["Craftable","Consumable"],"baseValue":550,"level":0,"stackMultiplier":50,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FISHBAIT_DAY","@type":"GameAsset"},{"id":"ATLAS_SEED_4","name":"DARK MATTER","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Unique valuable curiosity","description":"An Atlas Seed shell encompassing a void element harvested from the collapse state of the last universe. Toxic if ingested.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/ATLASSEED.4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/atlasseed.4.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"ATLAS_SEED_4_NAME","descriptionKey":"ATLAS_SEED_4_DESC","secondary":"Stellar","tags":["Craftable","Consumable"],"baseValue":1000,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ATLAS_SEED_4","@type":"GameAsset"},{"id":"TWITCH_GUN21","name":"DARNY'S OXIDE ENTANGLER","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Multifunction Survival Device","description":"An exclusive Multi-Tool. This experimental weapon comes with highly upgraded, lucrative scanner technology pre-installed. Take this Multi-Tool to add it to your collection, or Exchange it with your current Multi-Tool. Swap between active Multi-Tools from the Utilities section of the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.GUN21.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.gun21.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_GUN_21_NAME","descriptionKey":"UI_TWIT_GUN_21_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_GUN21","@type":"GameAsset"},{"id":"BLD_DATASIGN","name":"DATA DISPLAY UNIT","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Dynamic Signpost","description":"An arrangement of dynamic glass panels, each filled with undoubtedly useful and valuable information. This display unit also functions as a source of illumination.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.DATASIGN.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.datasign.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DATASIGN_NAME","descriptionKey":"BLD_DATASIGN_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BLD_DATASIGN","@type":"GameAsset"},{"id":"HULK_BLACKBOX","name":"DATA PACKET","kind":"Product","category":"Space Salvage","categoryKey":"SpaceSalvage","rarity":"Rare","subtitle":"Specialist Salvage Material","description":"Still sealed, this is an extremely valuable piece of industrial salvage. Harvested from the decaying remains of a collapsing space hulk. This has been processed at a deep-space outpost, and can be sold on the open market.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.2026.HULK.BLACKBOX.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.2026.hulk.blackbox.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_HULK_BLACKBOX_NAME","descriptionKey":"UI_HULK_RARE_DESC","secondary":"Exotic","tags":["Craftable","Cooking ingredient"],"baseValue":185000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/HULK_BLACKBOX","@type":"GameAsset"},{"id":"ATLAS_SEED_5","name":"DAWN'S END","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Unique valuable curiosity","description":"Sculpted tau neutrino-boson matrix fixed within an irreplaceable Atlas Seed shell. May be semi-sentient.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/ATLASSEED.5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/atlasseed.5.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"ATLAS_SEED_5_NAME","descriptionKey":"ATLAS_SEED_5_DESC","secondary":"Stellar","tags":["Craftable","Consumable"],"baseValue":1000,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ATLAS_SEED_5","@type":"GameAsset"},{"id":"BUI_HEAD_5","name":"DE-INDUSTRIALISED CASING","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Rare","subtitle":"Autophage Appearance Modification","description":"An exclusive Exosuit Appearance Override, granted by the Autophage to those who seek to build their own shell. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/ROBOTPARTS/ROBOTPARTS.HEAD.5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/robotparts/robotparts.head.5.webp","colour":"#8c4b9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TIP_HEAD_BUI_5_U","descriptionKey":"UI_BUILDER_CUSTOM_DESC","secondary":"Exotic","tags":[],"baseValue":999,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BUI_HEAD_5","@type":"GameAsset"},{"id":"F_DEEP_COM_S1","name":"DE-PRESSURISED BLOB","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_DEEP_COM_S_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.SMALL.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.small.2.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_DEEP_COM_S1_NAME","descriptionKey":"UI_FISH_DEEP_COM_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":1000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_DEEP_COM_S1","@type":"GameAsset"},{"id":"TRA_EXOTICS1","name":"DE-SCENTED BOTTLES","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Trade Goods (Scientific)","description":"A loose collection of recycled pheromone bottles. Vast quantities of pheromones are produced and distributed every day. This has spawned a lucrative trading opportunity for those willing to deal with the waste products. These glass jars have been thoroughly scrubbed and should pose no threat to the carrier.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.EXOTICS1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.exotics1.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TRADE_ITEM_EXOTICS_1_NAME","descriptionKey":"UI_TRADE_ITEM_EXOTICS_1_DESC","secondary":"Exotic","tags":["Trade good"],"baseValue":1000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TRA_EXOTICS1","@type":"GameAsset"},{"id":"FOOD_ICE_FIEND","name":"DEATHLY-COLD ICE CREAM","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.ICECREAM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.icecream.webp","colour":"#6ad01e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_ICE_FIEND_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":128000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_ICE_FIEND","@type":"GameAsset"},{"id":"BIGGS_POI_LOC","name":"DEBRIS RANGEFINDER","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Deep-Space Salvage Locator","description":"A single-use device for locating the wreckage of starships in deep space. Select the Rangefinder and Scan for Debris () to begin the location process.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.LOCATOR.BIGGSPOI.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.locator.biggspoi.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BIGGS_POI_LOC_NAME","descriptionKey":"UI_BIGGS_POI_LOC_DESC","secondary":"Special","tags":["Craftable","Consumable"],"baseValue":3200,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BIGGS_POI_LOC","@type":"GameAsset"},{"id":"SET_DEBT_NEG","name":"Debt","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Reward Item","description":"Currency or faction standing, given as a reward.","icon":"TEXTURES/UI/FRONTEND/ICONS/SETTLEMENT/NEGATIVEPRODUCTION.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/settlement/negativeproduction.webp","colour":"#7b0000","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_SETTLEMENT_STAT_DEBT","descriptionKey":"UI_REWARDPOP_DESC","secondary":"Substance","tags":[],"baseValue":20,"level":null,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/SET_DEBT_NEG","@type":"GameAsset"},{"id":"SET_DEBT_POS","name":"Debt","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Reward Item","description":"Currency or faction standing, given as a reward.","icon":"TEXTURES/UI/FRONTEND/ICONS/SETTLEMENT/POSITIVEPRODUCTION.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/settlement/positiveproduction.webp","colour":"#8a7f72","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_SETTLEMENT_STAT_DEBT","descriptionKey":"UI_REWARDPOP_DESC","secondary":"Substance","tags":[],"baseValue":20,"level":null,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/SET_DEBT_POS","@type":"GameAsset"},{"id":"TRA_TECH1","name":"DECOMMISSIONED CIRCUITS","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Trade Goods (Technology)","description":"A collection of salvaged circuitry. Power generation economies go through vast numbers of high-tech components. As such, the demand is present even for highly damaged circuits, to be scavenged for parts or just plugged wholesale into low-quality power cores.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.TECH1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.tech1.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TRADE_ITEM_TECH_1_NAME","descriptionKey":"UI_TRADE_ITEM_TECH_1_DESC","secondary":"Exotic","tags":["Trade good"],"baseValue":1000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TRA_TECH1","@type":"GameAsset"},{"id":"TRA_COMMODITY1","name":"DECRYPTED USER DATA","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Trade Goods","description":"A crate packed with hard drives, each of which contain vast amounts of decrypted user data. Individually of low value, taken together these repositories can be processed and scanned for valuable data. This processing occurs in systems with advanced material economies.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.COMMODITY1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.commodity1.webp","colour":"#cccccc","source":"NMS_REALITY_GCPR