ier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/U_SHOTGUN4","@type":"GameAsset"},{"id":"BAIT_VEG_1","name":"SCENTED HERBS","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Herbivore Bait","description":"A specialist bait for herbivores. Use the Analysis Visor to discover the bait preferences of specific creatures. Created in a Nutrient Processor from Faecium and harvestable plants. Can be further processed in the Nutrient Processor to create new bait types. Feeding using the correct bait will allow creatures to be ridden or harvested. Chose bait type from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.BAIT.HERBS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.bait.herbs.webp","colour":"#007953","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BAIT_VEG_1_NAME","descriptionKey":"BAIT_VEG_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BAIT_VEG_1","@type":"GameAsset"},{"id":"FOOD_M_MOLE","name":"SCOOPED INNARDS","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"A nutritious meat product, harvested from the corpse of the creature that once contained it. Process in a Nutrient Processor to generate edible products.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.MEAT.OFFAL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.meat.offal.webp","colour":"#bb3830","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_MOLE_MEAT_NAME","descriptionKey":"FOOD_MEAT_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":1400,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_M_MOLE","@type":"GameAsset"},{"id":"SHIPSLOT_DMG11","name":"SCORCHED PLATING","kind":"Technology","category":"Ship","categoryKey":"Ship","rarity":"Impossible","subtitle":"Damaged Starship Component","description":"Starship subsystem severely damaged. Slot cannot be used for storage or technology until damage is repaired. Use to begin repair process. Core starship functionality is not affected. Repairing this damage will free slot up for general inventory use.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/FARMPROD.5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/farmprod.5.webp","colour":"#7b0000","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SHIPSLOT_DMG11_NAME","descriptionKey":"UI_SHIPSLOT_DMG_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SHIPSLOT_DMG11","@type":"GameAsset"},{"id":"JETS_FIRE","name":"SCORCHING JETPACK TRAIL","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Jetpack Exhaust Override","description":"An exclusive Exosuit Appearance Override. Pressurised jets breathe additional oxygen into the Jetpack flames, brightening and lengthening the exhaust trail. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.JETS.FIRE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.jets.fire.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_JETTRAIL_FIRE_NAME","descriptionKey":"UI_JETTRAIL_FIRE_DESC","secondary":"Exotic","tags":[],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/JETS_FIRE","@type":"GameAsset"},{"id":"FOOD_S_HOT","name":"SCORCHING SAUCE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A consumable liquid, created in the Nutrient Processor. Prized across the galaxy for its pleasing mouth-feel and authentically natural flavours. Can be ingested as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.SAUCE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.sauce.webp","colour":"#db2400","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_S_HOT_NAME","descriptionKey":"FOOD_DRINK_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":7200,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_S_HOT","@type":"GameAsset"},{"id":"F_TOX_EPIC_M1","name":"SCORPIONFISH","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Rare Fish","description":"UI_FISH_TOX_EPIC_M_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.SMALL.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.small.1.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_TOX_EPIC_M1_NAME","descriptionKey":"UI_FISH_TOX_EPIC_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":20000,"level":3,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_TOX_EPIC_M1","@type":"GameAsset"},{"id":"FOOD_EGGPIE_B","name":"SCRAMBLED MARROW","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.OMLETTE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.omlette.webp","colour":"#f26d15","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_EGGPIE_BONE_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":24000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_EGGPIE_B","@type":"GameAsset"},{"id":"S_POSTER29","name":"SCRAMBLED SIGNAL POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster represents fragments of many long-distance communication signals between the dominant factions of the universe.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.S_POSTER29.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.s_poster29.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_S_POSTER29_NAME","descriptionKey":"BLD_S_POSTER29_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S_POSTER29","@type":"GameAsset"},{"id":"SHIELD_ALIEN","name":"SCREAM SUPPRESSOR","kind":"Technology","category":"Alien Ship","categoryKey":"AlienShip","rarity":"Always","subtitle":"Fused Organic Technology","description":"This small extension to the ship's automated defense network appears to be its own autonomous organism. A small mouth in the centre of its flesh hungers for Pugneum. During combat, it seems to hijack the neurological array and prevent fear or pain from traumatising the rest of the ship's body.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/BIOTECH.SCALES.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/biotech.scales.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"