":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Cake Batter.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.CAKE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.cake.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_CK_CARM_NAME","descriptionKey":"UI_CAKE_DESC_CK","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":52800,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_CK_CARM","@type":"GameAsset"},{"id":"FOOD_MM_CARM","name":"CARAMELISED NIGHTMARE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Writhing, Roiling Batter. Some caution is advised.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.TARTEVIL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.tartevil.webp","colour":"#6ad01e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_MM_CARM_NAME","descriptionKey":"UI_CAKE_DESC_MM","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":128000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_MM_CARM","@type":"GameAsset"},{"id":"FUEL1","name":"CARBON","kind":"Resource","category":"Fuel","categoryKey":"Fuel","rarity":"Common","subtitle":"Unrefined Organic Element","description":"The building block of all organic life. Of critical importance to space travellers, as Carbon is used to recharge mining equipment. The Mining Laser will harvest Carbon from trees, plants, and all other forms of vegetable.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.FUEL.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.fuel.1.webp","colour":"#bb3830","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_FUEL_1_NAME","descriptionKey":"UI_FUEL_1_DESC","secondary":"Substance","tags":["Cooking ingredient"],"baseValue":12,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/FUEL1","@type":"GameAsset"},{"id":"FUELPROD3","name":"CARBON CRYSTAL","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Concentrated Carbon Deposit","description":"Hyper-compressed carbon, this substance's dense nanostructure makes it highly valuable as both an energy source and a technology component. Synthesised from Condensed Carbon.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.FUELPROD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.fuelprod.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FUELPROD3_NAME","descriptionKey":"UI_FUELPROD3_DESC","secondary":"Exotic","tags":[],"baseValue":3600,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FUELPROD3","@type":"GameAsset"},{"id":"NANOTUBES","name":"CARBON NANOTUBES","kind":"Product","category":"Component","categoryKey":"Component","rarity":"Common","subtitle":"Crafted Technology Component","description":"Metres and metres of high capacity carbon nanotubes. Their high tensile strength and mild conductivity make these a key component in many advanced technologies.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.NANOTUBES.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.nanotubes.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"NANOTUBES_NAME","descriptionKey":"NANOTUBES_DESC","secondary":"Catalyst","tags":["Craftable","Cooking ingredient"],"baseValue":500,"level":0,"stackMultiplier":2,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/NANOTUBES","@type":"GameAsset"},{"id":"BASE_HOTPLANT07","name":"CARBON VINE","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A freestanding vine with a naturally gritty, powder-like texture to its leaves. Smells of bonfire and charcoal. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BIOMEPROP.HOTPLANT07.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.biomeprop.hotplant07.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_HOTPLANT_7_NAME","descriptionKey":"BLD_HOTPLANT_7_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_HOTPLANT07","@type":"GameAsset"},{"id":"FREI_INV_TOKEN","name":"CARGO BULKHEAD","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Auto-Expanding Freighter Module","description":"A technology module harvested from the remains of an abandoned freighter found floating in space. May also be salvaged during frigate expeditions. Pre-packed nano-expanders fill out this portable unit and graft it to an existing freighter, increasing its inventory capacity. Apply at your freighter's Upgrade Terminal.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.CARGOTOKEN.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.cargotoken.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FREIGHT_INV_TOKEN_NAME","descriptionKey":"UI_FREIGHT_INV_TOKEN_DESC","secondary":"Exotic","tags":["Craftable","Consumable"],"baseValue":105000,"level":0,"stackMultiplier":3,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FREI_INV_TOKEN","@type":"GameAsset"},{"id":"CARGOSHIELD","name":"CARGO SCAN DEFLECTOR","kind":"Technology","category":"All Ships Except Alien","categoryKey":"AllShipsExceptAlien","rarity":"VeryRare","subtitle":"Anti-Probe Countermeasures","description":"A specially tuned resonance jammer, designed to interfere with the remote cargo scans deployed by system authorities in the search for smuggled goods. Deploy from the Quick Menu () while a scan is in progress to deflect the probe. Note: jamming is not 100% effective.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.CARGOSHIELD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.cargoshield.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SCAN_BLOCKER_NAME","descriptionKey":"UI_SCAN_BLOCKER_DESC","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":4,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/CARGOSHIELD","@type":"GameAsset"},{"id":"CV_INV1","name":"cargo systems","kind":"Upgrade module","category":"Mining","categoryKey":"Mining","rarity":"Normal","subtitle":"UP_CRUI_SUB","description":"UT_CR_MINE_DESC","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UT_CR_MINE_NAME","descriptionKey":"UT_CR_MINE_DESC","secondary":"T_CR_INV","tags":["1 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/CV_INV1","@type":"GameAsset"},{"id":"CV_INV2","name":"cargo systems","kind":"Upgrade module","category":"Mining","categoryKey":"Mining","rarity":"Rare","subtitle":"UP_CRUI_SUB","description":"UT_CR_MINE_DESC","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UT_CR_MINE_NAME","descriptionKey":"UT_CR_MINE_DESC","secondary