2","@type":"GameAsset"},{"id":"FOOD_F_PIE","name":"MARINE PIE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A slab of seafood, created in the Nutrient Processor. Food such as this can be highly valuable. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.TART.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.tart.webp","colour":"#095c77","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_FOOD_PIE_NAME","descriptionKey":"UI_FISH_FOOD_LARGE_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":52500,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_F_PIE","@type":"GameAsset"},{"id":"BASE_ROCK01","name":"MARINE ROCK","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A pleasing mineral formation, crystalised from oceanic salts. May also contain aquatic fossils and/or lifeforms. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.ROCK01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.rock01.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_ROCK_1_NAME","descriptionKey":"BLD_ROCK_1_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_ROCK01","@type":"GameAsset"},{"id":"FOOD_F_LARGE1","name":"MARINE STEAK","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A slab of seafood, created in the Nutrient Processor. Food such as this can be highly valuable. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.FISH.TUNA.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.fish.tuna.webp","colour":"#095c77","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_FOOD_LARGE_1_NAME","descriptionKey":"UI_FISH_FOOD_LARGE_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":35400,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_F_LARGE1","@type":"GameAsset"},{"id":"DENYSUIT","name":"MARK OF THE DENIER","kind":"Technology","category":"Suit","categoryKey":"Suit","rarity":"Impossible","subtitle":"Priceless Fragment","description":"A tiny mote of stardust, no more than a speck. On closer examination, its surface is all crystalline shards and distorted crimson geometry. It flickers with pent-up energy, demanding to be free. Empower the mark as you discover systems, planets and objects across the universe.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.HERETICCORE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.hereticcore.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"DENIER_ITEM_NAME","descriptionKey":"DENIER_ITEM_DESC","secondary":"Installable","tags":["Chargeable","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/DENYSUIT","@type":"GameAsset"},{"id":"PLANT_CAVE","name":"MARROW BULB","kind":"Resource","category":"Flora","categoryKey":"Flora","rarity":"Uncommon","subtitle":"Harvested Agricultural Substance","description":"A glowing organic bulb, harvested from the Cave Marrow plant found growing underground. The Cave Marrow has proved resistant to domestication, and no farmable cultivars are known to exist. As such, marrow bulbs must be harvested by hand in the wild.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.PLANT.CAVE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.plant.cave.webp","colour":"#5b6f35","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_PLANTSUB_CAVE_NAME","descriptionKey":"UI_PLANTSUB_CAVE_DESC","secondary":"Substance","tags":["Cooking ingredient"],"baseValue":41,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/PLANT_CAVE","@type":"GameAsset"},{"id":"FOOD_P_CAVE","name":"MARROW FLESH","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"An edible plant, harvested from planetary flora. Process in a Nutrient Processor to generate edible products.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.PLANT.CAVEWILD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.plant.cavewild.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_PLANT_CAVE_NAME","descriptionKey":"FOOD_PLANT_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":1400,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_P_CAVE","@type":"GameAsset"},{"id":"F_LUSH_RARE_L1","name":"MARROW SHARK","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Uncommon Fish","description":"UI_FISH_LUSH_RARE_L_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.SHARK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.shark.webp","colour":"#2177c8","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_LUSH_RARE_L1_NAME","descriptionKey":"UI_FISH_LUSH_RARE_L_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":10000,"level":2,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_LUSH_RARE_L1","@type":"GameAsset"},{"id":"UT_RAIL","name":"MASS ACCELERATOR","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Common","subtitle":"Blaze Javelin Upgrade","description":"Extends the firing chamber of the Blaze Javelin, allowing the internal particle accelerators to reach both greater mass and speed. Significantly improves weapon damage.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.BLAZEJAVELINMOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.blazejavelinmod.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_RAIL_NAME","descriptionKey":"UT_RAIL_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/UT_RAIL","@type":"GameAsset"},{"id":"MAINT_FRIG7","name":"MASTER CIRCUIT","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Damaged Component","description":"The control circuit for all the other components in the device. Damage to this circuitry is fatal.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/MEGAPROD.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/megaprod.2.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINTAIN_TECH18_NAME","descriptionKey":"UI_MAINTAIN_TECH18_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_FRIG7","@type":"GameAsset"},{"id":"MAINT_TECH18","name":"MASTER CIRCUIT","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Damaged Component","description":"The control circuit for all the other components in the device. Damage to this circuitry is fatal.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/MEGAPROD.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/megaprod.2.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINTAIN_TECH18_NAME","descriptionKey":"UI_MAINTAIN_TECH18_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_TECH18","@type":"GameAsset"},{"id":"F_TELEPORT","name":"MATTER BEAM","kind":"Technology","category":"Freighter","categoryKey":"Freighter","rarity":"Impossible","subtitle":"Freighter-Mounted Teleportation Device","description":"A device that modulates standard freighter communication signals to enable the interplanetary transport of matter as well as data. Freighters fitted with such a device can send and receive products and substances to a user's Exosuit over a long distance.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4TECH/RENDER.FREIGHTERTELEPORT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4tech/render.freighterteleport.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"FREIGHTER_TELEPORT_NAME","descriptionKey":"FREIGHTER_TELEPORT_DESC","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/F_TELEPORT","@type":"GameAsset"},{"id":"BIOSHIP_GROWTH2","name":"MATURE HEART NODE","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Living Starship Organ","description":"Powerful and muscular, this bionic pump sits within a network of synthetic tubes. It twitches when touched, its rhythms sensitive to the presence of other thinking entities. It awaits its host.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/BIOTECH.HEART.MOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/biotech.heart.mod.webp","colour":"#1e2328","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BIOSHIP_GROWTH2_NAME","descriptionKey":"UI_BIOSHIP_GROWTH2_DESC","secondary":"Exotic","tags":[],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BIOSHIP_GROWTH2","@type":"GameAsset"},{"id":"BIOSHIP_GROWTH1","name":"MATURE NEURAL STEM","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Living Starship Organ","description":"This web of living tissue has grown its own metallic filaments, a mesh of silver and flesh. It crackles with its own electric charge, a network in need of its nodes. It awaits its host.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/BIOTECH.BRAIN.MOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/biotech.brain.mod.webp","colour":"#1e2328","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BIOSHIP_GROWTH1_NAME","descriptionKey":"UI_BIOSHIP_GROWTH1_DESC","secondary":"Exotic","tags":[],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BIOSHIP_GROWTH1","@type":"GameAsset"},{"id":"BASE_FLORAL02","name":"MATURE TASSEL LILY","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A small, attractive plant, native to humid climates. This petalled variety is in the mature stage of blooming. The dewy \"tassels\" radiate a gentle light, attracting nocturnal pollinators. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BIOMEPROP.FLORAL02.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.biomeprop.floral02.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_FLORAL_2_NAME","descriptionKey":"BLD_FLORAL_2_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,