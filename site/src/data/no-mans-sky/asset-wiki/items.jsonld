uct/FOOD_P_COLDFARM","@type":"GameAsset"},{"id":"TWITCH_GUN27","name":"GLEAMING LIGHT INJECTOR","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Multifunction Survival Device","description":"An exclusive Multi-Tool. This A-class weapon comes equipped with a range of pre-installed technologies and upgrades. Take this Multi-Tool to add it to your collection, or Exchange it with your current Multi-Tool. Swap between active Multi-Tools from the Utilities section of the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/TWITCH.GUN27.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/twitch.gun27.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_GUN_27_NAME","descriptionKey":"UI_TWIT_GUN_GENERIC_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_GUN27","@type":"GameAsset"},{"id":"FOOD_CK_HONEY","name":"GLITTERING HONEY CAKE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Cake Batter.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.CAKE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.cake.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_CK_HONEY_NAME","descriptionKey":"UI_CAKE_DESC_CK","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":50100,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_CK_HONEY","@type":"GameAsset"},{"id":"BASE_HOTPLANT02","name":"GLOBE TREE","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A thin tree with a large, fleshy root system, well adapted to hot climates. Root bulb may be tapped for a source of drinkable liquid, but this is not advised outside of the most dire circumstances.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.HOTPLANT02.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.hotplant02.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_HOTPLANT_2_NAME","descriptionKey":"BLD_HOTPLANT_2_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_HOTPLANT02","@type":"GameAsset"},{"id":"F_RAD_COM_L1","name":"GLOWING CATFISH","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_RAD_COM_L_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT4.FISH.BIG.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product4.fish.big.1.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_RAD_COM_L1_NAME","descriptionKey":"UI_FISH_RAD_COM_L_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":3000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_RAD_COM_L1","@type":"GameAsset"},{"id":"EXPD_EGG_16","name":"GLOWING EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Bioluminescent Spawning Sac","description":"A living, fertile egg, ready to hatch! A living fire burns within the egg, the haunting pale glow of a lifeform that must provide its own light. Scans indicate the being within has the genetic potential to be gelatinous and luminescent.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S16.PET.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s16.pet.webp","colour":"#4d2987","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_EGG_16_NAME","descriptionKey":"UI_EXPD_EGG_16_DESC","secondary":"Exotic","tags":[],"baseValue":3200,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_EGG_16","@type":"GameAsset"},{"id":"GEODE_RARE","name":"GLOWING MINERAL","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Valuable Rock Sample","description":"Though its surface is dirtied and dull, polishing this rock reveals a deep inner glow, a glitter beneath a subtly iridescent surface. Select in the Inventory () and crack open with .","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.WATERPROD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.waterprod.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_GEODE_RARE_NAME","descriptionKey":"UI_GEODE_RARE_DESC","secondary":"Special","tags":["Consumable"],"baseValue":3200,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/GEODE_RARE","@type":"GameAsset"},{"id":"FOOD_PIE_GLOW","name":"GLOWING PIE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.VEGPIE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.vegpie.webp","colour":"#007953","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_PIE_GLOW_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseVa