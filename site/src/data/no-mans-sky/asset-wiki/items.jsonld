nder.jetpackmod.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_JUMP_NAME","descriptionKey":"UT_JUMP_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/UT_JUMP","@type":"GameAsset"},{"id":"SHIPROCKETS","name":"ROCKET LAUNCHER","kind":"Technology","category":"All Ships Except Alien","categoryKey":"AllShipsExceptAlien","rarity":"Common","subtitle":"Long Range Starship Weapon","description":"A long range starship weapon, capable of delivering a highly explosive torpedo across massive distances. Note: explosive damage is highly effective against unshielded targets, but ineffective against shielded targets. Use to change weapon mode. Press to fire.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.ROCKET.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.rocket.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"SHIP_ROCKETS_NAME","descriptionKey":"SHIP_ROCKETS_DESC","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":2,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SHIPROCKETS","@type":"GameAsset"},{"id":"F_ALL_COM_M2","name":"ROCKFIN","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_ALL_COM_M_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.MEDIUM.3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.medium.3.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_ALL_COM_M2_NAME","descriptionKey":"UI_FISH_ALL_COM_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":2000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_ALL_COM_M2","@type":"GameAsset"},{"id":"FOOD_J_ALL3","name":"ROOT JUICE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A consumable liquid, created in the Nutrient Processor. Prized across the galaxy for its pleasing mouth-feel and authentically natural flavours. Can be ingested as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.SAUCE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.sauce.webp","colour":"#79502e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_J_ALL3_NAME","descriptionKey":"FOOD_DRINK_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":1800,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_J_ALL3","@type":"GameAsset"},{"id":"SPEC_PETCUST1","name":"ROUNDED LASER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Companion Accessory","description":"An exclusive Companion Appearance Enhancement. This articulated mining laser is insulated with a lightweight gel, ensuring ultimate comfort for companions assisting with resource harvesting. Earn the trust of wild animals to adopt companions. Interact with companions to customise their appearance.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.PETCUSTOM1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.petcustom1.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SPEC_PET_CUSTOM_01_NAME","descriptionKey":"UI_SPEC_PET_CUSTOM_01_DESC","secondary":"Exotic","tags":[],"baseValue":1600,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_PETCUST1","@type":"GameAsset"},{"id":"S22_FRAG_R","name":"ROYAL ECHO","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Lingering Soul Fragment","description":"A ghostly fragment of Traveller soul, lingering where it no longer belongs. Data containing the royal aspect of the Starship %SHIPNAME%'s previous owner.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.2026.S22_FRAG_R.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.2026.s22_frag_r.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S22_FRAG_R_NAME","descriptionKey":"UI_S22_FRAG_R_DESC","secondary":"Special","tags":["Craftable"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S22_FRAG_R","@type":"GameAsset"},{"id":"BANNER_RSS","name":"ROYAL SPACE SOCIETY BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Equip this exclusive Personal Flair to represent the Royal Space Society: a collaborative exploration community and refuge for Spanish-speaking Travellers. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BANNER.RSS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.banner.rss.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_RSS_NAME","descriptionKey":"UI_BANNER_RSS_DESC","secondary":"BuildingPart","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BANNER_RSS","@type":"GameAsset"},{"id":"DECAL_RSS","name":"ROYAL SPACE SOCIETY DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This emblem represents the Royal Space Society: a collaborative exploration community and refuge for Spanish-speaking Travellers.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.DECAL.RSS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.decal.rss.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_RSS_NAME","descriptionKey":"BLD_DECAL_RSS_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/DECAL_RSS","@type":"GameAsset"},{"id":"TEAM_RED","name":"ROYALS","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Reward Item","description":"Currency or faction standing, given as a reward.","icon":"TEXTURES/UI/FRONTEND/ICONS/SWARM/TEAM01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/swarm/team01.webp","colour":"#dedcd1","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_SWARMPAGE_TEAM_RED","descriptionKey":"UI_REWARDPOP_DESC","secondary":"Substance","tags":[],"baseValue":20,"level":null,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/TEAM_RED","@type":"GameAsset"},{"id":"SWARM_FLAG_R1","name":"ROYALS FLAG","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An ornamental flag for base decoration, celebrating the Royal fragment of the Traveller soul.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S22.FLAGR1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s22.flagr1.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_SWARM_FLAG_R1_NAME","descriptionKey":"BLD_SWARM_FLAG_R_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SWARM_FLAG_R1","@type":"GameAsset"},{"id":"EXPD_POSTER22A","name":"ROYALS POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster depicts the Royal fragment of the Traveller soul. A muse, a leader, a being of innate grace and courage. These worlds were made for you...","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S22.POSTERA.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s22.postera.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER22A_NAME","descriptionKey":"BLD_EXPD_POSTER22A_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER22A","@type":"GameAsset"},{"id":"BASE_JUNGLE01","name":"RUBBER PLANT ROCK","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"This nutrient-rich rock was mined from a dense jungle, and hosts a small colony of of rubber plants. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BIOMEPROP.JUNGLE01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.biomeprop.jungle01.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_JUNGLE01_NAME","descriptionKey":"BLD_JUNGLE01_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_JUNGLE01","@type":"GameAsset"},{"id":"BLD_SHIPBREAK1","name":"RUINED STARSHIP","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive buildable base ornament. The shattered remains of a crashed starship, this shell of a ship has rotted beyond the point of any useful salvage.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.SHIPBREAK1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.shipbreak1.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_SHIPBREAK1_NAME","descriptionKey":"BLD_EXPD_SHIPBREAK_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BLD_SHIPBREAK1","@type":"GameAsset"},{"id":"SPACEGUNK2","name":"RUNAWAY MOULD","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Common","subtitle":"Junk","description":"An out of control mould growth that builds up in poorly-maintained machinery. Likely to be several different species of mould, merged together into one super-colony.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/SPACEGUNK.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/spacegunk.2.webp","colour":"#5b6f35","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_MAINTAIN_SUB2_NAME","descriptionKey":"UI_MAINTAIN_SUB2_DESC","secondary":"Substance","tags":[],"baseValue":20,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/SPACEGUNK2","@type":"GameAsset"},{"id":"STAFF_POLE6","name":"RUNIC BEAM","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Autophage Staff Backbone","description":"This long pole forms the backbone of a traditional Autophage staff. One of three core components, this can be assembled into a staff at the Autophage Synthesis Terminal found at all Autophage camps.","icon":"TEXTURES/UI/FRONTEND/ICONS/ROBOTPARTS/ROBOTPARTS.STAFFPOLE.6.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/robotparts/robotparts.staffpole.6.webp","colour":"#8c4b9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_STAFF_POLE6_NAME","descriptionKey":"UI_STAFF_POLE_DESC","secondary":"Special","tags":[],"baseValue":333,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/STAFF_POLE6","@type":"GameAsset"},{"id":"STAFF_CORE6","name":"RUNIC CORE","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Autophage Staff Core","description":"This tightly-package electronic unit forms the core of a Autophage staff. One of three core components, this can be assembled into a staff at the Autophage Synthesis Terminal found at all Autophage camps.","icon":"TEXTURES/UI/FRONTEND/ICONS/ROBOTPARTS/ROBOTPARTS.STAFFCORE.6.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/robotparts/robotparts.staffcore.6.webp","colour":"#8c4b9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_STAFF_CORE6_NAME","descriptionKey":"UI_STAFF_CORE_DESC","secondary":"Special","tags":[],"baseValue":646,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/STAFF_CORE6","@type":"GameAsset"},{"id":"STAFF_HEAD6","name":"RUNIC FOCUS","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Autophage Staff Head","description":"This ornate centerpiece forms the head of a Autophage staff. One of three core components, this can be assembled into a staff at the Autophage Synthesis Terminal found at all Autophage camps.","icon":"TEXTURES/UI/FRONTEND/ICONS/ROBOTPARTS/ROBOTPARTS.STAFFHEAD.6.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/robotparts/robotparts.staffhead.6.webp","colour":"#8c4b9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_STAFF_HEAD6_NAME","descriptionKey":"UI_STAFF_HEAD_DESC","secondary":"Special","tags":[],"baseValue":999,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/STAFF_HEAD6","@type":"GameAsset"},{"id":"ATLAS_LASER","name":"RUNIC LENS","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Impossible","subtitle":"Geometric Anomaly","description":"The geometric heart of this ancient weapon is the Runic Lens. Its impossible geometry not only concentrates light into a high-powered Mining Laser, but can also warp the local electromagnetic field so as to render the user invisible. Powered by Carbon-based Elements. Fire the beam with . Select its secondary cloaking function with and hold to activate.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/TECH.ATLASLASER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/tech.atlaslaser.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_ATLAS_LASER_NAME","descriptionKey":"UI_ATLAS_LASER_NAME_DESC","secondary":"Core","tags":["Core technology","Chargeable","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/ATLAS_LASER","@type":"GameAsset"},{"id":"SHIPEASY_DMG2","name":"RUSTED CIRCUITS","kind":"Technology","category":"Ship","categoryKey":"Ship","rarity":"Impossible","subtitle":"Damaged Starship Component","description":"Starship subsystem severely damaged. Slot cannot be used for storage or technology until damage is repaired. Use to begin repair process. Core starship functionality is not affected. Repairing this damage will free slot up for general inventory use.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.TECH1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.tech1.webp","colour":"#7b0000","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SHIPSLOT_DMG2_NAME","descriptionKey":"UI_SHIPSLOT_DMG_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SHIPEASY_DMG2","@type":"GameAsset"},{"id":"SHIPSLOT_DMG2","name":"RUSTED CIRCUITS","kind":"Technology","category":"Ship","categoryKey":"Ship","rarity":"Impossible","subtitle":"Damaged Starship Component","description":"Starship subsystem severely damaged. Slot cannot be used for storage or technology until damage is repaired. Use to begin repair process. Core starship functionality is not affected. Repairing this damage will free slot up for general inventory use.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/SPACEGUNK.3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/spacegunk.3.webp","colour":"#7b0000","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SHIPSLOT_DMG2_NAME","descriptionKey":"UI_SHIPSLOT_DMG_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SHIPSLOT_DMG2","@type":"GameAsset"},{"id":"SPACEGUNK3","name":"RUSTED METAL","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Uncommon","subtitle":"Junk","description":"Handfuls of corroded metal, distorted by years of exposure to the harsh environment. Handle with care.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/SPACEGUNK.3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/spacegunk.3.webp","colour":"#5b6f35","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_MAINTAIN_SUB3_NAME","descriptionKey":"UI_MAINTAIN_SUB3_DESC","secondary":"Substance","tags":[],"baseValue":20,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/SPACEGUNK3","@type":"GameAsset"},{"id":"WEAPSLOT_DMG4","name":"RUSTED POWER CORE","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Impossible","subtitle":"Damaged Multi-Tool Component","description":"Multi-Tool subsystem critically damaged. Slot cannot be used until damage is repaired. Use to begin repair process. Repairing will free slot up for general use.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/FARMPRODBASIC.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/farmprodbasic.2.webp","colour":"#7b0000","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_WEAPSLOT_DMG4_NAME","descriptionKey":"UI_WEAPSLOT_DMG_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/WEAPSLOT_DMG4","@type":"GameAsset"},{"id":"F_TRASH_8","name":"RUSTED TECHNOLOGY","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Collected Flotsam","description":"A technology upgrade that has been permanently damaged by prolonged exposure to water. Use to begin upgrade installation process.","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.METALJUNK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.metaljunk.webp","colour":"#8a7f72","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_TRASH_METAL_NAME","descriptionKey":"UI_FISH_TRASH_METAL_DESC","secondary":"Special","tags":["Consumable","Trade good"],"baseValue":10,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_TRASH_8","@type":"GameAsset"},{"id":"SACVENOM","name":"SAC VENOM","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Rare","subtitle":"Trade commodity","description":"A stabilised poison gland extracted from a terrestrial urchin. The host-urchin is actually a colony of smaller proto-creatures, a formation built on years of slow growth and cooperation. Of use both medicinally and as a delicacy in some riskier cuisines. Can be sold at a Galactic Trade Terminal.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.SACVENOM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.sacvenom.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"NEWPROD12_NAME","descriptionKey":"NEWPROD12_DESC","secondary":"Exotic","tags