","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINTAIN_FARM4_NAME","descriptionKey":"UI_MAINTAIN_FARM4_DESC","secondary":"Core","tags":["Core technology","Chargeable"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_FARM4","@type":"GameAsset"},{"id":"MAINT_FISHTRAP","name":"AUTO-TRAP","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Self-Sustaining Auto Creel","description":"An autonomous fishing device, designed for long-term deployment in a wide-range of water conditions. Return later to collect trapped fish. Trap cycle: IN PROGRESS","icon":"TEXTURES/UI/FRONTEND/ICONS/CATEGORIES/HOOK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/categories/hook.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"BLD_SEAHARVESTER_NAME_S","descriptionKey":"BLD_SEAHARVESTER_DESC_ALT","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_FISHTRAP","@type":"GameAsset"},{"id":"TRA_TECH4","name":"AUTONOMOUS POSITIONING UNIT","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Trade Goods (Technology)","description":"A container of positioning units and associated wiring. These APS units can be used to turn virtually any technology into a self-navigating system. Highly valuable in power generation economies, where they're used to remove conductive organic hands from the manufacturing process.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.TECH4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.tech4.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TRADE_ITEM_TECH_4_NAME","descriptionKey":"UI_TRADE_ITEM_TECH_4_DESC","secondary":"Exotic","tags":["Tra