nce Cost","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Reward Item","description":"Currency or faction standing, given as a reward.","icon":"TEXTURES/UI/FRONTEND/ICONS/SETTLEMENT/NEGATIVEMAINTENANCE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/settlement/negativemaintenance.webp","colour":"#7b0000","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_SETTLEMENT_STAT_UPKEEP","descriptionKey":"UI_REWARDPOP_DESC","secondary":"Substance","tags":[],"baseValue":20,"level":null,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/SET_COST_NEG","@type":"GameAsset"},{"id":"SET_COST_POS","name":"Maintenance Cost","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Reward Item","description":"Currency or faction standing, given as a reward.","icon":"TEXTURES/UI/FRONTEND/ICONS/SETTLEMENT/POSITIVEMAINTENANCE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/settlement/positivemaintenance.webp","colour":"#8a7f72","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_SETTLEMENT_STAT_UPKEEP","descriptionKey":"UI_REWARDPOP_DESC","secondary":"Substance","tags":[],"baseValue":20,"level":null,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/SET_COST_POS","@type":"GameAsset"},{"id":"F_GAS_LEG_S1","name":"MANDELBROT WORM","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Legendary Fish","description":"\"The geometry of its impossible body folds within itself, a writhing thread of flesh and spacetime.\"","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT5.FISH.WORM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product5.fish.worm.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_GAS_LEG_S1_NAME","descriptionKey":"UI_FISH_GAS_LEG_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient"