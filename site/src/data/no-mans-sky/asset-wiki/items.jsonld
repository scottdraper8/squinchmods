tegory":"Consumable","categoryKey":"Consumable","rarity":"Rare","subtitle":"Significant Underwater Oxygen Upgrade","description":"An extremely powerful upgrade for the Exosuit Aeration Membrane. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Drastically improves survival times underwater.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PROCTECH/PROCTECH.A.WATER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/proctech/proctech.a.water.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UP_UNW2_NAME","descriptionKey":"UP_UNW2_DESC","secondary":"Special","tags":["Consumable"],"baseValue":300,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/U_UNW2","@type":"GameAsset"},{"id":"U_UNW3","name":"UNDERWATER PROTECTION MODULE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Rare","subtitle":"Powerful Underwater Oxygen Upgrade","description":"A supremely powerful upgrade for the Exosuit Aeration Membrane. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Drastically improves survival times underwater.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PROCTECH/PROCTECH.S.WATER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/proctech/proctech.s.water.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UP_UNW3_NAME","descriptionKey":"UP_UNW3_DESC","secondary":"Special","tags":["Consumable"],"baseValue":480,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/U_UNW3","@type":"GameAsset"},{"id":"BANNER_UFT","name":"UNITED FEDERATION OF TRAVELERS BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Equip this exclusive Personal Flair in support of a united universe. Document, aid, create, communicate. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BANNER.UFT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.banner.uft.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_UFT_NAME","descriptionKey":"UI_BANNER_UFT_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BANNER_UFT","@type":"GameAsset"},{"id":"DECAL_UFT","name":"UNITED FEDERATION OF TRAVELERS DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal represents the United Federation of Travelers. Document, aid, create, communicate.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.DECAL10.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.decal10.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_UFT_NAME","descriptionKey":"BLD_DECAL_UFT_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/DECAL_UFT","@type":"GameAsset"},{"id":"BANNER_UN42","name":"UNITED NATIONS 42 BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Equip this exclusive Personal Flair in support of the values of community, longevity, viability, and support. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BANNER.UN42.DDS","preview":"/asset-wik