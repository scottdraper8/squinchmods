NS/COOKINGPRODUCTS/PRODUCT.REFINED.VEGSTEW.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.vegstew.webp","colour":"#007953","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_STEW_V_HOT_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":18800,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_STEW_V_HOT","@type":"GameAsset"},{"id":"TWITCH_SHIP25","name":"FINAL ASHES PL4","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship. This intimidating fighter craft is exceptionally manoeuvrable, its Flight Assist Override technology enabling it to deftly drift between celestial bodies. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.SHIP25.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.ship25.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_25_NAME","descriptionKey":"UI_TWIT_SHIP_25_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP25","@type":"GameAsset"},{"id":"TWITCH_SHIP12","name":"FINAL IURANONO II","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship with an illegally modified Hyperdrive and Pulse Engine for efficient galactic exploration. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.SHIP12.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.ship12.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_12_NAME","descriptionKey":"UI_TWIT_SHIP_12_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP12","@type":"GameAsset"},{"id":"BANNER_CHEF","name":"FINE AND TASTY BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Demonstrate your commitment to delicious pan-galactic cookery with this exclusive Personal Flair. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BANNER.CHEF.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.banner.chef.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_CHEF_NAME","descriptionKey":"UI_BANNER_CHEF_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BANNER_CHEF","@type":"GameAsset"},{"id":"BASE_CAVE5","name":"FINGERY DEPOSIT","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"This stalagmite was formed by the dripping of cobalt-rich moisture over several millennia. It is eternally cold to the touch, as though the rock recalls the temperature of its home cave.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.CAVEPLANT05.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.caveplant05.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_CAVEPLANT_5_NAME","descriptionKey":"BLD_CAVEPLANT_5_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_CAVE5","@type":"GameAsset"},{"id":"MAINT_COOKER","name":"FINISHED DISH","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Storage Hopper","description":"A hopper for storing the materials generated by the refinery","icon":"TEXTURES/UI/FRONTEND/ICONS/WIKI/WIKI.COOKING.OFF.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/wiki/wiki.cooking.off.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_COOKER_OUTPUT_NAME","descriptionKey":"UI_MAINT_REFINE_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_COOKER","@type":"GameAsset"},{"id":"FOOD_J_HOT","name":"FIRE WATER","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A consumable liquid, created in the Nutrient Processor. Prized across the galaxy for its pleasing mouth-feel and authentically natural flavours. Can be ingested as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.SAUCE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.sauce.webp","colour":"#db2400","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_J_HOT_NAME","descriptionKey":"FOOD_DRINK_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":1800,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_J_HOT","@type":"GameAsset"},{"id":"FOOD_P_HOTWILD","name":"FIREBERRY","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"An edible plant, harvested from planetary flora. Process in a Nutrient Processor to generate edible products.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.PLANT.HOTWILD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.plant.hotwild.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_PLANT_HOT_WILD_NAME","descriptionKey":"FOOD_PLANT_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":800,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_P_HOTWILD","@type":"GameAsset"},{"id":"SPEC_HELMET05","name":"FIRST SPAWN BATTLE MASK","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Helmet","description":"An aggressive Exosuit Appearance Override, modeled on the war helmets of the ancient Gek. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.HELMET05.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.helmet05.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SPEC_HELMET_05_NAME","descriptionKey":"UI_SPEC_HELMET_05_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_HELMET05","@type":"GameAsset"},{"id":"ILLEGAL_PROD8","name":"FIRST SPAWN RELICS","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Smuggled Goods","description":"Relics of the fallen Gek empire, condemned and banned by all the galaxy's major civilisations. Purchase is illegal at nearly all galactic trade terminals. Regular supply is only available within outlaw systems. Selling banned goods into commercially-regulated space may be highly profitable.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.SMUGGLING8.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.smuggling8.webp","colour":"#383838","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_ILLEGAL_PROD8_NAME","descriptionKey":"UI_ILLEGAL_PROD8_DESC","secondary":"Exotic","tags":["Trade good"],"baseValue":98000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ILLEGAL_PROD8","@type":"GameAsset"},{"id":"BUI_HEAD_9","name":"FIRST-AMONG-CASINGS","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Rare","subtitle":"Autophage Appearance Modification","description":"An exclusive Exosuit Appearance Override, granted by the Autophage to those who seek to build their own shell. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/ROBOTPARTS/ROBOTPARTS.HEAD.9.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/robotparts/robotparts.head.9.webp","colour":"#8c4b9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TIP_HEAD_BUI_9_U","descriptionKey":"UI_BUILDER_CUSTOM_DESC","secondary":"Exotic","tags":[],"baseValue":999,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BUI_HEAD_9","@type":"GameAsset"},{"id":"FOOD_F_RICE","name":"FISH AND RICE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A slab of seafood, created in the Nutrient Processor. Food such as this can be highly valuable. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.FISH.TROUT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.fish.trout.webp","colour":"#095c77","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_FOOD_RICE_NAME","descriptionKey":"UI_FISH_FOOD_LARGE_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":52500,"level":0,"stackMu