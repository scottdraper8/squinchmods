grade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potential improvements include: mining power and/or heat dispersion.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PROCTECH/PROCTECH.B.SHIPLASER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/proctech/proctech.b.shiplaser.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UP_MECHLAS2_NAME","descriptionKey":"UP_MECHLAS2_DESC","secondary":"Special","tags":["Consumable"],"baseValue":140,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/U_MECHLAS2","@type":"GameAsset"},{"id":"U_MECHLAS3","name":"MINOTAUR LASER MODULE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Rare","subtitle":"Powerful Minotaur Weapon Upgrade","description":"An extremely powerful upgrade for the Minotaur Mining Laser. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potential improvements include: mining power and/or heat dispersion.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PROCTECH/PROCTECH.A.SHIPLASER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/proctech/proctech.a.shiplaser.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UP_MECHLAS3_NAME","descriptionKey":"UP_MECHLAS3_DESC","secondary":"Special","tags":["Consumable"],"baseValue":300,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/U_MECHLAS3","@type":"GameAsset"},{"id":"U_MECHLAS4","name":"MINOTAUR LASER MODULE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Rare","subtitle":"Supreme Minotaur Weapon Upgrade","description":"A supremely powerful upgrade for the Minotaur Mining Laser. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potential improvements include: mining power and/or heat dispersion.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PROCTECH/PROCTECH.S.SHIPLASER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/proctech/proctech.s.shiplaser.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UP_MECHLAS4_NAME","descriptionKey":"UP_MECHLAS4_DESC","secondary":"Special","tags":["Consumable"],"baseValue":480,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/U_MECHLAS4","@type":"GameAsset"},{"id":"MECH_SCAN","name":"MINOTAUR RADAR ARRAY","kind":"Technology","category":"Mech","categoryKey":"Mech","rarity":"Impossible","subtitle":"Minotaur Scan Attachment","description":"A high-detail radar device, capable of upgrading the scanner technology aboard the Minotaur to Analysis Visor levels. Press to activate a radar sweep, revealing additional points of interest that cannot be located via a Multi-Tool scanner. Use the Quick Menu to tune the radar to specific buildings.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/VEHICLE/RENDER.SCAN.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/vehicle/render.scan.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MECH_SCAN_NAME","descriptionKey":"UI_MECH_SCAN_DESC","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MECH_SCAN","@type":"GameAsset"},{"id":"F_HOT_LEG_M1","name":"MIRRORSCALE SKIPPER","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Legendary Fish","description":"\"Impossible to see with mortal eyes as it flashes through the water under boiling, cloudless skies.\"","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT5.FISH.SMALL.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product5.fish.small.1.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_HOT_LEG_M1_NAME","descriptionKey":"UI_FISH_HOT_LEG_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":100000,"level":4,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_HOT_LEG_M1","@type":"GameAsset"},{"id":"F_LUSH_LEG_M1","name":"MIST SERPENT","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Legendary Fish","description":"\"When hunting, can dissolve into a thin dark cloud, impossible to track, impossible to see coming...\"","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT5.FISH.EEL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product5.fish.eel.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_LUSH_LEG_M1_NAME","descriptionKey":"UI_FISH_LUSH_LEG_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":100000,"level":4,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_LUSH_LEG_M1","@type":"GameAsset"},{"id":"ATLAS_SEED_9","name":"MODIFIED QUANTA","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Unique valuable curiosity","description":"This one-of-a-kind Atlas Seed holds an aesthetically pleasing mathematical construct salvaged from the simulation of an alternate reality.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/ATLASSEED.9.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/atlasseed.9.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"ATLAS_SEED_9_NAME","descriptionKey":"ATLAS_SEED_9_DESC","secondary":"Stellar","tags":["Craftable","Consumable"],"baseValue":1000,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ATLAS_SEED_9","@type":"GameAsset"},{"id":"TWITCH_SHIP16","name":"MOGANONJ'S INFINITE PROTECTOR","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship, with a generous inventory capacity, and a balanced loadout of weaponry to allow for a variety of defence tactics. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.SHIP16.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.ship16.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_16_NAME","descriptionKey":"UI_TWIT_SHIP_16_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP16","@type":"GameAsset"},{"id":"FOOD_F_CLAM","name":"MOLLUSC FLESH","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A small morsel of seafood, created in the Nutrient Processor. Food such as this can be highly valuable. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.FISH.SCALLOP.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.fish.scallop.webp","colour":"#095c77","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_FOOD_CLAM_NAME","descriptionKey":"UI_FISH_FOOD_SMALL_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":33100,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_F_CLAM","@type":"GameAsset"},{"id":"FOOD_R_MCUSTARD","name":"MONSTROUS CUSTARD","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A refined food product, created in the Nutrient Processor. Food such as this can be highly valuable. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.SAUCE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.sauce.webp","colour":"#6ad01e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_R_MCUSTARD_NAME","descriptionKey":"FOOD_REFINED_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":100000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_R_MCUSTARD","@type":"GameAsset"},{"id":"FOOD_DNUT_MCUST","name":"MONSTROUS DOUGHNUT","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.DOUGHNUT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.doughnut.webp","colour":"#6ad01e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_DNUT_MCUST_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":180000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_DNUT_MCUST","@type":"GameAsset"},{"id":"FOOD_CM_HONEY","name":"MONSTROUS HONEY CAKE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Wailing Batter.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.CAKE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.cake.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_CM_HONEY_NAME","descriptionKey":"UI_CAKE_DESC_CM","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":149700,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_CM_HONEY","@type":"GameAsset"},{"id":"BLD_BUGHEAD1","name":"MONSTROUS TROPHY","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive buildable base ornament. The mounted head of a colossal insect, this is a trophy from the glorious work of the Liquidators.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.BUGHEAD1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.bughead1.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_BUGHEAD1_NAME","descriptionKey":"BLD_EXPD_BUGHEAD_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BLD_BUGHEAD1","@type":"GameAsset"},{"id":"TWITCH_SHIP64","name":"MOOKAW NI8","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship. This A-class explorer benefits from hyperdrive and launcher bonuses, and is pre-installed with a selection of technologies and upgrades. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/TWITCH.SHIP64.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/twitch.ship64.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_64_NAME","descriptionKey":"UI_TWIT_SHIP_SCIENTIFIC_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP64","@type":"GameAsset"},{"id":"ILLEGAL_PROD3","name":"MOON ETHER","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Smuggled Goods","description":"A vat of highly volatile liquid. Its fumes are extremely flammable and a function as a powerful sedative. Purchase is illegal at nearly all galactic trade terminals. Regular supply is only available within outlaw systems. Selling banned goods into commercially-regulated space may be highly profitable.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.SMUGGLING3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.smuggling3.webp","colour":"#383838","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_ILLEGAL_PROD3_NAME","descriptionKey":"UI_ILLEGAL_PROD3_DESC","secondary":"Exotic","tags":["Trade good"],"baseValue":18000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ILLEGAL_PROD3","@type":"GameAsset"},{"id":"F_ALL_EPIC_M1","name":"MOON TURTLE","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Rare Fish","description":"UI_FISH_ALL_EPIC_M_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.TURTLE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.turtle.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_ALL_EPIC_M1_NAME","descriptionKey":"UI_FISH_ALL_EPIC_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":20000,"lev