","nameKey":"UI_TWIT_GUN_UP_01_NAME","descriptionKey":"UI_TWIT_GUN_UP_01_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_GUNUP01E","@type":"GameAsset"},{"id":"F_ODD_COM_M1","name":"MURMURFISH","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_ODD_COM_M_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT5.FISH.SMALL.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product5.fish.small.2.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_ODD_COM_M1_NAME","descriptionKey":"UI_FISH_ODD_COM_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":2000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_ODD_COM_M1","@type":"GameAsset"},{"id":"FOOD_PIE_ROOTS","name":"MUSHED ROOT PIE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.VEGPIE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.vegpie.webp","colour":"#f26d15","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_PIE_ROOTS_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":40000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_PIE_ROOTS","@type":"GameAsset"},{"id":"PET_XP","name":"Mutated!","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Reward Item","description":"Mutated!","icon":"TEXTURES/UI/FRONTEND/ICONS/PETS/LEVELUP.DNA1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/pets/levelup.dna1.webp","colour":"#0063b7","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_PET_XP_AWARD_TITLE","descriptionKey":"UI_PET_XP_AWARD_TITLE","secondary":"Special","tags":[],"baseValue":0,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/PET_XP","@type":"GameAsset"},{"id":"FOOD_PIE_MEAT","name":"MYSTERY MEAT PIE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.MEATPIE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.meatpie.webp","colour":"#7b0000","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_PIE_MEAT_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":40000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_PIE_MEAT","@type":"GameAsset"},{"id":"FOOD_MEAT_STEW","name":"MYSTERY MEAT STEW","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.MEATSTEW.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.meatstew.webp","colour":"#db2400","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_MEAT_STEW_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":6400,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_MEAT_STEW","@type":"GameAsset"},{"id":"MYSTERY_BEACON","name":"MYTH BEACON","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Experimental Summoning Technology","description":"The result of Nada's research into unusual patterns detected in the stories of the Gek, Korvax, and Vy'keen. The beacon broadcasts a signal echo attuned to the shift historiographical flux mapped by Nada's Traveller companions. Specialist Polo is unwilling to predict the results of the broadcast.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.MYSTERYBEACON.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.mysterybeacon.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_MYSTERY_BEACON_NAME","descriptionKey":"UI_MYSTERY_BEACON_DESC","secondary":"Exotic","tags":[],"baseValue":80,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/MYSTERY_BEACON","@type":"GameAsset"},{"id":"S23_BEACON","name":"MYTH BEACON","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Experimental Summoning Technology","description":"This beacon broadcasts a signal echo attuned to the historiographical flux mapped in the Space Anomaly databanks. Specialist Polo is unwilling to predict the results of the broadcast.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.MYSTERYBEACON.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.mysterybeacon.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_MYSTERY_BEACON_NAME","descriptionKey":"UI_S23_MYSTERY_BEACON_DESC","secondary":"Exotic","tags":["Craftable","Consumable"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S23_BEACON","@type":"GameAsset"},{"id":"TWITCH_PET27","name":"N. HEYDROADRUS EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Companion Egg","description":"A living, fertile egg, ready to hatch! Large ears flap against the membrane of the egg, curiously listening to the world outside. Scans indicate the being within has the genetic potential for a loyal and affectionate companion.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/TWITCH.PET27.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/twitch.pet27.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_PET_27_NAME","descriptionKey":"UI_TWIT_PET_27_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_PET27","@type":"GameAsset"},{"id":"TWITCH_SHIP37","name":"NABAETO OF THE VOID","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship. This fighter comes with a Conflict Scanner and powerful Infra-Knife pre-installed. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.SHIP37.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.ship37.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_37_NAME","descriptionKey":"UI_TWIT_SHIP_37_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP37","@type":"GameAsset"},{"id":"SPEC_DECAL04","name":"NADA DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal depicts the Korvax Priest Entity Nada.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.DECAL04.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.decal04.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_NADA_NAME","descriptionKey":"BLD_DECAL_NADA_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_DECAL04","@type":"GameAsset"},{"id":"BOBBLE_NADA","name":"NADA FIGURINE","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Starship Interior Adornment","description":"A synthetic polymer companion for your starship's cockpit, fashioned in the likeness of Priest Entity Nada. Install to an Inventory Slot to decorate your ship's interior.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BOBBLENADA.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.bobblenada.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BOBBLE_NADA_NAME","descriptionKey":"UI_BOBBLE_NADA_DESC","secondary":"Exotic","tags":[],"baseValue":3200,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BOBBLE_NADA","@type":"GameAsset"},{"id":"T_BOBBLE_NADA","name":"NADA FIGURINE","kind":"Technology","category":"All Ships","categoryKey":"AllShips","rarity":"Impossible","subtitle":"Starship Interior Adornment","description":"A synthetic polymer companion for your starship's cockpit, fashioned in the likeness of Priest Entity Nada. Install to an Inventory Slot to decorate your ship's interior.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BOBBLENADA.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.bobblenada.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_BOBBLE_NADA_NAME","descriptionKey":"UI_BOBBLE_NADA_DESC","secondary":"Installable","tags":[],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/T_BOBBLE_NADA","@type":"GameAsset"},{"id":"TECHFRAG","name":"NANITE CLUSTER","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Technological Currency","description":"A dense miasma of Nanites, undulating in its potentiality. These clusters are stable, but unrestricted nanite foam can produce undesirable runaway reactions in the presence of organic matter. Used in the construction of advanced technologies. Highly valuable to specialist traders.","icon":"TEXTURES/UI/FRONTEND/ICONS/SUBSTANCES/NANITE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/substances/nanite.webp","colour":"#1e354e","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"TECH_FRAGMENT_NAME","descriptionKey":"TECH_FRAGMENT_DESC","secondary":"Substance","tags":[],"baseValue":20,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/TECHFRAG","@type":"GameAsset"},{"id":"DRONE_PART_E2","name":"NANITE FILAMENT","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Drone Component","description":"A thin, shimmering thread, once owned by Iteration: Gemini. This impossible fibre, once a treasured keepsake, sings on the wavelength of the Space Anomaly. A valuable and exotic component, this would be of great use to Iteration: Tethys in repairing the shattered Drone.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.DRONEPARTE2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.droneparte2.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_DRONE_PART_E2_NAME","descriptionKey":"UI_DRONE_PART_E2_DESC","secondary":"Special","tags":["Consumable"],"baseValue":16,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/DRONE_PART_E2","@type":"GameAsset"},{"id":"TECHFRAG_R","name":"NANITES","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Technological Currency","description":"A dense miasma of Nanites, undulating in its potentiality. These clusters are stable, but unrestricted nanite foam can produce undesirable runaway reactions in the presence of organic matter. Used in the construction of advanced technologies. Highly valuable to specialist traders.","icon":"TEXTURES/UI/FRONTEND/ICONS/SUBSTANCES/CURRENCY.NANITES.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/substances/currency.nanites.webp","colour":"#8a7f72","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_NANITES_REWARD_NAME","descriptionKey":"TECH_FRAGMENT_DESC","secondary":"Substance","tags":[],"baseValue":20,"level":null,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/TECHFRAG_R","@type":"GameAsset"},{"id":"TRA_ALLOY1","name":"NANOTUBE CRATE","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Trade Goods (Construction)","description":"A packed crate of carbon nanotubes. These tiny but incredibly strong tubes are required in the construction of tiny but incredibly strong scientific components.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.ALLOY1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.alloy1.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TRADE_ITEM_ALLOY_1_NAME","descriptionKey":"UI_TRADE_ITEM_ALLOY_1_DESC","secondary":"Exotic","tags":["Trade good"],"baseValue":1000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TRA_ALLOY1","@type":"GameAsset"},{"id":"F_COLD_LEG_XL","name":"NAUTILIA","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Legendary Fish","description":"\"None would believe the scale of this beast: its colossal shell, its enormous slimy foot. None, except those who have seen it...\"","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT2.FISH.SNAIL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product2.fish.snail.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_COLD_LEG_XL_NAME","descriptionKey":"UI_FISH_COLD_LEG_XL_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":200000,"level":4,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_COLD_LEG_XL","@type":"GameAsset"},{"id":"SUB_GUN","name":"NAUTILON CANNON","kind":"Technology","category":"Submarine","categoryKey":"Submarine","rarity":"Impossible","subtitle":"Submarine Weapon","description":"A mounted cannon specifically designed for the Nautilon Submarine. A high-energy weapon system, it superheats a small body of water before launching it rapidly towards the intended target. Designed primarily for damage against biological entities and inefficient when deployed as a mining device.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/VEHICLE/RENDER.SUBMARINECANNON.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/vehicle/render.submarinecannon.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SUBGUN_NAME","descriptionKey":"UI_SUBGUN_DESC","secondary":"Installable","tags":["Chargeable","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"http