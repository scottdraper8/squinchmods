/textures/ui/frontend/icons/u4products/proctech/proctechalien.s.shiplaser.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BIO_PROD_LAS_NAME","descriptionKey":"BIO_PROD_LAS4_DESC","secondary":"Special","tags":["Consumable"],"baseValue":480,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/AP_SHIPLAS4","@type":"GameAsset"},{"id":"SHIPLAS_ALIEN","name":"GRAFTED EYES","kind":"Technology","category":"Alien Ship","categoryKey":"AlienShip","rarity":"Always","subtitle":"Fused Organic Technology","description":"A complex arrangement of membranes and lens, fused atop a high-energy laser array. Incineration awaits those that meet their stare. Press request the eyes gaze upon nearby targets.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/BIOTECH.EYE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/biotech.eye.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"SHIPLAS1_ALIEN_NAME","descriptionKey":"SHIPLAS1_ALIEN_DESC","secondary":"Core","tags":["Core technology","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SHIPLAS_ALIEN","@type":"GameAsset"},{"id":"UA_SLASR1","name":"Grafted Eyes","kind":"Upgrade module","category":"Combat","categoryKey":"Combat","rarity":"Normal","subtitle":"C-Class %NAME% Node","description":"A moderate upgrade for the Grafted Eyes. Use to trigger node growth and begin the grafting process. Each node is genetically unique, and exact upgrade statistics are unknown until installation is complete. Potential improvements include: damage output, and overheat tolerance.","icon":"","preview":"","colour":"#1a2733","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"AP_SHIPLAS","descriptionKey":"BIO_PROD_LAS1_DESC","secondary":"A_SHIPLAS","tags":["3 possible stats"],"baseValue":null,"level":null,"stackMultipli