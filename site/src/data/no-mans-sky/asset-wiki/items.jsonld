","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.banner.reddit.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_REDDIT_NAME","descriptionKey":"UI_BANNER_REDDIT_DESC","secondary":"BuildingPart","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BANNER_REDDIT","@type":"GameAsset"},{"id":"BASE_BARNACLE","name":"BARNACLE","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A tenacious arthropod, naturally found encrusting stationary or slow-moving underwater objects. This variety can be encouraged to affix itself to a chosen position, adding an aged marine appearance to bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BARNACLE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.barnacle.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_BARNACLE_NAME","descriptionKey":"BLD_BARNACLE_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_BARNACLE","@type":"GameAsset"},{"id":"UT_BOLT","name":"BARREL IONISER","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Common","subtitle":"Boltcaster Upgrade","description":"Inserts a powerful field ionisation device into the barrel of the Boltcaster, increasing projectile stability through the air. Improves device accuracy and allows the user to fire for longer periods without degrading combat performance.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.PROJECTILE1MOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.projectile1mod.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_BOLT_NAME","descriptionKey":"UT_BOLT_