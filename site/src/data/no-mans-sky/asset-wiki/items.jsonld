uct","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.MEATSTEW.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.meatstew.webp","colour":"#6ad01e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_R_EYESTEW_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":90000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_R_EYESTEW","@type":"GameAsset"},{"id":"FARMPROD1","name":"ACID","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Rare","subtitle":"Advanced Agricultural Product","description":"Dilute acid for high current generation in diverse power cells. Crafted from Mordite and Fungal Mould.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/FARMPROD.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/farmprod.1.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FARMPROD_1_NAME","descriptionKey":"UI_FARMPROD_1_DESC","secondary":"Special","tags":["Craftable"],"baseValue":188000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FARMPROD1","@type":"GameAsset"},{"id":"F_TOX_RARE_M1","name":"ACIDIC PUFFERFISH","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Uncommon Fish","description":"UI_FISH_TOX_RARE_M_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.MEDIUM.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.medium.1.webp","colour":"#2177c8","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_TOX_RARE_M1_NAME","descriptionKey":"UI_FISH_TOX_RARE_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":5000,"level":2,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_TOX_RARE_M1","@type":"GameAsset"},{"id":"EX_RED","name":"ACTIVATED CADMIUM","kind":"Resource","category":"Stellar","categoryKey":"Stellar","rarity":"Rare","subtitle":"Refined Stellar Metal: Red","description":"A chromatic metal, generated by fusion in the heart of a star. This Cadmium has been activated by the extreme conditions in which it was formed, and is highly valuable. Cadmium is found on planets orbiting red stars, and can be placed in a Refiner to create purified Chromatic Metal.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.EXRED.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.exred.2.webp","colour":"#7b0000","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_EX_RED_NAME","descriptionKey":"UI_EX_RED_DESC","secondary":"Substance","tags":["Trade good"],"baseValue":111,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/EX_RED","@type":"GameAsset"},{"id":"EX_YELLOW","name":"ACTIVATED COPPER","kind":"Resource","category":"Stellar","categoryKey":"Stellar","rarity":"Common","subtitle":"Refined Stellar Metal: Yellow","description":"A chromatic metal, generated by fusion in the heart of a star. This Copper has been activated by the extreme conditions in which it was formed, and is highly valuable. Copper is found on planets orbiting yellow stars, and can be placed in a Refiner to create purified Chromatic Metal.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.EXYELLOW.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.exyellow.2.webp","colour":"#e59001","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_EX_YELLOW_NAME","descriptionKey":"UI_EX_YELLOW_DESC","secondary":"Substance","tags":["Trade good"],"baseValue":75,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/EX_YELLOW","@type":"GameAsset"},{"id":"EX_GREEN","name":"ACTIVATED EMERIL","kind":"Resource","category":"Stellar","categoryKey":"Stellar","rarity":"Rare","subtitle":"Refined Stellar Metal: Green","description":"A chromatic metal, generated by fusion in the heart of a star. This Emeril has been activated by the extreme conditions in which it was formed, and is highly valuable. Emeril is found on planets orbiting green stars, and can be placed in a Refiner to create purified Chromatic Metal.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.EXGREEN.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.exgreen.2.webp","colour":"#36611c","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_EX_GREEN_NAME","descriptionKey":"UI_EX_GREEN_DESC","secondary":"Substance","tags":["Trade good"],"baseValue":134,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/EX_GREEN","@type":"GameAsset"},{"id":"EX_BLUE","name":"ACTIVATED INDIUM","kind":"Resource","category":"Stellar","categoryKey":"Stellar","rarity":"Rare","subtitle":"Refined Stellar Metal: Blue","description":"A chromatic metal, generated by fusion in the heart of a star. Indium is found on planets orbiting blue stars, and can be placed in a Refiner to create purified Chromatic Metal. This Indium has been activated by the extreme conditions in which it was formed, and is highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.EXBLUE.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.exblue.2.webp","colour":"#01387d","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_EX_BLUE_NAME","descriptionKey":"UI_EX_BLUE_DESC","secondary":"Substance","tags":["Trade good"],"baseValue":165,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/EX_BLUE","@type":"GameAsset"},{"id":"EX_PURPLE","name":"ACTIVATED QUARTZITE","kind":"Resource","category":"Stellar","categoryKey":"Stellar","rarity":"Rare","subtitle":"Refined Stellar Metal: Purple","description":"A chromatic mineral, generated by fusion in the heart of a star. Quartzite is found on planets orbiting purple stars, and can be placed in a Refiner to create purified Chromatic Metal. This quartzite has been activated by the extreme conditions in which it was formed, and is highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.EXPURPLE.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.expurple.2.webp","colour":"#4d2957","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_EX_PURPLE_NAME","descriptionKey":"UI_EX_PURPLE_DESC","secondary":"Substance","tags":["Trade good"],"baseValue":165,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/EX_PURPLE","@type":"GameAsset"},{"id":"BIOSHIP_EGG1","name":"ACTIVE VOID EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Agitated Curiosity","description":"An anomalous egg. Since the encounter with the bizarre deep-space 'creature', its strange music has grown more active, more agitated. When touched, conjures a powerful vision of a world beset by powerful anomalies and strange colours.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/PRODUCT.EGG1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/product.egg1.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BIOSHIP_EGG1_NAME","descriptionKey":"UI_BIOSHIP_EGG1_DESC","secondary":"Exotic","tags":[],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BIOSHIP_EGG1","@type":"GameAsset"},{"id":"BUI_HEAD_4","name":"ADAPTIVE VISION UNIT","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Rare","subtitle":"Autophage Appearance Modification","description":"An exclusive Exosuit Appearance Override, granted by the Autophage to those who seek to build their own shell. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/ROBOTPARTS/ROBOTPARTS.HEAD.4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/robotparts/robotparts.head.4.webp","colour":"#8c4b9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TIP_HEAD_BUI_4_U","descriptionKey":"UI_BUILDER_CUSTOM_DESC","secondary":"Exotic","tags":[],"baseValue":999,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BUI_HEAD_4","@type":"GameAsset"},{"id":"EXPD_BANNER13","name":"ADRIFT BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Equip this exclusive Personal Flair in commemoration of the Adrift expedition, and to finding peace in a lonely universe. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.BANNER13.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.banner13.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_EXPD_13_NAME","descriptionKey":"UI_BANNER_EXPD_13_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_BANNER13","@type":"GameAsset"},{"id":"EXPD_DECAL13","name":"ADRIFT DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal commemorates completion of the Adrift expedition, and to finding peace in a lonely universe.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.DECAL13.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.decal13.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_EXPD_13_NAME","descriptionKey":"BLD_DECAL_EXPD_13_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_DECAL13","@type":"GameAsset"},{"id":"VEHICLE_LASER1","name":"ADVANCED EXOCRAFT LASER","kind":"Technology","category":"Exocraft","categoryKey":"Exocraft","rarity":"Impossible","subtitle":"Exocraft Mining Upgrade","description":"Increases power of the Exocraft Mining Laser.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/VEHICLE/RENDER.VEHICLE_LASERU1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/vehicle/render.vehicle_laseru1.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"VEHICLEMINER_U1_NAME","descriptionKey":"VEHICLEMINER_U1_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/VEHICLE_LASER1","@type":"GameAsset"},{"id":"BUI_HEAD_14","name":"ADVANCED FACIAL UNIT","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Rare","subtitle":"Autophage Appearance Modification","description":"An exclusive Exosuit Appearance Override, granted by the Autophage to those who seek to build their own shell. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/ROBOTPARTS/ROBOTPARTS.HEAD.14.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/robotparts/robotparts.head.14.webp","colour":"#8c4b9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TIP_HEAD_BUI_14_U","descriptionKey":"UI_BUILDER_CUSTOM_DESC","secondary":"Exotic","tags":[],"baseValue":999,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BUI_HEAD_14","@type":"GameAsset"},{"id":"POWERCELL2","name":"ADVANCED ION BATTERY","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Uncommon","subtitle":"Portable Energy Storage","description":"Powerful energy storage unit. Used in a wide variety of defensive and hazard protection systems. Constructed from Ionised Cobalt and Pure Ferrite, and occasionally found in cylindrical metal containers.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.POWERCELL2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.powercell2.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"POWERCELL2_NAME","descriptionKey":"POWERCELL2_DESC","secondary":"Catalyst","tags":["Consumable"],"baseValue":500,"level":0,"stackMultiplier":20,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/POWERCELL2","@type":"GameAsset"},{"id":"LAUNCHER_SPEC","name":"ADVANCED LAUNCH SYSTEM","kind":"Technology","category":"Ship","categoryKey":"Ship","rarity":"Impossible","subtitle":"Bespoke Landing Gear","description":"A custom-made launch control system for high-performance starships. Sensitive gyroscopes and specialised control circuits plot custom take-off routines for increased launch speed and efficiency. Specialised, deuterium-derived fuel is required to recharge thruster. Launch procedures require sufficient fuel levels before activation. Hold to take off from planet. Hold to initiate in-flight speed boost.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/VEHICLE/RENDER.ENGINE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/vehicle/render.engine.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"LAUNCHER_SPEC_NAME","descriptionKey":"LAUNCHER_SPEC_DESC","secondary":"Core","tags":["Core technology","Chargeable","Primary"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/LAUNCHER_SPEC","@type":"GameAsset"},{"id":"STRONGLASER","name":"ADVANCED MINING LASER","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Common","subtitle":"Mining Beam Companion Unit","description":"Replaces standard Mining Beam optics with high-grade Living Glass, allowing the beam to be effective against large and/or rare resource deposits. The lens adapts automatically to minute fluctuations in the beam waveform, minimising scatter and increasing device mining potential.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE1/TECH.STRONGLASER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update1/tech.stronglaser.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"STRONGLASER_NAME","descriptionKey":"STRONGLASER_DESCRIPTION","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/STRONGLASER","@type":"GameAsset"},{"id":"UT_TRANSLATE3","name":"ADVANCED TRANSLATOR","kind":"Technology","category":"Suit","categoryKey":"Suit","rarity":"Common","subtitle":"Automatic Language Parser","description":"An automatic translation device. It records and parses nearby conversations before running the data through a contextual learning system to determine intended meaning. A large memory array and overclocked language processors allow the real-time translation of significant chunks of speech.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/AUTOTRANSLATOR.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/autotranslator.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_TRANSLATE3_NAME","descriptionKey":"UT_TRANSLATE3_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/UT_TRANSLATE3","@type":"GameAsset"},{"id":"UT_WATER","name":"AERATION MEMBRANE","kind":"Technology","category":"Suit","categoryKey":"Suit","rarity":"Common","subtitle":"Aquatic Respiration Aid","description":"User is able to swim underwater for extended periods. Absorbs gases dissolved in water through a membrane contactor that, if user is of a conventionally structured species, is placed over the mouth or facial breathing hole. Operates automatically once constructed within user's exosuit inventory.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.HELMET.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.helmet.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_WATER_NAME","descriptionKey":"UNW1_DESCRIPTION","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/UT_WATER","@type":"GameAsset"},{"id":"UP_UNW1","name":"Aeration Membrane","kind":"Upgrade module","category":"Protection","categoryKey":"Protection","rarity":"Rare","subtitle":"Underwater Oxygen Upgrade","description":"A significant upgrade for the Exosuit Aeration Membrane. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Significantly improves survival times underwater.","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_UNW","descriptionKey":"UP_UNW1_DESC","secondary":"T_UNW","tags":["1 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_UNW1","@type":"GameAsset"},{"id":"UP_UNW2","name":"Aeration Membrane","kind":"Upgrade module","category":"Protection","categoryKey":"Protection","rarity":"Epic","subtitle":"Significant Underwater Oxygen Upgrade","description":"An extremely powerful upgrade for the Exosuit Aeration Membrane. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Drastically improves survival times underwater.","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_UNW","descriptionKey":"UP_UNW2_DESC","secondary":"T_UNW","tags":["1 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_UNW2","@type":"GameAsset"},{"id":"UP_UNW3","name":"Aeration Membrane","kind":"Upgrade module","category":"Protection","categoryKey":"Protection","rarity":"Legendary","subtitle":"Powerful Underwater Oxygen Upgrade","description":"A supremely powerful upgrade for the Exosuit Aeration Membrane. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Drastically improves survival times underwater.","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_UNW","descriptionKey":"UP_UNW3_DESC","secondary":"T_UNW","tags":["1 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_UNW3","@type":"GameAsset"},{"id":"BUI_HEAD_8","name":"AERODYNAMIC FACIAL UNIT","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Rare","subtitle":"Autophage Appearance Modification","description":"An exclusive Exosuit Appearance Override, granted by the Autophage to those who seek to build their own shell. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/ROBOTPARTS/ROBOTPARTS.HEAD.8.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/robotparts/robotparts.head.8.webp","colour":"#8c4b9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TIP_HEAD_BUI_8_U","descriptionKey":"UI_BUILDER_CUSTOM_DESC","secondary":"Exotic","tags":[],"baseValue":999,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BUI_HEAD_8","@type":"GameAsset"},{"id":"SPEC_PB_EGG01","name":"AERON CRAB EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Shellseeker Companion","description":"A living, fertile egg, ready to hatch! Laid by a soft-skinned crustacean, this species has evolved a synergistic relationship with Travellers, occupying the discarded shells of slain Sentinel Quadrupeds. Scans indicate the being within has the genetic potential to be shy and migratory.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.2026.HERMITCRABPET.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.2026.hermitcrabpet.webp","colour":"#4d2987","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SPEC_PB_EGG01_NAME","descriptionKey":"UI_SPEC_PB_EGG01_DESC","secondary":"Exotic","tags":[],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_PB_EGG01","@type":"GameAsset"},{"id":"SHIPSHIELD_ROBO","name":"AERON SHIELD","kind":"Technology","category":"Robot Ship","categoryKey":"RobotShip","rarity":"Always","subtitle":"Radiant Defensive Barrier","description":"A defensive crimson cocoon, obfuscating the ship's physical form and providing protection from collision and laser fire. The core self-heals over time, but may be quickly replenished with catalytic elements or radiant shards.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/ROBOTSHIP.SHIELD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/robotship.shield.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SHIPSHIELD_ROBO_NAME","descriptionKey":"UI_SHIPSHIELD_ROBO_DESC","secondary":"Core","tags":["Core technology","Chargeable","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SHIPSHIELD_ROBO","@type":"GameAsset"},{"id":"SHIP_ATLAS","name":"AERON STARSHIP TRAIL","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Starship Exhaust Override","description":"An exclusive Starship Exhaust Modifier. This engine modification injects the Starship exhaust trail with an arterial streak of crimson. Install this technology in your starship inventory to change the appearance of the engine exhaust trails.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S20.SHIPTRAIL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s20.shiptrail.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SHIPTRAIL_ATLAS_NAME","descriptionKey":"UI_SHIPTRAIL_ATLAS_DESC","secondary":"Exotic","tags":[],"baseValue":2100,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SHIP_ATLAS","@type":"GameAsset"},{"id":"T_SHIP_ATLAS","name":"AERON STARSHIP TRAIL","kind":"Technology","category":"All Ships","categoryKey":"AllShips","rarity":"Impossible","subtitle":"Starship Exhaust Override","description":"An exclusive Starship Exhaust Modifier. This engine modification injects the Starship exhaust trail with an arterial streak of crimson. Install this technology in your starship inventory to change the appearance of the engine exhaust trails.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S20.SHIPTRAIL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s20.shiptrail.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SHIPTRAIL_ATLAS_NAME","descriptionKey":"UI_SHIPTRAIL_ATLAS_DESC","secondary":"Installable","tags":[],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/T_SHIP_ATLAS","@type":"GameAsset"},{"id":"SPEC_SENTPACK","name":"AERON TURBOJET","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Exosuit Visual Enhancement","description":"An exclusive Exosuit Appearance Override. A titanium flightpack, assembled from technology stolen from the Sentinel horde. Its engines are precooled with a constant flow of pugneum and nitrogen, ensuring fuel-efficient and deadly silent operation. Warning: do not unseal pugneum containment chamber without protective gear. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BACKPACKSENTINEL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.backpacksentinel.webp","colour":"#262626","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BACKPACK_SENTINEL_NAME","descriptionKey":"UI_BACKPACK_SENTINEL_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_SENTPACK","@type":"GameAsset"},{"id":"EXO_PROT_TOX","name":"AIR FILTRATION UNIT","kind":"Technology","category":"Exocraft","categoryKey":"Exocraft","rarity":"Always","subtitle":"Exocraft Hazard Protection Unit","description":"Double-vacuumed air filtration systems allow no trace of the planetary atmosphere into the Exocraft cabin without being thoroughly scrubbed. Entirely prevents all damage or energy drain while inside an Exocraft in toxic environments.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.PROTECTTOXIC.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.protecttoxic.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_EXOHAZ_TOX_NAME","descriptionKey":"UI_EXOHAZ_TOX_DESC","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/EXO_PROT_TOX","@type":"GameAsset"},{"id":"UT_MIDAIR","name":"AIRBURST ENGINE","kind":"Technology","category":"Suit","categoryKey":"Suit","rarity":"Common","subtitle":"Jetpack Augmentation","description":"A powerful upgrade for the Exosuit Jetpack, allowing limited jetpack recharging while airborne. Highly efficient compressors fitted around the jetpack exhaust take advantage of the windflow generated by persistent falling, recycling some of that energy into jetpack fuel.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.JETPACKMOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.jetpackmod.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_MIDAIR_NAME","descriptionKey":"UT_MIDAIR_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/UT_MIDAIR","@type":"GameAsset"},{"id":"ALBUMENPEARL","name":"ALBUMEN PEARL","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Rare","subtitle":"Trade commodity","description":"Gemstone formed over the course of centuries within the egg of a super-incubatory species. Highly ornamental, these gems are themselves living seeds, lucent grains of potential life. Can be sold at a Galactic Trade Terminal.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.ABUMENPEARL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.abumenpearl.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"NE