chnology","category":"Suit","categoryKey":"Suit","rarity":"Impossible","subtitle":"TEMPLATE_SUB","description":"TEMPLATE_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.PROTECTWATER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.protectwater.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"TEMPLATE_NAME","descriptionKey":"TEMPLATE_DESC","secondary":"Installable","tags":["Chargeable"],"baseValue":1,"level":0,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/T_UNW","@type":"GameAsset"},{"id":"RADIO1","name":"URANIUM","kind":"Resource","category":"Earth","categoryKey":"Earth","rarity":"Uncommon","subtitle":"Localised Earth Element","description":"Local mineral extract, typically found in large deposits or extracted from common minerals after inspection with an Analysis Visor. Typically found on planets with a radioactive environment.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.BIOME.RADIO.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.biome.radio.webp","colour":"#ffad00","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_RADIO1_NAME","descriptionKey":"UI_RADIO1_DESC","secondary":"Substance","tags":[],"baseValue":62,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/RADIO1","@type":"GameAsset"},{"id":"BASE_FLOWER2","name":"URCHIN FLOWERS","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A hardy floral patch, genetically modified to thrive in all biomes, soil types, and weather conditions. These unusually-shaped flowers are packed with pollen, and release a dizzyingly sweet perfume.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.FLOWER02.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.flower02.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_FLOWER_2_NAME","descriptionKey":"BLD_FLOWER_2_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_FLOWER2","@type":"GameAsset"},{"id":"MP_REP_PART3C","name":"USER AUTHENTICATOR","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Starship Component","description":"An advanced nanocomputer, performing processing tasks related to starship-to-Exosuit synchronisation and security. The part appears intact, functional, and ready to be installed in a new ship.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.SALVAGE.RARE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.salvage.rare.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_MP_REPAIR_PART3C_NAME","descriptionKey":"UI_MP_REPAIR_PART3C_DESC","secondary":"Special","tags":["Consumable"],"baseValue":3200,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/MP_REP_PART3C","@type":"GameAsset"},{"id":"EXPD_BANNER09","name":"UTOPIA EXPEDITION BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Equip this exclusive Personal Flair in commemoration of the Utopia expedition, and contributions to the Utopia Foundation communal habitation project. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.BANNER09.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.banner09.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_EXPD_09_NAME","descriptionKey":"UI_BANNER_EXPD_09_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_BANNER09","@type":"GameAsset"},{"id":"EXPD_DECAL09","name":"UTOPIA EXPEDITION DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal commemorates completion of the Utopia expedition, and contributions to the Utopia Foundation communal habitation project.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.DECAL09.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.decal09.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_EXPD_09_NAME","descriptionKey":"BLD_DECAL_EXPD_09_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_DECAL09","@type":"GameAsset"},{"id":"S_POSTER28","name":"UTOPIA POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster captures an idyllic alien landscape under a gold-tinted sky.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.S_POSTER28.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.s_poster28.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_S_POSTER28_NAME","descriptionKey":"BLD_S_POSTER28_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S_POSTER28","@type":"GameAsset"},{"id":"EXPD_SHIP09","name":"UTOPIA SPEEDER","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"A unique and exclusive starship, commemorating completion of the Utopia expedition, and contributions to the Utopia Foundation communal habitation project. This versatile craft is plated with radiation-resistant armour, and engineered with an aerodynamic profile for agility during atmospheric flight. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.SHIP09.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.ship09.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_SHIP_09_NAME","descriptionKey":"UI_EXPD_SHIP_09_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_SHIP09","@type":"GameAsset"},{"id":"S9_PACK1","name":"UTOPIA SUPPLY DROP BETA","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Utopia Foundation Supply Cache","description":"To support the workers bravely terraforming the lava-filled wastes of planet Pehaelump, the Utopia Overseers are glad to supply this cache of vital goods. Select the supply pack and use Open Package () to collect your Utopia Foundation supplies, as well as details of your next assignment.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/HOLOCOMDEVICE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/holocomdevice.webp","colour":"#311a49","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S9_CARE_PACK1_NAME","descriptionKey":"UI_S9_CARE_PACK1_DESC","secondary":"Special","tags":[],"baseValue":2613,"level":1,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S9_PACK1","@type":"GameAsset"},{"id":"S9_PACK3","name":"UTOPIA SUPPLY DROP DELTA","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Utopia Foundation Supply Cache","description":"To support the surviving workers who now confront the [ REDACTED ] of planet Idalth XIV, the Utopia Overseers are glad to supply this cache of vital goods. Select the supply pack and use Open Package () to collect your Utopia Foundation supplies, as well as details of your next assignment.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/HOLOCOMDEVICE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/holocomdevice.webp","colour":"#311a49","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S9_CARE_PACK3_NAME","descriptionKey":"UI_S9_CARE_PACK3_DESC","secondary":"Special","tags":[],"baseValue":2613,"level":1,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S9_PACK3","@type":"GameAsset"},{"id":"S9_PACK4","name":"UTOPIA SUPPLY DROP EPSILON","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Utopia Foundation Supply Cache","description":"To support the workers who so nobly rebuild in the sucking quagmires of planet Endil A8, the Utopia Overseers are glad to supply this cache of vital goods. Select the supply pack and use Open Package () to collect your Utopia Foundation supplies, as well as details of your next assignment.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/HOLOCOMDEVICE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/holocomdevice.webp","colour":"#311a49","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S9_CARE_PACK4_NAME","descriptionKey":"UI_S9_CARE_PACK4_DESC","secondary":"Special","tags":[],"baseValue":2613,"level":1,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S9_PACK4","@type":"GameAsset"},{"id":"S9_PACK2","name":"UTOPIA SUPPLY DROP GAMMA","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Utopia Foundation Supply Cache","description":"To support the workers valiantly toiling on the steep, exposed mountains of planet New Sesto, the Utopia Overseers are glad to supply this cache of vital goods. Select the supply pack and use Open Package () to collect your Utopia Foundation supplies, as well as details of your next assignment.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/HOLOCOMDEVICE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/holocomdevice.webp","colour":"#311a49","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S9_CARE_PACK2_NAME","descriptionKey":"UI_S9_CARE_PACK2_DESC","secondary":"Special","tags":[],"baseValue":2613,"level":1,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S9_PACK2","@type":"GameAsset"},{"id":"TWITCH_PET04","name":"V. PENTAAMQUM EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Companion Egg","description":"A living, fertile egg, ready to hatch! The scaly reptile within scrapes its claws against the egg, hungry to prove its ferocity. Scans indicate the being within has the genetic potential to be a fierce hunter, defeating prey and rival creatures with powerful jaws.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.TWITCH.PET04.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.twitch.pet04.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_PET_04_NAME","descriptionKey":"UI_TWIT_PET_04_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_PET04","@type":"GameAsset"},{"id":"TWITCH_PET20","name":"V. SLASHUZANEUS EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Companion Egg","description":"A living, fertile egg, ready to hatch! The little embryo is coiled tightly within the egg, dreaming of stretching its long neck and tails in the sun. Scans indicate the being within has the genetic potential for a territorial nature, making for a powerful and loyal companion.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.PET20.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.pet20.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_PET_20_NAME","descriptionKey":"UI_TWIT_PET_20_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_PET20","@type":"GameAsset"},{"id":"F_TOX_LEG_M1","name":"VAMPIRE SQUID","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Legendary Fish","description":"\"A true error of the deep; its hungry bite corrupts your blood, filling your body with a spurting corrosive bile.\"","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT5.FISH.SQUID.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product5.fish.squid.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_TOX_LEG_M1_NAME","descriptionKey":"UI_FISH_TOX_LEG_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":100000,"level":4,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_TOX_LEG_M1","@type":"GameAsset"},{"id":"F_GAS_RARE_L1","name":"VAPOURFIN","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Uncommon Fish","description":"UI_FISH_GAS_RARE_L_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.XL.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.xl.2.webp","colour":"#2177c8","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_GAS_RARE_L1_NAME","descriptionKey":"UI_FISH_GAS_RARE_L_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":10000,"level":2,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_GAS_RARE_L1","@type":"GameAsset"},{"id":"TRA_COMPONENT5","name":"VECTOR COMPRESSORS","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Trade Goods (Industrial)","description":"A large crate of high-capacity vector compressors. The creation of interstellar drives often requires dimensions to be condensed and then re-rendered. Such high-tech component manufacture would not be possible without industrial-grade compressors such as these.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.COMPONENT5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.component5.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TRADE_ITEM_COMP_5_NAME","descriptionKey":"UI_TRADE_ITEM_COMP_5_DESC","secondary":"Exotic","tags":["Trade good"],"baseValue":50000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TRA_COMPONENT5","@type":"GameAsset"},{"id":"F_ODD_COM_S1","name":"VECTORFIN","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_ODD_COM_S_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT5.FISH.SMALL.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product5.fish.small.1.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_ODD_COM_S1_NAME","descriptionKey":"UI_FISH_ODD_COM_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":1000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_ODD_COM_S1","@type":"GameAsset"},{"id":"BASE_CAVE4","name":"VEINED FLAT CAPS","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"Clusters of these large mushrooms can be found growing in underground caves. The surface 'veins' form part of an unusual gill structure, releasing spores from both above and below the fungus's cap.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.CAVEPLANT04.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.caveplant04.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_CAVEPLANT_4_NAME","descriptionKey":"BLD_CAVEPLANT_4_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_CAVE4","@type":"GameAsset"},{"id":"F_TOX_COM_S2","name":"VENOMOUS TRIGGERFIN","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_TOX_COM_S_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.BIG.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.big.2.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_TOX_COM_S2_NAME","descriptionKey":"UI_FISH_TOX_COM_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":1000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_TOX_COM_S2","@type":"GameAsset"},{"id":"F_TOX_RARE_L1","name":"VENOMTOOTH WRIGGLER","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Uncommon Fish","description":"UI_FISH_TOX_RARE_L_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.BIG.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.big.1.webp","colour":"#2177c8","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_TOX_RARE_L1_NAME","descriptionKey":"UI_FISH_TOX_RARE_L_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":10000,"level":2,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_TOX_RARE_L1","@type":"GameAsset"},{"id":"FOOD_R_BCUSTARD","name":"VERY THICK CUSTARD","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A refined food product, created in the Nutrient Processor. Food such as this can be highly valuable. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.SAUCE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.sauce.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_BONECUST_NAME","descriptionKey":"FOOD_REFINED_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":32000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_R_BCUSTARD","@type":"GameAsset"},{"id":"SOLAR_SAIL","name":"VESPER SAIL","kind":"Technology","category":"Ship","categoryKey":"Ship","rarity":"Always","subtitle":"Advanced Engine Technology","description":"A high-performance solar sail, deployed automatically during flight. This advanced propulsion device generates an electric field within the sails themselves, allowing the starship to build momentum from the solar wind. Offers substantial gains in fuel efficiency and boost performance over conventional engine systems, as well as enabling photovoltaic recharge of the starship's launch systems.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.SOLARSAIL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.solarsail.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SOLAR_SAIL_NAME","descriptionKey":"UI_SOLAR_SAIL_DESC","secondary":"Core","tags":["Core technology","Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SOLAR_SAIL","@type":"GameAsset"},{"id":"STONE_EYE_PROD","name":"VIGILANT STONE","kind":"Product","category":"Component","categoryKey":"Component","rarity":"Rare","subtitle":"Unblinking Eye","description":"An eye of living stone: waiting, watching. A relic left by a slumbering guardian, keeping sentry over ancient creature burial grounds. Warning: Disturbing the eye may disturb the slumber of living stone guardians. Ensure re-animated guardians are defeated before storing this relic in the home.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.STONEEYE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.stoneeye.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_STONE_EYE_PROD_NAME","descriptionKey":"UI_STONE_EYE_PROD_DESC","secondary":"Special","tags":["Consumable"],"baseValue":102000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/STONE_EYE_PROD","@type":"GameAsset"},{"id":"BASE_HOUDINI3","name":"VIGILANT TARO","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"The eye-like protrusions on this bizarre organism are capable of both processing light and performing simple calculations, although it is unclear what they are watching for... Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.HOUDINIPLANT03.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.houdiniplant03.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_HOUDINIPLANT_3_NAME","descriptionKey":"BLD_HOUDINIPLANT_3_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_HOUDINI3","@type":"GameAsset"},{"id":"JETS_RUIN","name":"VIGILANT TRAIL","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Jetpack Exhaust Override","description":"An exclusive Exosuit Appearance Override. A Jetpack trail emitting the light of living stone; plucked from a slumbering guardian; focused and consolidated through a series of lenses. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S19.JETS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s19.jets.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_JETTRAIL_RUIN_NAME","descriptionKey":"UI_JETTRAIL_RUIN_DESC","secondary":"Exotic","tags":[],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/JETS_RUIN","@type":"GameAsset"},{"id":"QUEEN_PROD","name":"VILE CORTEX","kind":"Product","category":"Component","categoryKey":"Component","rarity":"Rare","subtitle":"Glorious Trophy","description":"The brain stem of a brood mother, pulled from its malignant corpse. This is a valuable trophy, signifying victory in the quest to purge the infestations of the vile brood. Turn it over to an envoy of the Mercenaries Guild to mark your triumph.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.SPECBUGHAT4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.specbughat4.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_QUEEN_PROD_NAME","descriptionKey":"UI_QUEEN_PROD_DESC","secondary":"Special","tags":["Consumable"],"baseValue":122000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/QUEEN_PROD","@type":"GameAsset"},{"id":"SPEC_FISH_BOB4","name":"VILE EGG FLOAT","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Customised Fishing Equipment","description":"An exclusive Fishing Rig Customisation, altering the appearance of the float. Transform the appearance of your fishing equipment from the fishing rig's bait management page.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.S17.FISHINGFLOATEGG.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.s17.fishingfloategg.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FLOAT_EGG_NAME","descriptionKey":"UI_FLOAT_CUSTOM_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_FISH_BOB4","@type":"GameAsset"},{"id":"WORMPROD","name":"VILE SPAWN","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Hungering Embryo","description":"The fragile embryo of a Hungering Tendril, still dripping with mucal butter. It wails and recoils when touched. May be extracted from embryotic sacs with the aid of a Visceral Synthesiser.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/WORMSPAWN.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/wormspawn.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_WORMPROD_NAME","descriptionKey":"UI_WORMPROD_DESC","secondary":"Special","tags":[],"baseValue":16,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/WORMPROD","@type":"GameAsset"},{"id":"BLD_BUGHEAD4","name":"VILE TAXIDERMY","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive buildable base ornament. The mounted head of a colossal insect, this is a trophy from the glorious work of the Liquidators.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.BUGHEAD4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.bughead4.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_BUGHEAD4_NAME","descriptionKey":"BLD_EXPD_BUGHEAD_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BLD_BUGHEAD4","@type":"GameAsset"},{"id":"EXPD_SHIP23B","name":"VINTAGE INTERCEPTOR","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive vintage Sentinel Interceptor, commemorating completion of the expedition Our Journey Continues, and the pilgrimage through past iterations of No Man's Sky. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S23.SHIPB.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s23.shipb.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_SHIP_23B_NAME","descriptionKey":"UI_EXPD_SHIP_23B_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_SHIP23B","@type":"GameAsset"},{"id":"F_TOX_EPIC_XL","name":"VIPER EEL","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Rare Fish","description":"UI_FISH_TOX_EPIC_XL_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.EEL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.eel.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_TOX_EPIC_XL_NAME","descriptionKey":"UI_FISH_TOX_EPIC_XL_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":50000,"level":3,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_TOX_EPIC_XL","@type":"GameAsset"},{"id":"SLIME_BLOB","name":"VIRAL HEART","kind":"Product","category":"Space Salvage","categoryKey":"SpaceSalvage","rarity":"Rare","subtitle":"Semi-Sentient Protein Strand","description":"A folded mass of pathogenic proteins, harvested from a deep-space biohazard. This has been processed at a deep-space outpost, and can be sold on the open market.","icon":"TEXTURES/UI/FRONTEND/ICONS/SUBSTANCES/SLIME.STARSLIME.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/substances/slime.starslime.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SLIME_BLOB_NAME","descriptionKey":"UI_SLIME_BLOB_DESC","secondary":"Exotic","tags":["Craftable","Cooking ingredient"],"baseValue":190000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SLIME_BLOB","@type":"GameAsset"},{"id":"EXPD_FLAG_06E","name":"VIRIDIAN FLAG","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Exclusive Flag","description":"A contrasting green and purple design, this flag was inspired by those searching for verdant galaxies. An exclusive buildable base ornament.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.FLAG06E.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.flag06e.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_FLAG_06E_NAME","descriptionKey":"UI_EXPD_FLAG_06E_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_FLAG_06E","@type":"GameAsset"},{"id":"WORMTECH","name":"VISCERAL SYNTHESISER","kind":"Technology","category":"Suit","categoryKey":"Suit","rarity":"Common","subtitle":"Ethereal Incubator","description":"A piece of otherworldy technology. Its inviting membranes are soft, gel-like, pulsing with a gentle crimson radiance. Its warm embrace allows the user to extricate any Vile Spawn from the embryotic sacs of Hungering Tendrils.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/TECH.WORMTECH.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/tech.wormtech.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_WORMTECH_NAME","descriptionKey":"UI_WORMTECH_DESC","secondary":"Installable","tags":["Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/WORMTECH","@type":"GameAsset"},{"id":"FOOD_R_CUSTARD","name":"VISCOUS CUSTARD","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A refined food product, created in the Nutrient Processor. Food such as this can be highly valuable. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.SAUCE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.sauce.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_R_CUSTARD_NAME","descriptionKey":"FOOD_REFINED_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":32000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_R_CUSTARD","@type":"GameAsset"},{"id":"SPACEGUNK5","name":"VISCOUS FLUIDS","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Junk","description":"An unnaturally thick liquid of dubious colour. Its origins are impossible to fathom. Appears to have some mild magnetic properties.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/SPACEGUNK.5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/spacegunk.5.webp","colour":"#5b6f35","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_MAINTAIN_SUB5_NAME","descriptionKey":"UI_MAINTAIN_SUB5_DESC","secondary":"Substance","tags":[],"baseValue":20,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/SPACEGUNK5","@type":"GameAsset"},{"id":"TWITCH_SHIP35","name":"VISIONARY EAGLE QL9","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship. This A-class fighter benefits from damage and manoeuvrability bonuses, and is pre-installed with a selection of technologies and upgrades. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.SHIP35.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.ship35.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_35_NAME","descriptionKey":"UI_TWIT_SHIP_FIGHTER_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP35","@type":"GameAsset"},{"id":"MAINT_ROBO7","name":"VISUAL SENSORS","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Damaged Autophage Component","description":"This autophage is far from working order, but its subcomponents shows the signs of a previous repair attempt. With a few additional tweaks, the work might be completed... Repair this component with , or use to locate the needed materials.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/MAINTTECH.FUEL1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/mainttech.fuel1.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINT_ROBO7_NAME","descriptionKey":"UI_MAINT_ROBO_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_ROBO7","@type":"GameAsset"},{"id":"EXPD_ODD_EGG","name":"VOID EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Living Curiosity","description":"An anomalous egg. The shell is tough and leathery, and twitches when touched. A faint tapping can be heard coming from within. From time to time, it appears to sing.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.MYSTERYEGG.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.mysteryegg.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_ODD_EGG_NAME","descriptionKey":"UI_ODD_EGG_DESC","secondary":"Exotic","tags":[],"baseValue":3200,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_ODD_EGG","@type":"GameAsset"},{"id":"ODD_EGG","name":"VOID EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Living Curiosity","description":"An anomalous egg. The shell is tough and leathery, and twitches when touched. A faint tapping can be heard coming from within. From time to time, it appears to sing.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.MYSTERYEGG.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.mysteryegg.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_ODD_EGG_NAME","descriptionKey":"UI_ODD_EGG_DESC","secondary":"Exotic","tags":[],"baseValue":3200,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ODD_EGG","@type":"GameAsset"},{"id":"S23_ODD_EGG","name":"VOID EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Living Curiosity","description":"An anomalous egg. The shell is tough and leathery, and twitches when touched. A faint tapping can be heard coming from within. From time to time, it appears to sing.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.MYSTERYEGG.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.mysteryegg.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_ODD_EGG_NAME","descriptionKey":"UI_ODD_EGG_DESC","secondary":"Special","tags":["Craftable"],"baseValue":32,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S23_ODD_EGG","@type":"GameAsset"},{"id":"BASE_INFEST1","name":"VOID HUSK","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"This eggshell still whispers a faint song, as though connected to a distant chorus... Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.INFESTEDPLANT01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.infestedplant01.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_INFESTEDPLANT_1_NAME","descriptionKey":"BLD_INFESTEDPLANT_1_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_INFEST1","@type":"GameAsset"},{"id":"BUI_SCRAP","name":"VOID MOTE","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Common","subtitle":"Essence of Atlantid","description":"A purified drop of Atlantideum, refined to its very essence. This precious material is acquired by earning favour with and assisting the Autophage. Visit the Autophage Synthesis Terminal found at all Autophage camps to exchange Void Motes for unique customisation options.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.BUISCRAP.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.buiscrap.webp","colour":"#dedcd1","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_BUI_SCRAP_NAME","descriptionKey":"UI_BUI_SCRAP_DESC","secondary":"Substance","tags":[],"baseValue":380,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/BUI_SCRAP","@type":"GameAsset"},{"id":"F_ODD_EPIC_XL","name":"VOID SQUID","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Rare Fish","description":"UI_FISH_ODD_EPIC_XL_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT4.FISH.SQUID.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product4.fish.squid.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_ODD_EPIC_XL_NAME","descriptionKey":"UI_FISH_ODD_EPIC_XL_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":50000,"level":3,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_ODD_EPIC_XL","@type":"GameAsset"},{"id":"FOOD_MM_CHOC","name":"VOLATILE CHOCOLATE FANCY","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Writhing, Roiling Batter. Some caution is advised.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.CUPCAKEEVIL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.cupcakeevil.webp","colour":"#6ad01e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_MM_CHOC_NAME","descriptionKey":"UI_CAKE_DESC_MM","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":123700,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_MM_CHOC","@type":"GameAsset"},{"id":"UT_STUNDMG","name":"VOLTAIC AMPLIFIER","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Rare","subtitle":"Damage Overload Module","description":"A generalised upgrade for all Multi-Tool weapon systems, causing its projectiles to resonate dramatically upon impact with any appropriate electromagnetic field. Will significantly increase the damage dealt to any organic and inorganic entities that are currently stunned.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.STUNDAMAGEMOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.stundamagemod.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_STUNDMG_NAME","descriptionKey":"UT_STUNDMG_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/UT_STUNDMG","@type":"GameAsset"},{"id":"CAVECUBE","name":"VORTEX CUBE","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Rare","subtitle":"Trade commodity","description":"An ancient object, unearthed from the depths of a planetary cave system. Its surface is cold to the touch, and is curiously polished despite its age. A fusion of metal and rock, these cubes have proved resistant to industrial processing. As such, they are of value only to collectors. Can be sold at a Galactic Trade Terminal.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.VORTEXCUBE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.vortexcube.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"NEWPROD11_NAME","descriptionKey":"NEWPROD11_DESC","secondary":"Exotic","tags":["Trade good"],"baseValue":5800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/CAVECUBE","@type":"GameAsset"},{"id":"S_POSTER26","name":"VOYAGE POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This soft-toned poster collects some of the landmarks of the Traveller's voyage.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.S_POSTER26.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.s_poster26.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_S_POSTER26_NAME","descriptionKey":"BLD_S_POSTER26_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S_POSTER26","@type":"GameAsset"},{"id":"EXPD_BANNER11","name":"VOYAGERS BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Equip this exclusive Personal Flair in commemoration of the Voyagers expedition, and the discoveries made along the way. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.BANNER11.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.banner11.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_EXPD_11_NAME","descriptionKey":"UI_BANNER_EXPD_11_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_BANNER11","@type":"GameAsset"},{"id":"EXPD_DECAL11","name":"VOYAGERS DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal commemorates completion of the Voyagers expedition, and the discoveries made along the way.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.DECAL11.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.decal11.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_EXPD_11_NAME","descriptionKey":"BLD_DECAL_EXPD_11_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_DECAL11","@type":"GameAsset"},{"id":"TWITCH_SHIP06","name":"VV5 ARIYAZ","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship, pre-fitted with a powerful Phase Beam and upgraded Pulse Engine for efficient space exploration. The Teleport Receiver also allows for gathered products and materials to be efficiently teleported back to the ship over long distances. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.TWITCH.SHIP06.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.twitch.ship06.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_06_NAME","descriptionKey":"UI_TWIT_SHIP_06_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP06","@type":"GameAsset"},{"id":"FOOD_ICE_GRAH","name":"VY'ICE CREAM","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.ICECREAM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.icecream.webp","colour":"#6ad01e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_ICE_GRAH_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":44000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_ICE_GRAH","@type":"GameAsset"},{"id":"WAR_STANDING_DN","name":"VY'KEEN","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Reward Item","description":"Currency or faction standing, given as a reward.","icon":"TEXTURES/UI/FRONTEND/MISSIONS/MISSIONFACTION.VYKEEN.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/missions/missionfaction.vykeen.webp","colour":"#7b0000","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_STANDING_WAR","descriptionKey":"UI_REWARDPOP_DESC","secondary":"Substance","tags":[],"baseValue":20,"level":null,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/WAR_STANDING_DN","@type":"GameAsset"},{"id":"WAR_STANDING_UP","name":"VY'KEEN","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Reward Item","description":"Currency or faction standing, given as a reward.","icon":"TEXTURES/UI/FRONTEND/MISSIONS/MISSIONFACTION.VYKEEN.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/missions/missionfaction.vykeen.webp","colour":"#8a7f72","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_STANDING_WAR","descriptionKey":"UI_REWARDPOP_DESC","secondary":"Substance","tags":[],"baseValue":20,"level":null,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/WAR_STANDING_UP","@type":"GameAsset"},{"id":"WAR_CURIO2","name":"VY'KEEN DAGGER","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Trade commodity","description":"Largely ceremonial weapon. A vital part of Vy'keen tradition and culture.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.VYKEENDAGGER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.vykeendagger.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"NEWPROD2_NAME","descriptionKey":"NEWPROD2_DESC","secondary":"Exotic","tags":[],"baseValue":11688,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/WAR_CURIO2","@type":"GameAsset"},{"id":"WAR_CURIO1","name":"VY'KEEN EFFIGY","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Medium value curiosity","description":"A small wooden icon carved into the shape of a Sentinel drone. Used by warriors to enter a temporary trance-like state that eliminates their kind's need for sleep.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.EFFIGY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.effigy.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"CURIO2_NAME","descriptionKey":"CURIO2_DESCRIPTION","secondary":"Exotic","tags":[],"baseValue":24750,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/WAR_CURIO1","@type":"GameAsset"},{"id":"BANNER_WAR","name":"VY'KEEN EMBLEM BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Express loyalty to the history and culture of the Vy'keen with this exclusive Personal Flair. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BANNER.VYKEEN.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.banner.vykeen.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_WAR_NAME","descriptionKey":"UI_BANNER_WAR_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BANNER_WAR","@type":"GameAsset"},{"id":"WAR_CURIO3","name":"VY'KEEN TABLET","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Communion of Hirk","description":"A stone tablet bearing line after line of intricate runes. The words are unintelligible, an ancient dialect forgotten by all but the oldest of the Vy'keen elders. The hand that carved this stone must have been extraordinary. The stonework is precise, delicate - and yet perfectly conveys the unyielding aggression its writer clearly possessed.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TREASUREPROD.STRANGEBOOK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/treasureprod.strangebook.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_WAR_TABLET_NAME","descriptionKey":"UI_WAR_TABLET_DESC","secondary":"Exotic","tags":[],"baseValue":1250,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/WAR_CURIO3","@type":"GameAsset"},{"id":"TWITCH_PET07","name":"W. FREGAEIOSUS EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Companion Egg","description":"A living, fertile egg, ready to hatch! A muffled squawking can be heard from within. Scans indicate the being within has the genetic potential for a mischievous personality.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.PET07.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.pet07.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_PET_07_NAME","descriptionKey":"UI_TWIT_PET_07_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_PET07","@type":"GameAsset"},{"id":"FOOD_R_MCAKEMIX","name":"WAILING BATTER","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A refined food product, created in the Nutrient Processor. Food such as this can be highly valuable. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.BATTER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.batter.webp","colour":"#6ad01e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_R_MCAKEMIX_NAME","descriptionKey":"FOOD_REFINED_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":120000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_R_MCAKEMIX","@type":"GameAsset"},{"id":"FOOD_CM_CARM","name":"WAILING CARAMEL CAKE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Wailing Batter.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.CCAKEEVIL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.ccakeevil.webp","colour":"#6ad01e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_CM_CARM_NAME","descriptionKey":"UI_CAKE_DESC_CM","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":152300,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_CM_CARM","@type":"GameAsset"},{"id":"WALKER_PROD","name":"WALKER BRAIN","kind":"Product","category":"Component","categoryKey":"Component","rarity":"Rare","subtitle":"Anomalous Material","description":"Shifting nanite clusters sewn together with a pugneum filament, this circuit is painfully hot to the touch. A sinister purple light leaks from deep within its wiring, changing in intensity as it watches its holder.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.WALKERBRAIN.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.walkerbrain.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_WALKER_PROD_NAME","descriptionKey":"UI_WALKER_PROD_DESC","secondary":"Special","tags":["Consumable"],"baseValue":35000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/WALKER_PROD","@type":"GameAsset"},{"id":"BUI_ARMOUR_2","name":"WANDERER'S CLOAK","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Rare","subtitle":"Autophage Appearance Modification","description":"An exclusive Exosuit Appearance Override, granted by the Autophage to those who seek to build their own shell. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/ROBOTPARTS/ROBOTPARTS.ARMOUR.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/robotparts/robotparts.armour.2.webp","colour":"#8c4b9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TIP_ARMOUR_BUI_2_U","descriptionKey":"UI_BUILDER_CUSTOM_DESC","secondary":"Exotic","tags":[],"baseValue":1515,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BUI_ARMOUR_2","@type":"GameAsset"},{"id":"F_LUSH_COM_M1","name":"WANDERING KELPFIN","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_LUSH_COM_M_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT5.FISH.MEDIUM.3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product5.fish.medium.3.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_LUSH_COM_M1_NAME","descriptionKey":"UI_FISH_LUSH_COM_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":2000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_LUSH_COM_M1","@type":"GameAsset"},{"id":"F_DEEP_COM_L1","name":"WANDERING SHELLBACK","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_DEEP_COM_L_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT4.FISH.TURTLE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product4.fish.turtle.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_DEEP_COM_L1_NAME","descriptionKey":"UI_FISH_DEEP_COM_L_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":3000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_DEEP_COM_L1","@type":"GameAsset"},{"id":"SPEC_PB_EGG02","name":"WANDERING SHRIMP TANK EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Liquid-Suspended Consciousness","description":"A metal 'egg' capsule, ready to hatch! Part robotic, part organic, part liquid. The primitive anatomy of this creature's conscious organ belies a deep, calculating intelligence. Scans indicate the being within has the genetic potential to be focused and strategic.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.2026.FISHBOWL3PET.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.2026.fishbowl3pet.webp","colour":"#4d2988","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SPEC_PB_EGG02_NAME","descriptionKey":"UI_SPEC_PB_EGG02_DESC","secondary":"Exotic","tags":[],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_PB_EGG02","@type":"GameAsset"},{"id":"F_LUSH_COM_XL","name":"WARDEN EEL","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_LUSH_COM_XL_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.EEL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.eel.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_LUSH_COM_XL_NAME","descriptionKey":"UI_FISH_LUSH_COM_XL_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":5000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_LUSH_COM_XL","@type":"GameAsset"},{"id":"FOOD_V_GEK","name":"WARM PROTO-MILK","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"An animal byproduct, this nutritious morsel can be easily farmed without harm to the animal that produces it. Process in a Nutrient Processor to generate edible products.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.MILK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.milk.webp","colour":"#e57002","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_GEK_VEG_NAME","descriptionKey":"FOOD_VEG_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":3200,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_V_GEK","@type":"GameAsset"},{"id":"DECAL_SKULL","name":"WARNING DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add a touch of macabre decoration to bases. This decal depicts the final state of an unfortunate soul.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.DECALSKULL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.decalskull.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_SKULL_NAME","descriptionKey":"BLD_DECAL_SKULL_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/DECAL_SKULL","@type":"GameAsset"},{"id":"HYPERFUEL1","name":"WARP CELL","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Rare","subtitle":"Hyperdrive Charging Unit","description":"This antimatter-based fuel is one of the few power sources capable of meeting the incredible energy requirements of a starship hyperdrive. Secured within a robust housing, the cell is guaranteed paradox-free during FTL travel.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.WARPCELL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.warpcell.webp","colour":"#c01746","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"HYPERFUEL1_NAME","descriptionKey":"HYPERFUEL1_DESCRIPTION","secondary":"Special","tags":["Craftable","Consumable"],"baseValue":46750,"level":0,"stackMultiplier":2,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/HYPERFUEL1","@type":"GameAsset"},{"id":"CV_HYP2","name":"warp core","kind":"Upgrade module","category":"Protection","categoryKey":"Protection","rarity":"Rare","subtitle":"B-Class %NAME% Upgrade","description":"A significant upgrade for the Hyperdrive. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potential improvements include: warp-drive efficiency and jump distance.","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_HYPERDRIVE","descriptionKey":"UP_HYPER2_DESC","secondary":"T_HDRIVE","tags":["1 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/CV_HYP2","@type":"GameAsset"},{"id":"CV_HYP3","name":"warp core","kind":"Upgrade module","category":"Protection","categoryKey":"Protection","rarity":"Epic","subtitle":"A-Class %NAME% Upgrade","description":"An extremely powerful upgrade for the Hyperdrive. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potential improvements include: warp-drive efficiency and jump distance.","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_HYPERDRIVE","descriptionKey":"UP_HYPER3_DESC","secondary":"T_HDRIVE","tags":["2 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/CV_HYP3","@type":"GameAsset"},{"id":"F_HDRIVEBOOST1","name":"WARP CORE RESONATOR","kind":"Technology","category":"Freighter","categoryKey":"Freighter","rarity":"Rare","subtitle":"Hyperdrive Companion Unit","description":"An augmentation for the colossal hyperdrive engine of an interstellar freighter. Quantum resonation improves the robustness of the drive during FTL travel, granting the ability to leap to stars previously out of reach.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/TECHNOLOGY.FREIGHTERSIGMA.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/technology.freightersigma.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_FREIGHTER_DRIVE1_NAME","descriptionKey":"UI_FREIGHTER_DRIVE1_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":2,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/F_HDRIVEBOOST1","@type":"GameAsset"},{"id":"HYPERFUEL2","name":"WARP HYPERCORE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Rare","subtitle":"Hyperdrive Charging Unit","description":"A high-capacity antimatter-based fuel, this cell harnesses an internal black hole generator to power starship hyperdrives across multiple warp jumps. Cell walls are specially designed to reflect any reality paradoxes back towards the heart of the unit, where they generate additional power.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.WARPCELL2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.warpcell2.webp","colour":"#c01746","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"HYPERFUEL2_NAME","descriptionKey":"HYPERFUEL2_DESCRIPTION","secondary":"Special","tags":["Craftable","Consumable"],"baseValue":46750,"level":0,"stackMultiplier":2,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/HYPERFUEL2","@type":"GameAsset"},{"id":"F_LUSH_COM_S2","name":"WARTY FROGFISH","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_LUSH_COM_S_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.MEDIUM.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.medium.1.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_LUSH_COM_S2_NAME","descriptionKey":"UI_FISH_LUSH_COM_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":1000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_LUSH_COM_S2","@type":"GameAsset"},{"id":"F_TOX_EPIC_S1","name":"WASPFISH","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Rare Fish","description":"UI_FISH_TOX_EPIC_S_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.BIG.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.big.2.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_TOX_EPIC_S1_NAME","descriptionKey":"UI_FISH_TOX_EPIC_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":10000,"level":3,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_TOX_EPIC_S1","@type":"GameAsset"},{"id":"BASE_TOXPLANT02","name":"WATCHFUL PROTRUSION","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"While this plant can be cultivated as a crop, consumption is not advised. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.TOXPLANT02.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.toxplant02.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_TOXPLANT_2_NAME","descriptionKey":"BLD_TOXPLANT_2_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_TOXPLANT02","@type":"GameAsset"},{"id":"SHIPJUMP_SPEC","name":"WAVEFORM ENGINE","kind":"Technology","category":"Ship","categoryKey":"Ship","rarity":"Impossible","subtitle":"Highly Customised Starship Engine","description":"A highly-tuned version of the conventional starship Pulse Engine. Wavefront occupancy has been pushed to the limit, creating a pulse experience that is both efficient and highly responsive. User is advised that Tritium is required to charge the drive. Tritium is abundant in near-space asteroid fields. Scan () to search for tritium-rich asteroids. Hold to engage Pulse Jump. Hold to initiate in-flight speed boost.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/ULTRAPROD.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/ultraprod.1.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"SHIPJUMP_SPEC_NAME","descriptionKey":"SHIPJUMP_SPEC_DESC","secondary":"Core","tags":["Core technology","Chargeable","Primary"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SHIPJUMP_SPEC","@type":"GameAsset"},{"id":"UT_RAIL_STUN","name":"WAVEFORM OSCILLATOR","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Common","subtitle":"Blaze Javelin Upgrade","description":"Overloads the energy beam generated by the Blaze Javelin, causing it to deliver a power electrical charge at its point of impact. Will briefly stun any organic and inorganic entities that intersect the Blaze Javelin's beam.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.BLAZEJAVELINMOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.blazejavelinmod.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_RAIL_STUN_NAME","descriptionKey":"UT_RAIL_STUN_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/UT_RAIL_STUN","@type":"GameAsset"},{"id":"UT_SCAN","name":"WAVEFORM RECYCLER","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Common","subtitle":"Multi-Tool Upgrade","description":"A powerful lateral processor inserted into the Multi-Tool Scanning System allows the device to recharge at a significantly improved rate. Increases potential scan frequency.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.SCANMOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.scanmod.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_SCAN_NAME","descriptionKey":"UT_SCAN_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/UT_SCAN","@type":"GameAsset"},{"id":"SPEC_ROCKETHAT","name":"WAYFARER'S HELM","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Helmet","description":"An exclusive Exosuit Appearance Override. Despite its aerodynamic appearance and advanced solar design, reliance on helmet-exclusive propulsion is not advised. For maximum safety, ensure all body parts are propelled equally. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.SAILHELM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.sailhelm.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SPEC_ROCKETHAT_NAME","descriptionKey":"UI_SPEC_ROCKETHAT_DESC","secondary":"Exotic","tags":[],"baseValue":3200,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_ROCKETHAT","@type":"GameAsset"},{"id":"EXPD_CUBE_06","name":"WAYWARD CUBE","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Floating Primitive","description":"An exclusive buildable base ornament. This cubic lifeform drifted into an orbital station from another reality, where it was captured by a travelling merchant. Provides placid companionship when rehomed in a habitable base.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.CUBE06.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.cube06.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_CUBE_06_NAME","descriptionKey":"UI_EXPD_CUBE_06_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_CUBE_06","@type":"GameAsset"},{"id":"TRUCK_PAINT02","name":"WEATHERED FINISH","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Rare","subtitle":"Exocraft Customisation Option","description":"A custom paintwork finish for a terrestrial vehicle, compatible with the Colossus large Exocraft. Recalibrate Exocraft visuals from the Colossus Geobay.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.2026.TRUCKPAINT02.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.2026.truckpaint02.webp","colour":"#dedcd1","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TRUCK_PAINT02_NAME","descriptionKey":"UI_TRUCK_PAINT_DESC","secondary":"Special","tags":[],"baseValue":12300,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TRUCK_PAINT02","@type":"GameAsset"},{"id":"S22_FRAG_B","name":"WEAVER ECHO","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Lingering Soul Fragment","description":"A ghostly fragment of Traveller soul, lingering where it no longer belongs. Data containing the weaver aspect of the Starship %SHIPNAME%'s previous owner.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.2026.S22_FRAG_B.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.2026.s22_frag_b.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S22_FRAG_B_NAME","descriptionKey":"UI_S22_FRAG_B_DESC","secondary":"Special","tags":["Craftable"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S22_FRAG_B","@type":"GameAsset"},{"id":"TEAM_BLUE","name":"WEAVERS","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Reward Item","description":"Currency or faction standing, given as a reward.","icon":"TEXTURES/UI/FRONTEND/ICONS/SWARM/TEAM02.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/swarm/team02.webp","colour":"#dedcd1","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_SWARMPAGE_TEAM_BLUE","descriptionKey":"UI_REWARDPOP_DESC","secondary":"Substance","tags":[],"baseValue":20,"level":null,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/TEAM_BLUE","@type":"GameAsset"},{"id":"SWARM_FLAG_B1","name":"WEAVERS FLAG","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An ornamental flag for base decoration, celebrating the Weaver fragment of the Traveller soul.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S22.FLAGB1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s22.flagb1.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_SWARM_FLAG_B1_NAME","descriptionKey":"BLD_SWARM_FLAG_B_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SWARM_FLAG_B1","@type":"GameAsset"},{"id":"EXPD_POSTER22C","name":"WEAVERS POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster depicts the Weaver fragment of the Traveller soul. A shaper of reality: a dreamer and creator. Your destiny is your own.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S22.POSTERC.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s22.posterc.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER22C_NAME","descriptionKey":"BLD_EXPD_POSTER22C_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER22C","@type":"GameAsset"},{"id":"TRA_TECH2","name":"WELDING SOAP","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Trade Goods (Technology)","description":"Several large bars of welding soap. Used in power generation systems to heat-clean metal diodes before they're fused into batteries.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.TECH2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.tech2.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TRADE_ITEM_TECH_2_NAME","descriptionKey":"UI_TRADE_ITEM_TECH_2_DESC","secondary":"Exotic","tags":["Trade good"],"baseValue":6000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TRA_TECH2","@type":"GameAsset"},{"id":"FOOD_B_BURN","name":"WELL-SMOKED BISCUIT","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A well-baked biscuit, created in the Nutrient Processor. What was once a thin sheet of vaguely-sweetend nutrient paste has been elevated with the addition of carefully-chosen ingredients.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.BISCUIT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.biscuit.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_B_BURN_NAME","descriptionKey":"UI_BISCUIT_DESC_REF","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":35000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_B_BURN","@type":"GameAsset"},{"id":"FOOD_STEW_DRILL","name":"WELL-STIRRED STEW","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.MEATSTEW.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.meatstew.webp","colour":"#bb3830","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_DRILL_STEW_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":6400,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_STEW_DRILL","@type":"GameAsset"},{"id":"F_TOX_RARE_S2","name":"WELTSCALE CLAM","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Uncommon Fish","description":"UI_FISH_TOX_RARE_S_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT4.FISH.CLAM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product4.fish.clam.webp","colour":"#2177c8","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_TOX_RARE_S2_NAME","descriptionKey":"UI_FISH_TOX_RARE_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":3000,"level":2,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_TOX_RARE_S2","@type":"GameAsset"},{"id":"ROGUE_BEACON","name":"WHALESONG FLUTE","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Cosmic Melody Instrument","description":"A powerful but mellow musical instrument, capable of relaying song through space via gently undulating electromagnetic waves. Use Relay Song () while in deep space to broadcast the flute's melody...","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.ROGUEBEACON.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.roguebeacon.webp","colour":"#311a49","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_ROGUE_BEACON_NAME","descriptionKey":"UI_ROGUE_BEACON_DESC","secondary":"Special","tags":["Craftable","Consumable"],"baseValue":16,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ROGUE_BEACON","@type":"GameAsset"},{"id":"EXPD_CAPE07","name":"WHALESTALKER CLOAK","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Cape","description":"An exclusive Exosuit Appearance Override. This sweeping cloak was once worn by an ill-fated Traveller - obsessed with their quest to capture a cosmic leviathan, and doomed to repeat the chase for all eternity. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.CAPE07.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.cape07.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_ROGUECAPE_NAME","descriptionKey":"UI_ROGUECAPE_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_CAPE07","@type":"GameAsset"},{"id":"SPEC_FIREWORK06","name":"WHEEL OF HIRK FIREWORK","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Consumable Pyrotechnics Device","description":"A luxury firework. When activated, this pyrotechnic marvel turns and whorls in a mesmerising spiral. Ignite to create glittering displays in the sky. Place launch tube via the Build Menu (). Warning: Aim away from living creatures. Not recommended for indoor use.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.FIREWORK06.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.firework06.webp","colour":"#262626","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FIREWORK_PROD_WHEEL_NAME","descriptionKey":"UI_FIREWORK_PROD_WHEEL_DESC","secondary":"Exotic","tags":[],"baseValue":60,"level":0,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_FIREWORK06","@type":"GameAsset"},{"id":"F_ALL_RARE_L1","name":"WHISPERING BONEFISH","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Uncommon Fish","description":"UI_FISH_ALL_RARE_L_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.SMALL.3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.small.3.webp","colour":"#2177c8","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_ALL_RARE_L1_NAME","descriptionKey":"UI_FISH_ALL_RARE_L_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":10000,"level":2,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_ALL_RARE_L1","@type":"GameAsset"},{"id":"EXPD_EGG_03","name":"WHISPERING COMPANION EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Horrific Spawn","description":"A living, fertile egg, ready to hatch! A shadow writhes beneath the egg's protective membrane. Scans indicate the being within has the genetic potential to be nightmarish and soul-consuming.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.EXPEDITION.EGG03.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.expedition.egg03.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_EGG_03_NAME","descriptionKey":"UI_EXPD_EGG_03_DESC","secondary":"Exotic","tags":[],"baseValue":3200,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_EGG_03","@type":"GameAsset"},{"id":"F_DEEP_COM_M2","name":"WHISPERING JELLY","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_DEEP_COM_M_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.JELLY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.jelly.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_DEEP_COM_M2_NAME","descriptionKey":"UI_FISH_DEEP_COM_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":2000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_DEEP_COM_M2","@type":"GameAsset"},{"id":"FOOD_EGGPIE_M","name":"WHISPERING OMELETTE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.OMLETTE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.omlette.webp","colour":"#6ad01e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_EGGPIE_M_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":96000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_EGGPIE_M","@type":"GameAsset"},{"id":"TWITCH_GUN10","name":"WHISPERS OF THE ABYSS 4-F33-QP4","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Multifunction Survival Device","description":"An exclusive Multi-Tool. This rifle's Blaze Javelin delivers precise, powerful beams of energy to long-range targets, both damaging and stunning them. Take this Multi-Tool to add it to your collection, or Exchange it with your current Multi-Tool. Swap between active Multi-Tools from the Utilities section of the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.GUN10.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.gun10.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_GUN_10_NAME","descriptionKey":"UI_TWIT_GUN_10_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_GUN10","@type":"GameAsset"},{"id":"FREIGHT_WHITE","name":"WHITE","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Rare","subtitle":"Freighter Customisation Option","description":"Unlocks this colour for freighter customisation. A self-replicating cloud of highly pigmatised nano-robots swarm the capital ship, changing its external appearance.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.FREIGHTPAINT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.freightpaint.webp","colour":"#dedcd1","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_PAINT_WHITE_U","descriptionKey":"UI_PAINT_PROD_DESC","secondary":"Exotic","tags":[],"baseValue":12300,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FREIGHT_WHITE","@type":"GameAsset"},{"id":"FOOD_F_SMALL2","name":"WHITEBAIT","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A small morsel of seafood, created in the Nutrient Processor. Food such as this can be highly valuable. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.FISH.PRAWN.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.fish.prawn.webp","colour":"#095c77","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_FOOD_SMALL_2_NAME","descriptionKey":"UI_FISH_FOOD_SMALL_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":28000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_F_SMALL2","@type":"GameAsset"},{"id":"FOOD_F_XL2","name":"WHOLE ROAST FISH","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A huge slab of seafood, created in the Nutrient Processor. Food such as this can be highly valuable. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.FISH.TROUT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.fish.trout.webp","colour":"#095c77","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_FOOD_XL_2_NAME","descriptionKey":"UI_FISH_FOOD_XL_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":39000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_F_XL2","@type":"GameAsset"},{"id":"TRUCK_CAB02","name":"WIDESCREEN CABIN","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Rare","subtitle":"Exocraft Customisation Option","description":"A custom cabin module for a terrestrial vehicle, compatible with the Colossus large Exocraft. Recalibrate Exocraft visuals from the Colossus Geobay.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.2026.TRUCKCAB02.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.2026.truckcab02.webp","colour":"#dedcd1","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TRUCK_CAB02_NAME","descriptionKey":"UI_TRUCK_CAB_DESC","secondary":"Special","tags":[],"baseValue":12300,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TRUCK_CAB02","@type":"GameAsset"},{"id":"FOOD_V_MILK","name":"WILD MILK","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"An animal byproduct, this nutritious morsel can be easily farmed without harm to the animal that produces it. Process in a Nutrient Processor to generate edible products.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.MILK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.milk.webp","colour":"#dedcd1","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_GENERIC_MILK_NAME","descriptionKey":"FOOD_VEG_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":1600,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_V_MILK","@type":"GameAsset"},{"id":"FOOD_P_POOP","name":"WILD YEAST","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"An edible plant, harvested from planetary flora. Process in a Nutrient Processor to generate edible products.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.PLANT.POOPWILD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.plant.poopwild.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_PLANT_POOP_NAME","descriptionKey":"FOOD_PLANT_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":600,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_P_POOP","@type":"GameAsset"},{"id":"TECH_COMP","name":"WIRING LOOM","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Rare","subtitle":"Universal Technology Platform","description":"A prefabricated circuit board, designed for flexible use in a large range of technology components. The module features an integrated nanite processor, allowing it to be quickly configured for a wide variety of uses.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.TECHMODULE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.techmodule.webp","colour":"#0063b7","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TECHMOD_NAME","descriptionKey":"UI_TECHMOD_DESC","secondary":"Special","tags":[],"baseValue":25000,"level":0,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TECH_COMP","@type":"GameAsset"},{"id":"F_LUSH_EPIC_S1","name":"WISPSCALE DARTER","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Rare Fish","description":"UI_FISH_LUSH_EPIC_S_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.DEFAULT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.default.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_LUSH_EPIC_S1_NAME","descriptionKey":"UI_FISH_LUSH_EPIC_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":10000,"level":3,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_LUSH_EPIC_S1","@type":"GameAsset"},{"id":"BASE_SWAMP2","name":"WIZENED STUMP","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"This ancient stump was harvested from a clonal tree colony, estimated to have lived for over a hundred millennia. Its bark releases a pleasant mossy fragrance. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.SWAMPPLANT02.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.swampplant02.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_SWAMPPLANT_2_NAME","descriptionKey":"BLD_SWAMPPLANT_2_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_SWAMP2","@type":"GameAsset"},{"id":"TWITCH_SHIP61","name":"WK5 MIMAR","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship. This A-class hauler benefits from shield and inventory capacity bonuses, and is pre-installed with a selection of technologies and upgrades. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/TWITCH.SHIP61.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/twitch.ship61.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_61_NAME","descriptionKey":"UI_TWIT_SHIP_DROPSHIP_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP61","@type":"GameAsset"},{"id":"SPEC_EMOTE04","name":"WONDER","kind":"Product","category":"Emote","categoryKey":"Emote","rarity":"Common","subtitle":"Unlockable Gesture","description":"An exclusive gesture. This can be selected from the Quick Menu. Gaze up to large structures, fauna, flora, or the stars themselves, and marvel at the insignificance of one small life in all the universe.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.EMOTE04.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.emote04.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"EMOTE_WONDER_U","descriptionKey":"EMOTE_WONDER_DESC","secondary":"Exotic","tags":[],"baseValue":1500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_EMOTE04","@type":"GameAsset"},{"id":"WORLDSMB_SOUL","name":"WORLDSMB_SOUL","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"UI_WORLDSMB_SOUL_SUB","description":"UI_WORLDSMB_SOUL_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.WORLDSMB.SOULSEED.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.worldsmb.soulseed.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_WORLDSMB_SOUL_NAME","descriptionKey":"UI_WORLDSMB_SOUL_DESC","secondary":"Stellar","tags":["Craftable","Consumable"],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/WORLDSMB_SOUL","@type":"GameAsset"},{"id":"DECAL_WORM_P1","name":"WORM HUNT I DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This cursed decal depicts the mighty titan worm. \"The worm lord towers above the dusty earth; its flesh becomes the sky.\"","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.DECALPWORM1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.decalpworm1.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_P_WORM_P1_NAME","descriptionKey":"BLD_DECAL_P_WORM_P1_NAME_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/DECAL_WORM_P1","@type":"GameAsset"},{"id":"DECAL_WORM_P2","name":"WORM HUNT II DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This cursed decal depicts the mighty titan worm. \"The veins of the Atlas had surfaced.\"","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.DECALPWORM2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.decalpworm2.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_P_WORM_P2_NAME","descriptionKey":"BLD_DECAL_P_WORM_P2_NAME_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/DECAL_WORM_P2","@type":"GameAsset"},{"id":"DECAL_WORM_P3","name":"WORM HUNT III DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This cursed decal depicts the mighty titan worm. \"The rapture of our consumption is beyond words.\"","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.DECALPWORM3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.decalpworm3.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_P_WORM_P3_NAME","descriptionKey":"BLD_DECAL_P_WORM_P3_NAME_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/DECAL_WORM_P3","@type":"GameAsset"},{"id":"DECAL_WORM_P4","name":"WORM HUNT IV DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This cursed decal depicts the mighty titan worm. \"We tumble as it swallows, but grip the slick walls as best we can.\"","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.DECALPWORM4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.decalpworm4.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_P_WORM_P4_NAME","descriptionKey":"BLD_DECAL_P_WORM_P4_NAME_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/DECAL_WORM_P4","@type":"GameAsset"},{"id":"DECAL_WORM_P5","name":"WORM HUNT V DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This cursed decal depicts the mighty titan worm. \"My brethren were reborn, rising from the blessed dust as fresh tendrils.\"","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.DECALPWORM5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.decalpworm5.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_P_WORM_P5_NAME","descriptionKey":"BLD_DECAL_P_WORM_P5_NAME_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/DECAL_WORM_P5","@type":"GameAsset"},{"id":"SHIPSCAN_ALIEN","name":"WORMHOLE BRAIN","kind":"Technology","category":"Alien Ship","categoryKey":"AlienShip","rarity":"Impossible","subtitle":"Sentient Vessel Node","description":"The wormhole brain permits the ship vision of systems far beyond its own experience. It consists of strands of neural matter, wrapped around a micro-singularity and tethered directly to the ship's visual cortex. Detailed economic and conflict data will become available on the Galaxy Map, should the ship permit it.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/PRODUCT.STEM4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/product.stem4.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SHIPSCAN_ALIEN_NAME","descriptionKey":"UI_SHIPSCAN_ALIEN_DESC","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":3,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SHIPSCAN_ALIEN","@type":"GameAsset"},{"id":"WORMSCROLL1","name":"WORMSKIN FOLIO: 1","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Fleshy Scroll","description":"Ancient words are carved into this living document. They read: 'The worm lord towers above the dusty earth; its flesh becomes the sky. Our pathetic shells cannot follow, cannot reach its height, cannot reach its depths. We offer ourselves to the ground. We beg our sacrifice accepted.'","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/WORMSCROLL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/wormscroll.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_WORMSCROLL1_NAME","descriptionKey":"UI_WORMSCROLL1_DESC","secondary":"Special","tags":[],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/WORMSCROLL1","@type":"GameAsset"},{"id":"WORMSCROLL2","name":"WORMSKIN FOLIO: 2","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Fleshy Scroll","description":"Ancient words are carved into this living document. They read: 'The dust was choking. Our eyes reddened and watered. But the truth was inescapable. The veins of the Atlas had surfaced.'","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/WORMSCROLL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/wormscroll.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_WORMSCROLL2_NAME","descriptionKey":"UI_WORMSCROLL2_DESC","secondary":"Special","tags":[],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/WORMSCROLL2","@type":"GameAsset"},{"id":"WORMSCROLL3","name":"WORMSKIN FOLIO: 3","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Fleshy Scroll","description":"Ancient words are carved into this living document. They read: 'Now with every storm we beg to be chosen; Arms to the sky, faces to the dirt, calling out with all we have! When heavy raindrops hit the earth, the veins of Atlas answer. The rapture of our consumption is beyond words.'","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/WORMSCROLL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/wormscroll.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_WORMSCROLL3_NAME","descriptionKey":"UI_WORMSCROLL3_DESC","secondary":"Special","tags":[],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/WORMSCROLL3","@type":"GameAsset"},{"id":"WORMSCROLL4","name":"WORMSKIN FOLIO: 4","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Fleshy Scroll","description":"Ancient words are carved into this living document. They read: 'We tumble as it swallows, but grip the slick walls as best we can - Oh! - to reach the gizzard still awake. Breathe it deeply! How our lungs gurgle! The slime clogs our noses and stings our eyes, though in this warm darkness, we are already blind.'","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/WORMSCROLL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/wormscroll.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_WORMSCROLL4_NAME","descriptionKey":"UI_WORMSCROLL4_DESC","secondary":"Special","tags":[],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/WORMSCROLL4","@type":"GameAsset"},{"id":"WORMSCROLL5","name":"WORMSKIN FOLIO: 5","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Fleshy Scroll","description":"Ancient words are carved into this living document. They read: 'Curse the agony of regurgitation, Curse this this feeble flesh that still confines me! My brethren were reborn, rising from the blessed dust as fresh tendrils. Glistening capillaries to the great veins, slithering away into the sand. I will be patient. Until the next storm.'","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/WORMSCROLL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/wormscroll.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_WORMSCROLL5_NAME","descriptionKey":"UI_WORMSCROLL5_DESC","secondary":"Special","tags":[],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/WORMSCROLL5","@type":"GameAsset"},{"id":"F_GAS_EPIC_XL","name":"WRACKJAW","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Rare Fish","description":"UI_FISH_GAS_EPIC_XL_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.XL.3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.xl.3.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_GAS_EPIC_XL_NAME","descriptionKey":"UI_FISH_GAS_EPIC_XL_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":50000,"level":3,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_GAS_EPIC_XL","@type":"GameAsset"},{"id":"BASE_TOYJELLY","name":"WRIGGLING COMPANION","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Betentacled Steward","description":"The captured essence of an abyssal horror, contained for scientific and decorative use. The bounding forcefield is of the very highest quality. The companion cannot escape. The companion will not escape. Escape.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.TOYJELLY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.toyjelly.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_TOYJELLY_NAME","descriptionKey":"BLD_TOYJELLY_SUB","secondary":"BuildingPart","tags":["Craftable"],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_TOYJELLY","@type":"GameAsset"},{"id":"FOOD_DNUT_CJAM","name":"WRIGGLING DOUGHNUT","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.DOUGHNUT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.doughnut.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_DNUT_CJAM_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":70000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_DNUT_CJAM","@type":"GameAsset"},{"id":"FOOD_JAM_CRAB","name":"WRIGGLING JAM","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A refined food product, created in the Nutrient Processor. Food such as this can be highly valuable. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.JAM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.jam.webp","colour":"#db2400","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_JAM_CRAB_NAME","descriptionKey":"FOOD_REFINED_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":9000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_JAM_CRAB","@type":"GameAsset"},{"id":"FOOD_B_WORM","name":"WRIGGLING TACK","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A well-baked biscuit, created in the Nutrient Processor. What was once a thin sheet of vaguely-sweetend nutrient paste has been elevated with the addition of carefully-chosen ingredients.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.BISCUIT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.biscuit.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_B_WORM_NAME","descriptionKey":"UI_BISCUIT_DESC_REF","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":55000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_B_WORM","@type":"GameAsset"},{"id":"FOOD_PIE_CRABJ","name":"WRIGGLING TART","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.TART.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.tart.webp","colour":"#bb3830","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_PIE_CRABJ_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":54000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_PIE_CRABJ","@type":"GameAsset"},{"id":"F_ODD_RARE_M1","name":"WRITHING BRAINWORM","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Uncommon Fish","description":"UI_FISH_ODD_RARE_M_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT5.FISH.WORM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product5.fish.worm.webp","colour":"#2177c8","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_ODD_RARE_M1_NAME","descriptionKey":"UI_FISH_ODD_RARE_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":5000,"level":2,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_ODD_RARE_M1","@type":"GameAsset"},{"id":"BASE_RADPLANT01","name":"WRITHING BUSH","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A native of radioactive worlds, this curiously meaty succulent seems to sway gently even when the air is still... Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.RADPLANT01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.radplant01.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_RADPLANT_1_NAME","descriptionKey":"BLD_RADPLANT_1_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_RADPLANT01","@type":"GameAsset"},{"id":"FOOD_MM_JAM","name":"WRITHING JAM PUFF","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Writhing, Roiling Batter. Some caution is advised.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.CUPCAKEEVIL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.cupcakeevil.webp","colour":"#6ad01e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_MM_JAM_NAME","descriptionKey":"UI_CAKE_DESC_MM","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":153300,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_MM_JAM","@type":"GameAsset"},{"id":"WORMBOOK","name":"WRITHING MANUSCRIPT","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Cultist Document","description":"A translucent sheet of worm-vellum, inscribed with a fanatical text. It writhes when touched. 'The children were the first to notice. A thump thump thump, thundering deep below the sand. The first worm split the sky like black lightning as it leapt overhead. Worm by worm, they rose from the desert. Migrating. Every storm season, we each hope to be chosen. We arrange ourselves in lines across the desert, arms lifted to the sky. Anyone may enter the maw. We are all equal under the great worms.'","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/WORMBOOK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/wormbook.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_WORMBOOK_NAME","descriptionKey":"UI_WORMBOOK_DESC","secondary":"Special","tags":[],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/WORMBOOK","@type":"GameAsset"},{"id":"FOOD_R_MMERMIX","name":"WRITHING, ROILING BATTER","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A refined food product, created in the Nutrient Processor. Food such as this can be highly valuable. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.BATTER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.batter.webp","colour":"#6ad01e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_R_MMERMIX_NAME","descriptionKey":"FOOD_REFINED_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":100000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_R_MMERMIX","@type":"GameAsset"},{"id":"BASE_BUBPIPE_X","name":"X-SHAPED BUBBLE DUCT","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decorative Aqueduct","description":"This clear glass aqueduct encloses a perpetually churning supply of 'liquid'. This X-shaped configuration allows for connecting four ducts in a cruciform arrangement. Weld together with different duct shapes to create mesmerising displays in your base.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BUBBLEPIPE_X.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.bubblepipe_x.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_BUBBLE_PIPE_X_NAME","descriptionKey":"BLD_BUBBLE_PIPE_X_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_BUBPIPE_X","@type":"GameAsset"},{"id":"TWITCH_PET17","name":"X. LARVADOAGERA EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Companion Egg","description":"A living, fertile egg, ready to hatch! The biomechanical creature inside is silent, waiting to be hatched from stasis. Scans indicate the being within will grow into a dutiful companion, motivated to assist in exploration.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.PET17.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.pet17.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_PET_17_NAME","descriptionKey":"UI_TWIT_PET_17_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_PET17","@type":"GameAsset"},{"id":"TWITCH_PET26","name":"X. SPELLRISTREUS EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Companion Egg","description":"A living, fertile egg, ready to hatch! The creature inside flexes its hefty torso. Scans indicate the being within has the genetic potential for a dutiful disposition; a faithful and hard-working companion.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/TWITCH.PET26.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/twitch.pet26.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_PET_26_NAME","descriptionKey":"UI_TWIT_PET_26_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_PET26","@type":"GameAsset"},{"id":"SPEC_XOHELMET","name":"X.O. SUIT","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"UI_SPEC_XOHELMET_NAME_SUB","description":"UI_SPEC_XOHELMET_NAME_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BLOB_B.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.blob_b.webp","colour":"#262626","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SPEC_XOHELMET_NAME","descriptionKey":"UI_SPEC_XOHELMET_NAME_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_XOHELMET","@type":"GameAsset"},{"id":"FOOD_CP_JGLITCH","name":"XENO-SPONGE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Thick, Sweet Batter.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.CAKEBLOB.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.cakeblob.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_CP_JGLITCH_NAME","descriptionKey":"UI_CAKE_DESC_CB","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":80800,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_CP_JGLITCH","@type":"GameAsset"},{"id":"TWITCH_GUN09","name":"YAUZA'S QUANTUM TUNER","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Multifunction Survival Device","description":"An exclusive Multi-Tool. This alien weapon is fitted with an upgraded Pulse Spitter, the fuel-injected projectiles capable of igniting targets after impact. Take this Multi-Tool to add it to your collection, or Exchange it with your current Multi-Tool. Swap between active Multi-Tools from the Utilities section of the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.GUN09.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.gun09.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_GUN_09_NAME","descriptionKey":"UI_TWIT_GUN_09_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_GUN09","@type":"GameAsset"},{"id":"FREIGHT_YELLOW","name":"YELLOW","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Rare","subtitle":"Freighter Customisation Option","description":"Unlocks this colour for freighter customisation. A self-replicating cloud of highly pigmatised nano-robots swarm the capital ship, changing its external appearance.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.FREIGHTPAINT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.freightpaint.webp","colour":"#ffc356","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_PAINT_YELLOW_U","descriptionKey":"UI_PAINT_PROD_DESC","secondary":"Exotic","tags":[],"baseValue":12300,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FREIGHT_YELLOW","@type":"GameAsset"},{"id":"TWITCH_PET05","name":"Z. FALYNASCRIA EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Companion Egg","description":"A living, fertile egg, ready to hatch! The insect within clicks its great horns, eager to hatch and explore the universe. Scans indicate the being within has the genetic potential to be deeply adventurous, curious to explore planets beyond its marshy homeworld.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.TWITCH.PET05.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.twitch.pet05.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_PET_05_NAME","descriptionKey":"UI_TWIT_PET_05_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_PET05","@type":"GameAsset"},{"id":"TWITCH_PET09","name":"Z. PETALPOEMEUM EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Companion Egg","description":"A living, fertile egg, ready to hatch! The creature within wriggles whenever the egg is touched, excited by the prospect of hatching. Scans indicate the being within has the genetic potential for a sweet tempered nature, comforted by gentle touch.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.PET09.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.pet09.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_PET_09_NAME","descriptionKey":"UI_TWIT_PET_09_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_PET09","@type":"GameAsset"},{"id":"TWITCH_PET13","name":"Z. SPELTWIREUM EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Companion Egg","description":"A living, fertile egg, ready to hatch! The many-legged embryo chitters within its shell. Scans indicate the being within has the genetic potential for a cooperative personality.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.PET13.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.pet13.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_PET_13_NAME","descriptionKey":"UI_TWIT_PET_13_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_PET13","@type":"GameAsset"}]}
