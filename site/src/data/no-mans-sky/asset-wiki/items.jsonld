:"GameAsset"},{"id":"BUILDCHAIR4","name":"CLASSIC CHAIR","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Furniture","description":"A sturdy, well-constructed seat, standardised for installation in Space Stations across the galaxies. Its angular design is surprisingly ergonomic.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.CHAIR004.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.chair004.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_BUILDCHAIR4_NAME","descriptionKey":"BLD_BUILDCHAIR4_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BUILDCHAIR4","@type":"GameAsset"},{"id":"F_LUSH_COM_M2","name":"CLEARWATER SKIPPER","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_LUSH_COM_M_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.BIG.3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.big.3.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_LUSH_COM_M2_NAME","descriptionKey":"UI_FISH_LUSH_COM_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":2000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_LUSH_COM_M2","@type":"GameAsset"},{"id":"STEALTH","name":"CLOAKING DEVICE","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"VeryRare","subtitle":"Active Camouflage Unit","description":"On activation, this module draws power from Exosuit Life Support systems to manipulate the gravitational field around the user, refracting the light and creating an active camouflage effect. This temporary effect can be used to escape unwanted hostile attention. WARNING: active camouflage will be aborted upon dramatic Exosuit manoeuvres such as jetpack activation, or by activating Multi-Tool weapons systems.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4TECH/RENDER.STEALTH.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4tech/render.stealth.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_STEALTH_NAME","descriptionKey":"UI_STEALTH_DESC","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/STEALTH","@type":"GameAsset"},{"id":"BASE_SUBZPLANT1","name":"CLOSED SEED CONE","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A large organic structure, housing the seeds of coniferous megaflora. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BIOMEPROP.SUBZPLANT1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.biomeprop.subzplant1.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_SUBZPLANT_1_NAME","descriptionKey":"BLD_SUBZPLANT_1_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_SUBZPLANT1","@type":"GameAsset"},{"id":"BASE_GRASS6","name":"CLOVEN PAW GRASS","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A tough ornamental grass, suitable for growing in all biomes, soil types, and weather conditions. Cloven paw bears more structural similarity to a shrub than a true grass, and features large glossy leaves for rapid photosynthesis.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.GRASS06.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.grass06.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_GRASS_6_NAME","descriptionKey":"BLD_GRASS_6_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_GRASS6","@type":"GameAsset"},{"id":"CAVE1","name":"COBALT","kind":"Resource","category":"Earth","categoryKey":"Earth","rarity":"Common","subtitle":"Subterranean Mineral","description":"Mined from underground minerals, cobalt is found in plentiful supply in caves and caverns. Useful in the manufacture of Ion Batteries. It is used in the creation of several technologies and structures, and can be processed in a Refiner to make the most of its inherent charge.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.CAVE.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.cave.1.webp","colour":"#005c83","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_CAVE1_NAME","descriptionKey":"UI_CAVE1_DESC","secondary":"Substance","tags":[],"baseValue":76,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/CAVE1","@type":"GameAsset"},{"id":"CAVE_CRAFT","name":"COBALT MIRROR","kind":"Product","category":"Component","categoryKey":"Component","rarity":"Uncommon","subtitle":"Crafted Technology Component","description":"A specialist optical component. Employing a polished cobalt surface, this mirror is able to selectively filter different wavelengths of light, changing its reflective pattern based on nearby magnetic fields.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.COBALTMIRROR.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.cobaltmirror.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_CAVE_CRAFT_NAME","descriptionKey":"UI_CAVE_CRAFT_DESC","secondary":"Stellar","tags":["Consumabl