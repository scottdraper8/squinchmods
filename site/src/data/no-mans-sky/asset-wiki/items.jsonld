d/icons/update3/ultraprod.1.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_ULTRAPROD_1_NAME","descriptionKey":"UI_ULTRAPROD_1_DESC","secondary":"Special","tags":["Craftable"],"baseValue":15600000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ULTRAPROD1","@type":"GameAsset"},{"id":"JETS_FUSION","name":"FUSION JETPACK TRAIL","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Jetpack Exhaust Override","description":"An exclusive Exosuit Appearance Override. Harnesses natural stellar processes to make the Jetpack output blaze. A light-diffusing compound protects the user and onlookers from retinal damage. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.JETS.FUSION.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.jets.fusion.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_JETTRAIL_FUSION_NAME","descriptionKey":"UI_JETTRAIL_FUSION_DESC","secondary":"Exotic","tags":[],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/JETS_FUSION","@type":"GameAsset"},{"id":"TWITCH_PET23","name":"G. LYCONATAE EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Companion Egg","description":"A living, fertile egg, ready to hatch! The weight inside this egg shifts constantly, as though the creature within is bouncing energetically. Scans indicate the being within has the genetic potential to be an adventurous companion, curious to explore planets beyond its frozen homeworld.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/TWITCH.PET23.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/twitch.pet23.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_PET_23_NAME","descriptionKey":"UI_TWIT_PET_23_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_PET23","@type":"GameAsset"},{"id":"TWITCH_PET03","name":"G. OESTRIDINZEUS EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Companion Egg","description":"A living, fertile egg, ready to hatch! The weight inside this egg shifts constantly, as though the creature within is bouncing energetically. Scans indicate the being within has the genetic potential to be a sweet tempered companion, soothed by gentle interactions.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.TWITCH.PET03.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.twitch.pet03.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_PET_03_NAME","descriptionKey":"UI_TWIT_PET_03_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_PET03","@type":"GameAsset"},{"id":"BANNER_HUB","name":"GALACTIC HUB BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Equip this exclusive Personal Flair and explore together! Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BANNER.HUB.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.banner.hub.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_HUB_NAME","descriptionKey":"UI_BANNER_HUB_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BANNER_HUB","@type":"GameAsset"},{"id":"SPEC_DECAL02","name":"GALACTIC HUB DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal depicts an emblem bearing the mission statement: 'Explore Together'.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.DECAL02.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.decal02.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_GALHUB_NAME","descriptionKey":"BLD_DECAL_GALHUB_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_DECAL02","@type":"GameAsset"},{"id":"PLANT_RADIO","name":"GAMMA ROOT","kind":"Resource","category":"Flora","categoryKey":"Flora","rarity":"Rare","subtitle":"Harvested Agricultural Substance","description":"A strange substance that seems to slowly shift the air around it. It is found in the roots of the Gamma Weed plant. Gamma Weed requires high background radiation to thrive in the wild, but can be farmed in all environments with the aid of a Hydroponics Tray.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.PLANT.RADIO.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.plant.radio.webp","colour":"#c5871d","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_PLANTSUB_RADIO_NAME","descriptionKey":"UI_PLANTSUB_RADIO_DESC","secondary":"Substance","tags":["Cooking ingredient"],"baseValue":16,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/PLANT_RADIO","@type":"GameAsset"},{"id":"F_RAD_LEG_L1","name":"GAMMA SQUID","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Legendary Fish","description":"\"A pale blue glow surrounds it as it drifts through the water - a warning to all those who would come too close...\"","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT4.FISH.SQUID.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product4.fish.squid.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_RAD_LEG_L1_NAME","descriptionKey":"UI_FISH_RAD_LEG_L_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":150000,"level":4,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_RAD_LEG_L1","@type":"GameAsset"},{"id":"EXPD_POSTER17A","name":"GAS GIANT POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster shows the titanic form of a gas giant and its surrounding moons.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S17.POSTERA.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s17.postera.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER17A_NAME","descriptionKey":"BLD_EXPD_POSTER17A_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER17A","@type":"GameAsset"},{"id":"F_GAS_COM_S1","name":"GAS-WORM","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_GAS_COM_S_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.WORM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.worm.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_GAS_COM_S1_NAME","descriptionKey":"UI_FISH_GAS_COM_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":1000,"leve