D_ATLASPACK","name":"ATLAS FLIGHTPACK","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Exosuit Visual Enhancement","description":"An exclusive Exosuit Appearance Override. A lightweight jetpack, welded from stellar alloys around a fiery crimson core. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.ATLASPACK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.atlaspack.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_ATLASPACK_NAME","descriptionKey":"UI_EXPD_ATLASPACK_DESC","secondary":"Exotic","tags":[],"baseValue":3500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_ATLASPACK","@type":"GameAsset"},{"id":"BANNER_AF","name":"ATLAS FOUNDATION BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Equip this exclusive Personal Flair to represent the enigmatic organisation known as the Atlas Foundation. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BANNER.ATLASFOUNDATION.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.banner.atlasfoundation.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_AF_NAME","descriptionKey":"UI_BANNER_AF_DESC","secondary":"BuildingPart","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BANNER_AF","@type":"GameAsset"},{"id":"DECAL_AF","name":"ATLAS FOUNDATION DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This emblem represents the Citizen Science Division of the enigmatic Atlas Foundation.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.DECAL23.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.decal23.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_AF_NAME","descriptionKey":"BLD_DECAL_AF_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/DECAL_AF","@type":"GameAsset"},{"id":"EXPD_ATLASHELM","name":"ATLAS HEADSHIELD","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Helmet","description":"An exclusive Exosuit Appearance Override. A soft but immutable heartbeat resonates through your skull when you wear this helmet. A T L A S. The pulse is strangely soothing. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.ATLASHELM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.atlashelm.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_ATLASHELM_NAME","descriptionKey":"UI_EXPD_ATLASHELM_DESC","secondary":"Exotic","tags":[],"baseValue":3200,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_ATLASHELM","@type":"GameAsset"},{"id":"EXPD_POSTER10A","name":"ATLAS POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster glows with a crimson so intense, it lingers when you close your eyes.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.POSTER10A.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.poster10a.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER10A_NAME","descriptionKey":"BLD_EXPD_POSTER10A_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER10A","@type":"GameAsset"},{"id":"EXPD_ATLASSTAFF","name":"ATLAS SCEPTRE","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Unique Korvax Technology?","description":"An exclusive Multi-Tool. This unusual ceremonial staff was hand-forged by a Korvax Priest Entity in tribute to the Atlas. Take this Multi-Tool to add it to your collection, or Exchange it with your current Multi-Tool. Swap between active Multi-Tools from the Utilities section of the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.ATLASSTAFF.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.atlasstaff.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_ATLASSTAFF_NAME","descriptionKey":"UI_EXPD_ATLASSTAFF_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_ATLASSTAFF","@type":"GameAsset"},{"id":"S_POSTER27","name":"ATLAS SEED POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster depicts an Atlas-like silhouette bursting forth from a planetary crust.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.S_POSTER27.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.s_poster27.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_S_POSTER27_NAME","descriptionKey":"BLD_S_POSTER27_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S_POSTER27","@type":"GameAsset"},{"id":"ATLAS_STONE","name":"ATLAS STONE","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Very high value curiosity","description":"A spherical gem that seems to pulsate with red light from its centre. An extremely rare item often associated with ancient monolithic sites.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.ATLASSTONE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.atlasstone.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"CURIO4_NAME","descriptionKey":"CURIO4_DESCRIPTION","secondary":"Special","tags":[],"baseValue":68750,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ATLAS_STONE","@type":"GameAsset"},{"id":"ACCESS1","name":"ATLASPASS v1","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Access Card","description":"Security and permissions pass granted to specific travellers by many primary galactic species. Provides access to low level restricted areas and outpost systems.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.ATLASPASS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.atlaspass.webp","colour":"#0063b7","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"ACCESS1_NAME","descriptionKey":"ACCESS1_DESCRIPTION","secondary":"Stellar","tags":["Craftable"],"baseValue":825,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ACCESS1","@type":"GameAsset"},{"id":"ACCESS2","name":"ATLASPASS v2","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Uncommon","subtitle":"Access Card","description":"Security and permissions pass granted to specific travellers by many primary galactic species. Provides access to mid-tier restricted areas and outpost systems.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.ATLASPASS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.atlaspass.webp","colour":"#0063b7","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"ACCESS2_NAME","descriptionKey":"ACCESS2_DESCRIPTION","secondary":"Stellar","tags":["Craftable"],"baseValue":1856,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ACCESS2","@type":"GameAsset"},{"id":"ACCESS3","name":"ATLASPASS v3","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Access Card","description":"Security and permissions pass granted to specific travellers by many primary galactic species. Provides access to high level restricted areas and outpost systems.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.ATLASPASS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.atlaspass.webp","colour":"#0063b7","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"ACCESS3_NAME","descriptionKey":"ACCESS3_DESCRIPTION","secondary":"Stellar","tags":["Craftable"],"baseValue":2613,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ACCESS3","@type":"GameAsset"},{"id":"ACCESS4","name":"ATLASPASS v4","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Access Card","description":"Security and permissions pass granted to specific travellers by many primary galactic species. Provides access to high level restricted areas and outpost systems.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.ATLASPASS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.atlaspass.webp","colour":"#0063b7","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"ACCESS4_NAME","descriptionKey":"ACCESS