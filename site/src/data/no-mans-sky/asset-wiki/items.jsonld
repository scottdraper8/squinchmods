,"secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_HOTPLANT06","@type":"GameAsset"},{"id":"BASE_MEDPLANT01","name":"CARNIVOROUS BUSH","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A medium-sized decorative plant. Each of its leaves is covered in a thin film of sticky latex. Insects that land on these leaves are slowly absorbed by digestive hormones mixed in with the glue. Avoid accidental skin contact.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.MEDPLANT01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.medplant01.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_MEDPLANT_1_NAME","descriptionKey":"BLD_MEDPLANT_1_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_MEDPLANT01","@type":"GameAsset"},{"id":"SENTFREI_PROD","name":"CARRIER AI FRAGMENT","kind":"Product","category":"Component","categoryKey":"Component","rarity":"Rare","subtitle":"Battleship Core Remnant","description":"A single splinter of the colossal mainframe at the heart of a Sentinel capital ship. It blinks, its solitary living eye trained upon the one piece of data it retains - the last known location of one of its fleet of Interceptors. Select the AI Fragment and use Search Archive () to translate information about Interceptor's crash site to your starship's navigation systems.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.FREIGHTERCORE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.freightercore.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SENTFREI_PROD_NAME","descriptionKey":"UI_SENTFREI_PROD_DESC","secondary":"Special","tags":["Consumable"],"baseValue":35000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SENTFREI_PROD","@type":"GameAsset"},{"id":"EXPD_POSTER17C","name":"CARTOGRAPHER'S CHART","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. A planetary map, designed to show the detailed survey results gathered during the exploration of unmapped worlds.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S17.POSTERC.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s17.posterc.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER17C_NAME","descriptionKey":"BLD_EXPD_POSTER17C_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER17C","@type":"GameAsset"},{"id":"EXPD_BANNER03","name":"CARTOGRAPHERS EXPEDITION BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Equip this exclusive Personal Flair in commemoration of the 'Cartographers' Expedition, and your success in documenting and then escaping from the expedition planet. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.EXPEDITION.BANNER03.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.expedition.banner03.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_EXPD_03_NAME","descriptionKey":"UI_BANNER_EXPD_03_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_BANNER03","@type":"GameAsset"},{"id":"EXPD_DECAL03","name":"CARTOGRAPHERS EXPEDITION DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal commemorates your success in documenting and then escaping from the expedition planet.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.EXPEDITION.DECAL03.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.expedition.decal03.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_EXPD_03_NAME","descriptionKey":"BLD_DECAL_EXPD_03_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_DECAL03","@type":"GameAsset"},{"id":"BUI_HEAD_7","name":"CASING OF THE HUNT","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Rare","subtitle":"Autophage Appearance Modification","description":"An exclusive Exosuit Appearance Override, granted by the Autophage to those who seek to build their own shell. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/ROBOTPARTS/ROBOTPARTS.HEAD.7.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/robotparts/robotparts.head.7.webp","colour":"#8c4b9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TIP_HEAD_BUI_7_U","descriptionKey":"UI_BUILDER_CUSTOM_DESC","secondary":"Exotic","tags":[],"baseValue":999,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BUI_HEAD_7","@type":"GameAsset"},{"id":"TRUCK_WHEELS06","name":"CATERPILLAR TRACK","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Rare","subtitle":"Exocraft Customisation Option","description":"A custom running ge