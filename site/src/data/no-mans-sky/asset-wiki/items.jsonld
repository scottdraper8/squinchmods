LAG_B_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SWARM_FLAG_B3","@type":"GameAsset"},{"id":"BASE_FLORAL04","name":"TASSEL LILY","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A small, attractive plant, native to humid climates. This petalled variety is in the early stage of blooming. The dewy \"tassels\" radiate a gentle light, attracting nocturnal pollinators. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BIOMEPROP.FLORAL04.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.biomeprop.floral04.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_FLORAL_4_NAME","descriptionKey":"BLD_FLORAL_4_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_FLORAL04","@type":"GameAsset"},{"id":"BASE_FLORAL01","name":"TASSEL WEED","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A small, attractive plant, native to humid climates. The dewy \"tassels\" radiate a gentle light, attracting nocturnal pollinators. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BIOMEPROP.FLORAL01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.biomeprop.floral01.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_FLORAL_1_NAME","descriptionKey":"BLD_FLORAL_1_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_FLORAL01","@type":"GameAsset"},{"id":"EXPD_POSTER18B","name":"TAXONOMY POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. A lovely catalogue of different skulls, in case you need a reference.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S18.POSTERB.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s18.posterb.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER18B_NAME","descriptionKey":"BLD_EXPD_POSTER18B_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER18B","@type":"GameAsset"},{"id":"SPEC_FIREWORK12","name":"TEAL RIBBON FIREWORK","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Consumable Pyrotechnics Device","description":"This exotic firework, sparkling with zinc and antimony elements, bursts into a cluster of wildly spiralling ribbons. Ignite to create glittering displays in the sky. Place launch tube via the Build Menu (). Warning: Aim away from living creatures. Not recommended for indoor use.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.FIREWORK12.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.firework12.webp","colour":"#262626","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FIREWORK_PROD_SWIRL_T_NAME","descriptionKey":"UI_FIREWORK_PROD_SWIRL_T_DESC","secondary":"Exotic","tags":[],"baseValue":60,"level":0,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_FIREWORK12","@type":"GameAsset"},{"id":"TRA_COMMODITY5","name":"TELEPORT COORDINATORS","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Trade Goods","description":"A bundle of precisely calibrated teleport coordinators. These pin-prick sized circuits are vital to the delicate process of inserting reinforcing material into advanced alloys. They can also aid long-distance sales efforts.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.COMMODITY5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.commodity5.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TRADE_ITEM_COMMOD_5_NAME","descriptionKey":"UI_TRADE_ITEM_COMMOD_5_DESC","secondary":"Exotic","tags":["Trade good"],"baseValue":50000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TRA_COMMODITY5","@type":"GameAsset"},{"id":"SHIP_TELEPORT","name":"TELEPORT RECEIVER","kind":"Technology","category":"All Ships Except Alien","categoryKey":"AllShipsExceptAlien","rarity":"VeryRare","subtitle":"Ship-Mounted Teleportation Device","description":"A device that modulates standard starship communication signals to enable the transport of matter as well as data. Starships fitted with such a device can send and receive products and substances to a user's exosuit over a long distance.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4TECH/RENDER.SHIPTELEPORT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4tech/render.shipteleport.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"SHIP_TELEPORT_NAME","descriptionKey":"SHIP_TELEPORT_DESC","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SHIP_TELEPORT","@type":"GameAsset"},{"id":"SHIP_ROGUE","name":"TEMPORAL STARSHIP TRAIL","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Starship Exhaust Override","description":"An exclusive Starship Exhaust Modifier. A cosmic resonance chamber interacts with starship exhaust, modifying propulsion energy to leave a streak of temporal disturbances. Install this technology in your starship inventory to change the appearance of the engine exhaust trails.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.SHIPTRAIL.ROGUE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.shiptrail.rogue.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SHIPTRAIL_ROGUE_NAME","descriptionKey":"UI_SHIPTRAIL_ROGUE_DESC","secondary":"Exotic","tags":[],"baseValue":2100,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SHIP_ROGUE","@type":"GameAsset"},{"id":"T_SHIP_ROGUE","name":"TEMPORAL STARSHIP TRAIL","kind":"Technology","category":"All Ships","categoryKey":"AllShips","rarity":"Impossible","subtitle":"Starship Exhaust Override","description":"An exclusive Starship Exhaust Modifier. A cosmic resonance chamber interacts with starship exhaust, modifying propulsion energy to leave a streak of temporal disturbances. Install this technology in your starship inventory to change the appearance of the engine exhaust trails.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.SHIPTRAIL.ROGUE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.shiptrail.rogue.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SHIPTRAIL_ROGUE_NAME","descriptionKey":"UI_SHIPTRAIL_ROGUE_DESC","secondary":"Installable","tags":[],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/T_SHIP_ROGUE","@type":"GameAsset"},{"id":"F_HACCESS3","name":"TEMPORAL WARP COMPUTER","kind":"Technology","category":"Freighter","categoryKey":"Freighter","rarity":"Impossible","subtitle":"Hyperdrive Upgrade: Blue Systems","description":"Upgrades the hyperdrive's computational matrix, preventing temporal anomalies when attempting to reach rare-class blue stellar bodies. User is advised to access Hyperdrive systems via the Galactic Map.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/TECHNOLOGY.FREIGHTERTHETA.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/technology.freightertheta.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"RGB_WARP_3_NAME","descriptionKey":"RGB_WARP_3_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":4,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/F_HACCESS3","@type":"GameAsset"},{"id":"F_GAS_EPIC_L1","name":"TENDRILLA","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Rare Fish","description":"UI_FISH_GAS_EPIC_L_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT2.FISH.OCTOPUS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product2.fish.octopus.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_GAS_EPIC_L1_NAME","descriptionKey":"UI_FISH_GAS_EPIC_L_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":30000,"level":3,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_GAS_EPIC_L1","@type":"GameAsset"},{"id":"BASE_TOXPLANT03","name":"TENTACLE SPIRE","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"This delightful architectural floral combines two highly popular aesthetics: wriggling tentacles and giant fungi. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.TOXPLANT03.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.toxplant03.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_TOXPLANT_3_NAME","descriptionKey":"BLD_TOXPLANT_3_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_TOXPLANT03","@type":"GameAsset"},{"id":"BANNER_SLIMY","name":"TENTACLED BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Express your curiosity about abyssal alien lifeforms with this exclusive Personal Flair. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BANNER.SLIMY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.banner.slimy.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_SLIMY_NAME","descriptionKey":"UI_BANNER_SLIMY_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BANNER_SLIMY","@type":"GameAsset"},{"id":"CAPE_JELLY","name":"TENTACLED CAPE","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Cape","description":"An exclusive Exosuit Appearance Override. Flow across the galaxy with this cape's lattice of fluttering tentacles, woven from regenerated cellulose fibres. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.CAPE.JELLY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.cape.jelly.webp","colour":"#008951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_CAPE_JELLY_NAME","descriptionKey":"UI_CAPE_JELLY_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/CAPE_JELLY","@type":"GameAsset"},{"id":"DECAL_JELLY","name":"TENTACLED DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add a touch of macabre decoration to bases. This decal depicts a many-armed sentience, found drifting in the dark places of the universe.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.DECALJELLY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.decaljelly.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_JELLY_NAME","descriptionKey":"BLD_DECAL_JELLY_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/DECAL_JELLY","@type":"GameAsset"},{"id":"BOBBLE_OCTO","name":"TENTACLED FIGURINE","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Starship Interior Adornment","description":"A synthetic polymer companion for your starship's cockpit, fashioned in the likeness of a sea creature. Install to an Inventory Slot to decorate your ship's interior.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.OCTOBOBBLE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.octobobble.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S15_FISH_BOBBLE","descriptionKey":"UI_S15_FISH_BOBBLE_DESC","secondary":"Exotic","tags":[],"baseValue":3200,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BOBBLE_OCTO","@type":"GameAsset"},{"id":"T_BOBBLE_OCTO","name":"TENTACLED FIGURINE","kind":"Technology","category":"All Ships","categoryKey":"AllShips","rarity":"Impossible","subtitle":"Starship Interior Adornment","description":"A synthetic polymer companion for your starship's cockpit, fashioned in the likeness of a sea creature. Install to an Inventory Slot to decorate your ship's interior.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.OCTOBOBBLE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.octobobble.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_S15_FISH_BOBBLE","descriptionKey":"UI_S15_FISH_BOBBLE_DESC","secondary":"Installable","tags":[],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/T_BOBBLE_OCTO","@type":"GameAsset"},{"id":"TERRAINEDITOR","name":"TERRAIN MANIPULATOR","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Common","subtitle":"Landscape Shaping Tool","description":"Advanced terraforming device. This module overloads existing multi-tool systems, allowing the user to reshape regions as they wish. Charged with metallic elements.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.TERRAINEDITOR.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.terraineditor.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_TERRAIN_EDIT_NAME","descriptionKey":"UI_TERRAIN_EDIT_DESC","secondary":"Installable","tags":["Chargeable","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/TERRAINEDITOR","@type":"GameAsset"},{"id":"BASE_TERRARIUM","name":"TERRARIUM","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Specialised Creature Enclosure","description":"A small observatory unit for studying animal behaviours. Completely self-contained, complete with inbuilt nutrient processor, air purifier and faecal disposal system.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.TERRARIUM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.terrarium.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_TERRARIUM_NAME","descriptionKey":"BLD_TERRARIUM_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_TERRARIUM","@type":"GameAsset"},{"id":"EXPD_POSTER05C","name":"TERRITORIES POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This adrenaline-fueled poster depicts two noble herd leaders clashing over territory.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.POSTER05C.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.poster05c.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER5C_NAME","descriptionKey":"BLD_EXPD_POSTER5C_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER05C","@type":"GameAsset"},{"id":"SUB_LASER","name":"TETHYS BEAM","kind":"Technology","category":"Submarine","categoryKey":"Submarine","rarity":"Impossible","subtitle":"Submarine Mining Laser","description":"A mounted laser system specifically designed for the Nautilon Submarine. Fires a concentrated plasma beam towards the intended target, which is then ignited. Such a trigger mechanism allows the use of high-energy optical mining systems in a liquid medium.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/VEHICLE/RENDER.VEHICLE_LASER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/vehicle/render.vehicle_laser.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SUBLASER_NAME","descriptionKey":"UI_SUBLASER_DESC","secondary":"Installable","tags":["Chargeable","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SUB_LASER","@type":"GameAsset"},{"id":"CAVEPROD3","name":"TETRACOBALT","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Concentrated Cobalt Deposit","description":"A novel molecular form of Cobalt, requiring very high energy levels to create. Natural occurrence is extremely rare. Synthesised from Ionised Cobalt.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.CAVEPROD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.caveprod.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_CAVEPROD3_NAME","descriptionKey":"UI_CAVEPROD3_DESC","secondary":"Exotic","tags":[],"baseValue":6150,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/CAVEPROD3","@type":"GameAsset"},{"id":"F_COLD_COM_M2","name":"THAWED DIAMONDFIN","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_COLD_COM_M_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT2.FISH.BIG.3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product2.fish.big.3.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_COLD_COM_M2_NAME","descriptionKey":"UI_FISH_COLD_COM_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":2000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_COLD_COM_M2","@type":"GameAsset"},{"id":"S15_FISH","name":"THE ANGLER","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Rare","subtitle":"Legendary Fish","description":"Fire dances across the scales of this impossible marine being. Its starlit eyes stare back at you with a meaning far deeper than any fish should know. As they stare, the world around you fades away. The sound of water fills your ears. It wants to be free. You want to be free...","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.OCTOPUS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.octopus.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S15_FISH_NAME","descriptionKey":"UI_S15_FISH_DESC","secondary":"Special","tags":["Craftable","Cooking ingredient"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S15_FISH","@type":"GameAsset"},{"id":"S15_MESSAGE0","name":"THE ANGLER'S DIARY","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Collected Flotsam","description":"A message recovered from a bottle stowed beneath the seat of the starship. It reads: \"I finally feel like I'm getting closer. A trader on Gisto offered me solid-gold information on its location, for a price. And so I'm selling my ship. I'll miss the Celeste, but I have to know if the rumours are true. I hope whoever buys you takes good care of you...\" %PARTY_1%","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.MESSAGE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.message.webp","colour":"#8a7f72","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S15_BOTTLED_MESSAGE_NAME","descriptionKey":"UI_S15_BOTTLED_MESSAGE1_DESC","secondary":"Special","tags":["Craftable"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S15_MESSAGE0","@type":"GameAsset"},{"id":"S15_MESSAGE1","name":"THE ANGLER'S DIARY","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Collected Flotsam","description":"A scrap of paper recovered from a bottle found bobbling in the water. The message on it reads: \"The rumours were true. It's out there, I can feel it. Not here, but somewhere. The water calls to me, I just need to follow its voice...\" %PARTY_3%","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.MESSAGE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.message.webp","colour":"#8a7f72","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S15_BOTTLED_MESSAGE_NAME","descriptionKey":"UI_S15_BOTTLED_MESSAGE2_DESC","secondary":"Special","tags":["Craftable"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S15_MESSAGE1","@type":"GameAsset"},{"id":"S15_MESSAGE2","name":"THE ANGLER'S DIARY","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Collected Flotsam","description":"A scrap of paper recovered from a bottle found bobbling in the water. The message on it reads: \"I saw it in my dreams last night. Scales like fire and eyes of pure starlight. It sang to me, a song of hope and longing. It wants me to find it, I know it. I must be closing in.\" %PARTY_4%","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.MESSAGE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.message.webp","colour":"#8a7f72","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S15_BOTTLED_MESSAGE_NAME","descriptionKey":"UI_S15_BOTTLED_MESSAGE3_DESC","secondary":"Special","tags":["Craftable"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S15_MESSAGE2","@type":"GameAsset"},{"id":"S15_MESSAGE3","name":"THE ANGLER'S DIARY","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Collected Flotsam","description":"A scrap of paper recovered from a bottle found bobbling in the water. The message on it reads: \"I was right! It was here! After all these light years, all the doubts, it's finally mine. Oh, and how it shines! Like fire in the water, beautiful, impossible...\" %PARTY_5%","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.MESSAGE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.message.webp","colour":"#8a7f72","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S15_BOTTLED_MESSAGE_NAME","descriptionKey":"UI_S15_BOTTLED_MESSAGE4_DESC","secondary":"Special","tags":["Craftable"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S15_MESSAGE3","@type":"GameAsset"},{"id":"S15_MESSAGE4","name":"THE ANGLER'S DIARY","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Collected Flotsam","description":"A scrap of paper recovered from a bottle found bobbling in the water. The message on it reads: \"The fire has faded from my catch's scales, and my dreams have soured. I thrash through the night. My skin itches, damp and clammy. Salt seeps from my pores. It longs to be free. I cannot keep it contained like this. It must be free. I must be free...\"","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.MESSAGE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.message.webp","colour":"#8a7f72","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S15_BOTTLED_MESSAGE_NAME","descriptionKey":"UI_S15_BOTTLED_MESSAGE5_DESC","secondary":"Special","tags":["Craftable"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S15_MESSAGE4","@type":"GameAsset"},{"id":"TWITCH_SHIP27","name":"THE ASHES OF DEVASTATION","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship. This A-class solar ship benefits from damage and shield bonuses, as well as a beautiful high-tech Vesper Sail. pre-installed with a selection of technologies and upgrades. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.SHIP27.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.ship27.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_27_NAME","descriptionKey":"UI_TWIT_SHIP_SAIL_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP27","@type":"GameAsset"},{"id":"TWITCH_SHIP42","name":"THE DEPARTURE OF FIRE","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship. This A-class solar ship benefits from damage and shield bonuses, as well as a beautiful high-tech Vesper Sail. pre-installed with a selection of technologies and upgrades. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.SHIP42.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.ship42.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_42_NAME","descriptionKey":"UI_TWIT_SHIP_SAIL_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP42","@type":"GameAsset"},{"id":"TWITCH_SHIP50","name":"THE FORGE OF THE GEK","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship. This A-class fighter benefits from damage and manoeuvrability bonuses, and is pre-installed with a selection of technologies and upgrades. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/TWITCH.SHIP50.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/twitch.ship50.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_50_NAME","descriptionKey":"UI_TWIT_SHIP_FIGHTER_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP50","@type":"GameAsset"},{"id":"F_DEEP_LEG_L1","name":"THE HUNTER BELOW","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Legendary Fish","description":"\"Streamlined, deadly, perfect: the terror of the deep.\"","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT5.FISH.XL.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product5.fish.xl.2.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_DEEP_LEG_L1_NAME","descriptionKey":"UI_FISH_DEEP_LEG_L_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":150000,"level":4,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_DEEP_LEG_L1","@type":"GameAsset"},{"id":"SPEC_BUG_HAT2","name":"THE HUNTER'S JAWS","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Helmet","description":"An exclusive Exosuit Appearance Override. A fusion of advanced technology and resinous organic secretions, this insectoid helmet represents the apex of bio-organic engineering. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.SPECBUGHAT2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.specbughat2.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SPEC_BUG_HAT2_NAME","descriptionKey":"UI_EXPED_BUG_HAT_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_BUG_HAT2","@type":"GameAsset"},{"id":"EXPD_POSTER07B","name":"THE LOOP POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster represents the reiterative nature of time.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.POSTER07B.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.poster07b.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER7B_NAME","descriptionKey":"BLD_EXPD_POSTER7B_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER07B","@type":"GameAsset"},{"id":"F_ALL_LEG_XL","name":"THE LUNKER","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Legendary Fish","description":"\"A true titan of the depths. Nothing compares for sheer mass.\"","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.XL.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.xl.2.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_ALL_LEG_XL_NAME","descriptionKey":"UI_FISH_ALL_LEG_XL_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":200000,"level":4,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_ALL_LEG_XL","@type":"GameAsset"},{"id":"TWITCH_SHIP58","name":"THE MASTER OF SLEEP","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship. This A-class explorer benefits from hyperdrive and launcher bonuses, and is pre-installed with a selection of technologies and upgrades. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/TWITCH.SHIP58.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/twitch.ship58.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_58_NAME","descriptionKey":"UI_TWIT_SHIP_SCIENTIFIC_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP58","@type":"GameAsset"},{"id":"F_GAS_LEG_XL","name":"THE MAW OF TITAN","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Legendary Fish","description":"\"So few things survive in waters such as these... so that which thrives should strike fear into the heart of any thinking being.\"","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.XL.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.xl.1.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_GAS_LEG_XL_NAME","descriptionKey":"UI_FISH_GAS_LEG_XL_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":200000,"level":4,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_GAS_LEG_XL","@type":"GameAsset"},{"id":"TWITCH_SHIP19","name":"THE NEMESIS OF THE KORVAX","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship, with a spacious hold for hauling goods, and a pre-fitted Emergency Warp Unit for hastily evading dangerous encounters. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.SHIP19.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.ship19.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_19_NAME","descriptionKey":"UI_TWIT_SHIP_19_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP19","@type":"GameAsset"},{"id":"FOOD_PIE_DIG","name":"THE PIE OF KNOWLEDGE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.MEATPIE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.meatpie.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_BALL_PIE_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":62000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_PIE_DIG","@type":"GameAsset"},{"id":"TWITCH_SHIP23","name":"THE SON OF THE SUN","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship. This exploration vessel is configured with Economy and Conflict Scanners, for remotely probing system data. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.SHI