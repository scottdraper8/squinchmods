aseValue":140000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPOOK_PACKAGE6","@type":"GameAsset"},{"id":"SPOOK_PACKAGE3","name":"PRESERVED SAMPLE","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Haunting Memento","description":"A shivering sea skeleton, sloshing to and fro in a jar of formaldehyde. This haunting memento can be offered to a forsaken trader in exchange for a unique set of corvette modules. Meet such traders at a deep-space outpost.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.2026.SPOOKYPACKAGE3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.2026.spookypackage3.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SPOOK_PACKAGE7_NAME","descriptionKey":"UI_SPOOK_PACKAGE_BONES_DESC","secondary":"Special","tags":[],"baseValue":140000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPOOK_PACKAGE3","@type":"GameAsset"},{"id":"MAINT_FRIG6","name":"PRESSURE CHAMBER","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Damaged Component","description":"A small pressurised chamber, designed to create the compressed gas necessary for the device to function. Cracks have appeared in the chamber, causing it to leak.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/MAINTTECH.FUEL4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/mainttech.fuel4.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINTAIN_TECH17_NAME","descriptionKey":"UI_MAINTAIN_TECH17_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_FRIG6","@type":"GameAsset"},{"id":"MAINT_TECH17","name":"PRESSURE CHAMBER","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Damaged Component","description":"A small pressurised chamber, designed to create the compressed gas necessary for the device to function. Cracks have appeared in the chamber, causing it to leak.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/MAINTTECH.FUEL4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/mainttech.fuel4.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINTAIN_TECH17_NAME","descriptionKey":"UI_MAINTAIN_TECH17_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_TECH17","@type":"GameAsset"},{"id":"PRESSURE_SUIT","name":"PRESSURE MEMBRANE","kind":"Technology","category":"Suit","categoryKey":"Suit","rarity":"Common","subtitle":"Reinforced Barometric Stabiliser","description":"Extreme pressure environments - such as deep water - cause elevated stress on the Exosuit's oxygen circulation and general life support systems. Installation of this reinforced pressurisation shell increases efficiency and protection while operating in high-pressure environments.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.PROTECTGENERICMOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.protectgenericmod.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_PRESSURE_SUIT_NAME","descriptionKey":"UI_PRESSURE_SUIT_DESC","secondary":"Installable","tags":["Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/PRESSURE_SUIT","@type":"GameAsset"},{"id":"MAINT_ROBO2","name":"PRESSURE SEAL","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Damaged Autophage Component","description":"This autophage is far from working order, but its subcomponents shows the signs of a previous repair attempt. With a few additional tweaks, the work might be completed... Repair this component with , or use to locate the needed materials.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/MAINTTECH.TECH2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/mainttech.tech2.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINT_ROBO2_NAME","descriptionKey":"UI_MAINT_ROBO_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_ROBO2","@type":"GameAsset"},{"id":"SHIP_LIFESUP","name":"PRESSURISATION CAPSULE","kind":"Technology","category":"Ship","categoryKey":"Ship","rarity":"Impossible","subtitle":"Starship Life Support Unit","description":"A critical starship safety feature, vital for extra-orbital flight. The pressuration capsule is a dedicated unit that both ensures a breathable atmosphere and prevents the catastrophic explosion of unconventional cockpit designs.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.TECH5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.tech5.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"SHIP_LIFESUPPORT_SPEC_NAME","descriptionKey":"SHIP_LIFESUPPORT_SPEC_DESC","secondary":"Core","tags":["Core technology","Chargeable","Primary"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SHIP_LIFESUP","@type":"GameAsset"},{"id":"F_GAS_COM_S2","name":"PRESSURISED CLAM","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_GAS_COM_S_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.CLAM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.clam.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_GAS_COM_S2_NAME","descriptionKey":"UI_FISH_GAS_COM_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":1000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_GAS_COM_S2","@type":"GameAsset"},{"id":"FOOD_CG_CACTUS","name":"PRICKLY CURIOSITY","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Proto-Batter.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.CUPCAKE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.cupcake.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_CG_CACTUS_NAME","descriptionKey":"UI_CAKE_DESC_CG","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":71500,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_CG_CACTUS","@type":"GameAsset"},{"id":"BANNER_NADA","name":"PRIEST ENTITY NADA BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Bring Priest Entity Nada into your personal convergence by equipping this exclusive Personal Flair. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BANNER.NADA.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.banner.nada.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_NADA_NAME","descriptionKey":"UI_BANNER_NADA_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BANNER_NADA","@type":"GameAsset"},{"id":"TWITCH_SHIP05","name":"PRIME SONG JZ4","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship, pre-fitted with a powerful Phase Beam and upgraded Pulse Engine for efficient space exploration. The Economy Scanner also allows for remote access to detailed economic data about a system, assisting in planning galactic trade routes. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.TWITCH.SHIP05.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.twitch.ship05.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_05_NAME","descriptionKey":"UI_TWIT_SHIP_05_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP05","@type":"GameAsset"},{"id":"TWITCH_SHIP13","name":"PRIME VOICE TU7","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship, pre-fitted with an illegally modified Photon Cannon for efficient destruction of hostile ships. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.SHIP13.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.ship13.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_13_NAME","descriptionKey":"UI_TWIT_SHIP_13_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP13","@type":"GameAsset"},{"id":"FOOD_CM_BUGJAM","name":"PRIMORDIAL SPONGE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Wailing Batter.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.CCAKEEVIL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.ccakeevil.webp","colour":"#6ad01e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_CM_BUGJAM_NAME","descriptionKey":"UI_CAKE_DESC_CM","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":180700,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_CM_BUGJAM","@type":"GameAsset"},{"id":"SWARM_TROPHY_B","name":"PRISMATIC CORE","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Antivitreous Device Memento","description":"A constructable replica of Specialist Polo's Prismatic Core device, assembled from fragments and ichor to counteract the Hive of Glass. All aspects of the Traveller soul are represented, forged around a Weaver heart.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S22.TROPHYB.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s22.trophyb.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_SWARM_TROPHY_NAME","descriptionKey":"BLD_SWARM_TROPHY_B_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SWARM_TROPHY_B","@type":"GameAsset"},{"id":"ILLEGAL_PROD4","name":"PRISMATIC FEATHERS","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Smuggled Goods","description":"A vacuum-sealed bundle of dazzlingly beautiful feathers. The animal that gave its life for this impossible, kaleidoscopic, charm is long since extinct. Purchase is illegal at nearly all galactic trade terminals. Regular supply is only available within outlaw systems. Selling banned goods into commercially-regulated space may be highly profitable.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.SMUGGLING4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.smuggling4.webp","colour":"#383838","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_ILLEGAL_PROD4_NAME","descriptionKey":"UI_ILLEGAL_PROD4_DESC","secondary":"Exotic","tags":["Trade good"],"baseValue":32000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ILLEGAL_PROD4","@type":"GameAsset"},{"id":"WALKER_PROD_2","name":"PRISTINE BRAIN","kind":"Product","category":"Component","categoryKey":"Component","rarity":"Rare","subtitle":"Anomalous Material","description":"Shifting nanite clusters sewn together with a pugneum filament, this circuit is painfully hot to the touch. A sinister purple light leaks from deep within its wiring, changing in intensity as it watches its holder. Unlike most Walker brains, this one has survived its violent extraction and is pristine and undamaged. It could potentially be installed in a new vessel...","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.WALKERBRAIN2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.walkerbrain2.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_WALKER_PROD_2_NAME","descriptionKey":"UI_WALKER_PROD_2_DESC","secondary":"Special","tags":["Consumable"],"baseValue":35000,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/WALKER_PROD_2","@type":"GameAsset"},{"id":"BLD_BUGHEAD5","name":"PRIZED EXOSKELETON","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive buildable base ornament. The mounted head of a colossal insect, this is a trophy from the glorious work of the Liquidators.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.BUGHEAD5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.bughead5.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_BUGHEAD5_NAME","descriptionKey":"BLD_EXPD_BUGHEAD_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BLD_BUGHEAD5","@type":"GameAsset"},{"id":"FOOD_R_MEAT","name":"PROCESSED MEAT","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A refined food product, created in the Nutrient Processor. Food such as this can be highly valuable. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.MEAT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.meat.webp","colour":"#7b0000","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_R_MEAT_NAME","descriptionKey":"FOOD_REFINED_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":2100,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_R_MEAT","@type":"GameAsset"},{"id":"FOOD_R_SUGAR","name":"PROCESSED SUGAR","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A refined food product, created in the Nutrient Processor. Food such as this can be highly valuable. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.SUGAR.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.sugar.webp","colour":"#534c45","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_SUGAR_NAME","descriptionKey":"FOOD_REFINED_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":1600,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_R_SUGAR","@type":"GameAsset"},{"id":"SET_PROD_NEG","name":"Productivity","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Reward Item","description":"Currency or faction standing, given as a reward.","icon":"TEXTURES/UI/FRONTEND/ICONS/SETTLEMENT/NEGATIVEPRODUCTION.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/settlement/negativeproduction.webp","colour":"#7b0000","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_SETTLEMENT_STAT_PRODUCTION","descriptionKey":"UI_REWARDPOP_DESC","secondary":"Substance","tags":[],"baseValue":20,"level":null,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/SET_PROD_NEG","@type":"GameAsset"},{"id":"SET_PROD_POS","name":"Productivity","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Reward Item","description":"Currency or faction standing, given as a reward.","icon":"TEXTURES/UI/FRONTEND/ICONS/SETTLEMENT/POSITIVEPRODUCTION.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/settlement/positiveproduction.webp","colour":"#8a7f72","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_SETTLEMENT_STAT_PRODUCTION","descriptionKey":"UI_REWARDPOP_DESC","secondary":"Substance","tags":[],"baseValue":20,"level":null,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/SET_PROD_POS","@type":"GameAsset"},{"id":"AMMO","name":"PROJECTILE AMMUNITION","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Rare","subtitle":"Universal Ammo Module","description":"Advanced munition fragments, constructed to fit Universal Multi-Tool Standard 07/FF1. Easily inserted into the Boltcaster, Pulse Spitter and Scatter Blaster via the Multi-Tool clip reloading system.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.AMMO.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.ammo.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"AMMO_PROD_NAME","descriptionKey":"AMMO_PROD_DESC","secondary":"Special","tags":["Craftable","Consumable"],"baseValue":1,"level":0,"stackMultiplier":1000,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/AMMO","@type":"GameAsset"},{"id":"BASE_HOUDINI2","name":"PROTEA WHEEL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"This unusual lifeform, dominated by a wheel of photophore glands, is difficult to classify neatly into flora or fauna. The thick columns of thorns help protect the flavoursome glands from predators. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.HOUDINIPLANT02.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.houdiniplant02.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_HOUDINIPLANT_2_NAME","descriptionKey":"BLD_HOUDINIPLANT_2_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_HOUDINI2","@type":"GameAsset"},{"id":"FOOD_DNUT_MEAT","name":"PROTEINOUS DOUGHNUT","kind":"Product","category":"Consumable","