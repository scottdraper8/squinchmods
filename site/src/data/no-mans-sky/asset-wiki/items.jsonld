DMG4","@type":"GameAsset"},{"id":"SHIPSLOT_DMG9","name":"CORRODED TANKS","kind":"Technology","category":"Ship","categoryKey":"Ship","rarity":"Impossible","subtitle":"Damaged Starship Component","description":"Starship subsystem severely damaged. Slot cannot be used for storage or technology until damage is repaired. Use to begin repair process. Core starship functionality is not affected. Repairing this damage will free slot up for general inventory use.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/MAINTTECH.FUEL5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/mainttech.fuel5.webp","colour":"#7b0000","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SHIPSLOT_DMG9_NAME","descriptionKey":"UI_SHIPSLOT_DMG_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SHIPSLOT_DMG9","@type":"GameAsset"},{"id":"WEAPEASY_DMG1","name":"CORRUPT MODULE","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Impossible","subtitle":"Damaged Multi-Tool Component","description":"Multi-Tool subsystem critically damaged. Slot cannot be used until damage is repaired. Use to begin repair process. Repairing will free slot up for general use.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/MAINTTECH.TECH2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/mainttech.tech2.webp","colour":"#7b0000","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_WEAPSLOT_DMG5_NAME","descriptionKey":"UI_WEAPSLOT_DMG_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/WEAPEASY_DMG1","@type":"GameAsset"},{"id":"WEAPSLOT_DMG5","name":"CORRUPT MODULE","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Impossible","subtitle":"Damaged Multi-Tool Component","description":"Multi-Tool subsystem critically damaged. Slot cannot be used until damage is repaired. Use to begin repair process. Repairing will free slot up for general use.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/MAINTTECH.TECH2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/mainttech.tech2.webp","colour":"#7b0000","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_WEAPSLOT_DMG5_NAME","descriptionKey":"UI_WEAPSLOT_DMG_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/WEAPSLOT_DMG5","@type":"GameAsset"},{"id":"SWARMDUST","name":"CORRUPTED ICHOR","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Corrosive Biofluid","description":"When swarmer shells are completely obliterated, this syrupy metal remains. It has a cloying, coppery smell that clings to the throat. Pure corrupted ichor is always flowing, sluggishly folding its molecules over and over.","icon":"TEXTURES/UI/FRONTEND/ICONS/SUBSTANCES/SUBSTANCE.SWARMDUST.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/substances/substance.swarmdust.webp","colour":"#1a2733","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_SWARMDUST_NAME","descriptionKey":"UI_SWARMDUST_DESC","secondary":"Substance","tags":[],"baseValue":1616,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/SWARMDUST","@type":"GameAsset"},{"id":"WEAPSENT_DMG3","name":"CORRUPTED LENS","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Impossible","subtitle":"Incomplete Sentinel Salvage","description":"This Multi-Tool is a piece of hybrid technology, a fusion of crude scrap and a deep, powerful energy - part salvage, part Sentinel, part something undefinable... This process of recycled fusion was incomplete when this tool was acquired. Use to continue repair operations and free this slot for general use.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/ROBOTSHIP.SHIELD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/robotship.shield.webp","colour":"#7b0000","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_WEAPSENT_DMG3_NAME","descriptionKey":"UI_WEAPSENT_DMG_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/WEAPSENT_DMG3","@type":"GameAsset"},{"id":"SPEC_PB_EGG04","name":"CORRUPTED QUAD EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Sentinel Spawn Capsule","description":"A metal 'egg' capsule, ready to hatch! The shell crackles with an electronic energy; mutated by Atlantideum, neutralised by [ redacted ]. Scans indicate the being within is programmed to be tireless and gLaSs.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.2026.SPIDERQUADPET.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.2026.spiderquadpet.webp","colour":"#4d2990","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SPEC_PB_EGG04_NAME","descriptionKey":"UI_SPEC_PB_EGG04_DESC","secondary":"Exotic","tags":[],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_PB_EGG04","@type":"GameAsset"},{"id":"EXPD_BANNER19","name":"CORVETTE BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Equip this exclusive Personal Flair in commemoration of the Corvette expedition, and the design and assembly of your own habitable starship. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S19.BANNER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s19.banner.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_EXPD_19_NAME","descriptionKey":"UI_BANNER_EXPD_19_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_BANNER19","@type":"GameAsset"},{"id":"EXPD_POSTER19A","name":"CORVETTE BLUEPRINT POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster depicts a classic Corvette design, outfitted with high-capacity habitation modules and immense engines.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S19.POSTERA.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s19.postera.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER19A_NAME","descriptionKey":"BLD_EXPD_POSTER19A_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER19A","@type":"GameAsset"},{"id":"EXPD_DECAL19","name":"CORVETTE DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal commemorates completion of the Corvette expedition, and the design and assembly of your own habitable starship.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S19.DECAL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s19.decal.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_EXPD_19_NAME","descriptionKey":"BLD_DECAL_EXPD_19_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_DECAL19","@type":"GameAsset"},{"id":"S_POSTER20","name":"COSMIC FLIGHT POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. A poster celebrating the joy of lifting off in a starship.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.S_POSTER20.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.s_poster20.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_S_POSTER20_NAME","descriptionKey":"BLD_S_POSTER20_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S_POSTER20","@type":"GameAsset"},{"id":"CAPE_BIOFRIG","name":"COSMIC MEGAFAUNA CAPE","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Cape","description":"An exclusive Exosuit Appearance Override. In the furthest reaches of space swim cosmic megafauna, aligning their paths with Travellers, dreaming of possible realities. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.CAPE.BIOFRIG.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.cape.biofrig.webp","colour":"#008951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_CAPE_BIOFRIG_NAME","descriptionKey":"UI_CAPE_BIOFRIG_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/CAPE_BIOFRIG","@type":"GameAsset"},{"id":"FOOD_B_CAT","name":"COUGH BISCUITS","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A well-baked biscuit, created in the Nutrient Processor. What was once a thin sheet of vaguely-sweetend nutrient paste has been elevated with the addition of carefully-chosen ingredients.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.BISCUIT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.biscuit.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_B_CAT_NAME","descriptionKey":"UI_BISCUIT_DESC_REF","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":40000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_B_CAT","@type":"GameAsset"},{"id":"ILLEGAL_PROD6","name":"COUNTERFEIT CIRCUITS","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Smuggled Goods","description":"Reversed-engineered from a captured space station core, these unlicensed circuits are used in a wide range of black- and grey-market technologies. Purchase is illegal at nearly all galactic trade terminals. Regular supply is only available within outlaw systems. Selling banned goods into commercially-regulated space may be highly profitable.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.SMUGGLING6.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.smuggling6.webp","colour":"#383838","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_ILLEGAL_PROD6_NAME","descriptionKey":"UI_ILLEGAL_PROD6_DESC","secondary":"Exotic","tags":["Trade good"],"baseValue":68000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ILLEGAL_PROD6","@type":"GameAsset"},{"id":"S_POSTER18","name":"COUNTERFEIT PASS POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster depicts a discounted Atlas Pass, as advertised at a disreputable marketplace.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.S_POSTER18.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.s_poster18.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_S_POSTER18_NAME","descriptionKey":"BLD_S_POSTER18_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S_POSTER18","@type":"GameAsset"},{"id":"MAINT_ROBO3","name":"COUPLING HINGE","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Damaged Autophage Component","description":"This autophage is far from working order, but its subcomponents shows the signs of a previous repair attempt. With a few additional tweaks, the work might be completed... Repair this component with , or use to locate the needed materials.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/MAINTTECH.TECH3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/mainttech.tech3.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINT_ROBO3_NAME","descriptionKey":"UI_MAINT_ROBO_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_ROBO3","@type":"GameAsset"},{"id":"BLD_COVCRATE","name":"COVERED CRATE","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"A large crate, sealed and prepared for transportation. The tarpaulin wrapping conceals the precise nature of this cargo, obscuring whether all the export stamps are where they ought to be...","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.COVEREDCRATE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.coveredcrate.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_COVEREDCRATE_NAME","descriptionKey":"BLD_COVEREDCRATE_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BLD_COVCRATE","@type":"GameAsset"},{"id":"BLD_COVSILOS","name":"COVERED SILOS","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"A set of tarpaulin-draped silo barrels, containing cargo of questionable provenance.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.COVEREDSILOS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.coveredsilos.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_COVEREDSILOS_NAME","descriptionKey":"BLD_COVEREDSILOS_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BLD_COVSILOS","@type":"GameAsset"},{"id":"HULK_DATACORE","name":"CPU HARNESS","kind":"Product","category":"Space Salvage","categoryKey":"SpaceSalvage","rarity":"Rare","subtitle":"Rare Salvage Material","description":"Full of heavy metals and precious synthetics, this is a valuable piece of industrial salvage. Harvested from the decaying remains of a collapsing space hulk. This has been processed at a deep-space outpost, and can be sold on the open market.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.2026.HULK.DATACORE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.2026.hulk.datacore.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_HULK_DATACORE_NAME","descriptionKey":"UI_HULK_UNCOMMON_DESC","secondary":"Exotic","tags":["Craftable","Cooking ingredient"],"baseValue":52000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/HULK_DATACORE","@type":"GameAsset"},{"id":"FOOD_V_CRAB","name":"CRAB 'APPLE'","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"An animal byproduct, this nutritious morsel can be easily farmed without harm to the animal that produces it. Process in a Nutrient Processor to generate edible products.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.WEIRDFRUIT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.weirdfruit.webp","colour":"#e57002","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_CRAB_VEG_NAME","descriptionKey":"FOOD_VEG_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":3200,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_V_CRAB","@type":"GameAsset"},{"id":"BIOSHIP_EGG4","name":"CRACKING VOID EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Agitated Curiosity","description":"An anomalous egg. Since the encounter with the bizarre deep-space 'creature', its strange music has grown more active, more agitated. When touched, conjures a powerful vision of a planet of strange anomalies, one minute a world of grass, the next a world of bizarre fungal growths...","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/PRODUCT.EGG4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/product.egg4.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BIOSHIP_EGG4_NAME","descriptionKey":"UI_BIOSHIP_EGG4_DESC","secondary":"Exotic","tags":[],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BIOSHIP_EGG4","@type":"GameAsset"},{"id":"BIOSHIP_EGG5","name":"CRACKING VOID EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Agitated Curiosity","description":"An anomalous egg. Since the encounter with the bizarre deep-space 'creature', its strange music has grown more active, more agitated. When touched, conjures a powerful vision of pink and blue, colours seared into the mind of the holder. The Hunter The Reflection The Hunter The Spiral of Reality The Star Over Water The Ascending Orb The Obscured Companion The Hunter The Lowly Insect The Anomaly The Sailor The Ocean King EUCLID EUCLID EUCLID","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/PRODUCT.EGG4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/product.egg4.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BIOSHIP_EGG4_NAME","descriptionKey":"UI_BIOSHIP_EGG5_DESC","secondary":"Exotic","tags":[],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BIOSHIP_EGG5","@type":"GameAsset"},{"id":"FOOD_V_FLYER","name":"CRAW MILK","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"An animal byproduct, this nutritious morsel can be easily farmed without harm to the animal that produces it. Process in a Nutrient Processor to generate edible products.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.MILK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.milk.webp","colour":"#e57002","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_FLYER_VEG_NAME","descriptionKey":"FOOD_VEG_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":3200,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_V_FLYER","@type":"GameAsset"},{"id":"FOOD_R_CREAM","name":"CREAM","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A refined food product, created in the Nutrient Processor. Food such as this can be highly valuable. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.CREAM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.cream.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_R_CREAM_NAME","descriptionKey":"FOOD_REFINED_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":5400,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_R_CREAM","@type":"GameAsset"},{"id":"FOOD_CK_CREAM","name":"CREAM BUNS","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Cake Batter.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.CUPCAKE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.cupcake.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_CK_CREAM_NAME","descriptionKey":"UI_CAKE_DESC_CK","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":52800,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_CK_CREAM","@type":"GameAsset"},{"id":"FOOD_CG_CREAM","name":"CREAM CURIOSITY","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Proto-Batter.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.CUPCAKE.DDS","preview":"/asset-wi