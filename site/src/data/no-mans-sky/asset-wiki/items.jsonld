Asset"},{"id":"DECAL_BONEJUDGE","name":"BONES OF JUSTICE DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal judges the value of one bone against another.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.DECAL.BONEJUDGE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.decal.bonejudge.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_P_BONEJUDGE_NAME","descriptionKey":"BLD_DECAL_P_BONEJUDGE_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/DECAL_BONEJUDGE","@type":"GameAsset"},{"id":"TWITCH_SHIP15","name":"BORIBETS'S VOYAGE YZ7","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship with a spacious cargo hold, and pre-fitted with illegally modified Deflector Shields. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.SHIP15.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.ship15.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_15_NAME","descriptionKey":"UI_TWIT_SHIP_15_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP15","@type":"GameAsset"},{"id":"EXPD_POSTER16A","name":"BOUNDARY ANOMALY POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster serves as a warning to all those who would venture into the tunnels of portal network...","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S16.POSTERA.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s16.postera.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER16A_NAME","descriptionKey":"BLD_EXPD_POSTER16A_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER16A","@type":"GameAsset"},{"id":"EXPD_SHIP16","name":"BOUNDARY HERALD","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive starship, retrieved while escaping the reality collapse that occurred during the Cursed Expedition. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S16.SPOOKSHIP.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s16.spookship.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_SHIP_16_NAME","descriptionKey":"UI_EXPD_SHIP_16_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_SHIP16","@type":"GameAsset"},{"id":"SPEC_PB_EGG03","name":"BOUNDARY HORROR EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Spectral Anomaly","description":"A living, fertile egg, ready to hatch! It wails, sleepless. Scans indicate the being within has the genetic potential to be haunting and adrift.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.2026.LANDSQUIDPET.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.2026.landsquidpet.webp","colour":"#4d2989","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SPEC_PB_EGG03_NAME","descriptionKey":"UI_SPEC_PB_EGG03_DESC","secondary":"Exotic","tags":[],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_PB_EGG03","@type":"GameAsset"},{"id":"EXPD_S16_HAT","name":"BOUNDARY HORROR MANDIBLES","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Helmet","description":"An exclusive Exosuit Appearance Override. Transform your appearance into that of a Boundary Horror, a fragment of what dwells beyond the tunnels of the portal network... Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S16.OCTHULHU.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s16.octhulhu.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_SQUID_HAT_NAME","descriptionKey":"UI_EXPED_SQUID_HAT_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_S16_HAT","@type":"GameAsset"},{"id":"EXPD_POSTER15C","name":"BOUNTY OF THE SEA POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. An educational poster, useful for all those who seek to identify the teeming bounty of the ocean.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.POSTER15C.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.poster15c.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER15C_NAME","descriptionKey":"BLD_EXPD_POSTER15C_DES