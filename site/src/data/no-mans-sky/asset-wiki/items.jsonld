lue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_FOOD","@type":"GameAsset"},{"id":"JETS_SQUID","name":"INK-STAINED TRAIL","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Jetpack Exhaust Override","description":"An exclusive Exosuit Appearance Override. A localised anomaly within the jetpack's core allows the spectral afterglow of the boundary horrors to leak across into this reality. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S16.SPOOKJETS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s16.spookjets.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_JETTRAIL_SQUID_NAME","descriptionKey":"UI_JETTRAIL_SQUID_DESC","secondary":"Exotic","tags":[],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/JETS_SQUID","@type":"GameAsset"},{"id":"MAINT_TECH4","name":"INPUT TERMINAL","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Damaged Component","description":"A terminal designed to allow manual control of the device. Damage prevents it actually receiving any input.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/MAINTTECH.TECH4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/mainttech.tech4.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINTAIN_TECH4_NAME","descriptionKey":"UI_MAINTAIN_TECH4_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_TECH4","@type":"GameAsset"},{"id":"UT_PULSEFUEL","name":"INSTABILITY DRIVE","kind":"Technology","category":"All Ships Except Alien","categoryKey":"AllShipsExceptAlien","rarity":"VeryRare","subtitle":"Pulse Engine Augmentation","description":"A highly-advanced upgrade for the Pulse Engine, vastly increasing fuel efficiency. Tritium supplies are redirected into a cycle of miniature black holes. Resulting micro-gravity fluctuations are harnessed to boost starship propulsion beyond conventional combustion-based approaches.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.PULSEDRIVEMOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.pulsedrivemod.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_PULSEFUEL_NAME","descriptionKey":"UT_PULSEFUEL_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/UT_PULSEFUEL","@type":"GameAsset"},{"id":"TRA_EXOTICS3","name":"INSTABILITY INJECTOR","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Trade Goods (Scientific)","description":"A jumbled box of instability injectors. Grand experiments often require a large number of variables to be changed in a very short period of time. An instability injector provides such a service. They can also be used to create chaos in market systems; such unethical behaviour represents an excellent trading opportunity.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.EXOTICS3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.exotics3.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TRADE_ITEM_EXOTICS_3_NAME","descriptionKey":"UI_TRADE_ITEM_EXOTICS_3_DESC","secondary":"Exotic","tags":["Trade good"],"baseValue":15000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TRA_EXOTICS3","@type":"GameAsset"},{"id":"EXPD_POSTER12B","name":"INTERFACE POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster depicts an infinite array of Atlas Interfaces, crimson eyes staring tirelessly into the dark.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.POSTER12B.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.poster12b.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER12B_NAME","descriptionKey":"BLD_EXPD_POSTER12B_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER12B","@type":"GameAsset"},{"id":"FOOD_CG_SCUST","name":"INTERSTELLAR CURIOSITY","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Proto-Batter.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.CUPCAKE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.cupcake.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_CG_SCUST_NAME","descriptionKey":"UI_CAKE_DESC_CG","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":92300,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_CG_SCUST","@type":"GameAsset"},{"id":"FOOD_CK_SCUST","name":"INTERSTELLAR FANCY","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Cake Batter.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.CUPCAKE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.cupcake.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_CK_SCUST_NAME","descriptionKey":"UI_CAKE_DESC_CK","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":80200,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_CK_SCUST","@type":"GameAsset"},{"id":"F_SCANNER","name":"INTERSTELLAR SCANNER","kind":"Technology","category":"Freighter","categoryKey":"Freighter","rarity":"VeryRare","subtitle":"Long Range Sensor Technology","description":"An upgrade to the freighter's galactic-scale sensors. This device allows the user to access detailed economic and conflict data for a system, even without having previously visited.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.FREIGHTERSCANNER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.freighterscanner.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_FREI_SCAN_NAME","descriptionKey":"UI_FREI_SCAN_DESC","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/F_SCANNER","@type":"GameAsset"},{"id":"F_ODD_COM_M2","name":"INVERTED BRAINFISH","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_ODD_COM_M_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT5.FISH.BIG.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product5.fish.big.2.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_ODD_COM_M2_NAME","descriptionKey":"UI_FISH_ODD_COM_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":2000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_ODD_COM_M2","@type":"GameAsset"},{"id":"DRONE_SALVAGE","name":"INVERTED MIRROR","kind":"Product","category":"Component","categoryKey":"Component","rarity":"Uncommon","subtitle":"Burning Glassy Remnant","description":"A pane of watchful g l a s s, retrieved from the smoking remains of the corrupted swarm's Dissonance Resonators. It emits more light than it reflects, casting a faint purple hue on its surroundings. Highly sought after for salvage operations, as it can be used to bypass the security systems of key Sentinel ship technologies.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.DRONESALVAGE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.dronesalvage.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_DRONE_SALVAGE_NAME","descriptionKey":"UI_DRONE_SALVAGE_DESC","secondary":"Special","tags":["Consumable"],"baseValue":17000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/DRONE_SALVAGE","@type":"GameAsset"},{"id":"F_RAD_COM_M2","name":"INVERTED SNAPPER","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_RAD_COM_M_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.MEDIUM.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.medium.2.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_RAD_COM_M2_NAME","descriptionKey":"UI_FISH_RAD_COM_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":2000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_RAD_COM_M2","@type":"GameAsset"},{"id":"TWITCH_SHIP22","name":"INZAKITA'S FOLLY PY9","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship. This fighter craft is armed with a powerful Positron Ejector for rapid destruction of hostile ships. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.SHIP22.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.ship22.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_22_NAME","descriptionKey":"UI_TWIT_SHIP_22_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP22","@type":"GameAsset"},{"id":"TWITCH_SHIP44","name":"IOBANA LW1","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship. This A-class fighter benefits from damage and manoeuvrability bonuses, and is pre-installed with a selection of technologies and upgrades. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.SHIP44.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.ship44.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_44_NAME","descriptionKey":"UI_TWIT_SHIP_FIGHTER_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP44","@type":"GameAsset"},{"id":"POWERCELL","name":"ION BATTERY","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Uncommon","subtitle":"Portable Energy Storage","description":"Convenient and optimised power storage unit. Used in a wide variety of defensive and hazard protection systems. Constructed by fusing Ferrite Dust with underground Cobalt. Frequently found ready-made in cylindrical metal containers.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.POWERCELL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.powercell.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"POWERCELL_NAME","descriptionKey":"POWERCELL_DESC","secondary":"Catalyst","tags":["Craftable","Consumable"],"baseValue":200,"level":0,"stackMultiplier":20,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/POWERCELL","@type":"GameAsset"},{"id":"TRA_TECH3","name":"ION CAPACITOR","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Trade Goods (Technology)","description":"A reinforced crate of ion capacitors. These supercapacitors have an incredibly high energy density. In great demand in power generation economies.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.TECH3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.tech3.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TRADE_ITEM_TECH_3_NAME","descriptionKey":"UI_TRADE_ITEM_TECH_3_DESC","secondary":"Exotic","tags":["Trade good"],"baseValue":15000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TRA_TECH3","@type":"GameAsset"},{"id":"TRA_COMMODITY4","name":"ION SPHERE","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Trade Goods","description":"A packed crate of ion spheres. These delicate glass spheres house a small-scale replica of the upper atmosphere. Sparkly and hypnotic to look at, these baubles are also of importance in the manufacture of advanced material alloys.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.COMMODITY4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.commodity4.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TRADE_ITEM_COMMOD_4_NAME","descriptionKey":"UI_TRADE_ITEM_COMMOD_4_DESC","secondary":"Exotic","tags":["Trade good"],"baseValue":30000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TRA_COMMODITY4","@type":"GameAsset"},{"id":"F_RAD_RARE_S1","name":"IONISED CLAM","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Uncommon Fish","description":"UI_FISH_RAD_RARE_S_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.CLAM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.clam.webp","colour":"#2177c8","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_RAD_RARE_S1_NAME","descriptionKey":"UI_FISH_RAD_RARE_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":3000,"level":2,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_RAD_RARE_S1","@type":"GameAsset"},{"id":"CAVE2","name":"IONISED COBALT","kind":"Resource","category":"Earth","categoryKey":"Earth","rarity":"Rare","subtitle":"Processed Subterranean Mineral","description":"A highly energised form of Cobalt, this processed metal can be used to create Advanced Ion Batteries, a conveniently portable source of energy for the Exosuit. In widespread use as a key component in the creation of advanced technologies and structures.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.CAVE.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.cave.2.webp","colour":"#005c83","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_CAVE2_NAME","descriptionKey":"UI_CAVE2_DESC","secondary":"Substance","tags":["Easy to refine"],"baseValue":162,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/CAVE2","@type":"GameAsset"},{"id":"F_GAS_RARE_S1","name":"IONISED OYSTER","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Uncommon Fish","description":"UI_FISH_GAS_RARE_S_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT5.FISH.CLAM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product5.fish.clam.webp","colour":"#2177c8","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_GAS_RARE_S1_NAME","descriptionKey":"UI_FISH_GAS_RARE_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":3000,"level":2,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_GAS_RARE_S1","@type":"GameAsset"},{"id":"ALLOY8","name":"IRIDESITE","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Rare","subtitle":"Enriched Alloy Metal","description":"Advanced light metal alloy traded throughout the galactic Outer Edge. Often used in the interiors of trading shuttles to reduce weight as they ascend from planets with high gravitational fields. Crafted from Aronium, Magno-Gold and Grantine.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.IRIDISITE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.iridisite.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_ALLOY_COMPLEX_2_NAME","descriptionKey":"UI_ALLOY_COMPLEX_2_DESC","secondary":"Stellar","tags":["Craftable","Trade good"],"baseValue":150000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ALLOY8","@type":"GameAsset"},{"id":"EXPD_SHIP_METAL","name":"IRON PANELS","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Starship Customisation Option","description":"An exclusive starship customisation option, creating a unique well-worn appearance for Fighter and Hauler class starships. Acquire starship components by breaking down existing ships at the Starship Outfitting unit aboard any space station. Visit the Starship Fabricator to design and assemble a new vessel.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.METALSHIPMAT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.metalshipmat.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_SHIPMAT_BOLT_NAME","descriptionKey":"UI_EXPD_SHIPMAT_13_DESC","secondary":"Exotic","tags":[],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_SHIP_METAL","@type":"GameAsset"},{"id":"EXPD_SHIP13","name":"IRON VULTURE","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"A unique and exclusive starship, commemorating completion of the Adrift expedition. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.SHIP13.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.ship13.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_SHIP_13_NAME","descriptionKey":"UI_EXPD_SHIP_13_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_SHIP13","@type":"GameAsset"},{"id":"EXPD_POSTER13C","name":"ISOLATION POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster is for those who face the black expanse alone.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.POSTER13C.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.poster13c.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER13C_NAME","descriptionKey":"BLD_EXPD_POSTER13C_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER13C","@type":"GameAsset"},{"id":"TWITCH_GUN07","name":"ISOTOPE TUNER MARK XVII","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Multifunction Survival Device","description":"An exclusive Multi-Tool. This weapon comes with the tactical Paralysis Mortar and lethal Blaze Javelin pre-installed, for disabling aggressors and delivering powerful shots. Take this Multi-Tool to add it to your collection, or Exchange it with your current Multi-Tool. Swap between active Multi-Tools from the Utilities section of the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.GUN07.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.gun07.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_GUN_07_NAME","descriptionKey":"UI_TWIT_GUN_07_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_GUN07","@type":"GameAsset"},{"id":"HULK1","name":"ISOTOPIC DUST","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Industrial Salvage","description":"Torn fragments of old industrial components. Years of decay have left it pocked by exotic oxides and faintly irradiated. This material requires deep processing before it can be recycled into new components. Salvaged from the creaking wreck of an abandoned space hulk.","icon":"TEXTURES/UI/FRONTEND/ICONS/SUBSTANCES/SUBSTANCE.HULK.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/substances/substance.hulk.1.webp","colour":"#1a2733","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_HULK1_NAME","descriptionKey":"UI_HULK1_DESC","secondary":"Substance","tags":[],"baseValue":240,"level":null,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/HULK1","@type":"GameAsset"},{"id":"FOOD_MM_BLOB","name":"ITCHING, CREEPING HONEY SPONGE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Writhing, Roiling Batter. Some caution is advised.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.CCAKEEVIL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.ccakeevil.webp","colour":"#6ad01e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_MM_BLOB_NAME","descriptionKey":"UI_CAKE_DESC_MM","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":142900,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_MM_BLOB","@type":"GameAsset"},{"id":"SPEC_EXOTIC10","name":"ITERATION: ARES VISAGE","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Anomalous Face Transformation","description":"An exclusive Exosuit Appearance Override. This part silicone, part biological helmet can detect and replicate the facial muscle movements of the wearer, creating the appearance of a natural head. It is fully compatible with exosuit technology and provides all protection of a traditional helmet. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.EXOTICHEAD10.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.exotichead10.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SPEC_EXOTICHEAD_10_NAME","