OD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":56000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_ICE_BONE","@type":"GameAsset"},{"id":"BASE_LAVA1","name":"IGNEOUS CRYSTAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A quiet roar sounds from within this natural crystal formation, lava and gas dancing in a perpetual cycle of heating and solidifying. Mesmerising to the eye, but despite the ultrahot core, only slightly warm to the touch. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.LAVAPLANT01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.lavaplant01.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_LAVAPLANT_1_NAME","descriptionKey":"BLD_LAVAPLANT_1_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_LAVA1","@type":"GameAsset"},{"id":"BASE_LAVA2","name":"IGNEOUS DROP","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"This hybrid of egg and rock is known to form around the larvae of certain species, keeping the vulnerable creature warm and protected as it develops over the course of several decades. Membranous splits in the rock's surface expose the ever-shifting molten heart. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.LAVAPLANT02.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.lavaplant02.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_LAVAPLANT_2_NAME","descriptionKey":"BLD_LAVAPLANT_2_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_LAVA2","@type":"GameAsset"},{"id":"TWITCH_SHIP39","name":"IIYAW JU4","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship. This capacious hauler comes with an Economy Scanner and Cargo Scan Deflector pre-installed. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.SHIP39.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.ship39.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_39_NAME","descriptionKey":"UI_TWIT_SHIP_39_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP39","@type":"GameAsset"},{"id":"TWITCH_SHIP26","name":"IKAWAJI'S DEFEAT","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship. This A-class explorer benefits from hyperdrive and launcher bonuses, and is pre-installed with a selection of technologies and upgrades. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.SHIP26.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.ship26.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_26_NAME","descriptionKey":"UI_TWIT_SHIP_SCIENTIFIC_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP26","@type":"GameAsset"},{"id":"PLANTPOT4","name":"ILLUMINATED POT","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"This clay plant pot features a climate neutralising field, nutrient recycling system, and integrated drip tray. Ideal for showcasing decorative plants or other decorations.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.PLANTPOT4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.plantpot4.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_PLANTPOT4_NAME","descriptionKey":"BLD_PLANTPOT4_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/PLANTPOT4","@type":"GameAsset"},{"id":"F_RAD_EPIC_M1","name":"IMMORTAL FLATFISH","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Rare Fish","description":"UI_FISH_RAD_EPIC_M_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.BIG.3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.big.3.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_RAD_EPIC_M1_NAME","descriptionKey":"UI_FISH_RAD_EPIC_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":20000,"level":3,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_RAD_EPIC_M1","@type":"GameAsset"},{"id":"UT_SMG_DOT","name":"IMPACT IGNITER","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Common","subtitle":"Pulse Spitter Upgrade","description":"A powerful combat upgrade for the Pulse Spitter. This module installs series of delicately calibrated fuel-injection nozzles within the firing chamber, which are used to initiate a controlled burn within its plasma projectiles. Causes targets hit by the Pulse Spitter to burn for a short while, causing additional damage.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.PULSESPITTERMOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.pulsespittermod.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_SMG_DOT_NAME","descriptionKey":"UT_SMG_DOT_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/UT_SMG_DOT","@type":"GameAsset"},{"id":"TWITCH_GUN05","name":"IMPERFECT LOOP REFLECTOR","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Multifunction Survival Device","description":"An exclusive Multi-Tool. This rifle comes with the deadly Pulse Spitter and explosive Plasma Launcher pre-installed. Take this Multi-Tool to add it to your collection, or Exchange it with your current Multi-Tool. Swap between active Multi-Tools from the Utilities section of the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.TWITCH.GUN05.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.twitch.gun05.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_GUN_05_NAME","descriptionKey":"UI_TWIT_GUN_05_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_GUN05","@type":"GameAsset"},{"id":"BIOSHIP_COMP3","name":"IMPOSSIBLE MEMBRANE","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Auto-Regenerating Lifeform","description":"A biomechanical construct, created to the design of an anonymous host. A fine mesh of tightly woven fibre. Micro-organisms embedded within the weave allow it to regenerate endlessly, a perfect and infinite bionic skin.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/PRODUCT.BIOCOMP3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/product.biocomp3.webp","colour":"#311a49","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BIOSHIP_COMP3_NAME","descriptionKey":"UI_BIOSHIP_COMP3_DESC","secondary":"Exotic","tags":["Craftable"],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BIOSHIP_COMP3","@type":"GameAsset"},{"id":"TWITCH_GUN32","name":"IMPROVISED ION GENERATOR","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Multifunction Survival Device","description":"An exclusive Multi-Tool. This A-class weapon comes equipped with a range of pre-installed technologies and upgrades. Take this Multi-Tool to add it to your collection, or Exchange it with your current Multi-Tool. Swap between active Multi-Tools from the Utilities section of the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/TWITCH.GUN32.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/twitch.gun32.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_GUN_32_NAME","descriptionKey":"UI_TWIT_GUN_GENERIC_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_GUN32","@type":"GameAsset"},{"id":"TWITCH_GUN24","name":"IMPROVISED VOLODOV CLARIFIER","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Multifunction Survival Device","description":"An exclusive Multi-Tool. This A-class weapon comes equipped with a range of pre-installed technologies and upgrades. Take this Multi-Tool to add it to your collection, or Exchange it with your current Multi-Tool. Swap between active Multi-Tools from the Utilities section of the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/TWITCH.GUN24.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/twitch.gun24.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_GUN_24_NAME","descriptionKey":"UI_TWIT_GUN_24_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_GUN24","@type":"GameAsset"},{"id":"FOOD_P_LUSHWILD","name":"IMPULSE BEANS","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"An edible plant, harvested from planetary flora. Process in a Nutrient Processor to generate edible products.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.PLANT.LUSHWILD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.plant.lushwild.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_PLANT_LUSH_WILD_NAME","descriptionKey":"FOOD_PLANT_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":800,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_P_LUSHWILD","@type":"GameAsset"},{"id":"FLAME","name":"INCINERATOR","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Impossible","subtitle":"Short-Range Fire Delivery Unit","description":"Specialist high temperature weapon attachment for the Multi-Tool. Access fire mode by pressing and fire weapon with . The Incinerator focuses internal lasers onto the naturally-occuring exhaust gases generated by the Multi-Tool. Ignition results in a highly destructive, if short range, inferno.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.FLAMETHROWER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.flamethrower.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"FLAMETHROW_NAME","descriptionKey":"FLAMETHROW_DESCRIPTION","secondary":"Installable","tags":["Primary"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/FLAME","@type":"GameAsset"},{"id":"BLUE2","name":"INDIUM","kind":"Resource","category":"Stellar","categoryKey":"Stellar","rarity":"Rare","subtitle":"Refined Stellar Metal: Blue","description":"A chromatic metal, generated by fusion in the heart of a star. Such stellar material ends up forming deposits in the crust of local planets. Indium is found on planets orbiting blue stars, and can be placed in a Refiner to create purified Chromatic Metal for use in the manufacture of advanced technologies.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.BLUE.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.blue.2.webp","colour":"#01387d","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_BLUE2_NAME","descriptionKey":"UI_BLUE2_DESC","secondary":"Substance","tags":["Trade good"],"baseValue":132,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/BLUE2","@type":"GameAsset"},{"id":"HDRIVEBOOST3","name":"INDIUM DRIVE","kind":"Technology","category":"All Ships Except Alien","categoryKey":"AllShipsExceptAlien","rarity":"Impossible","subtitle":"Hyperdrive Upgrade: Blue Systems","description":"Upgrades the hyperdrive's computational matrix, preventing temporal anomalies when attempting to reach rare-class blue stellar bodies. User is advised to access Hyperdrive systems via the Galactic Map.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/TECHNOLOGY.INDIUMDRIVE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/technology.indiumdrive.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"HYP_ACCESS3_NAME","descriptionKey":"RGB_WARP_3_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":3,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/HDRIVEBOOST3","@type":"GameAsset"},{"id":"BLD_CRANE","name":"INDUSTRIAL CRANE","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"Heavy machinery, for lifting and relocating heavy cargo. Despite the crane's size, the rotation-resistant hoist rope and AI-corrected swivel allow for extremely precise movements.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.CRANE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.crane.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_CRANE_NAME","descriptionKey":"BLD_CRANE_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BLD_CRANE","@type":"GameAsset"},{"id":"HULK_COMMON","name":"INDUSTRIAL SALVAGE","kind":"Product","category":"Space Salvage","categoryKey":"SpaceSalvage","rarity":"Common","subtitle":"Common Salvage Material","description":"A tainted metallic shell. Though damaged, its core components can be recycled into valuable materials. Harvested from the decaying remains of a collapsing space hulk. This has been processed at a deep-space outpost, and can be sold on the open market.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.2026.JUNK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.2026.junk.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_HULK_COMMON_NAME","descriptionKey":"UI_HULK_COMMON_DESC","secondary":"Exotic","tags":["Craftable","Cooking ingredient"],"baseValue":32000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/HULK_COMMON","@type":"GameAsset"},{"id":"TRA_ENERGY2","name":"INDUSTRIAL-GRADE BATTERY","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Trade Goods (Energy Source)","description":"A packet of well-isolated industrial batteries. Heavy-duty batteries are required to power deep level miningoperations. These highly durable sources can last for weeks, even in the extremes of heat and pressure found kilometres underground.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.ENERGY2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.energy2.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TRADE_ITEM_ENERGY_2_NAME","descriptionKey":"UI_TRADE_ITEM_ENERGY_2_DESC","secondary":"Exotic","tags":["Trade good"],"baseValue":6000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TRA_ENERGY2","@type":"GameAsset"},{"id":"F_GAS_COM_S3","name":"INERT WHELK","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_GAS_COM_S_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT5.FISH.CLAM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product5.fish.clam.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_GAS_COM_S3_NAME","descriptionKey":"UI_FISH_GAS_COM_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":1000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_GAS_COM_S3","@type":"GameAsset"},{"id":"TWITCH_GUN16","name":"INERTIAL FOCUSER NL4-0/9","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Multifunction Survival Device","description":"An exclusive Multi-Tool. This pistol comes with a powerful Javelin Beam pre-installed. Take this Multi-Tool to add it to your collection, or Exchange it with your current Multi-Tool. Swap between active Multi-Tools from the Utilities section of the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.GUN16.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.gun16.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_GUN_16_NAME","descriptionKey":"UI_TWIT_GUN_16_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_GUN16","@type":"GameAsset"},{"id":"SWITCH_GUN01","name":"INFINITE NEON MARK XXII","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Multifunction Survival Device","description":"An exclusive Multi-Tool. This brightly-coloured rifle offers the user cutting-edge defensive capabilities in ground combat situations. Take this Multi-Tool to add it to your collection, or Exchange it with your current Multi-Tool. Swap between active Multi-Tools from the Utilities section of the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.SWITCH.GUN01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.switch.gun01.webp","colour":"#262626","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SWIT_GUN_01_NAME","descriptionKey":"UI_SWIT_GUN_01_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SWITCH_GUN01","@type":"GameAsset"},{"id":"SHIPMINIGUN","name":"INFRA-KNIFE ACCELERATOR","kind":"Technology","category":"All Ships Except Alien","categoryKey":"AllShipsExceptAlien","rarity":"Rare","subtitle":"Rapid Fire Starship Weapon","description":"A rapid fire starship weapon that launches superheated globes of liquid metal at hostile targets. These projectiles are extremely effective against unshielded starship hulls. Note: the Accelerator's internal components are vulnerable to rapid overheating. Sustained burst fire is not recommended. Use to change weapon mode. Press to fire.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.PHOTONACCEL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.photonaccel.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"SHIPMINIGUN_NAME","descriptionKey":"SHIPMINIGUN_DESCRIPTION","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":3,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SHIPMINIGUN","@type":"GameAsset"},{"id":"UP_SMINI1","name":"Infra-Knife Accelerator","kind":"Upgrade module","category":"Combat","categoryKey":"Combat","rarity":"Normal","subtitle":"C-Class %NAME% Upgrade","description":"A moderate upgrade for the Infra-Knife Accelerator. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potential improvements include: damage output, fire rate and overheat times.","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_SHIPMINI","descriptionKey":"UP_SHIPMINI1_DESC","secondary":"T_SHIPMINI","tags":["3 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_SMINI1","@type":"GameAsset"},{"id":"UP_SMINI2","name":"Infra-Knife Accelerator","kind":"Upgrade module","category":"Combat","categoryKey":"Combat","rarity":"Rare","subtitle":"B-Class %NAME% Upgrade","description":"A significant upgrade for the Infra-Knife Accelerator. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potential improvements include: damage output, fire rate and overheat times.","icon":"","preview":"","colour":"#2177c8","source":"NMS_