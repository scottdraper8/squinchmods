nKey":"UI_MECH_ARMY_R_ARM_DESC","secondary":"Installable","tags":["Chargeable","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MECH_ARMY_R_ARM","@type":"GameAsset"},{"id":"WATERWORLD1","name":"LITHIUM","kind":"Resource","category":"Earth","categoryKey":"Earth","rarity":"Uncommon","subtitle":"Localised Earth Element","description":"Local metallic extract, typically found in large deposits or harvested from common mineral formations after inspection with an Analysis Visor. Typically found on ocean planets.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.BIOME.WATERWORLD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.biome.waterworld.webp","colour":"#1a2733","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_WATERWORLD1_NAME","descriptionKey":"UI_WATERWORLD1_DESC","secondary":"Substance","tags":[],"baseValue":72,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/WATERWORLD1","@type":"GameAsset"},{"id":"BLD_CRYS_SENT0","name":"LIVING FRAGMENT A","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive buildable base ornament. This is a detailed replica of the Living Fragments that litter discordant worlds, the prismatic grains that thrust from the earth in a struggle for freedom from their geological prison.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.CRYSTALSENTINEL0.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.crystalsentinel0.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_CRYS_SENT0_NAME","descriptionKey":"BLD_CRYS_DRONE_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BLD_CRYS_SENT0","@type":"GameAsset"},{"id":"BLD_CRYS_SENT1","name":"LIVING FRAGMENT B","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive buildable base ornament. This is a detailed replica of the Living Fragments that litter discordant worlds, the prismatic grains that thrust from the earth in a struggle for freedom from their geological prison.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.CRYSTALSENTINEL1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.crystalsentinel1.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_CRYS_SENT1_NAME","descriptionKey":"BLD_CRYS_DRONE_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BLD_CRYS_SENT1","@type":"GameAsset"},{"id":"FARMPROD8","name":"LIVING GLASS","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Rare","subtitle":"Advanced Agricultural Product","description":"An advanced building material, this glass has been imbued with organic compounds that allow it to react to the environment. Microbes within the glass filter harmful light of all wavelengths and balance the atmosphere as required. Crafted from Lubricant and Glass.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/FARMPROD.8.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/farmprod.8.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FARMPROD_8_NAME","descriptionKey":"UI_FARMPROD_8_DESC","secondary":"Special","tags":["Craftable","Trade good"],"baseValue":566000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FARMPROD8","@type":"GameAsset"},{"id":"S22_LINK","name":"LIVING LENS","kind":"Technology","category":"Suit","categoryKey":"Suit","rarity":"Impossible","subtitle":"Chromatic Focuser","description":"Slotting seamlessly into a Traveller Exosuit, this glassy technology links a Traveller fragment to Specialist Polo's Prismatic Core, reforging the many into one. Protects against annihilation by the Hive of Glass.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/TECH.S22LINK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/tech.s22link.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_S22_LINK_NAME","descriptionKey":"UI_S22_LINK_DESC","secondary":"Installable","tags":["Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/S22_LINK","@type":"GameAsset"},{"id":"CLAMPEARL","name":"LIVING PEARL","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Rare","subtitle":"Semi-Conscious Gemstone","description":"Born in the hearts of enormous glowing molluscs found deep underwater. Unlike most pearls, this sample is no unliving calcite. Some trace of the mother-clam's consciousness remains within the gem, giving it a lingering, haunting beauty.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.CLAMPEARL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.clampearl.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_CLAMPEARL_NAME","descriptionKey":"UI_CLAMPEARL_DESC","secondary":"Exotic","tags":[],"baseValue":5050,"level":0,"stackMultiplier":3,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/CLAMPEARL","@type":"GameAsset"},{"id":"SPACEGUNK4","name":"LIVING SLIME","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Uncommon","subtitle":"Junk","description":"A heavy, oozing slime. It is moving gently, as if it has a heartbeat of its own. Nutrient source: unknown.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/SPACEGUNK.4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/spacegunk.4.webp","colour":"#5b6f35","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_MAINTAIN_SUB4_NAME","descriptionKey":"UI_MAINTAIN_SUB4_DESC","secondary":"Substance","tags":[],"baseValue":20,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/SPACEGUNK4","@type":"GameAsset"},{"id":"STONE_ARMOUR","name":"LIVING STONE ARMOUR","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Armour","description":"An exclusive Exosuit Appearance Override. A powerful magnetic field runs through this ancient stone, turning lumpen rock into something almost alive. The carver of this effigy is unknown. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S18.STONEARMOUR.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s18.stonearmour.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_STONE_ARMOUR_NAME","descriptionKey":"UI_EXPED_STONE_ARMOUR_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/STONE_ARMOUR","@type":"GameAsset"},{"id":"STONE_BOOTS","name":"LIVING STONE BOOTS","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Boots","description":"An exclusive Exosuit Appearance Override. A powerful magnetic field runs through this ancient stone, turning lumpen rock into something almost alive. The carver of this effigy is unknown. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S18.STONEBOOTS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s18.stoneboots.webp","colour":"#007951","source":"NMS_REALITY_GCPRODU