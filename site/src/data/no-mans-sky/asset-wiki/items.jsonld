FLUID","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Trade Goods (Energy Source)","description":"Corrosion-resistant barrels of an experimental power fluid. One barrel of this highly volatile concoction is enough to power a space station for weeks on end. Particularly valued by mining economies.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.ENERGY4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.energy4.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TRADE_ITEM_ENERGY_4_NAME","descriptionKey":"UI_TRADE_ITEM_ENERGY_4_DESC","secondary":"Exotic","tags":["Trade good"],"baseValue":30000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TRA_ENERGY4","@type":"GameAsset"},{"id":"F_TRASH_5","name":"EXPIRED BRAINCORAL","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Collected Flotsam","description":"A piece of flotsam, wrenched from its years of drifting in the water when it became entangled in a fishing lure. Of little use to anyone.","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.CORAL.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.coral.2.webp","colour":"#8a7f72","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_TRASH_CORAL2_NAME","descriptionKey":"UI_FISH_TRASH_DESC","secondary":"Special","tags":["Consumable","Trade good"],"baseValue":500,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_TRASH_5","@type":"GameAsset"},{"id":"SHIPSLOT_DMG8","name":"EXPLODED PANEL","kind":"Technology","category":"Ship","categoryKey":"Ship","rarity":"Impossible","subtitle":"Damaged Starship Component","description":"Starship subsystem severely damaged. Slot cannot be used for storage or technology until damage is repaired. Use to begin repair process. Core starship functionality is not affected. Repairing this damage will free slot up for general inventory use.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/MAINTTECH.FARM5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/mainttech.farm5.webp","colour":"#7b0000","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SHIPSLOT_DMG8_NAME","descriptionKey":"UI_SHIPSLOT_DMG_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SHIPSLOT_DMG8","@type":"GameAsset"},{"id":"EGUILD_STAND_DN","name":"EXPLORERS","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Reward Item","description":"Currency or faction standing, given as a reward.","icon":"TEXTURES/UI/FRONTEND/ICONS/RANK/FACTIONS.EXPLORERGUILD.ON.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/rank/factions.explorerguild.on.webp","colour":"#7b0000","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_STANDING_G_EXP","descriptionKey":"UI_REWARDPOP_DESC","secondary":"Substance","tags":[],"baseValue":20,"level":null,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/EGUILD_STAND_DN","@type":"GameAsset"},{"id":"EGUILD_STAND_UP","name":"EXPLORERS","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Reward Item","description":"Currency or faction standing, given as a reward.","icon":"TEXTURES/UI/FRONTEND/ICONS/RANK/FACTIONS.EXPLORERGUILD.ON.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/rank/factions.explorerguild.on.webp","colour":"#8a7f72","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_STANDING_G_EXP","descriptionKey":"UI_REWARDPOP_DESC","secondary":"Substance","tags":[],"baseValue":20,"level":null,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/EGUILD_STAND_UP","@type":"GameAsset"},{"id":"FRIG_BOOST_COM","name":"EXPLOSIVE DRONES","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Rare","subtitle":"Consumable Frigate Upgrade","description":"A temporary frigate upgrade that lasts for one expedition. This pack of autonomous explosives have been programmed to launch from the fleet and pilot themselves directly towards hostile vessels. Extremely dangerous.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.FRIGBOOST.COMBAT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.frigboost.combat.webp","colour":"#0063b7","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FRIG_BOOST_COM_NAME","descriptionKey":"UI_FRIG_BOOST_COM_DESC","secondary":"Special","tags":["Craftable","Consumable"],"baseValue":75000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FRIG_BOOST_COM","@type":"GameAsset"},{"id":"DECAL_EXTINCT","name":"EXTINCTION DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal is dedicated to all extinct creatures who inhabited the worlds of the universe long ago.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.DECAL.EXTINCT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.decal.extinct.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_P_EXTINCT_NAME","descriptionKey":"BLD_DECAL_P_EXTINCT_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/DECAL_EXTINCT","@type":"GameAsset"},{"id":"FOOD_R_MERMIX","name":"EXTRA-FLUFFY BATTER","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A refined food product, created in the Nutrient Processor. Food such as this can be highly valuable. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.BATTER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.batter.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_R_MERMIX_NAME","descriptionKey":"FOOD_REFINED_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":14000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_R_MERMIX","@type":"GameAsset"},{"id":"FOOD_MC_CREAM","name":"EXTRA-FLUFFY CREAM CAKE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Extra-Fluffy Batter.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.CAKE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.cake.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_MC_CREAM_NAME","descriptionKey":"UI_CAKE_DESC_MC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":23600,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_MC_CREAM","@type":"GameAsset"},{"id":"MAINT_HOOVER","name":"EXTRACTOR UNIT","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Stellar Extractor Core","description":"Gathers resources directly from the interstellar medium, via a complex system of suction intakes and condensing tubes. The gathered substance varies with the local star classification. Powered directly from the freighter's main electrical loop. Functionality is entirely autonomous.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/MAINTTECH.FUEL3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/mainttech.fuel3.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_HOOVER_TECH_NAME","descriptionKey":"UI_HOOVER_TECH_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_HOOVER","@type":"GameAsset"},{"id":"SPEC_HELMET03","name":"EYE OF THE KORVAX HELMET","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Helmet","description":"An exclusive Exosuit Appearance Override. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.HELMET03.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.helmet03.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SPEC_HELMET_03_NAME","descriptionKey":"UI_SPEC_HELMET_03_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_HELMET03","@type":"GameAsset"},{"id":"TWITCH_PET19","name":"F. GRASPAEEUM EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Companion Egg","description":"A living, fertile egg, ready to hatch! The unborn creature nudges the eggshell with its tusks, excited to be hatched and see the universe. Scans indicate the being within has the genetic potential for a whimsical nature, likely to make a playful companion.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.PET19.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.pet19.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_PET_19_NAME","descriptionKey":"UI_TWIT_PET_19_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_PET19","@type":"GameAsset"},{"id":"EXPD_POSTER09A","name":"FACTIONS POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster echoes the ongoing tensions between the galaxies' dominant lifeforms.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.POSTER09A.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.poster09a.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER9A_NAME","descriptionKey":"BLD_EXPD_POSTER9A_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER09A","@type":"GameAsset"},{"id":"FACT_TOKEN","name":"FACTORY OVERRIDE UNIT","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Advanced Research Module","description":"A portable data unit, compatible with most planetary fabricator facilities. Once access has been gained to a central control terminal, the Override Unit can divert the facilities resources towards researching new product recipes.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.RESEARCHTOKEN.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.researchtoken.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FACT_TOKEN_NAME","descriptionKey":"UI_FACT_TOKEN_DESC","secondary":"Exotic","tags":["Craftable","Consumable"],"baseValue":50000,"level":0,"stackMultiplier":3,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FACT_TOKEN","@type":"GameAsset"},{"id":"PLANT_POOP","name":"FAECIUM","kind":"Resource","category":"Flora","categoryKey":"Flora","rarity":"Common","subtitle":"Harvested Agricultural Substance","description":"A foul-smelling compound that can be harvested from the Gutrot Flower, or less desirably from the faecal matter of some species. Creatures can be fed to encourage the formation and deposition of faecium crystals.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.PLANT.POOP.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.plant.poop.webp","colour":"#79502e","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_PLANTSUB_CREATUREPOOP_NAME","descriptionKey":"UI_PLANTSUB_CREATUREPOOP_DESC","secondary":"Substance","tags":["Cooking ingredient"],"baseValue":30,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/PLANT_POOP","@type":"GameAsset"},{"id":"WEAPEASY_DMG4","name":"FAILED RESISTOR","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Impossible","subtitle":"Damaged Multi-Tool Component","description":"Multi-Tool subsystem critically damaged. Slot cannot be used until damage is repaired. Use to begin repair process. Repairing will free slot up for general use.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.TECH5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.tech5.webp","colour":"#7b0000","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_WEAPSLOT_DMG12_NAME","descriptionKey":"UI_WEAPSLOT_DMG_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/WEAPEASY_DMG4","@type":"GameAsset"},{"id":"WEAPSLOT_DMG12","name":"FAILED RESISTOR","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Impossible","subtitle":"Damaged Multi-Tool Component","description":"Multi-Tool subsystem critically damaged. Slot cannot be used until damage is repaired. Use to begin repair process. Repairing will free slot up for general use.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.TECH5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.tech5.webp","colour":"#7b0000","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_WEAPSLOT_DMG12_NAME","descriptionKey":"UI_WEAPSLOT_DMG_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/WEAPSLOT_DMG12","@type":"GameAsset"},{"id":"PROC_FARM","name":"Farm (procedural)","kind":"Procedural item","category":"Farm","categoryKey":"Farm","rarity":"Rare","subtitle":"Delicate Flora","description":"A genetically engineered plant, ready for propagation. Sample appears to have %AGE% mutated genes. Root Structure: %ROOTS% Nutrient Source: %FOOD% Notes: %NOTES%","icon":"TEXTURES/UI/FRONTEND/ICONS/BUILDABLE/DECORATION.PLANTPOT3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/buildable/decoration.plantpot3.webp","colour":"#1eb809","source":"PROCEDURALPRODUCTTABLE.MBIN","nameKey":"ITEMGEN_FORMAT_PLANT","descriptionKey":"ITEMGEN_PLANT_MODERN","secondary":"Procedural","tags":["Generated name and value"],"baseValue":1000,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/procedural-item/PROC_FARM","@type":"GameAsset"},{"id":"EXOPOD_TECH1","name":"FAULTY HOLOGRAM","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Damaged Component","description":"This Exosuit Upgrade Module is critically damaged. Repair systems to restore upgrade functionality. If repaired, User will not be charged for any Exosuit Upgrades.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TREASUREPROD.PLANT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/treasureprod.plant.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_EXO_MAINT1_NAME","descriptionKey":"UI_EXO_MAINT_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/EXOPOD_TECH1","@type":"GameAsset"},{"id":"SPEC_BUCKETHELM","name":"FEARSOME VISOR","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Helmet","description":"An exclusive Exosuit Appearance Override. Strike dread into the hearts of your foes with this oxide-strengthened helmet. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.BUCKETHELM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.buckethelm.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SPEC_BUCKETHELM_NAME","descriptionKey":"UI_SPEC_BUCKETHELM_DESC","secondary":"Exotic","tags":[],"baseValue":3200,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_BUCKETHELM","@type":"GameAsset"},{"id":"EXPD_WORMHAT","name":"FEASTING CASQUE","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Helmet","description":"An exclusive Exosuit Appearance Override. Redistribute your facial organs and alarm other explorers by assuming the appearance of a sandworm cultist. This bio-silicone helmet is sealed against all known planetary hazards, but may feel slightly clammy to the wearer. Ritualistically transform the head of your Vy'keen appearance at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.WORMHEAD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.wormhead.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_WORMHAT_NAME","descriptionKey":"UI_WORMHAT_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_WORMHAT","@type":"GameAsset"},{"id":"BASE_DUST12","name":"FEATHER PALM","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"This tall-growing palm tree is common in arid climates, and often farmed for its sweet, nutritious sap. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BIOMEPROP.DUST12.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.biomeprop.dust12.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DUST12_NAME","descriptionKey":"BLD_DUST12_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_DUST12","@type":"GameAsset"},{"id":"NEW_PERK","name":"Feature","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Reward Item","description":"Currency or faction standing, given as a reward.","icon":"TEXTURES/UI/HUD/ICONS/BUILDINGS/BUILDING.SETTLEMENT.DDS","preview":"/asset-wiki/assets/textures/ui/hud/icons/buildings/building.settlement.webp","colour":"#1a2733","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_NEW_PERK_NAME","descriptionKey":"UI_REWARDPOP_DESC","secondary":"Substance","tags":[],"baseValue":20,"level":null,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/NEW_PERK","@type":"GameAsset"},{"id":"FOOD_M_CAT","name":"FELINE LIVER","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"A nutritious meat product, harvested from the corpse of the creature that once contained it. Process in a Nutrient Processor to generate edible products.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.MEAT.OFFAL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.meat.offal.webp","colour":"#bb3830","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_CAT_MEAT_NAME","descriptionKey":"FOOD_MEAT_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":1400,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_M_CAT","@type":"GameAsset"},{"id":"BAIT_VEG_3","name":"FERMENTED FRUIT","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Herbivore Bait","description":"A specialist bait for herbivores. Use the Analysis Visor to discover the bait preferences of specific creatures. Created in a Nutrient Processor from Faecium and harvestable plants. Can be further processed in the Nutrient Processor to create new bait types. Feeding using the correct bait will allow creatures to be ridden or harvested. Chose bait type from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.BAIT.FRUIT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.bait.fruit.webp","colour":"#007953","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BAIT_VEG_3_NAME","descriptionKey":"BAIT_VEG_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BAIT_VEG_3","@type":"GameAsset"},{"id":"F_DUST_EPIC_L1","name":"FERRITE BOWFIN","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Rare Fish","description":"UI_FISH_DUST_EPIC_L_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.MEDIUM.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.medium.2.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_DUST_EPIC_L1_NAME","descriptionKey":"UI_FISH_DUST_EPIC_L_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":30000,"level":3,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_DUST_EPIC_L1","@type":"GameAsset"},{"id":"LAND1","name":"FERRITE DUST","kind":"Resource","category":"Metal","categoryKey":"Metal","rarity":"Common","subtitle":"Metallic Mineral Extract","description":"An abundant mineral element, found in rock formations and other areas of geological interest. Easily extracted using a Mining Laser. Typically requires processing in a Refiner before use in construction or technology manufacture.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.LAND.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.land.1.webp","colour":"#8a7f72","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_LAND1_NAME","descriptionKey":"UI_LAND1_DESC","secondary":"Substance","tags":[],"baseValue":14,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/LAND1","@type":"GameAsset"},{"id":"JETS_CONFETTI","name":"FESTIVE JETPACK TRAIL","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Jetpack Exhaust Override","description":"An exclusive Exosuit Appearance Override. A multi-coloured scattering of bio-plastic flakes adds a celebratory flair to the Jetpack's output. Expelled material is fully compostable. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.JETS.CONFETTI.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.jets.confetti.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_JETTRAIL_CONFETTI_NAME","descriptionKey":"UI_JETTRAIL_CONFETTI_DESC","secondary":"Exotic","tags":[],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/JETS_CONFETTI","@type":"GameAsset"},{"id":"STAFF_PART_A","name":"FIBREGLASS GRIP","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Voltaic Component","description":"A strap of flexible resin, securely wrapped around a steel pole. One of three core components, this forms the backbone of a traditional Autophage Voltaic Staff.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/STAFFPARTA.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/staffparta.webp","colour":"#8c4b9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_STAFF_PART_A_NAME","descriptionKey":"UI_STAFF_PART_A_DESC","secondary":"Special","tags":["Craftable"],"baseValue":333,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/STAFF_PART_A","@type":"GameAsset"},{"id":"FOOD_VEG_STEW","name":"FIBROUS STEW","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.VEGSTEW.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.vegstew.webp","colour":"#007953","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_VEG_STEW_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":6400,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_VEG_STEW","@type":"GameAsset"},{"id":"F_RAD