rontend/icons/update3/mainttech.fuel4.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINT_ROBO10_NAME","descriptionKey":"UI_MAINT_ROBO_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_ROBO10","@type":"GameAsset"},{"id":"MAINT_FUEL3","name":"POWER CONDENSER","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Chargeable Power Unit","description":"A piece of rechargeable power technology. The power condenser harvests any heat energy wasted during the machine's operation, and uses it to generate extra power.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/MAINTTECH.FUEL3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/mainttech.fuel3.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINTAIN_FUEL3_NAME","descriptionKey":"UI_MAINTAIN_FUEL3_DESC","secondary":"Core","tags":["Core technology","Chargeable"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_FUEL3","@type":"GameAsset"},{"id":"MAINT_FRIG8","name":"POWER DISTRIBUTOR","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Damaged Component","description":"The central power unit for the device. Damage to the unit means it is currently distributing all the power to one particular circuit, causing a dangerous short.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.TECH1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.tech1.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINTAIN_TECH19_NAME","descriptionKey":"UI_MAINTAIN_TECH19_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-man