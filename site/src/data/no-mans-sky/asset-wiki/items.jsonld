condary":"Exotic","tags":["Trade good"],"baseValue":50000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TRA_EXOTICS5","@type":"GameAsset"},{"id":"MAINT_ROBO8","name":"NEURAL IGNITOR","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Damaged Autophage Component","description":"This autophage is far from working order, but its subcomponents shows the signs of a previous repair attempt. With a few additional tweaks, the work might be completed... Repair this component with , or use to locate the needed materials.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/MAINTTECH.FUEL2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/mainttech.fuel2.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINT_ROBO8_NAME","descriptionKey":"UI_MAINT_ROBO_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_ROBO8","@type":"GameAsset"},{"id":"CARGO_S_ALIEN","name":"NEURAL SHIELDING","kind":"Technology","category":"Alien Ship","categoryKey":"AlienShip","rarity":"Impossible","subtitle":"Hostile Probe Deflector","description":"A beautiful living weave of nanotubes, laced through the vessel's neural assembly. This structure can be energised as the ship deems fit, creating a field that blocks hostile cargo probes. Use the Quick Menu () while a scan is in progress to ask that the ship might block the scan.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/PRODUCT.STEM1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/product.stem1.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_CARGO_S_ALIEN_NAME","descriptionKey":"UI_CARGO_S_ALIEN_DESC","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":3,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/CARGO_S_ALIEN","@type":"GameAsset"},{"id":"UT_JET","name":"NEURAL STIMULATOR","kind":"Technology","category":"Suit","categoryKey":"Suit","rarity":"Common","subtitle":"Exosuit Movement Upgrade","description":"Increases the capacity of the Exosuit's Jetpack Tanks and Adrenal Pump Reserves, allowing the user to both fly and sprint longer.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.JETPACKMOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.jetpackmod.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_JET_NAME","descriptionKey":"UT_JET_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/UT_JET","@type":"GameAsset"},{"id":"CANNON","name":"NEUTRON CANNON","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Rare","subtitle":"Explosive Energy Weapon","description":"A high-energy weapon attachment for the Multi-Tool. The Neutron Cannon energises atmospheric particles before propelling them towards hostile targets, delivering significant area damage Access fire mode by pressing . Charge the weapon with , then release to unleash a volley of ionised particles. While the cannon can deliver instantaneous single shots, longer charges will result in significant increases to the speed and volume of released particles.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.CANNON.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.cannon.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"CANNON_NAME","descriptionKey":"CANNON_DESCRIPTION","secondary":"Installable","tags":["Chargeable","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/CANNON","@type":"GameAsset"},{"id":"UP_CANN1","name":"Neutron Cannon","kind":"Upgrade module","category":"Combat","categoryKey":"Combat","rarity":"Normal","subtitle":"C-Class %NAME% Upgrade","description":"A moderate upgrade for the Neutron Cannon. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potential upgrades include: projectile speed, charge time, weapon damage and number of projectiles.","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_CANNON","descriptionKey":"UP_CANNON1_DESC","secondary":"T_CANNON","tags":["4 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_CANN1","@type":"GameAsset"},{"id":"UP_CANN2","name":"Neutron Cannon","kind":"Upgrade module","category":"Combat","categoryKey":"Combat","rarity":"Rare","subtitle":"B-Class %NAME% Upgrade","description":"A significant upgrade for the Neutron Cannon. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potential upgrades include: projectile speed, charge time, weapon damage and number of projectiles.","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_CANNON","descriptionKey":"UP_CANNON2_DESC","secondary":"T_CANNON","tags":["4 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_CANN2","@type":"GameAsset"},{"id":"UP_CANN3","name":"Neutron Cannon","kind":"Upgrade module","category":"Combat","categoryKey":"Combat","rarity":"Epic","subtitle":"A-Class %NAME% Upgrade","description":"An extremely powerful upgrade for the Neutron Cannon. Use to begin upgrade installation process. The module is flexible, and exact upg