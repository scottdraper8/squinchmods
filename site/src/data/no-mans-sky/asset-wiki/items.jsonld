"],"baseValue":5000,"level":2,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_DUST_RARE_M2","@type":"GameAsset"},{"id":"SAND1","name":"SILICATE POWDER","kind":"Resource","category":"Metal","categoryKey":"Metal","rarity":"Common","subtitle":"Abundant Mineral","description":"An abundant mineral element, found within the geological strata of all rocky worlds. Easily extracted using a Terrain Manipulator. Create a tunnel anywhere to begin extraction. Process in a Refiner to create Glass.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.SAND.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.sand.1.webp","colour":"#8a7f72","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_SAND1_NAME","descriptionKey":"UI_SAND1_DESC","secondary":"Substance","tags":[],"baseValue":2,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/SAND1","@type":"GameAsset"},{"id":"FOOD_P_STELLAR","name":"SILICON EGG","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"A refined food product, created in the Nutrient Processor. Food such as this can be highly valuable. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.PLANT.STELLARWILD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.plant.stellarwild.webp","colour":"#095c77","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_MISC_STELLAR_NAME","descriptionKey":"FOOD_REFINED_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":500,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_P_STELLAR","@type":"GameAsset"},{"id":"ASTEROID1","name":"SILVER","kind":"Resource","category":"Exotic","categoryKey":"Exotic","rarity":"Common","subtitle":"Valuable Asteroid Mineral","description":"Valuable interstellar trading mineral, typically mined from asteroids. Occasionally found in underground planetary deposits. Prized by people in all systems for its lustre and shine.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.ASTEROID.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.asteroid.1.webp","colour":"#8a7f72","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_ASTEROID1_NAME","descriptionKey":"UI_ASTEROID1_DESC","secondary":"Substance","tags":["Trade good"],"baseValue":186,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/ASTEROID1","@type":"GameAsset"},{"id":"STATUE_ASTRO_S","name":"SILVER ASTRONAUT STATUE","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Unlockable Decoration","description":"An exclusive buildable base ornament, cast in silver. This astronaut statue is a tribute to all galactic explorers.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.ASTRO_S.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.astro_s.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_ASTRO_S_NAME","descriptionKey":"BLD_ASTRO_S_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/STATUE_ASTRO_S","@type":"GameAsset"},{"id":"STATUE_ATLAS_S","name":"SILVER ATLAS STATUE","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Unlockable Decoration","description":"An exclusive buildable base ornament, cast in silver. This statue is a decorative replica of an Atlas Interface. Its core rotates, powe