uinchmods.com/asset-wiki/id/item/product/U_LAUNCH4","@type":"GameAsset"},{"id":"F_HOT_COM_M2","name":"LAVASCALE TROUT","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_HOT_COM_M_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.SMALL.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.small.1.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_HOT_COM_M2_NAME","descriptionKey":"UI_FISH_HOT_COM_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":2000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_HOT_COM_M2","@type":"GameAsset"},{"id":"WEAPSLOT_DMG11","name":"LEAKING MEMBRANE","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Impossible","subtitle":"Damaged Multi-Tool Component","description":"Multi-Tool subsystem critically damaged. Slot cannot be used until damage is repaired. Use to begin repair process. Repairing will free slot up for general use.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/FARMPROD.5.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/farmprod.5.webp","colour":"#7b0000","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_WEAPSLOT_DMG11_NAME","descriptionKey":"UI_WEAPSLOT_DMG_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/WEAPSLOT_DMG11","@type":"GameAsset"},{"id":"FOOD_PIE_BEET","name":"LEATHERY TART","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.MEATPIE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.meatpie.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_BEETLE_PIE_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":62000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_PIE_BEET","@type":"GameAsset"},{"id":"FOOD_M_CRAB","name":"LEG MEAT","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"A nutritious meat product, harvested from the corpse of the creature that once contained it. Process in a Nutrient Processor to generate edible products.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.MEAT.RAW.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.meat.raw.webp","colour":"#bb3830","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_CRAB_MEAT_NAME","descriptionKey":"FOOD_MEAT_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":1400,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_M_CRAB","@type":"GameAsset"},{"id":"TWITCH_GUN22","name":"LEGACY OF THOUGHT","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Multifunction Survival Device","description":"An exclusive Multi-Tool. This A-class weapon comes equipped with a range of pre-installed technologies and upgrades. Take this Multi-Tool to add it to your collection, or Exchange it with your current Multi-Tool. Swap between active Multi-Tools from the Utilities section of the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/TWITCH.GUN22.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/twitch.gun22.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_GUN_22_NAME","descriptionKey":"UI_TWIT_GUN_22_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_GUN22","@type":"GameAsset"},{"id":"ALLOY4","name":"LEMMIUM","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Rare","subtitle":"Alloy Metal","description":"Pure Ferrite alloy. Crafted from Pure Ferrite and Uranium. Used extensively in starship freighter construction due to its sheer strength. A hardcore material popular on the Galactic Trade Network.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.METALLIC.4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.metallic.4.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_ALLOY_SIMPLE_4_NAME","descriptionKey":"UI_ALLOY_SIMPLE_4_DESC","secondary":"Stellar","tags":["Craftable"],"baseValue":25000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ALLOY4","@type":"GameAsset"},{"id":"BASE_DUST04","name":"LEOPARD TREE","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A thick-trunked tree with a distinctive rosette-like pattern across its bark. Water is retained in the trunk, the tree swelling to tremendous proportions during wet seasons. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BIOMEPROP.DUST04.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.biomeprop.dust04.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DUST04_NAME","descriptionKey":"BLD_DUST04_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_DUST04","@type":"GameAsset"},{"id":"FOOD_V_CAT","name":"LEOPARD-FRUIT","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"An animal byproduct, this nutritious morsel can be easily farmed without harm to the animal that produces it. Process in a Nutrient Processor to generate edible products.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.CATFRUIT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.catfruit.webp","colour":"#e57002","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_CAT_VEG_NAME","descriptionKey":"FOOD_VEG_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":3200,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_V_CAT","@type":"GameAsset"},{"id":"F_DUST_COM_S2","name":"LESSER DUSTFIN","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_DUST_COM_S_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.SMALL.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.small.2.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_DUST_COM_S2_NAME","descriptionKey":"UI_FISH_DUST_COM_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":1000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_DUST_COM_S2","@type":"GameAsset"},{"id":"EXPD_BANNER07","name":"LEVIATHAN EXPEDITION BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Equip this exclusive Personal Flair in commemoration of the 'Leviathan' Expedition, and the lifting of a generation-spanning curse. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.BANNER07.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.banner07.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_EXPD_07_NAME","descriptionKey":"UI_BANNER_EXPD_07_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_BANNER07","@type":"GameAsset"},{"id":"EXPD_DECAL07","name":"LEVIATHAN EXPEDITION DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal commemorates completion of the Leviathan expedition, and the lifting of a generation-spanning curse.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.DECAL07.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.decal07.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_EXPD_07_NAME","descriptionKey":"BLD_DECAL_EXPD_07_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_DECAL07","@type":"GameAsset"},{"id":"EXPD_POSTER07A","name":"LEVIATHAN POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster depicts a pod of biological frigates gliding serenely through the cosmos.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.POSTER07A.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.poster07a.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER7A_NAME","descriptionKey":"BLD_EXPD_POSTER7A_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER07A","@type":"GameAsset"},{"id":"F_DEEP_LEG_XL","name":"LEVIATHAN SPAWN","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Legendary Fish","description":"\"So young and fragile, despite its years beneath the waves. And yet thousands more years must pass before it joins the great herd in the stars...\"","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.LEVIATHANFISH.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.leviathanfish.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_DEEP_LEG_XL_NAME","descriptionKey":"UI_FISH_DEEP_LEG_XL_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":200000,"level":4,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_DEEP_LEG_XL","@type":"GameAsset"},{"id":"ENERGY","name":"LIFE SUPPORT","kind":"Technology","category":"Suit","categoryKey":"Suit","rarity":"Always","subtitle":"Suit Survival Power Pack","description":"The core of the Exosuit, the Life Support System continually filters and pumps breathable Oxygen. In addition to its role in the continued existence of the Exosuit user, the Life Support Unit uses surplus oxygen to generate power for secondary systems, such as the Jetpack, Speed Augmentation and Torch.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.CELL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.cell.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"ENERGY_NAME","descriptionKey":"ENERGY_DESCRIPTION","secondary":"Core","tags":["Core technology","Chargeable","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/ENERGY","@type":"GameAsset"},{"id":"UP_ENGY0","name":"Life Support","kind":"Upgrade module","category":"Protection","categoryKey":"Protection","rarity":"SeaTrash","subtitle":"Rusted %NAME% Upgrade","description":"UP_SEATRASH_DESC","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_LIFEBOOST","descriptionKey":"UP_SEATRASH_DESC","secondary":"T_ENERGY","tags":["2 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_ENGY0","@type":"GameAsset"},{"id":"UP_ENGY1","name":"Life Support","kind":"Upgrade module","category":"Protection","categoryKey":"Protection","rarity":"Rare","subtitle":"B-Class %NAME% Upgrade","description":"A significant upgrade for the Life Support System. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Increases life support power.","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_LIFEBOOST","descriptionKey":"UP_ENERGY1_DESC","secondary":"T_ENERGY","tags":["2 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_ENGY1","@type":"GameAsset"},{"id":"UP_ENGY2","name":"Life Support","kind":"Upgrade module","category":"Protection","categoryKey":"Protection","rarity":"Epic","subtitle":"A-Class %NAME% Upgrade","description":"An extremely powerful upgrade for the Life Support System. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potentially increases life support power and may offer limited solar-energy power-offsetting, decreasing power use during daylight.","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_LIFEBOOST","descriptionKey":"UP_ENERGY2_DESC","secondary":"T_ENERGY","tags":["2 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_ENGY2","@type":"GameAsset"},{"id":"UP_ENGY3","name":"Life Support","kind":"Upgrade module","category":"Protection","categoryKey":"Protection","rarity":"Legendary","subtitle":"S-Class %NAME% Upgrade","description":"A supremely powerful upgrade for the Life Support System. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potentially increases life support power and may offer limited solar-energy power-offsetting, decreasing power use during daylight.","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_LIFEBOOST","descriptionKey":"UP_ENERGY3_DESC","secondary":"T_ENERGY","tags":["2 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_ENGY3","@type":"GameAsset"},{"id":"UP_ENGYX","name":"Life Support","kind":"Upgrade module","category":"Protection","categoryKey":"Protection","rarity":"Illegal","subtitle":"Illegal %NAME% Upgrade","description":"UP_ENERGYX_DESC","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UP_LIFEBOOST","descriptionKey":"UP_ENERGYX_DESC","secondary":"T_ENERGY","tags":["2 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/UP_ENGYX","@type":"GameAsset"},{"id":"PRODFUEL2","name":"LIFE SUPPORT GEL","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Uncommon","subtitle":"Portable Life Support Power","description":"Emergency life support fuel. Synthesised from rocket fuel crystals and carbon, this gel offers a temporary boost to life support systems. Long-term impact on user's lungs is currently unknown.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.OXYGENGEL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.oxygengel.webp","colour":"#c01746","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FUELGEL3_NAME","descriptionKey":"FUELGEL3_DESC","secondary":"Fuel","tags":["Craftable","Consumable"],"baseValue":200,"level":0,"stackMultiplier":20,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/PRODFUEL2","@type":"GameAsset"},{"id":"U_ENERGY1","name":"LIFE SUPPORT MODULE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Rare","subtitle":"Significant Life Support Upgrade","description":"A significant upgrade for the Life Support System. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Increases life support power.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PROCTECH/PROCTECH.B.LIFESUPPORT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/proctech/proctech.b.lifesupport.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UP_ENERGY1_NAME","descriptionKey":"UP_ENERGY1_DESC","secondary":"Special","tags":["Consumable"],"baseValue":140,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/U_ENERGY1","@type":"GameAsset"},{"id":"U_ENERGY2","name":"LIFE SUPPORT MODULE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Rare","subtitle":"Powerful Life Support Upgrade","description":"An extremely powerful upgrade for the Life Support System. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potentially increases life support power and may offer limited solar-energy power-offsetting, decreasing power use during daylight.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PROCTECH/PROCTECH.A.LIFESUPPORT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/proctech/proctech.a.lifesupport.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UP_ENERGY2_NAME","descriptionKey":"UP_ENERGY2_DESC","secondary":"Special","tags":["Consumable"],"baseValue":300,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/U_ENERGY2","@type":"GameAsset"},{"id":"U_ENERGY3","name":"LIFE SUPPORT MODULE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Rare","subtitle":"Supreme Life Support Upgrade","description":"A supremely powerful upgrade for the Life Support System. Use to begin upgrade installation process. The module is flexible, and exact upgrade statistics are unknown until installation is complete. Potentially increases life support power and may offer limited solar-energy power-offsetting, decreasing power use during daylight.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PROCTECH/PROCTECH.S.LIFESUPPORT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/proctech/proctech.s.lifesupport.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UP_ENERGY3_NAME","descriptionKey":"UP_ENERGY3_DESC","secondary":"Special","tags":["Consumable"],"baseValue":480,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/U_ENERGY3","@type":"GameAsset"},{"id":"MAINT_FARM3","name":"LIGHT BALANCER","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Autonomous Agriculture Unit","description":"A bank of LEDs controlled by a photosensitive processing unit, designed to carefully deliver exactly the mix of red, green or blue light that the plant requires.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/MAINTTECH.FARM3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/mainttech.farm3.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MAINTAIN_FARM3_NAME","descriptionKey":"UI_MAINTAIN_FARM3_DESC","secondary":"Core","tags":["Core technology","Chargeable"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_FARM3","@type":"GameAsset"},{"id":"S23_PROD","name":"LIKE-SEED","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Window to a Dream","description":"A seed from another place. It crackles and hisses with static. Everything you thought you knew is within.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.ATLASSTONE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.atlasstone.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S23PROD_NAME","descriptionKey":"UI_S23PROD_DESC","secondary":"Stellar","tags":["Craftable","Consumable"],"baseValue":1600,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S23_PROD","@type":"GameAsset"},{"id":"TWITCH_SHIP45","name":"LIMITLESS MASTER PH1","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship. This A-class hauler benefits from shield and inventory capacity bonuses, and is pre-installed with a selection of technologies and upgrades. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.SHIP45.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.ship45.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_45_NAME","descriptionKey":"UI_TWIT_SHIP_DROPSHIP_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP45","@type":"GameAsset"},{"id":"FARMPROD7","name":"LIQUID EXPLOSIVE","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Rare","subtitle":"Advanced Agricultural Product","description":"A general purpose high explosive, offered in liquid form for convenience of transport and deployment. Do not drink. Crafted from Acid and Unstable Gel.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/FARMPROD.7.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/farmprod.7.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FARMPROD_7_NAME","descriptionKey":"UI_FARMPROD_7_DESC","secondary":"Special","tags":["Craftable","Trade good"],"baseValue":800500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FARMPROD7","@type":"GameAsset"},{"id":"SUNGOLD","name":"LIQUID SUN","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Common","subtitle":"Transmuted Metal","description":"Conventional planetary metal, superheated and then held in a stabilised plasmatic form. Extracted from metallic terrain deposits using a Solar Ray. Enormously energetic.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/SUB.SUNGOLD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/sub.sungold.webp","colour":"#e59001","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_SUNGOLD_NAME","descriptionKey":"UI_SUNGOLD_DESC","secondary":"Substance","tags":[],"baseValue":16,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/SUNGOLD","@type":"GameAsset"},{"id":"EXPD_BANNER14","name":"LIQUIDATOR BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Equip this exclusive Personal Flair in commemoration of the glorious triumph Liquidators expedition! Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.BANNER14.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.banner14.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_EXPD_14_NAME","descriptionKey":"UI_BANNER_EXPD_14_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_BANNER14","@type":"GameAsset"},{"id":"BUGMECH_HEAD","name":"LIQUIDATOR BODY","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Minotaur Limb Replacement","description":"An upgrade to the Minotaur Heavy Exocraft Hybrid, the Liquidator is a cutting-edge heavy-duty combat unit, designed to operate in the harshest of environments. Will function as a semi-autonomous artificial pilot plugin. Installation allows the Minotaur to traverse planets itself and engage in combat or mining activities to support its primary operator. The AI pilot will always cede control to the primary operator when they enter the cockpit.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/VEHICLE/RENDER.MECH.ARMY.HEAD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/vehicle/render.mech.army.head.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_MECH_ARMY_HEAD_NAME","descriptionKey":"UI_MECH_ARMY_HEAD_DESC","secondary":"Exotic","tags":["Craftable"],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BUGMECH_HEAD","@type":"GameAsset"},{"id":"MECH_ARMY_HEAD","name":"LIQUIDATOR BODY","kind":"Technology","category":"Mech","categoryKey":"Mech","rarity":"Always","subtitle":"Minotaur Limb Replacement","description":"An upgrade to the Minotaur Heavy Exocraft Hybrid, the Liquidator is a cutting-edge heavy-duty combat unit, designed to operate in the harshest of environments. Will function as a semi-autonomous artificial pilot plugin. Installation allows the Minotaur to traverse planets itself and engage in combat or mining activities to support its primary operator. The AI pilot will always cede control to the primary operator when they enter the cockpit.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/VEHICLE/RENDER.MECH.ARMY.HEAD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/vehicle/render.mech.army.head.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MECH_ARMY_HEAD_NAME","descriptionKey":"UI_MECH_ARMY_HEAD_DESC","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MECH_ARMY_HEAD","@type":"GameAsset"},{"id":"EXPD_DECAL14","name":"LIQUIDATOR DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal commemorates the glorious triumph Liquidators expedition, and the victory over the endless swarm.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.DECAL14.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.decal14.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_EXPD_14_NAME","descriptionKey":"BLD_DECAL_EXPD_14_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_DECAL14","@type":"GameAsset"},{"id":"BUGMECH_ARML","name":"LIQUIDATOR LEFT ARM","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Minotaur Limb Replacement","description":"An upgrade to the Minotaur Heavy Exocraft Hybrid, the Liquidator is a cutting-edge heavy-duty combat unit, designed to operate in the harshest of environments. This limb override also functions as its own dedicated combat system. It deploys high-velocity stun projectiles, perfect for keeping hostiles in place while advancing to close range.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/VEHICLE/RENDER.MECH.ARMY.LARM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/vehicle/render.mech.army.larm.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_MECH_ARMY_L_ARM_NAME","descriptionKey":"UI_MECH_ARMY_L_ARM_DESC","secondary":"Exotic","tags":["Craftable"],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BUGMECH_ARML","@type":"GameAsset"},{"id":"MECH_ARMY_L_ARM","name":"LIQUIDATOR LEFT ARM","kind":"Technology","category":"Mech","categoryKey":"Mech","rarity":"Impossible","subtitle":"Minotaur Limb Replacement","description":"An upgrade to the Minotaur Heavy Exocraft Hybrid, the Liquidator is a cutting-edge heavy-duty combat unit, designed to operate in the harshest of environments. This limb override also functions as its own dedicated combat system. It deploys high-velocity stun projectiles, perfect for keeping hostiles in place while advancing to close range.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/VEHICLE/RENDER.MECH.ARMY.LARM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/vehicle/render.mech.army.larm.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MECH_ARMY_L_ARM_NAME","descriptionKey":"UI_MECH_ARMY_L_ARM_DESC","secondary":"Installable","tags":["Chargeable","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MECH_ARMY_L_ARM","@type":"GameAsset"},{"id":"BUGMECH_LEGS","name":"LIQUIDATOR LEGS","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Minotaur Limb Replacement","description":"An upgrade to the Minotaur Heavy Exocraft Hybrid, the Liquidator is a cutting-edge heavy-duty combat unit, designed to operate in the harshest of environments. Installation will significantly improve the Minotaur's engine and mobility systems.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/VEHICLE/RENDER.MECH.ARMY.LEGS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/vehicle/render.mech.army.legs.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_MECH_ARMY_LEGS_NAME","descriptionKey":"UI_MECH_ARMY_LEGS_DESC","secondary":"Exotic","tags":["Craftable"],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BUGMECH_LEGS","@type":"GameAsset"},{"id":"MECH_ARMY_LEGS","name":"LIQUIDATOR LEGS","kind":"Technology","category":"Mech","categoryKey":"Mech","rarity":"Impossible","subtitle":"Minotaur Limb Replacement","description":"An upgrade to the Minotaur Heavy Exocraft Hybrid, the Liquidator is a cutting-edge heavy-duty combat unit, designed to operate in the harshest of environments. Installation will significantly improve the Minotaur's engine and mobility systems.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/VEHICLE/RENDER.MECH.ARMY.LEGS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/vehicle/render.mech.army.legs.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_MECH_ARMY_LEGS_NAME","descriptionKey":"UI_MECH_ARMY_LEGS_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseVa