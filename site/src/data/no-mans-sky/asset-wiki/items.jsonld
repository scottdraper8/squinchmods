subtitle":"Edible Product","description":"A well-baked biscuit, created in the Nutrient Processor. What was once a thin sheet of vaguely-sweetend nutrient paste has been elevated with the addition of carefully-chosen ingredients.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.BISCUIT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.biscuit.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_B_FLOWER_NAME","descriptionKey":"UI_BISCUIT_DESC_REF","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":35000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_B_FLOWER","@type":"GameAsset"},{"id":"F_LUSH_COM_L1","name":"FLOURISHING SHALEFISH","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_LUSH_COM_L_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.BIG.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.big.2.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_LUSH_COM_L1_NAME","descriptionKey":"UI_FISH_LUSH_COM_L_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":3000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_LUSH_COM_L1","@type":"GameAsset"},{"id":"BASE_SUBZPLANT7","name":"FLOWERING CHILLWOOD","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A hardy, slender-branched tree, native to subzero environs. This specimen is in full bloom. The thickened venation in the foliage protects the plant against extreme cold. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BIOMEPROP.SUBZPLANT7.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.biomeprop.subzplant7.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_SUBZPLANT_7_NAME","descriptionKey":"BLD_SUBZPLANT_7_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_SUBZPLANT7","@type":"GameAsset"},{"id":"FOOD_MC_CARM","name":"FLUFFY CARAMEL DELIGHT","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Extra-Fluffy Batter.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.CAKE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.cake.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_MC_CARM_NAME","descriptionKey":"UI_CAKE_DESC_MC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":23600,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_MC_CARM","@type":"GameAsset"},{"id":"FOOD_MM_CACTUS","name":"FLUFFY THROATRIPPER","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Writhing, Roiling Batter. Some caution is advised.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.CUPCAKEEVIL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.cupcakeevil.webp","colour":"#6ad01e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_MM_CACTUS_NAME","descriptionKey":"UI_CAKE_DESC_MM","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"