riptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":6400,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_STEW_BONE","@type":"GameAsset"},{"id":"BLD_CRYS_DRONE","name":"CRYSTALLISED DRONE","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive buildable base ornament. This is a detailed replica of the Living Fragments that litter discordant worlds, the prismatic grains that thrust from the earth in a struggle for freedom from their geological prison.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.CRYSTALDRONE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.crystaldrone.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_CRYS_DRONE_NAME","descriptionKey":"BLD_CRYS_DRONE_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BLD_CRYS_DRONE","@type":"GameAsset"},{"id":"SPIDER_PROD","name":"CRYSTALLISED HEART","kind":"Product","category":"Component","categoryKey":"Component","rarity":"Uncommon","subtitle":"Corrupted Aeronic Core","description":"The functional core of a Sentinel quadruped unit, but warped beyond all recognition. The entire machine is infested with a crystalline material that pulses wildy upon inspection. A close analysis reveals the machinery itself appears to have been reconfigured, stretching and warping into a whole new form, writhing in the presence of these radiant shards of glass.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.SPIDERCRYSTAL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.spidercrystal.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SPIDER_PROD_NAME","descriptionKey":"UI_SPIDER_PROD_DESC","secondary":"Special","tags":["Consumable"],"baseValue":37000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPIDER_PROD","@type":"GameAsset"},{"id":"GASGIANT1","name":"CRYSTALLISED HELIUM","kind":"Resource","category":"Earth","categoryKey":"Earth","rarity":"Uncommon","subtitle":"Localised Earth Element","description":"A supercooled chemical extract, typically found in large deposits or extracted from smaller mineral formations after inspection with an Analysis Visor. Extracted from deposits formed in the hostile conditions of gas giants.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.BIOME.GASGIANT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.biome.gasgiant.webp","colour":"#1e4fd0","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_GASGIANT1_NAME","descriptionKey":"UI_GASGIANT1_DESC","secondary":"Substance","tags":[],"baseValue":82,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/GASGIANT1","@type":"GameAsset"},{"id":"FOOD_B_CHEESE","name":"CURDY CRACKER","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A well-baked biscuit, created in the Nutrient Processor. What was once a thin sheet of vaguely-sweetend nutrient paste has been elevated with the addition of carefully-chosen ingredients.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.BISCUIT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.biscuit.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_B_CHEESE_NAME","descriptionKey":"UI_BISCUIT_DESC_REF","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":60000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_B_CHEESE","@type":"GameAsset"},{"id":"BASE_MEDPLANT03","name":"CURIOUS CORN","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"Sprouting decorative corn. Comes in a variety of colours. May attract decorative wildlife. Unable to reproduce naturally. Must be hand-pollinated.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.MEDPLANT03.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.medplant03.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_MEDPLANT_3_NAME","descriptionKey":"BLD_MEDPLANT_3_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_MEDPLANT03","@type":"GameAsset"},{"id":"BANNER_CHU","name":"CURIOUS FAUNA BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Demonstrate your interest in strange and unusual animal life with this exclusive Personal Flair. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BANNER.CHU.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.banner.chu.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_CHU_NAME","descriptionKey":"UI_BANNER_CHU_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BANNER_CHU","@type":"GameAsset"},{"id":"BASE_WPLANT1","name":"CURLY CORAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A delicate marine invertebrate, cultivated for potted growth. Its distinctive looping structure gives it an attractive whimsical appearance.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.WATERPLANT01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.waterplant01.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_WATERPLANT_1_NAME","descriptionKey":"BLD_WATERPLANT_1_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_WPLANT1","@type":"GameAsset"},{"id":"EXPD_BANNER16","name":"CURSED BANNER","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Bespoke Personal Identification","description":"Equip this exclusive Personal Flair in commemoration of the Cursed expedition. Apply this banner to your profile at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S16.BANNER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s16.banner.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BANNER_EXPD_16_NAME","descriptionKey":"UI_BANNER_EXPD_16_DESC","secondary":"Exotic","tags":[],"baseValue":220,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_BANNER16","@type":"GameAsset"},{"id":"EXPD_DECAL16","name":"CURSED DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal marks the escape from the boundary failure that occurred during the Cursed expedition...","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S16.DECAL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s16.decal.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_EXPD_16_NAME","descriptionKey":"BLD_DECAL_EXPD_16_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_DECAL16","@type":"GameAsset"},{"id":"WORMDUST","name":"CURSED DUST","kind":"Resource","category":"Special","categoryKey":"Special","rarity":"Rare","subtitle":"Ashes of Despair","description":"A powdery desert soil, slick with the gland expressions of a colossal sandworm. Historically, some have regarded this dust as the divine parent of such worms. It smells curiously sweet. Cursed Dust gathers in the terrain deposits of planets blighted by titan worm activity.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.WORMDUST.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.wormdust.webp","colour":"#512741","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_WORMDUST_NAME","descriptionKey":"UI_WORMDUST_DESC","secondary":"Substance","tags":[],"baseValue":959,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/WORMDUST","@type":"GameAsset"},{"id":"FOOD_CG_CUST","name":"CUSTARD CURIOSITY","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Proto-Batter.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.CUPCAKE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.cupcake.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_CG_CUST_NAME","descriptionKey":"UI_CAKE_DESC_CG","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":97200,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_CG_CUST","@type":"GameAsset"},{"id":"FOOD_DNUT_CUST","name":"CUSTARD DOUGHNUT","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.DOUGHNUT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.doughnut.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_DNUT_CUST_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":105000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_DNUT_CUST","@type":"GameAsset"},{"id":"FOOD_CK_CUST","name":"CUSTARD FANCY","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Cake Batter.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.CUPCAKE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.cupcake.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_CK_CUST_NAME","descriptionKey":"UI_CAKE_DESC_CK","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":85100,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_CK_CUST","@type":"GameAsset"},{"id":"FOOD_PIE_CUST","name":"CUSTARD TART","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.TART.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.tart.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_PIE_CUST_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":78000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_PIE_CUST","@type":"GameAsset"},{"id":"F_GAS_COM_XL","name":"CYCLONIC EEL","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Common Fish","description":"UI_FISH_GAS_COM_XL_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT4.FISH.EEL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product4.fish.eel.webp","colour":"#1e8a42","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_GAS_COM_XL_NAME","descriptionKey":"UI_FISH_GAS_COM_XL_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":5000,"level":1,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_GAS_COM_XL","@type":"GameAsset"},{"id":"F_RAD_EPIC_L1","name":"CYCLOPIC EEL","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Rare Fish","description":"UI_FISH_RAD_EPIC_L_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.EEL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.eel.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_RAD_EPIC_L1_NAME","descriptionKey":"UI_FISH_RAD_EPIC_L_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":30000,"level":3,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_RAD_EPIC_L1","@type":"GameAsset"},{"id":"VEHICLE_SCOPE","name":"CYCLOPS SCOPE","kind":"Technology","category":"All Vehicles","categoryKey":"AllVehicles","rarity":"Impossible","subtitle":"Exocraft Survey Device","description":"An enhancement to the Exocraft's navigational capabilities, attaching to the driver's visor display. Analyses surroundings and projects detailed data over the environment, identifying points of interest and generating valuable data when used to study flora, fauna and minerals. Hold to operate.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/VEHICLE/RENDER.SCOPE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/vehicle/render.scope.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_VEHICLESCOPE_NAME","descriptionKey":"UI_VEHICLESCOPE_DESC","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/VEHICLE_SCOPE","@type":"GameAsset"},{"id":"SHIPPLASMA","name":"CYCLOTRON BALLISTA","kind":"Technology","category":"All Ships Except Alien","categoryKey":"AllShipsExceptAlien","rarity":"Rare","subtitle":"Anti-Electronics Starship Weapon","description":"A powerful ship-to-ship weapon, flinging plasmatic balls of ionising radiation towards the selected target. These projectiles can disable starship engines, leaving the target vulnerable to attack from other weapons. These charged particles are extremely effective against starship shields, and considerably weaker against the metal armour of a ship's hull. Use to change weapon mode. Press to fire.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.IONBLAST.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.ionblast.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"SHIPBLOB_NAME","descriptionKey":"SHIPBLOB_DESCRIPT