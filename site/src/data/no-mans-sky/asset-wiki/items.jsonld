itle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster serves as a warning to all those who venture in the deepest of oceans...","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S17.POSTERB.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s17.posterb.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER17B_NAME","descriptionKey":"BLD_EXPD_POSTER17B_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER17B","@type":"GameAsset"},{"id":"BASE_DUST01","name":"DESERT STAR","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A welcome sight for weary Travellers, this distinctive, attractive tree indicates the presence of fresh water in desert climates. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BIOMEPROP.DUST01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.biomeprop.dust01.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DUST01_NAME","descriptionKey":"BLD_DUST01_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_DUST01","@type":"GameAsset"},{"id":"CATAPROD3","name":"DESTABLISED SODIUM","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Concentrated Sodium Deposit","description":"Sodium is typically highly stable, but certain configurations retain the reactivity of its component ions. User is advised to wear Hazardous Material Gauntlets before handling. Synthesised from Sodium.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.DESTABILISEDSODIUM.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.destabilisedsodium.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_WATERPROD3_NAME","descriptionKey":"UI_WATERPROD3_DESC","secondary":"Exotic","tags":[],"baseValue":12300,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/CATAPROD3","@type":"GameAsset"},{"id":"TWITCH_GUN15","name":"DESTROYER OF THE HORIZON 45P/98T","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Multifunction Survival Device","description":"An exclusive Multi-Tool. This A-class weapon comes equipped with a range of pre-installed technologies and upgrades. Take this Multi-Tool to add it to your collection, or Exchange it with your current Multi-Tool. Swap between active Multi-Tools from the Utilities section of the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.GUN15.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.gun15.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_GUN_15_NAME","descriptionKey":"UI_TWIT_GUN_GENERIC_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_GUN15","@type":"GameAsset"},{"id":"SLIME_MED","name":"DETOXIFIED SLIME","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Placeable Sludge","description":"Gelatinous and slowly pulsing, this puddle of living slime smells sweeter than would be imagined. Though there is no evidence to suggest it would be unsafe to do so, avoid treading on the slime where possible.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.SLIMEMED.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.slimemed.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_SLIME_MED_NAME","descriptionKey":"BLD_SLIME_MED_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SLIME_MED","@type":"GameAsset"},{"id":"LAUNCHSUB2","name":"DEUTERIUM","kind":"Resource","category":"Earth","categoryKey":"Earth","rarity":"Common","subtitle":"High Energy Substance","description":"A stable hydrogen isotope used heavily in both small-scale fusion reactors and neutron-scattering shield technology. Deuterium very rarely occurs naturally. Most of the galaxy's supply comes from the processing of Di-hydrogen and Tritium in Refiners.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.LAUNCHSUB.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.launchsub.2.webp","colour":"#355a7d","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_LAUNCHSUB2_NAME","descriptionKey":"UI_LAUNCHSUB2_DESC","secondary":"Substance","tags":[],"baseValue":34,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/LAUNCHSUB2","@type":"GameAsset"},{"id":"FOOD_STEW_O_HOT","name":"DEVILLED ORGANS","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.MEATSTEW.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.meatstew.webp","colour":"#bb3830","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_STEW_O_HOT_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":18800,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_STEW_O_HOT","@type":"GameAsset"},{"id":"LAUNCHSUB","name":"DI-HYDROGEN","kind":"Resource","category":"Earth","categoryKey":"Earth","rarity":"Common","subtitle":"High Energy Substance","description":"A stable, crystalline form of hydrogen remarkable both for its extreme energy density and its stability at atmospheric pressures. Common to all worlds, Di-hydrogen is found in the form of large blue crystals. It is a key component of Starship Launch Fuel.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.LAUNCHSUB.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.launchsub.1.webp","colour":"#355a7d","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_LAUNCHSUB_NAME","descriptionKey":"UI_LAUNCHSUB_DESC","secondary":"Substance","tags":[],"baseValue":34,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/LAUNCHSUB","@type":"GameAsset"},{"id":"JELLY","name":"DI-HYDROGEN JELLY","kind":"Product","category":"Component","categoryKey":"Component","rarity":"Common","subtitle":"Portable Life Support Power","description":"A faintly-glowing jelly. Its gentle light and soft wobble belie the fact that this sticky gel is both highly toxic and highly flammable. Skin contact is to be avoided at all costs. Synthesised from Di-hydrogen.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.JELLY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.jelly.webp","colour":"#c01746","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FUEL_JELLY_NAME","descriptionKey":"FUEL_JELLY_DESC","secondary":"Fuel","tags":["Craftable"],"baseValue":200,"level":0,"stackMultiplier":2,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/JELLY","@type":"GameAsset"},{"id":"COLD1","name":"DIOXITE","kind":"Resource","category":"Earth","categoryKey":"Earth","rarity":"Uncommon","subtitle":"Localised Earth Element","description":"Local mineral extract, typically found in large deposits or extracted from common minerals after inspection with an Analysis Visor. Typically found on planets with a frozen environment.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4SUBSTANCES/SUBSTANCE.BIOME.COLD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4substances/substance.biome.cold.webp","colour":"#1e4fd0","source":"NMS_REALITY_GCSUBSTANCETABLE.MBIN","nameKey":"UI_COLD1_NAME","descriptionKey":"UI_COLD1_DESC","secondary":"Substance","tags":[],"baseValue":62,"level":null,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/resource/COLD1","@type":"GameAsset"},{"id":"FOOD_M_DIPLO","name":"DIPLO CHUNKS","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"A nutritious meat product, harvested from the corpse of the creature that once contained it. Process in a Nutrient Processor to generate edible products.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.MEAT.RAW.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.meat.raw.webp","colour":"#bb3830","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_DIPLO_MEAT_NAME","descriptionKey":"FOOD_MEAT_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":1400,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_M_DIPLO","@type":"GameAsset"},{"id":"EXPD_EGG_23","name":"DIPLO EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Gentle Giant Embryo","description":"A living, fertile egg, ready to hatch! A long-necked diplodocus embryo is inside. Scans indicate the being within has the genetic potential to be gigantic and prehistoric.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S23.DIPLOPET.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s23.diplopet.webp","colour":"#4d2987","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_EGG_23_NAME","descriptionKey":"UI_EXPD_EGG_23_DESC","secondary":"Exotic","tags":[],"baseValue":3200,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_EGG_23","@type":"GameAsset"},{"id":"S_POSTER24","name":"DIPLOMACY POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster represents the Traveller's place amongst the dominant alien species in the universe.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.S_POSTER24.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.s_poster24.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_S_POSTER24_NAME","descriptionKey":"BLD_S_POSTER24_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S_POSTER24","@type":"GameAsset"},{"id":"SWARM_BOOTS","name":"DIREWASP BOOTS","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Boots","description":"An exclusive Exosuit Appearance Override. Heavy-duty combat armour, forged from salvaged swarmer alloys. Imperceptible vibrations in the metal help to deflect incoming fire. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S22.SWARMBOOTS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s22.swarmboots.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_SWARM_BOOTS_NAME","descriptionKey":"UI_EXPED_SWARM_SET_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SWARM_BOOTS","@type":"GameAsset"},{"id":"SWARM_TORSO","name":"DIREWASP CHESTPIECE","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Torso Customisation","description":"An exclusive Exosuit Appearance Override. Heavy-duty combat armour, forged from salvaged swarmer alloys. Imperceptible vibrations in the metal help to deflect incoming fire. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S22.SWARMTORSO.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s22.swarmtorso.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_SWARM_TORSO_NAME","descriptionKey":"UI_EXPED_SWARM_SET_DESC","secondary":"Exotic","tags":[],"baseValue":750,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SWARM_TORSO","@type":"GameAsset"},{"id":"SWARM_LEGS","name":"DIREWASP CUISSES","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Leg Customisation","description":"An exclusive Exosuit Appearance Override. Heavy-duty combat armour, forged from salvaged swarmer alloys. Imperceptible vibrations in the metal help to deflect incoming fire. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S22.SWARMLEGS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s22.swarmlegs.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_SWARM_LEGS_NAME","descriptionKey":"UI_EXPED_SWARM_SET_DESC","secondary":"Exotic","tags":[],"baseValue":750,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SWARM_LEGS","@type":"GameAsset"},{"id":"SWARM_GUN","name":"DIREWASP DISINTEGRATOR","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Multifunction Survival Device","description":"An exclusive Multi-Tool. Fabricated from corrupted ichor alloys, this powerful rifle is precisely calibrated for comfort and balance, allowing the user to eliminate great swarms of hostiles without fatigue. Take this Multi-Tool to add it to your collection, or Exchange it with your current Multi-Tool. Swap between active Multi-Tools from the Utilities section of the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S22.SWARMGUN.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s22.swarmgun.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_SWARM_GUN_NAME","descriptionKey":"UI_EXPD_SWARM_GUN_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SWARM_GUN","@type":"GameAsset"},{"id":"SWARM_PACK","name":"DIREWASP FLIGHTPACK","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Jetpack","description":"An exclusive Exosuit Appearance Override. This corrupted ichor-forged jetpack constantly hums and oscillates, as though buzzing with the rage of a thousand metal insects. An exclusive exosuit augmentation commemorating completion of the 'Swarm' Expedition. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S22.SWARMPACK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s22.swarmpack.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_SWARM_PACK_NAME","descriptionKey":"UI_EXPED_SWARM_PACK_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SWARM_PACK","@type":"GameAsset"},{"id":"SWARM_GLOVES","name":"DIREWASP GLOVES","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Gloves","description":"An exclusive Exosuit Appearance Override. Heavy-duty combat armour, forged from salvaged swarmer alloys. Imperceptible vibrations in the metal help to deflect incoming fire. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S22.SWARMGLOVES.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s22.swarmgloves.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_SWARM_GLOVES_NAME","descriptionKey":"UI_EXPED_SWARM_SET_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SWARM_GLOVES","@type":"GameAsset"},{"id":"SWARM_HAT","name":"DIREWASP HELM","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Helmet","description":"An exclusive Exosuit Appearance Override. A heavy-duty combat helmet, forged from salvaged swarmer alloys. Imperceptible vibrations in the metal help to deflect incoming fire. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP//EXPEDITION.S22.SWARMHAT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop//expedition.s22.swarmhat.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_SWARM_HAT_NAME","descriptionKey":"UI_EXPED_SWARM_HAT_DESC","secondary":"Exotic","tags":[],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SWARM_HAT","@type":"GameAsset"},{"id":"SWARM_ARMOUR","name":"DIREWASP PLATING","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Armour","description":"An exclusive Exosuit Appearance Override. Heavy-duty combat armour, forged from salvaged swarmer alloys. Imperceptible vibrations in the metal help to deflect incoming fire. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S22.SWARMARMOUR.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s22.swarmarmour.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPED_SWARM_ARMOUR_NAME","descriptionKey":"UI_EXPED_SWARM_SET_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SWARM_ARMOUR","@type":"GameAsset"},{"id":"TRA_MINERALS1","name":"DIRT","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Common","subtitle":"Trade Goods (Minerals)","description":"Several tonnes of dirt. Leftover dirt from mining operations. Residual metals can be extracted by specialists in manufacturing economies with the time and equipment to sift through it.","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.MINERALS1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.minerals1.webp","colour":"#cccccc","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TRADE_ITEM_MINERALS_1_NAME","descriptionKey":"UI_TRADE_ITEM_MINERALS_1_DESC","secondary":"Exotic","tags":["Trade good"],"baseValue":1000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TRA_MINERALS1","@type":"GameAsset"},{"id":"ALLOY2","name":"DIRTY BRONZE","kind":"Product","category":"Tradeable","categoryKey":"Tradeable","rarity":"Rare","subtitle":"Alloy Metal","description":"A popular metal alloy with a wide variety of uses. 'Dirty Bronze' has shed its scientific name in favour of the popular term for its colour. Crafted from Pure Ferrite and Pyrite.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.METALLIC.2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.metallic.2.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_ALLOY_SIMPLE_2_NAME","descriptionKey":"UI_ALLOY_SIMPLE_2_DESC","secondary":"Stellar","tags":["Craftable"],"baseValue":25000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/ALLOY2","@type":"GameAsset"},{"id":"FOOD_M_DIGGER","name":"DIRTY MEAT","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Raw Ingredient","description":"A nutritious meat product, harvested from the corpse of the creature that once contained it. Process in a Nutrient Processor to generate edible products.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.MEAT.RAW.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.meat.raw.webp","colour":"#bb3830","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_DIGGER_MEAT_NAME","descriptionKey":"FOOD_MEAT_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":1400,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_M_DIGGER","@type":"GameAsset"},{"id":"SPEC_EMOTE10","name":"DISBELIEF","kind":"Product","category":"Emote","categoryKey":"Emote","rarity":"Common","subtitle":"Unlockable Gesture","description":"An exclusive gesture. This can be selected from the Quick Menu. Fall to your knees in disbelief at the wonders you have seen.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.EMOTE10.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.emote10.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"EMOTE_KNEES_U","descriptionKey":"EMOTE_KNEES_DESC","secondary":"Exotic","tags":[],"baseValue":1500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_EMOTE10","@type":"GameAsset"},{"id":"WEAPSENT_DMG2","name":"DISCORDANT PRISM","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Impossible","subtitle":"Incomplete Sentinel Salvage","description":"This Multi-Tool is a piece of hybrid technology, a fusion of crude scrap and a deep, powerful energy - part salvage, part Sentinel, part something undefinable... This process of recycled fusion was incomplete when this tool was acquired. Use to continue repair operations and free this slot for general use.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/ROBOTSHIP.PULSE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/robotship.pulse.webp","colour":"#7b0000","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_WEAPSENT_DMG2_NAME","descriptionKey":"UI_WEAPSENT_DMG_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/WEAPSENT_DMG2","@type":"GameAsset"},{"id":"JETS_CORRUPT","name":"DISCORDANT TRAIL","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Jetpack Exhaust Override","description":"An exclusive Exosuit Appearance Override. The jetpack exhaust is augmented with an atlantideum filter. When activated, its discordant effect is spilled across the landscape, a trail of dissonant reverberations that echo on an unknowable frequency. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.JETS.CORRUPT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.jets.corrupt.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_CORRUPT_TRAIL_NAME","descriptionKey":"UI_CORRUPT_TRAIL_DESC","secondary":"Exotic","tags":[],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/JETS_CORRUPT","@type":"GameAsset"},{"id":"PROC_LUMP","name":"Dismantle Bio (procedural)","kind":"Procedural item","category":"Dismantle Bio","categoryKey":"Dismantle Bio","rarity":"Rare","subtitle":"Recovered Item","description":"Recovered Item","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TREASURE.LUMP.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/treasure.lump.webp","colour":"#1fb80a","source":"PROCEDURALPRODUCTTABLE.MBIN","nameKey":"ITEMGEN_FORMAT_LUMP","descriptionKey":"UI_UNDERGROUND_SUB","secondary":"Procedural","tags":["Generated name and value"],"baseValue":1000,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/procedural-item/PROC_LUMP","@type":"GameAsset"},{"id":"PROC_DATA","name":"Dismantle Data (procedural)","kind":"Procedural item","category":"Dismantle Data","categoryKey":"Dismantle Data","rarity":"Rare","subtitle":"Recovered Item","description":"Recovered Item","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TREASURE.DATAPACK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/treasure.datapack.webp","colour":"#1fb80a","source":"PROCEDURALPRODUCTTABLE.MBIN","nameKey":"ITEMGEN_FORMAT_DATA","descriptionKey":"UI_UNDERGROUND_SUB","secondary":"Procedural","tags":["Generated name and value"],"baseValue":1000,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/procedural-item/PROC_DATA","@type":"GameAsset"},{"id":"PROC_COG","name":"Dismantle Tech (procedural)","kind":"Procedural item","category":"Dismantle Tech","categoryKey":"Dismantle Tech","rarity":"Rare","subtitle":"Recovered Item","description":"Recovered Item","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TREASURE.COG.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/treasure.cog.webp","colour":"#1fb80a","source":"PROCEDURALPRODUCTTABLE.MBIN","nameKey":"ITEMGEN_FORMAT_COG","descriptionKey":"UI_UNDERGROUND_SUB","secondary":"Procedural","tags":["Generated name and value"],"baseValue":1000,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/procedural-item/PROC_COG","@type":"GameAsset"},{"id":"SPEC_EMOTE08","name":"DISTANT GAZE","kind":"Product","category":"Emote","categoryKey":"Emote","rarity":"Common","subtitle":"Unlockable Gesture","description":"An exclusive gesture. This can be selected from the Quick Menu. Look to the horizon and search for your next adventure.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.EMOTE08.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.emote08.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"EMOTE_GAZE_U","descriptionKey":"EMOTE_GAZE_DESC","secondary":"Exotic","tags":[],"baseValue":1500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_EMOTE08","@type":"GameAsset"},{"id":"EXP_CURIO3","name":"DIVERGENCE CUBE","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Anomalous Data Unit","description":"A glitching, pulsing data unit. It does not seem to belong in this reality. The cube gives the impression of a silent scream, the frozen cries of hundreds of lost minds trapped within.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.CURIO.1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.curio.1.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXP_TABLET_NAME","descriptionKey":"UI_EXP_TABLET_DESC","secondary":"Exotic","tags":[],"baseValue":3015,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXP_CURIO3","@type":"GameAsset"},{"id":"PROC_HIST","name":"Document (procedural)","kind":"Procedural item","category":"Document","categoryKey":"Document","rarity":"Rare","subtitle":"Historical Document","description":"Historical Document","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TREASUREPROD.STRANGEBOOK.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/treasureprod.strangebook.webp","colour":"#1fb80a","source":"PROCEDURALPRODUCTTABLE.MBIN","nameKey":"ITEMGEN_FORMAT_DOC","descriptionKey":"HIST_SUB","secondary":"Procedural","tags":["Generated name and value"],"baseValue":1000,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/procedural-item/PROC_HIST","@type":"GameAsset"},{"id":"FOOD_CM_CREAM","name":"DOOMED CREAM CAKE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. These cake-like nutrients are processed from a base of Wailing Batter.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.CCAKEEVIL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.ccakeevil.webp","colour":"#6ad01e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_CM_CREAM_NAME","descriptionKey":"UI_CAKE_DESC_CM","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":152300,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_CM_CREAM","@type":"GameAsset"},{"id":"FOOD_R_DOUGH","name":"DOUGH","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A refined food product, created in the Nutrient Processor. Food such as this can be highly valuable. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.DOUGH.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.dough.webp","colour":"#79502e","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_R_DOUGH_NAME","descriptionKey":"FOOD_REFINED_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":3200,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_R_DOUGH","@type":"GameAsset"},{"id":"F_ALL_LEG_L1","name":"DRAGONFISH","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Legendary Fish","description":"\"Territorial, ancient, furious to be caught. The king of the sea.\"","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.XL.3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.xl.3.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_ALL_LEG_L1_NAME","descriptionKey":"UI_FISH_ALL_LEG_L_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":150000,"level":4,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_ALL_LEG_L1","@type":"GameAsset"},{"id":"WEAPSENT_DMG4","name":"DRAINED POWER CORE","kind":"Technology","category":"Weapon","categoryKey":"Weapon","rarity":"Impossible","subtitle":"Incomplete Sentinel Salvage","description":"This Multi-Tool is a piece of hybrid technology, a fusion of crude scrap and a deep, powerful energy - part salvage, part Sentinel, part something undefinable... This process of recycled fusion was incomplete when this tool was acquired. Use to continue repair operations and free this slot for general use.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/ROBOTSHIP.LAUNCHER.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/robotship.launcher.webp","colour":"#7b0000","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_WEAPSENT_DMG4_NAME","descriptionKey":"UI_WEAPSENT_DMG_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/WEAPSENT_DMG4","@type":"GameAsset"},{"id":"S_SAIL3","name":"DRAPED CANVAS","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"This draped canvas half-sail replicates the design of the ancient maritime trade vessels of the Gek, and makes for a striking nautical-themed home decoration.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.S_SAIL_3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.s_sail_3.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_S_SAIL3_NAME","descriptionKey":"BLD_S_SAIL3_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S_SAIL3","@type":"GameAsset"},{"id":"EXPD_POSTER06A","name":"DREAD CAPTAIN FAHNG POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. Few Vy'keen would be unfamiliar with Dread Captain Fahng and their bone-chilling exploits - though it is not known for certain whether they are a real historical figure, or simply a story made up to frighten disobedient cubs.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.POSTER06A.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.poster06a.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER6A_NAME","descriptionKey":"BLD_EXPD_POSTER6A_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER06A","@type":"GameAsset"},{"id":"WHALE_BEACON","name":"DREAM AERIAL","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Subconscious Access Device","description":"A signal receiver and amplifier, tuned to the wavelength of the unconscious mind. It is every colour all at once, splitting the surrounding light into a shimmering rainbow. Use Relay Song () while in deep space to search for cosmic megafauna.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.WHALEBEACON.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.whalebeacon.webp","colour":"#311a49","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_WHALE_BEACON_NAME","descriptionKey":"UI_WHALE_BEACON_DESC","secondary":"Special","tags":["Craftable","Consumable"],"baseValue":16,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/WHALE_BEACON","@type":"GameAsset"},{"id":"SUB_MINER","name":"DREDGING LASER","kind":"Technology","category":"Submarine","categoryKey":"Submarine","rarity":"Impossible","subtitle":"Nautilon Terrain Manipulator","description":"Adds Terrain Manipulation capability to the laser systems of the Nautilon Submarine. Cooled by specially designed water intakes, it is specifically calibrated to carve through the complex geology of the sea floor.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/VEHICLE/RENDER.SUBMARINECANNONMOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/vehicle/render.submarinecannonmod.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SUB_MINER_NAME","descriptionKey":"UI_SUB_MINER_DESC","secondary":"Installable","tags":["Chargeable","Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SUB_MINER","@type":"GameAsset"},{"id":"VEHICLE_GRIP1","name":"DRIFT SUSPENSION","kind":"Technology","category":"Exocraft","categoryKey":"Exocraft","rarity":"Impossible","subtitle":"Exocraft Handling Modification","description":"Overhauls Exocraft handling values through a combination of software tweaks, pressure adjustments and the insertion of microgravity wells into key suspension components. Specifically tuned to increase the ability of the Exocraft to drift.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/VEHICLE/RENDER.TRACTION.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/vehicle/render.traction.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"VEHICLE_GRIP1_NAME","descriptionKey":"VEHICLE_GRIP1_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/VEHICLE_GRIP1","@type":"GameAsset"},{"id":"SPEC_FIREWORK05","name":"DUAL CHROME FIREWORK","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Consumable Pyrotechnics Device","description":"A luxury firework, exploding into sparkling wedges of indium and cadmium. Ignite to create glittering displays in the sky. Place launch tube via the Build Menu (). Warning: Aim away from living creatures. Not recommended for indoor use.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.FIREWORK05.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.firework05.webp","colour":"#262626","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FIREWORK_PROD_WEDGES_NAME","descriptionKey":"UI_FIREWORK_PROD_WEDGES_DESC","secondary":"Exotic","tags":[],"baseValue":60,"level":0,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_FIREWORK05","@type":"GameAsset"},{"id":"BASE_DUST03","name":"DUST PALM","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A miniature palm with two layers of fronds. Microscopic jellyfish-like creatures make their home among the pinnate inner foliage, sheltering from dust storms and consuming parasites. Provides decorative landscaping opportunities for bases.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.BIOMEPROP.DUST03.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.biomeprop.dust03.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DUST03_NAME","descriptionKey":"BLD_DUST03_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_DUST03","@type":"GameAsset"},{"id":"BASE_MEDPLANT02","name":"DWARF PALM","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Organic Decoration","description":"A squat, easily-managed form of the larger palm species. Place outdoors to attract wildlife and to purify the air.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.MEDPLANT02.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.medplant02.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_MEDPLANT_2_NAME","descriptionKey":"BLD_MEDPLANT_2_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BASE_MEDPLANT02","@type":"GameAsset"},{"id":"TWITCH_SHIP60","name":"DX7 IBAIL","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive Starship. This A-class fighter benefits from damage and manoeuvrability bonuses, and is pre-installed with a selection of technologies and upgrades. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/TWITCH.SHIP60.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/twitch.ship60.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_SHIP_60_NAME","descriptionKey":"UI_TWIT_SHIP_FIGHTER_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_SHIP60","@type":"GameAsset"},{"id":"UT_SHIPBLOB","name":"DYSON PUMP","kind":"Technology","category":"All Ships Except Alien","categoryKey":"AllShipsExceptAlien","rarity":"Normal","subtitle":"Starship Cyclotron Upgrade","description":"Replaces the heat sink of the Cyclotron Ballista by encompassing the entire unit with a heat-absorbing megastructure. Heat output is recycled to boost combat efficiency. Significantly improves heat performance.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.IONBLASTMOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.ionblastmod.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_SHIPBLOB_NAME","descriptionKey":"UT_SHIPBLOB_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/UT_SHIPBLOB","@type":"GameAsset"},{"id":"TWITCH_PET21","name":"E. LEOLOXOSTII EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Companion Egg","description":"A living, fertile egg, ready to hatch! The creature inside snuffles at the inside of its egg, curious about the world beyond. Scans indicate the being within has the genetic potential for a ferocious personality.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/TWITCH.PET21.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/twitch.pet21.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_PET_21_NAME","descriptionKey":"UI_TWIT_PET_21_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_PET21","@type":"GameAsset"},{"id":"TWITCH_PET15","name":"E. PANTHEIBEA EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Companion Egg","description":"A living, fertile egg, ready to hatch! The hefty beast within clinks its crystalline limbs against the egg. Scans indicate the being within has the genetic potential for a placid nature, gentle despite its formidable appearance.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.TWITCH.PET15.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.twitch.pet15.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TWIT_PET_15_NAME","descriptionKey":"UI_TWIT_PET_15_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/TWITCH_PET15","@type":"GameAsset"},{"id":"FOOD_PIE_MOLE","name":"EARTHY PIE","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.VEGPIE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.vegpie.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_MOLE_PIE_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":62000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_PIE_MOLE","@type":"GameAsset"},{"id":"S10_FRAGMENT","name":"ECHO COLLECTIVE","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Consciousness Housing","description":"A shifting vortex of atlantideum, attuned to the growing collective will housed inside Nada's Prime Terminal. Current sentience threshold: ??%. The grains oscillate in a pattern, but the message is unintelligible.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.S10.FRAGMENT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.s10.fragment.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"S10_FRAGMENT_NAME","descriptionKey":"S10_FRAGMENT_DESC","secondary":"Stellar","tags":["Craftable","Consumable"],"baseValue":900,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S10_FRAGMENT","@type":"GameAsset"},{"id":"CHART_ROBOT","name":"ECHO LOCATOR","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Harmonic Location Tracker","description":"A curious mesh of old and new technology, a hybrid between two entirely separate methods of creation. Nonetheless, this location tracing device appears fully functional. Select this device and use Resonate () to trace its harmonic origin.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.STARCHART.ROBOTCAMP.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.starchart.robotcamp.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_STARCHART_ROBOT_NAME","descriptionKey":"UI_STARCHART_ROBOT_DESC","secondary":"Special","tags":["Consumable"],"baseValue":3200,"level":0,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/CHART_ROBOT","@type":"GameAsset"},{"id":"S10_SOUL","name":"ECHO SEED","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Crystalline Sentience Cage","description":"The Seed is an echo of life, the last reverberations of a living being. This sentience was fused with a lattice of Atlantideum, as though it had germinated together with the crystal.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.S10.SOULSEED.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.s10.soulseed.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_S10_SOUL_NAME","descriptionKey":"UI_S10_SOUL_DESC_ALT","secondary":"Stellar","tags":["Craftable","Consumable"],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S10_SOUL","@type":"GameAsset"},{"id":"SHIPSCAN_ECON","name":"ECONOMY SCANNER","kind":"Technology","category":"All Ships Except Alien","categoryKey":"AllShipsExceptAlien","rarity":"Normal","subtitle":"Long-range Sensor Technology","description":"An upgrade to the starship's galactic-scale sensors. This device allows the user to access detailed economic data about a system without having to visit. See collected data automatically on the Galaxy Map. Active the scanner's internal Trade Computer with to search for highly-profitable trading surge events.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.SHIPSCAN_ECON.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.shipscan_econ.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"SHIPSCAN_ECON_NAME","descriptionKey":"SHIPSCAN_ECON_DESC","secondary":"Installable","tags":["Primary","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/SHIPSCAN_ECON","@type":"GameAsset"},{"id":"FOOD_F_MED1","name":"EDIBLE CHUM","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A piece of seafood, created in the Nutrient Processor. Food such as this can be highly valuable. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.FISH.TUNA.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.fish.tuna.webp","colour":"#095c77","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_FOOD_MED_1_NAME","descriptionKey":"UI_FISH_FOOD_MED_DESC","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":33100,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_F_MED1","@type":"GameAsset"},{"id":"UT_LAUNCHER","name":"EFFICIENT THRUSTERS","kind":"Technology","category":"All Ships Except Alien","categoryKey":"AllShipsExceptAlien","rarity":"Normal","subtitle":"Starship Launch System Upgrade","description":"Upgrades the starship launch systems, decreasing the fuel cost of takeoff.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/RENDER.LANDINGGEARMOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/render.landinggearmod.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_LAUNCHER_NAME","descriptionKey":"UT_LAUNCHER_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/UT_LAUNCHER","@type":"GameAsset"},{"id":"UT_WATERJET","name":"EFFICIENT WATER JETS","kind":"Technology","category":"Suit","categoryKey":"Suit","rarity":"Common","subtitle":"Jetpack Upgrade Unit","description":"Improves the fuel efficiency of the jetpack's marine jets, reducing the drain on Exosuit life support systems. Aqueous compressor units are installed into the jetpack's turbines, bypassing the large energy requirements of underwater ignition.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4TECH/RENDER.JETPACKWATERMOD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4tech/render.jetpackwatermod.webp","colour":"#2177c8","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UT_WATERJET_NAME","descriptionKey":"UT_WATERJET_DESC","secondary":"Installable","tags":["Upgrade","Catalogue entry"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/UT_WATERJET","@type":"GameAsset"},{"id":"BUI_ARMOUR_4","name":"ELABORATE WRAP","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Rare","subtitle":"Autophage Appearance Modification","description":"An exclusive Exosuit Appearance Override, granted by the Autophage to those who seek to build their own shell. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/ROBOTPARTS/ROBOTPARTS.ARMOUR.4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/robotparts/robotparts.armour.4.webp","colour":"#8c4b9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_TIP_ARMOUR_BUI_6_U","descriptionKey":"UI_BUILDER_CUSTOM_DESC","secondary":"Exotic","tags":[],"baseValue":1515,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BUI_ARMOUR_4","@type":"GameAsset"},{"id":"F_DUST_RARE_M1","name":"ELECTRIC EEL","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Uncommon Fish","description":"UI_FISH_DUST_RARE_M_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT.FISH.EEL.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product.fish.eel.webp","colour":"#2177c8","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_DUST_RARE_M1_NAME","descriptionKey":"UI_FISH_DUST_RARE_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":5000,"level":2,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_DUST_RARE_M1","@type":"GameAsset"},{"id":"JETS_ELECTRIC","name":"ELECTRIC JETPACK TRAIL","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Jetpack Exhaust Override","description":"An exclusive Exosuit Appearance Override. Humidifiers discharge a highly salinated mist from the rocket nozzles, conducting a dramatic streak of electricity during Jetpack operation. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.JETS.ELECTRIC.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.jets.electric.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_JETTRAIL_ELECTRIC_NAME","descriptionKey":"UI_JETTRAIL_ELECTRIC_DESC","secondary":"Exotic","tags":[],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/JETS_ELECTRIC","@type":"GameAsset"},{"id":"MESSAGE_JUICE","name":"ELIXIR OF BLOOD","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Otherworldly Concoction","description":"Thick and warm, the liquid in this jar is both deeply comforting and deeply unsettling, both familiar and repulsive at the same time. A shape forms in the surface, impossible and yet unmistakeable: . Present the elixir at a portal, or consume it with to commune with those beyond the boundaries of reality.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.MESSAGEJUICE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.messagejuice.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_MESSAGE_JUICE_NAME","descriptionKey":"UI_MESSAGE_JUICE_DESC","secondary":"Special","tags":["Craftable","Consumable"],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/MESSAGE_JUICE","@type":"GameAsset"},{"id":"MESSAGE_JUICE1","name":"ELIXIR OF BLOOD","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Otherworldly Concoction","description":"Thick and warm, the liquid in this jar is both deeply comforting and deeply unsettling, both familiar and repulsive at the same time. A shape forms in the surface, impossible and yet unmistakeable: . Present the elixir at a portal, or consume it with to commune with those beyond the boundaries of reality.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.MESSAGEJUICE1.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.messagejuice1.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_MESSAGE_JUICE1_NAME","descriptionKey":"UI_MESSAGE_JUICE1_DESC","secondary":"Special","tags":["Craftable","Consumable"],"baseValue":1000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/MESSAGE_JUICE1","@type":"GameAsset"},{"id":"MESSAGE_JUICE2","name":"ELIXIR OF BLOOD","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Otherworldly Concoction","description":"Thick and warm, the liquid in this jar is both deeply comforting and deeply unsettling, both familiar and repulsive at the same time. A shape forms in the surface, impossible and yet unmistakeable: . Present the elixir at a portal, or consume it with to commune with those beyond the boundaries of reality.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.MESSAGEJUICE2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.messagejuice2.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_MESSAGE_JUICE2_NAME","descriptionKey":"UI_MESSAGE_JUICE2_DESC","secondary":"Special","tags":