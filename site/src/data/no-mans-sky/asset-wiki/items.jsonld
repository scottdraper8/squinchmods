:333,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BUI_CLOTH_1","@type":"GameAsset"},{"id":"CHART_BUI_SETTL","name":"AUTOPHAGE SETTLEMENT CHART","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Harmonic Planetary Chart","description":"A map showing the location of a nearby Autophage planetary settlement, acquired from an Autophage Synthesis Terminal. Select the map and use Plot Route () to pin the location in your Exosuit display.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.STARCHART.SETTLEMENTBUILDERS.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.starchart.settlementbuilders.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_STARCHART_BUI_SETTLE_NAME","descriptionKey":"UI_STARCHART_BUI_SETTLE_DESC","secondary":"Special","tags":["Consumable"],"baseValue":1499,"level":0,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/CHART_BUI_SETTL","@type":"GameAsset"},{"id":"HULK_AUX","name":"AUXILIARY CORE","kind":"Product","category":"Space Salvage","categoryKey":"SpaceSalvage","rarity":"Rare","subtitle":"Rare Salvage Material","description":"Full of heavy metals and precious synthetics, this is a valuable piece of industrial salvage. Harvested from the decaying remains of a collapsing space hulk. This has been processed at a deep-space outpost, and can be sold on the open market.","icon":"TEXTURES/UI/FRONTEND/ICONS/PRODUCTS/PRODUCT.2026.HULK.AUX.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/products/product.2026.hulk.aux.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_HULK_AUX_NAME","descriptionKey":"UI_HULK_UNCOMMON_DESC","secondary":"Exotic","tags":["Craftable","Cooking ingredient"],"baseValue":56000,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/HULK_AUX","@type":"GameAsset"},{"id":"BIOSHIP_EGG3","name":"AWAKENED VOID EGG","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Agitated Curiosity","description":"An anomalous egg. Since the encounter with the bizarre deep-space 'creature', its strange music has grown more active, more agitated. When touched, conjures a powerful vision of a water world covered in lush and verdant plantlife.","icon":"TEXTURES/UI/FRONTEND/ICONS/TECHNOLOGY/BIO/PRODUCT.EGG3.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/technology/bio/product.egg3.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_BIOSHIP_EGG3_NAME","descriptionKey":"UI_BIOSHIP_EGG3_DESC","secondary":"Exotic","tags":[],"baseValue":1616,"level":0,"stackMultiplier":0,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BIOSHIP_EGG3","@type":"GameAsset"},{"id":"DECAL_FPLANET2","name":"AWAKENINGS DECAL","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive placeable decal, to add flair and decoration to bases. This decal depicts an explorer awakening on a strange world, with no memory of how they got there...","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.FIRSTPLANET2.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.firstplanet2.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_DECAL_P_FIRSTPLANET2_NAME","descriptionKey":"BLD_DECAL_P_FIRSTPLANET2_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/DECAL_FPLANET2","@type":"GameAsset"},{"id":"MAINT_BAIT","name":"BAIT BOX","kind":"Technology","category":"Maintenance","categoryKey":"Maintenance","rarity":"Impossible","subtitle":"Automatic Bait Dispenser","description":"Insert bait or lures to attract specific fish, or to improve catch chances. Note: any foodstuff may be used as bait. Current Bait: %BAIT% Catch Rarity Improvement: %RARE_BOOST%% Catch Size Improvement %SIZE_BOOST%% Other notes: %NOTES%","icon":"TEXTURES/UI/FRONTEND/ICONS/UPDATE3/TRADEPROD.COMMODITY4.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/update3/tradeprod.commodity4.webp","colour":"#095c77","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_BAIT_BOX_NAME","descriptionKey":"UI_BAIT_BOX_DESC","secondary":"Core","tags":["Core technology"],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/MAINT_BAIT","@type":"GameAsset"},{"id":"S_POSTER31","name":"BAKE SALE POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster advertises an assortment of baked goods, including a crusty bread roll and fresh stack of haunted wafers.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.S_POSTER31.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.s_poster31.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_S_POSTER31_NAME","descriptionKey":"BLD_S_POSTER31_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/S_POSTER31","@type":"GameAsset"},{"id":"FOOD_B_WEIRD","name":"BAKED ANOMALY","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A well-baked biscuit, created in the Nutrient Processor. What was once a thin sheet of vaguely-sweetend nutrient paste has been elevated with the addition of carefully-chosen ingredients.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.BISCUIT.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.biscuit.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_B_WEIRD_NAME","descriptionKey":"UI_BISCUIT_DESC_REF","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":40000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_B_WEIRD","@type":"GameAsset"},{"id":"FOOD_PIE_CHEESE","name":"BAKED CHEESE TART","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A highly refined food product, created in the Nutrient Processor. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Food such as this can be highly valuable.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.TART.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/cookingproducts/product.refined.tart.webp","colour":"#d35300","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"FOOD_PIE_CHEESE_NAME","descriptionKey":"FOOD_REFINED_DESC_FINAL","secondary":"Exotic","tags":["Consumable","Cooking ingredient"],"baseValue":62000,"level":0,"stackMultiplier":10,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FOOD_PIE_CHEESE","@type":"GameAsset"},{"id":"FOOD_R_EGGS","name":"BAKED EGGS","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A refined food product, created in the Nutrient Processor. Food such as this can be highly valuable. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Can be consumed as it stands or subjected to further processing.","icon":"TEXTURES/UI/FRONTEND/ICONS/COOKINGPRODUCTS/PRODUCT.REFINED.OMLETTE.DDS","preview":"/asset-wiki/assets/textures/ui/fronte