NAME","descriptionKey":"UI_GEODE_ASTEROID_DESC","secondary":"Special","tags":["Consumable"],"baseValue":3200,"level":0,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/GEODE_ASTEROID","@type":"GameAsset"},{"id":"STATUE_WALK_G","name":"GOLD WALKER STATUE","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Unlockable Decoration","description":"An exclusive buildable base ornament, cast in gold. This statue depicts the Sentinel Walker, an advanced combat unit.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.WALK_G.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.walk_g.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_WALK_G_NAME","descriptionKey":"BLD_WALK_G_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/STATUE_WALK_G","@type":"GameAsset"},{"id":"EXPD_FIREWORK02","name":"GOLD-BLUE ATLAS FIREWORK","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Consumable Pyrotechnics Device","description":"A stunning pyrotechnic rendition of an Atlas Interface, rendered in a burst of gold and indium. Ignite to create glittering displays in the sky. Place launch tube via the Build Menu (). Warning: Aim away from living creatures. Not recommended for indoor use.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.EXPEDITION.FIREWORK02.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.expedition.firework02.webp","colour":"#262626","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FIREWORK_PROD_EXPD_02_NAME","descriptionKey":"UI_FIREWORK_PROD_EXPD_02_DESC","secondary":"Exotic","tags":[],"baseValue":50,"level":0,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_FIREWORK02","@type":"GameAsset"},{"id":"EXPD_HELMET01","name":"GOLDEN FIRST SPAWN BATTLE MASK","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Unlockable Helmet","description":"An aggressive Exosuit Appearance Override, modeled on the war helmets of the ancient Gek. This special edition is cast in a durable and precious alloy. Transform the appearance of your Exosuit at an Appearance Modifier.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.EXPEDITION.HELMET01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.expedition.helmet01.webp","colour":"#007951","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_HELMET_01_NAME","descriptionKey":"UI_EXPD_HELMET_01_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_HELMET01","@type":"GameAsset"},{"id":"FREI_TRAIL_YEL","name":"GOLDEN FREIGHTER TRAIL","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Freighter Engine Flare Override","description":"An exclusive Freighter Engine Flare Modifier. The extreme heat of the freighter's engines excites this filter of sodium salts, tinting the exhaust with a vivid golden hue. Transform the appearance of your freighter at the Upgrade Control Terminal on the bridge.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.FREIGHTJETS.YELLOW.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.freightjets.yellow.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FREI_TRAIL_YEL_NAME","descriptionKey":"UI_FREI_TRAIL_YEL_DESC","secondary":"Exotic","tags":[],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/FREI_TRAIL_YEL","@type":"GameAsset"},{"id":"F_ALL_LEG_M1","name":"GOLDEN JELLYFISH","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Legendary Fish","description":"\"Its tentacles that glitter like wisps of golden hair, but sting with the fire of thousand suns.\"","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT3.FISH.JELLY.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product3.fish.jelly.webp","colour":"#f3a923","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_ALL_LEG_M1_NAME","descriptionKey":"UI_FISH_ALL_LEG_M_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":100000,"level":4,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_ALL_LEG_M1","@type":"GameAsset"},{"id":"EXPD_SHIP23A","name":"GOLDEN RASAMAMA S36","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive golden edition of the classic Rasamama S36, commemorating completion of the expedition Our Journey Continues, and the pilgrimage through past iterations of No Man's Sky. This highly-manoeuvrable spacecraft is constructed from a durable and precious alloy, and coated in a tough layer of fibrous insulation to endure many lifetimes' worth of rigorous space exploration. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/EXPEDITION.S23.SHIPA.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/expedition.s23.shipa.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_SHIP_23A_NAME","descriptionKey":"UI_EXPD_SHIP_23A_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_SHIP23A","@type":"GameAsset"},{"id":"SHIP_GOLD","name":"GOLDEN STARSHIP TRAIL","kind":"Product","category":"Customisation Part","categoryKey":"CustomisationPart","rarity":"Common","subtitle":"Starship Exhaust Override","description":"An exclusive Starship Exhaust Modifier. Gold injection nozzles add a dazzling gold flair to the Pulse Engine's output. Install this technology in your starship inventory to change the appearance of the engine exhaust trails.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.SHIPTRAIL.GOLD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.shiptrail.gold.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_SHIPTRAIL_GOLD_NAME","descriptionKey":"UI_SHIPTRAIL_GOLD_DESC","secondary":"Exotic","tags":[],"baseValue":800,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SHIP_GOLD","@type":"GameAsset"},{"id":"T_SHIP_GOLD","name":"GOLDEN STARSHIP TRAIL","kind":"Technology","category":"All Ships","categoryKey":"AllShips","rarity":"Impossible","subtitle":"Starship Exhaust Override","description":"An exclusive Starship Exhaust Modifier. Gold injection nozzles add a dazzling gold flair to the Pulse Engine's output. Install this technology in your starship inventory to change the appearance of the engine exhaust trails.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.SHIPTRAIL.GOLD.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.shiptrail.gold.webp","colour":"#1a2733","source":"NMS_REALITY_GCTECHNOLOGYTABLE.MBIN","nameKey":"UI_SHIPTRAIL_GOLD_NAME","descriptionKey":"UI_SHIPTRAIL_GOLD_DESC","secondary":"Installable","tags":[],"baseValue":1,"level":1,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/technology/T_SHIP_GOLD","@type":"GameAsset"},{"id":"SPEC_FIREWORK08","name":"GOLDEN TITAN FIREWORK","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Consumable Pyrotechnics Device","description":"This exotic firework, tinted with sodium salts, is inspired by the undulating form of the titanic sandworm. Ignite to create glittering displays in the sky. Place launch tube via the Build Menu (). Warning: Aim away from living creatures. Not recommended for indoor use.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.FIREWORK08.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.firework08.webp","colour":"#262626","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FIREWORK_PROD_TITAN_Y_NAME","descriptionKey":"UI_FIREWORK_PROD_TITAN_Y_DESC","secondary":"Exotic","tags":[],"baseValue":60,"level":0,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/SPEC_FIREWORK08","@type":"GameAsset"},{"id":"F_DUST_EPIC_S1","name":"GOLDEN URCHIN","kind":"Product","category":"Fish","categoryKey":"Fish","rarity":"Common","subtitle":"Rare Fish","description":"UI_FISH_DUST_EPIC_S_DESC","icon":"TEXTURES/UI/FRONTEND/ICONS/FISH/PRODUCT3.FISH.STARFISH.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/fish/product3.fish.starfish.webp","colour":"#4d2957","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_FISH_DUST_EPIC_S1_NAME","descriptionKey":"UI_FISH_DUST_EPIC_S_DESC","secondary":"Special","tags":["Consumable","Cooking ingredient","Trade good"],"baseValue":10000,"level":3,"stackMultiplier":5,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/F_DUST_EPIC_S1","@type":"GameAsset"},{"id":"EXPD_SHIP01","name":"GOLDEN VECTOR","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Common","subtitle":"Exclusive Spacecraft","description":"An exclusive golden edition of the iconic Alpha Vector Starship, commemorating completion of the inaugural Expedition, 'Pioneers'. This highly-manoeuvrable spacecraft is constructed from a durable and precious alloy, and coated in a tough layer of fibrous insulation to endure many lifetimes' worth of rigorous space exploration. Claim this ship to add it to your collection, or Exchange it with your current ship. While on a planet, summon ships from the Quick Menu ().","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL.EXPEDITION.SHIP01.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special.expedition.ship01.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_EXPD_SHIP_01_NAME","descriptionKey":"UI_EXPD_SHIP_01_DESC","secondary":"Exotic","tags":[],"baseValue":3000,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_SHIP01","@type":"GameAsset"},{"id":"EXPD_POSTER15A","name":"GONE FISHIN' POSTER","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Decoration","description":"An exclusive piece of self-adhesive, crease-proof wall art. This poster celebrates the need to get away from distractions and spend some time on and/or in the water.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.EXPEDITION.POSTER15A.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.expedition.poster15a.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_EXPD_POSTER15A_NAME","descriptionKey":"BLD_EXPD_POSTER15A_DESCRIPTION","secondary":"BuildingPart","tags":["Craftable"],"baseValue":400,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/EXPD_POSTER15A","@type":"GameAsset"},{"id":"FOOD_R_BLOBBUT","name":"GOOEY BUTTER","kind":"Product","category":"Consumable","categoryKey":"Consumable","rarity":"Common","subtitle":"Edible Product","description":"A refined food product, created in the Nutrient Processor. Food such as this can be highly valuable. It has both the identifying shapes and aromas of an actual food item, in stark contrast with conventional nutrition paste or pellets. Can be consumed as it stands or subjected to further processing.","ico