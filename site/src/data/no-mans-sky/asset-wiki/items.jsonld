,"tags":["Consumable"],"baseValue":480,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/U_EXO_SUBGUN4","@type":"GameAsset"},{"id":"BLD_MAPTUBE","name":"NAVIGATION ARCHIVE","kind":"Product","category":"Building Part","categoryKey":"BuildingPart","rarity":"Common","subtitle":"Secure Map Containment","description":"A secure containment vessel, designed to provide a near-indestructible chamber for the storage of vital navigation charts. Resilient and designed to last thousands of years, this archive is entirely free of electronic components.","icon":"TEXTURES/UI/FRONTEND/ICONS/SPECIALSHOP/SPECIAL1.MAPTUBE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/specialshop/special1.maptube.webp","colour":"#2c7c9f","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"BLD_MAPTUBE_NAME","descriptionKey":"BLD_MAPTUBE_DESC","secondary":"BuildingPart","tags":["Craftable"],"baseValue":500,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/BLD_MAPTUBE","@type":"GameAsset"},{"id":"MP_REP_PART1C","name":"NAVIGATION COMPUTER","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Starship Component","description":"An advanced nanocomputer, performing processing tasks related to starship navigation, flight stabilisation, and external sensors. The part appears intact, functional, and ready to be installed in a new ship.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.SALVAGE.RARE.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.salvage.rare.webp","colour":"#1a2733","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_MP_REPAIR_PART1C_NAME","descriptionKey":"UI_MP_REPAIR_PART1C_DESC","secondary":"Special","tags":["Consumable"],"baseValue":3200,"level":0,"stackMultiplier":1,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/MP_REP_PART1C","@type":"GameAsset"},{"id":"NAV_DATA","name":"NAVIGATION DATA","kind":"Product","category":"Curiosity","categoryKey":"Curiosity","rarity":"Rare","subtitle":"Encrypted Navigation Data","description":"Encoded navigation data. This highly portable data unit contains all relevant cartographical information for a planetary region. May be traded with a Cartographer aboard a Space Station in exchange for usable star charts.","icon":"TEXTURES/UI/FRONTEND/ICONS/U4PRODUCTS/PRODUCT.NAVDATA.DDS","preview":"/asset-wiki/assets/textures/ui/frontend/icons/u4products/product.navdata.webp","colour":"#0063b7","source":"NMS_REALITY_GCPRODUCTTABLE.MBIN","nameKey":"UI_NAV_DATA_NAME","descriptionKey":"UI_NAV_DATA_DESC","secondary":"Special","tags":["Consumable"],"baseValue":1000,"level":0,"stackMultiplier":4,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/product/NAV_DATA","@type":"GameAsset"},{"id":"CV_SCI1","name":"navigation systems","kind":"Upgrade module","category":"Scanning","categoryKey":"Scanning","rarity":"Normal","subtitle":"UP_CRUI_SUB","description":"UT_CR_SCI_DESC","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UT_CR_SCI_NAME","descriptionKey":"UT_CR_SCI_DESC","secondary":"T_CR_SCI","tags":["3 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/CV_SCI1","@type":"GameAsset"},{"id":"CV_SCI2","name":"navigation systems","kind":"Upgrade module","category":"Scanning","categoryKey":"Scanning","rarity":"Rare","subtitle":"UP_CRUI_SUB","description":"UT_CR_SCI_DESC","icon":"","preview":"","colour":"#2177c8","source":"NMS_REALITY_GCPROCEDURALTECHNOLOGYTABLE.MBIN","nameKey":"UT_CR_SCI_NAME","descriptionKey":"UT_CR_SCI_DESC","secondary":"T_CR_SCI","tags":["3 possible stats"],"baseValue":null,"level":null,"stackMultiplier":null,"@id":"https://no-mans-sky.squinchmods.com/asset-wiki/id/item/upgrade-module/CV_SCI2","@type":"GameAsset"},{"id":"CV_SCI3","name":"navig