{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "squinchmods",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-27",
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.jsonld"],
      "fallthrough": true,
    },
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*", "!/favicon.svg", "!/robots.txt"],
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8788,
  },
}
