package example;

import com.google.gson.JsonObject;
import org.squinchmods.investigate.FinishedChunkSelection;
import org.squinchmods.investigate.ProbePack;
import org.squinchmods.investigate.ProbeRegistry;

public final class ExampleProbePack implements ProbePack {
    @Override
    public void register() {
        ProbeRegistry.register("example:probe", "1", request -> {
            FinishedChunkSelection selection = new FinishedChunkSelection(
                request.config(), "example:probe"
            );
            return server -> {
                FinishedChunkSelection.Snapshot snapshot = selection.poll(server.overworld());
                if (snapshot == null) {
                    return null;
                }
                JsonObject data = new JsonObject();
                data.addProperty("measurement", "replace-with-specific-result");
                return selection.result(snapshot, data);
            };
        });
    }
}
