{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://squinchmods.local/schemas/nms-investigate/cli-output-v1.json",
  "title": "Squinch No Man's Sky investigation CLI envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "state", "run_id", "timestamps", "artifact_paths", "error", "data"],
  "properties": {
    "schema_version": {"const": "1"},
    "command": {"type": "string", "minLength": 1},
    "state": {"enum": ["succeeded", "failed", "inconclusive", "error", "inactive", "staged", "degraded"]},
    "run_id": {"type": ["string", "null"], "minLength": 1},
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emitted_at", "started_at", "finished_at"],
      "properties": {
        "emitted_at": {"type": "string", "format": "date-time"},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "finished_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "artifact_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1},
            "details": {"type": "object"}
          }
        }
      ]
    },
    "data": {"type": "object"}
  }
}
