{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://squinchmods/.squinch/schema/mod-config.schema.json",
  "title": "Minecraft local check configuration",
  "description": "Targets and test settings for one mod's local checks.",
  "type": "object",
  "required": ["schema", "mod", "targets"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "mod": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/profileOverride" }
    },
    "tests": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/testDef" }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": ["id", "minecraft", "loader", "java"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "minecraft": { "type": "string", "minLength": 1 },
        "loader": {
          "type": "string",
          "enum": ["forge", "neoforge", "fabric", "quilt"]
        },
        "loader_version": { "type": "string" },
        "java": { "type": "integer", "minimum": 8 }
      }
    },
    "profileOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "add": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "config": {
                "type": "object",
                "description": "Profile-specific settings merged over shared and mod test settings."
              }
            }
          }
        }
      },
      "oneOf": [{ "required": ["add"] }, { "required": ["tests"] }]
    },
    "testDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config": {
          "type": "object",
          "description": "Settings consumed by the selected check."
        }
      }
    }
  }
}
